// The four flow operators, each rendered with its own edge style.
scene theme=paper
layout LR

client WebApp
service Api
database RecordsDb
queue EventQueue

beat flows:
  show $nodes
  WebApp -> Api "request"          // -> solid request edge
  Api <- WebApp "response"         // <- dashed response (drawn back toward API)
  Api ~> EventQueue "event"        // ~> dotted event edge
  Api -- RecordsDb "dependency"    // -- thin dependency link

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.25 1"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
