// The four flow operators, each rendered with its own edge style.
scene theme=paper

client WebApp
service Api
database RecordsDb
queue EventQueue

beat flows:
  WebApp -> Api "request"          // -> solid request edge
  WebApp <- Api "response"         // <- dashed response (drawn back toward client)
  Api ~> EventQueue "event"        // ~> dotted event edge
  Api -- RecordsDb "dependency"    // -- thin dependency link

player:
  playback:
    loop true
  controls:
    speed true
    speeds "0.25"
    interact true
    fullscreen true
    gif true
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress none
    color "#3b82f6"
