# 18-layer-stack.markdy
# Demonstrates Layer Stack Layout for Abstraction / Context Hierarchy.

scene theme=editorial type=layers

service AppLayer "Application Layer (HTTP / TLS / gRPC)"
service TransportLayer "Transport Layer (TCP / UDP)" focal=true
service NetworkLayer "Network Layer (IP / Routing / BGP)"
service DataLinkLayer "Data Link Layer (Ethernet / Frames)"
service PhysicalLayer "Physical Layer (Fiber / Radio)"

beat stack_reveal "Abstraction Stack":
  show $nodes stagger=50ms
  glow TransportLayer "Flow control and packet reliability"

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
