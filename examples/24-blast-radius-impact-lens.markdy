// Showcase: Blast Radius & Impact Lens Analysis
// Illustrates the root fault and its downstream transitive blast radius.
scene "Blast Radius & Topology Impact Lens" theme=midnight

client Ingest "Ingest Producer" icon=terminal
gateway Router "Ingress Router" icon=nginx
service Worker "Processing Engine" icon=golang
service Transform "Data Transformer" icon=python stroke="#ef4444" accent="#ef4444" tech="Root Fault"
cache HotBuffer "Redis Buffer" icon=redis stroke="#f97316" accent="#f97316" tech="Blast Radius"
database CentralStore "Primary Warehouse" icon=postgres stroke="#f97316" accent="#f97316" tech="Blast Radius"
service Analytics "Real-Time Dashboard" icon=grafana stroke="#f97316" accent="#f97316" tech="Transitive Impact"

beat pipeline_flow:
  Ingest -> Router "Push Telemetry" -> Worker "Task Queue"
  Worker -> Transform "Normalize Payload"
  Transform -> HotBuffer "Stage Batch"
  Transform -> CentralStore "Bulk Commit"
  CentralStore -> Analytics "Query Materialized View"

beat simulate_impact "Cascading Blast Radius & Impact Lens":
  glow Transform color=#ef4444
  glow HotBuffer CentralStore Analytics color=#f97316

player:
  playback:
    loop true
  controls:
    speed true
    speeds "0.25"
    interact true
    fullscreen true
    gif true
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress none
