# Kubernetes rollout from CI to cluster, pod, and service endpoint.
scene width=1000 height=460 bg=#0f172a fps=30

service CI at (110, 230)
container Image at (320, 230)
cluster Kubernetes at (550, 230)
container PodA "Pod A" at (760, 150)
container PodB "Pod B" at (760, 310)
service Service at (900, 230)
actor title = caption("Kubernetes deployment") at top opacity 0

scene "build" {
  @+0.0: title.line_reveal(from=left, dur=0.4)
  @+0.2: CI.request(to=Image, label=build, dur=0.6)
  @+0.0: Image.glow(color=#38bdf8, dur=0.5)
}

scene "rollout" {
  @+0.2: Image.emit(to=Kubernetes, label=deploy, dur=0.6)
  @+0.0: Kubernetes.pulse(amount=1.08, dur=0.5)
  @+0.2: Kubernetes.emit(to=PodA, label=schedule, dur=0.5)
  @+0.0: Kubernetes.emit(to=PodB, label=schedule, dur=0.5)
}

scene "ready" {
  @+0.3: PodA.response(to=Service, label=ready, dur=0.5)
  @+0.0: PodB.response(to=Service, label=ready, dur=0.5)
  @+0.1: Service.ripple(color=#22c55e, dur=0.6)
}