# A card moving through idle, loading, loaded, and error states.
scene width=800 height=420 bg=#f8fafc

actor title    = caption("Card component states") at top
actor card     = box() at (400, 220)
actor spinner  = box() at (400, 220) scale 0.15 opacity 0
actor s_idle    = caption("Idle") at bottom opacity 0
actor s_loading = caption("Loading…") at bottom opacity 0
actor s_loaded  = caption("Loaded") at bottom opacity 0
actor s_error   = caption("Error") at bottom opacity 0

scene "idle" {
  @+0.0: title.fade_in(dur=0.4)
  @+0.3: card.enter(from=top, dur=0.4)
  @+0.0: s_idle.fade_in(dur=0.3)
}

scene "loading" {
  @+0.6: s_idle.fade_out(dur=0.2)
  @+0.0: spinner.fade_in(dur=0.2)
  @+0.0: spinner.rotate(to=360, dur=0.8, ease=inout)
  @+0.0: s_loading.fade_in(dur=0.3)
}

scene "loaded" {
  @+0.9: spinner.fade_out(dur=0.2)
  @+0.0: s_loading.fade_out(dur=0.2)
  @+0.0: card.scale(to=1.1, dur=0.35, ease=overshoot)
  @+0.0: s_loaded.fade_in(dur=0.3)
}

scene "error" {
  @+0.8: s_loaded.fade_out(dur=0.2)
  @+0.0: card.shake(intensity=6, dur=0.35)
  @+0.0: card.scale(to=1.0, dur=0.3, ease=out)
  @+0.0: s_error.fade_in(dur=0.3)
}
