# CI/CD pipeline from commit to production deploy.
scene width=1000 height=430 bg=#0f172a fps=30

service Git at (100, 220)
service Test at (300, 220)
service Build at (500, 220)
container Artifact at (700, 220)
cloud Production at (900, 220)
actor title = caption("CI/CD pipeline") at top opacity 0

scene "pipeline" {
  @+0.0: title.line_reveal(from=left, dur=0.4)
  @+0.2: Git.emit(to=Test, label=commit, dur=0.5)
  @+0.0: Test.pulse(dur=0.35)
  @+0.2: Test.emit(to=Build, label=pass, dur=0.5)
  @+0.0: Build.glow(color=#38bdf8, dur=0.4)
  @+0.2: Build.emit(to=Artifact, label=image, dur=0.5)
  @+0.2: Artifact.emit(to=Production, label=deploy, dur=0.6)
  @+0.0: Production.ripple(color=#22c55e, dur=0.6)
}