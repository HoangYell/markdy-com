# Sequential bullet points animating in with stagger — the PowerPoint-style reveal people actually need.
scene width=800 height=450 bg=#f8fafc

actor title = caption("What's new this release") at top
actor b1 = text("Faster cold starts") at (400, 170) size 26 opacity 0
actor b2 = text("Smaller bundle size") at (400, 220) size 26 opacity 0
actor b3 = text("Built-in retry logic") at (400, 270) size 26 opacity 0
actor b4 = text("Zero config setup") at (400, 320) size 26 opacity 0

@0.0: title.fade_in(dur=0.5)
@0.8: b1.fade_in(dur=0.5, ease=out)
@1.0: b2.fade_in(dur=0.5, ease=out)
@1.2: b3.fade_in(dur=0.5, ease=out)
@1.4: b4.fade_in(dur=0.5, ease=out)
