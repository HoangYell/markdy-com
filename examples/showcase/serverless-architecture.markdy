# Serverless request flow from edge to function, queue, and database.
scene width=1000 height=460 bg=#0f172a fps=30

client Browser at (100, 240)
cloud Edge at (300, 240)
service Function at (520, 160)
queue Jobs at (520, 320)
database D1 at (760, 160)
service Worker at (760, 320)
actor title = caption("Serverless architecture") at top opacity 0

scene "request" {
  @+0.0: title.line_reveal(from=left, dur=0.4)
  @+0.2: Browser.request(to=Edge, label=request, dur=0.6)
  @+0.0: Edge.glow(color=#38bdf8, dur=0.5)
  @+0.2: Edge.request(to=Function, label=invoke, dur=0.5)
  @+0.2: Function.request(to=D1, label=query, dur=0.5)
}

scene "async" {
  @+0.2: Function.emit(to=Jobs, label=enqueue, dur=0.5)
  @+0.2: Jobs.emit(to=Worker, label=job, dur=0.5)
  @+0.0: Worker.ripple(color=#22c55e, dur=0.5)
  @+0.2: Function.response(to=Browser, label="200", dur=0.7)
}