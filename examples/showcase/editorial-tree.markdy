scene theme=editorial type=tree width=1280 height=720
layout TB

service CEO "Chief Executive"
service Eng "Engineering"
service Sales "Sales"
service Backend "Backend"
service Frontend "Frontend"

edge e1: CEO -> Eng
edge e2: CEO -> Sales
edge e3: Eng -> Backend
edge e4: Eng -> Frontend

group company: CEO Eng Sales Backend Frontend

beat reveal:
  show $nodes stagger=45ms
  frame company zoom=1.05 dur=600ms

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.1 0.25 0.5 1 1.5"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
