scene "Organizational Leadership & Hierarchy Tree" theme=auto type=tree

service CEO "Chief Executive Officer"
service Eng "Engineering Leadership"
service Sales "Global Sales Division"
service Backend "Backend Platform Fleet"
service Frontend "Frontend Experience Fleet"

edge e1: CEO -> Eng
edge e2: CEO -> Sales
edge e3: Eng -> Backend
edge e4: Eng -> Frontend

group company "Executive Org Tree": CEO Eng Sales Backend Frontend

beat reveal "1. Reveal Organizational Hierarchy":
  show $nodes stagger=45ms
  frame company zoom=1.05 dur=600ms
  glow CEO color=#c45d3e & glow Eng color=#10b981

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
