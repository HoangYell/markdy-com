scene theme=paper width=1200 height=720
layout LR

client Browser
service API
database DB
queue Queue
cache Redis
auth Auth
pipeline Pipeline
monitor Monitor

group app: Browser API Auth
group data: DB Redis Queue
group ops: Pipeline Monitor

beat layout:
  show app stagger=40ms & show data stagger=40ms & show ops stagger=40ms

beat sample:
  Browser -> API "request"
  API -> DB "persist"
  API ~> Queue "enqueue" & API -> Redis "cache"
  Auth <- API "token"
  Pipeline -- Monitor "metrics"

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.1 0.25 0.5 1 1.5"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
