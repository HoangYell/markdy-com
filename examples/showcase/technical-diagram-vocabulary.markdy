scene "Technical Diagram Vocabulary" theme=midnight
layout LR

client Browser
service API
database DB
queue Queue
cache Redis
auth Auth
pipeline Pipeline
monitor Monitor

beat layout:
  show $nodes stagger=40ms

beat sample:
  Browser -> API "request" -> DB "persist"
  API ~> Queue "enqueue" & API -> Redis "cache"
  Auth <- API "token"
  Pipeline -- Monitor "metrics"
