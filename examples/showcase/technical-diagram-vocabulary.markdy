scene "Technical Diagram Vocabulary" theme=paper width=1200 height=720
layout LR

client Browser
service API
database DB
queue Queue
cache Redis
auth Auth
pipeline Pipeline
monitor Monitor

group app: Browser API Auth
group data: DB Redis Queue
group ops: Pipeline Monitor

beat layout:
  show app stagger=40ms & show data stagger=40ms & show ops stagger=40ms

beat sample:
  Browser -> API "request"
  API -> DB "persist"
  API ~> Queue "enqueue" & API -> Redis "cache"
  Auth <- API "token"
  Pipeline -- Monitor "metrics"
