scene "Technical Architecture Node Vocabulary" theme=auto

client Browser "Web Browser"
service API "API Gateway"
database DB "PostgreSQL 16"
queue Queue "Kafka Stream"
cache Redis "Redis Cache"
auth Auth "OIDC Auth Engine"
pipeline Pipeline "CI/CD Pipeline"
monitor Monitor "Telemetry Monitor"

group app "Application & Auth": Browser API Auth
group data "Data & Messaging": DB Redis Queue
group ops "DevOps & Telemetry": Pipeline Monitor

beat layout "1. Initialize Architecture Vocabulary":
  show app stagger=40ms & show data stagger=40ms & show ops stagger=40ms

beat sample "2. Multi-Protocol Edge Orchestration":
  frame app data zoom=1.1 dur=500ms
  Browser -> API "GET /data"
  API -> DB "ACID persist"
  API ~> Queue "publish event" & API -> Redis "cache hot data"
  Auth <- API "validate JWT"
  Pipeline -- Monitor "stream build metrics"
  glow DB color=#10b981 & glow Queue color=#f59e0b

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
