scene theme=editorial type=state width=1100 height=720
layout LR

state Pending "Pending"
state Paid "Paid"
state Shipped "Shipped"
state Closed "Closed"

edge flow1: Pending -> Paid
edge flow2: Paid -> Shipped
edge flow3: Shipped -> Closed
edge loop: Pending -> Pending

beat lifecycle "State transitions":
  show $nodes stagger=50ms
  Pending -> Paid "payment captured"
  Paid -> Shipped "carrier pickup"
  Shipped -> Closed "delivered"

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.25 1"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
