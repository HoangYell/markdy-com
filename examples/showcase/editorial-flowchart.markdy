scene theme=editorial type=flowchart width=960 height=720
layout TB
annotation "Decision gate" target=Valid position=top-left

start Start "Begin checkout"
decision Valid "Cart valid?"
service Process "Process payment"
end End "Complete"

edge path: Start -> Valid -> Process -> End

beat main "Walk the flow":
  show $nodes stagger=60ms
  Start -> Valid "scan cart"
  Valid -> Process "charge card"
  Process -> End "send receipt"

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.1 0.25 0.5 1 1.5"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
