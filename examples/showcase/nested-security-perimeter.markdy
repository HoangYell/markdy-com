# nested-security-perimeter.markdy
# Kubernetes Zero-Trust Security Perimeter & VPC Defense-in-Depth

scene "Kubernetes Zero-Trust Security Perimeter" theme=auto type=nested width=1280 height=760

security PublicEdge "Layer 1: Global Edge (Cloudflare WAF & DDoS Shield)"
security DMZIngress "Layer 2: DMZ Ingress (Envoy Gateway & Rate Limiter)"
security PrivateMesh "Layer 3: Private Pod Mesh (mTLS & NetworkPolicies)"
security EnclaveCore "Layer 4: Hardware Enclave (HSM Vault & Master Keys)" focal=true

beat edge_perimeter "1. Global Edge Perimeter Filtering":
  show PublicEdge
  frame PublicEdge zoom=1.05 dur=500ms
  glow PublicEdge color=#047857

beat dmz_ingress "2. DMZ Ingress & Token Verification":
  show DMZIngress
  frame DMZIngress zoom=1.08 dur=500ms
  glow DMZIngress color=#38bdf8

beat private_mesh "3. Zero-Trust Private Service Mesh":
  show PrivateMesh
  frame PrivateMesh zoom=1.12 dur=500ms
  glow PrivateMesh color=#a855f7

beat core_vault "4. Hardware Security Module Key Protection":
  show EnclaveCore
  frame EnclaveCore zoom=1.18 dur=500ms
  glow EnclaveCore color=#22c55e strength=1.5

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#047857"
