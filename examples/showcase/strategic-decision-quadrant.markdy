# strategic-decision-quadrant.markdy
# CAP Theorem & Distributed Data Store 2x2 Strategic Quadrant

scene "CAP Theorem Distributed Storage 2x2 Matrix" theme=auto type=quadrant width=1280 height=760

database Spanner "Google Cloud Spanner (CP / Strict)" quadrant=Q1 focal=true
database Cockroach "CockroachDB (CP / Raft SQL)" quadrant=Q1

database Cassandra "Apache Cassandra (AP / Tunable)" quadrant=Q2
database DynamoDB "AWS DynamoDB (AP / High-Write)" quadrant=Q2

database SQLite "Embedded SQLite (CA / Single-Node)" quadrant=Q3
database Postgres "PostgreSQL (CA / ACID)" quadrant=Q3

database RedisCluster "Redis Sentinel (HA In-Memory)" quadrant=Q4

beat reveal "1. CAP Theorem Architectural Classification":
  show $nodes stagger=40ms
  frame Spanner Cockroach Cassandra DynamoDB SQLite Postgres RedisCluster zoom=1.05 dur=500ms
  glow Spanner color=#047857

beat cp_focus "2. Strict Consistency & Partition Tolerance (CP)":
  frame Spanner Cockroach zoom=1.15 dur=500ms
  glow Spanner color=#22c55e & glow Cockroach color=#22c55e

beat ap_focus "3. High Availability & Eventual Consistency (AP)":
  frame Cassandra DynamoDB zoom=1.15 dur=500ms
  glow Cassandra color=#38bdf8 & glow DynamoDB color=#38bdf8 strength=1.4

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#047857"
