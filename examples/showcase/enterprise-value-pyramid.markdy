# enterprise-value-pyramid.markdy
# Full-Stack Observability & Telemetry Hierarchy Pyramid

scene "Full-Stack Observability & Telemetry Pyramid" theme=editorial type=pyramid width=1280 height=760

stat AIInsights "Layer 4: AI Root Cause Analysis & Automated Remediation" focal=true
stat Traces "Layer 3: Distributed Tracing & APM (OpenTelemetry / Jaeger)"
stat Metrics "Layer 2: Aggregated Time-Series Metrics (Prometheus / Grafana)"
stat StructuredLogs "Layer 1: High-Volume Structured Logs (Elasticsearch / ClickHouse)"

beat pyramid_reveal "1. Telemetry Hierarchy Stratification":
  show $nodes stagger=60ms
  glow AIInsights color=#047857

beat signal_correlation "2. Multi-Signal Incident Correlation":
  StructuredLogs -> Metrics "aggregate" -> Traces "contextualize" -> AIInsights "diagnose"
  glow AIInsights color=#22c55e

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#047857"
