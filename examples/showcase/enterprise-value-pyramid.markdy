# enterprise-value-pyramid.markdy
# Demonstrates Hierarchical Value Pyramid & Stacked Abstraction Tiers.

scene theme=editorial type=pyramid width=1200 height=800

service UserValue "Developer Velocity & Business Value" tier=0 focal=true
service InternalDevPortal "Internal Developer Portal (Backstage)" tier=1
service OrchestrationMesh "K8s Operator & Service Mesh" tier=2
service CloudFoundation "Multi-Cloud Infrastructure & VPC" tier=3

beat value_pyramid_revelation "1. Value Hierarchy":
  show $nodes stagger=40ms
  glow UserValue "Apex: Max Impact"

beat dependency_chain "2. Upward Capability Flow":
  CloudFoundation -> OrchestrationMesh "automated terraform provisioning"
  OrchestrationMesh -> InternalDevPortal "declarative Golden Paths"
  InternalDevPortal -> UserValue "10x faster service deployments"

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.25 1"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
