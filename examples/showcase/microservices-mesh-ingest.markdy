scene "Service Mesh & Async Event Ingestion" theme=auto

group ingress_mesh "Ingress Controller & Sidecar": IngressController EnvoyProxy
group business_services "Service Mesh Core": CatalogAPI InventoryWorker NotificationSvc
group datastores "Managed Backends Tier": DocumentDB SQSQueue

browser WebClient "Storefront React App"
gateway IngressController "Nginx Ingress Controller"
gateway EnvoyProxy "Envoy Service Mesh Sidecar"

service CatalogAPI "Catalog Service :8080"
worker InventoryWorker "Inventory Sync Worker"
service NotificationSvc "Notification Gateway"

database DocumentDB "MongoDB Atlas Cluster"
queue SQSQueue "AWS SQS FIFO Queue"

beat ingress_beat "1. Ingress Routing & Sidecar mTLS":
  show WebClient ingress_mesh business_services stagger=30ms
  frame WebClient ingress_mesh business_services zoom=1.05 dur=500ms
  WebClient -> IngressController "GET /catalog" -> EnvoyProxy "mTLS mesh route"
  EnvoyProxy -> CatalogAPI "forward payload"

beat query_beat "2. Database Read & Event Dispatch":
  show datastores stagger=30ms
  frame CatalogAPI DocumentDB SQSQueue zoom=1.12 dur=500ms
  CatalogAPI -> DocumentDB "find({ active: true })"
  CatalogAPI <- DocumentDB "products cursor"
  CatalogAPI ~> SQSQueue "emit ProductViewed"
  glow DocumentDB color=#10b981

beat async_beat "3. Async Worker Consumption & Client Return":
  frame WebClient ingress_mesh business_services datastores zoom=1.0 dur=500ms
  SQSQueue ~> NotificationSvc "poll SQS batch"
  NotificationSvc -> InventoryWorker "sync inventory status"
  WebClient <- IngressController "200 OK (Product Catalog)"
  glow SQSQueue color=#f59e0b & glow CatalogAPI color=#38bdf8

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
