scene "Zero-Trust FinTech Core Banking & Ledger Engine" theme=auto

group client_tier "Trader Client Terminals": WebTerminal MobileTrader
group edge_perimeter "Edge Security Zone": WAF CloudflareEdge
group gateway_tier "API Orchestration & Auth": KongGateway AuthEngine
group core_domain "Ledger & Transaction Processing": TransactionService AccountService
group persistence "ACID Storage Tier": AuroraPostgres RedisCache
group event_stream "Audit & Compliance Telemetry": KafkaTopic AuditWorker

browser WebTerminal "Trader Workstation"
browser MobileTrader "Mobile App"

gateway CloudflareEdge "Cloudflare Edge & Anycast"
gateway WAF "AWS WAF Shield"
gateway KongGateway "Kong Enterprise Gateway"
service AuthEngine "OAuth2 / OIDC Auth Engine"

service TransactionService "Tx Settlement Engine"
service AccountService "Accounts & Balances Service"

database AuroraPostgres "Amazon Aurora Multi-AZ"
cache RedisCache "Redis Cluster Cache"

queue KafkaTopic "Kafka Audit Log Stream"
worker AuditWorker "Regulatory Compliance Engine"

beat perimeter "1. Perimeter Inspection & mTLS":
  show client_tier edge_perimeter gateway_tier stagger=40ms
  frame edge_perimeter gateway_tier zoom=1.12 dur=500ms
  WebTerminal -> CloudflareEdge "TLS 1.3" & MobileTrader -> CloudflareEdge "Mobile HTTPS"
  CloudflareEdge -> WAF "DDoS Filter" -> KongGateway "mTLS"
  KongGateway -> AuthEngine "Validate JWT Claims"
  KongGateway <- AuthEngine "Claims Validated"

beat transaction_flow "2. Transaction Execution & ACID Commit":
  show core_domain persistence stagger=40ms
  frame core_domain persistence zoom=1.12 dur=500ms
  KongGateway -> TransactionService "POST /orders/execute"
  TransactionService -> RedisCache "Check Balance Cache"
  TransactionService -> AccountService "Debit / Credit Call"
  AccountService -> AuroraPostgres "ACID Commit"
  glow AuroraPostgres color=#10b981

beat audit_trail "3. Asynchronous Compliance Stream & Confirmation":
  show event_stream stagger=40ms
  frame client_tier edge_perimeter gateway_tier core_domain persistence event_stream zoom=1.0 dur=500ms
  TransactionService ~> KafkaTopic "TradeExecuted"
  KafkaTopic ~> AuditWorker "Verify Audit Compliance"
  AuditWorker -> AuroraPostgres "Write Audit Record"
  WebTerminal <- KongGateway "200 Trade Confirmed"
  glow KafkaTopic color=#f59e0b & glow AuditWorker color=#38bdf8

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
