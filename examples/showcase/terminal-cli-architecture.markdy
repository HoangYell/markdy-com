# showcase/terminal-cli-architecture.markdy
# Demonstrates Terminal Theme (CLI/TUI aesthetics, dark paper, monospace typography, neon accents).

scene "Low-Latency Kernel Daemon & TUI Pipeline" theme=auto type=architecture width=1500 height=720
layout LR

terminal EdgeGateway "gateway.internal:443" focal=true
terminal AuthProxy "auth-proxy:8080 (mTLS)"
terminal CoreDaemon "systemd:core-service.service"
terminal StorageEngine "nvme-pool:raw-storage"
terminal AuditLog "/var/log/audit.log"

group ingress "Ingress & Proxy Mesh": EdgeGateway AuthProxy
group system "Kernel & Storage Engine": CoreDaemon StorageEngine AuditLog

beat init_services "1. Spawn System Daemons":
  show ingress stagger=50ms
  frame EdgeGateway AuthProxy zoom=1.12 dur=500ms
  glow EdgeGateway color=#38bdf8

beat dispatch_traffic "2. Low-Latency IPC & Disk Fsync":
  show system stagger=40ms
  frame ingress system zoom=1.0 dur=500ms
  EdgeGateway -> AuthProxy "verify client mTLS"
  AuthProxy -> CoreDaemon "unix_socket:dispatch"
  CoreDaemon -> StorageEngine "io_uring fsync block"
  CoreDaemon -> AuditLog "append secure audit"
  glow StorageEngine color=#22c55e & glow AuditLog color=#a78bfa

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
