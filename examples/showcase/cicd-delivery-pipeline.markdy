scene theme=paper width=1600 height=740
layout LR

user Developer
repo CodeRepo "Code Repo"
pipeline Pipeline "CI Pipeline"
worker Builder "Build & Test"
registry Registry "Artifact Registry"
deploy Deployer "Deploy Runner"
environment Production "Production"
monitor Monitor "Release Monitor"

group source: Developer CodeRepo
group ci: Pipeline Builder
group delivery: Registry Deployer
group ops: Production Monitor

beat layout:
  show source stagger=45ms & show ci stagger=45ms & show delivery stagger=45ms & show ops stagger=45ms

beat commit:
  Developer -> CodeRepo "git push"
  CodeRepo ~> Pipeline "trigger"

beat integrate:
  Pipeline -> Builder "compile and test"
  Builder -> Registry "publish artifact"

beat release:
  Registry -> Deployer "pull image"
  Deployer -> Production "canary rollout"
  Deployer -- Production "promotion gate"

beat observe:
  Production ~> Monitor "emit metrics"
  Monitor <- Production "health ok"
  focus Production
  glow Production color=#22c55e & glow Monitor color=#0284c7

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.25 1"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
