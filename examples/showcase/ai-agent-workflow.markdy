# AI agent loop with tool calls, memory, and final response.
scene width=1000 height=460 bg=#0f172a fps=30

client User at (100, 240)
service Agent at (330, 240)
service Planner at (540, 140)
database Memory at (540, 340)
service ToolAPI "Tool API" at (780, 240)
actor title = caption("AI agent workflow") at top opacity 0

scene "reason" {
  @+0.0: title.line_reveal(from=left, dur=0.4)
  @+0.2: User.request(to=Agent, label=task, dur=0.6)
  @+0.0: Agent.glow(color=#38bdf8, dur=0.5)
  @+0.2: Agent.request(to=Planner, label=plan, dur=0.5)
  @+0.0: Agent.request(to=Memory, label=context, dur=0.5)
}

scene "act" {
  @+0.2: Planner.response(to=Agent, label=steps, dur=0.5)
  @+0.1: Agent.request(to=ToolAPI, label=call, dur=0.6)
  @+0.0: ToolAPI.ripple(color=#22c55e, dur=0.5)
  @+0.2: ToolAPI.response(to=Agent, label=result, dur=0.6)
  @+0.2: Agent.response(to=User, label=answer, dur=0.6)
}