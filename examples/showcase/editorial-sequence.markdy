scene theme=editorial type=sequence width=1280 height=720
layout LR

participant Browser
participant API
participant Auth
database SessionDB

beat auth "Authenticate user":
  show $nodes stagger=40ms
  Browser -> API "POST /login"
  API -> Auth "verify credentials"
  Auth -> SessionDB "create session"
  API <- Auth "token"
  Browser <- API "200 OK"

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.1 0.25 0.5 1 1.5"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
