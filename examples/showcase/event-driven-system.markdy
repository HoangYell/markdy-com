# Event-driven system with producer, broker, workers, and projections.
scene width=1000 height=460 bg=#0f172a fps=30

service Producer at (110, 230)
queue Broker at (340, 230)
service WorkerA "Worker A" at (570, 150)
service WorkerB "Worker B" at (570, 310)
database Projection at (820, 230)
actor title = caption("Event-driven system") at top opacity 0

scene "publish" {
  @+0.0: title.line_reveal(from=left, dur=0.4)
  @+0.2: Producer.emit(to=Broker, label=OrderCreated, dur=0.7)
  @+0.0: Broker.pulse(amount=1.1, dur=0.5)
}

scene "consume" {
  @+0.2: Broker.emit(to=WorkerA, label=event, dur=0.5)
  @+0.0: Broker.emit(to=WorkerB, label=event, dur=0.5)
  @+0.2: WorkerA.request(to=Projection, label=update, dur=0.5)
  @+0.0: WorkerB.request(to=Projection, label=update, dur=0.5)
  @+0.1: Projection.glow(color=#22c55e, dur=0.5)
}