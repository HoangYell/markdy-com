# cross-functional-swimlanes.markdy
# Saga Distributed Transaction Order Fulfillment Swimlanes

scene "Saga Distributed Transaction Swimlanes" theme=auto type=swimlane

group client_lane "Client Tier": WebApp MobileApp
group edge_lane "Edge & Security Tier": CloudflareWAF KongGateway
group domain_lane "Domain Microservices Tier": OrderSaga PaymentSvc InventorySvc
group data_lane "Persistence Tier": OrdersDB PaymentVault RedisCluster

browser WebApp "Next.js Web Client"
browser MobileApp "React Native App"

gateway CloudflareWAF "Cloudflare Edge WAF"
gateway KongGateway "Kong API Gateway"

service OrderSaga "Order Saga Orchestrator" focal=true
service PaymentSvc "Payment Gateway Client"
service InventorySvc "Inventory Allocator"

database OrdersDB "Aurora PostgreSQL"
database PaymentVault "Encrypted Vault DB"
cache RedisCluster "Distributed Session Cache"

beat ingress_flow "1. Client Ingress across Lanes":
  show client_lane edge_lane stagger=30ms
  WebApp -> CloudflareWAF "POST /checkout"
  CloudflareWAF -> KongGateway "mTLS"

beat saga_dispatch "2. Cross-Lane Domain Processing & Saga Orchestration":
  show domain_lane stagger=30ms
  KongGateway -> OrderSaga "route order"
  OrderSaga -> PaymentSvc
  PaymentSvc -> InventorySvc

beat persistence_commit "3. Persistence & Transactional Commit":
  show data_lane stagger=30ms
  OrderSaga -> OrdersDB "commit order"
  PaymentSvc -> PaymentVault "store token"
  InventorySvc -> RedisCluster "decrement stock"
  glow OrdersDB color=#22c55e & glow PaymentVault color=#38bdf8

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#047857"
