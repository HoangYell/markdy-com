# 15-project-timeline.markdy
# Demonstrates Horizontal Timeline Diagram for Release History & Milestones.

scene theme=editorial type=timeline width=1200 height=600

service AlphaRelease "v0.1 Alpha Launch"
service BetaRelease "v0.5 Public Beta" focal=true
service GARelease "v1.0 General Availability"
service EnterpriseTier "v2.0 Enterprise Tier"
service GlobalExpansion "v3.0 Multi-Region"

beat timeline_reveal "Platform Evolution":
  show $nodes stagger=60ms
  glow BetaRelease "First paying customers"

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.1 0.25 0.5 1 1.5"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
