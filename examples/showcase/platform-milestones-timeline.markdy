# platform-milestones-timeline.markdy
# Database Write-Ahead Log (WAL) & CDC Event Replication Timeline

scene "Database Write-Ahead Log (WAL) & Event Lifecycle" theme=editorial type=timeline width=1280 height=760

event T0_Write "T0: Client Ingress"
event T1_WAL "T1: WAL fsync (Disk)" focal=true
event T2_MemTable "T2: MemTable Insert"
event T3_SSTable "T3: SSTable Flush"
event T4_Compaction "T4: LSM Compaction"
event T5_CDC "T5: Kafka CDC Event"

beat lifecycle "1. LSM Storage Engine Event Progression":
  show $nodes stagger=50ms
  T0_Write -> T1_WAL "fsync" -> T2_MemTable "insert" -> T3_SSTable "flush" -> T4_Compaction "merge" -> T5_CDC "stream"
  glow T1_WAL color=#047857

beat durability_focus "2. Strict Durability Guarantee":
  glow T1_WAL color=#22c55e & glow T5_CDC color=#38bdf8

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#047857"
