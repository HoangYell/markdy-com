# A failing request retrying at increasing intervals until it succeeds.
scene width=800 height=420 bg=#0f172a

actor title = caption("Retry with backoff") at top
actor node  = box() at (400, 220)
actor s1    = caption("Attempt 1 — failed") at bottom opacity 0
actor s2    = caption("Attempt 2 — failed") at bottom opacity 0
actor s3    = caption("Attempt 3 — succeeded") at bottom opacity 0

scene "attempt-1" {
  @+0.0: title.fade_in(dur=0.4)
  @+0.3: node.enter(from=top, dur=0.4)
  @+0.3: node.shake(intensity=6, dur=0.3)
  @+0.0: s1.fade_in(dur=0.3)
}

scene "attempt-2" {
  @+0.6: s1.fade_out(dur=0.25)
  @+0.0: node.shake(intensity=6, dur=0.3)
  @+0.0: s2.fade_in(dur=0.3)
}

scene "attempt-3" {
  @+1.0: s2.fade_out(dur=0.25)
  @+0.0: node.scale(to=1.15, dur=0.35, ease=overshoot)
  @+0.0: s3.fade_in(dur=0.3)
}
