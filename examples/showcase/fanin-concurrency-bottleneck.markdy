# fanin-concurrency-bottleneck.markdy
# Demonstrates Fan-In Concurrency & Constrained Bottleneck Queue Pattern.

scene "High-Throughput Fan-In Queue & Batch Bottleneck" theme=paper width=1200 height=800
layout LR

service ProducerA "Payment Ingestion Worker"
service ProducerB "Webhook Receiver"
service ProducerC "Mobile Event Producer"

queue PriorityQueue "Constrained Buffer Queue (depth=10k)" focal=true
worker BatchProcessor "Worker Pool (concurrency=4)"
database AnalyticsLake "Delta Lakehouse Store"
queue DeadLetterQueue "Dead Letter Queue (DLQ)"

group producers "Concurrent Ingestion Fleet": ProducerA ProducerB ProducerC
group processing "Batch Processing & Persistence": PriorityQueue BatchProcessor AnalyticsLake DeadLetterQueue

beat fanin_convergence "1. High-Concurrency Fan-In Stream":
  show producers PriorityQueue stagger=30ms
  frame producers PriorityQueue zoom=1.1 dur=500ms
  ProducerA ~> PriorityQueue "5,000 tx/sec"
  ProducerB ~> PriorityQueue "3,200 events/sec"
  ProducerC ~> PriorityQueue "8,000 hits/sec"
  glow PriorityQueue color=#f59e0b

beat constrained_dispatch "2. Rate-Limited Worker Consumption":
  show BatchProcessor AnalyticsLake DeadLetterQueue stagger=30ms
  frame processing zoom=1.1 dur=500ms
  PriorityQueue -> BatchProcessor "pull batch (size=500)"
  BatchProcessor -> AnalyticsLake "bulk write parquet"
  BatchProcessor ~> DeadLetterQueue "failed payloads"
  glow AnalyticsLake color=#10b981 & glow DeadLetterQueue color=#ef4444

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
