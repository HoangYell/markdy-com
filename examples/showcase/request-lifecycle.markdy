# Browser to CDN to server to database, with a packet traveling the path and a response returning.
scene width=1000 height=420 bg=#0f172a fps=30

actor title   = caption("Request lifecycle") at top
actor browser = text("Browser") at (120, 220) size 26 opacity 0
actor cdn     = text("CDN") at (380, 220) size 26 opacity 0
actor server  = text("Server") at (640, 220) size 26 opacity 0
actor db      = text("Database") at (900, 220) size 26 opacity 0
actor packet  = text("●") at (120, 220) size 32 opacity 0
actor note    = caption("Request out, response returns") at bottom opacity 0

scene "nodes" {
  @+0.0: title.fade_in(dur=0.4)
  @+0.2: browser.fade_in(dur=0.3)
  @+0.1: cdn.fade_in(dur=0.3)
  @+0.1: server.fade_in(dur=0.3)
  @+0.1: db.fade_in(dur=0.3)
}

scene "request" {
  @+0.2: packet.fade_in(dur=0.2)
  @+0.0: packet.move(to=(380, 220), dur=0.5, ease=out)
  @+0.1: cdn.shake(intensity=3, dur=0.2)
  @+0.1: packet.move(to=(640, 220), dur=0.5, ease=out)
  @+0.1: server.shake(intensity=3, dur=0.2)
  @+0.1: packet.move(to=(900, 220), dur=0.5, ease=out)
  @+0.1: db.shake(intensity=3, dur=0.2)
}

scene "response" {
  @+0.3: packet.move(to=(120, 220), dur=0.9, ease=inout)
  @+0.1: browser.shake(intensity=3, dur=0.25)
  @+0.2: packet.fade_out(dur=0.2)
  @+0.0: note.fade_in(dur=0.4)
}
