# osi-abstraction-layers.markdy
# OSI 7-Layer Abstraction Stack & Packet Encapsulation

scene "OSI 7-Layer Protocol Stack & Packet Encapsulation" theme=editorial type=layers width=1280 height=760

service AppLayer "Layer 7: Application Layer (HTTP/3, gRPC, TLS 1.3)"
service PresLayer "Layer 6: Presentation Layer (JSON Serialization, Compression)"
service SessLayer "Layer 5: Session Layer (RPC Sockets, Connection State)"
service TransportLayer "Layer 4: Transport Layer (TCP Flow Control, UDP QUIC)" focal=true
service NetworkLayer "Layer 3: Network Layer (IPv6 Routing, BGP, Subnets)"
service DataLinkLayer "Layer 2: Data Link Layer (Ethernet Frames, MAC, VLAN)"
service PhysicalLayer "Layer 1: Physical Layer (Fiber Optic, Radio Signal)"

beat stack_reveal "1. Complete OSI Networking Protocol Stack":
  show $nodes stagger=50ms
  glow TransportLayer color=#047857

beat encapsulation "2. Outgoing Packet Encapsulation (Top-Down)":
  AppLayer -> PresLayer
  PresLayer -> SessLayer "JSON Stream"
  SessLayer -> TransportLayer "TCP Segments"
  TransportLayer -> NetworkLayer "IP Packets"
  NetworkLayer -> DataLinkLayer "Ethernet Frames"
  DataLinkLayer -> PhysicalLayer "Bitstream"
  glow PhysicalLayer color=#22c55e

beat decapsulation "3. Ingress Packet Decapsulation & CRC Validation":
  PhysicalLayer -> DataLinkLayer -> NetworkLayer -> TransportLayer -> SessLayer -> PresLayer -> AppLayer
  glow AppLayer color=#047857

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#047857"
