# osi-abstraction-layers.markdy
# OSI 7-Layer Abstraction Stack & Packet Encapsulation

scene "OSI 7-Layer Protocol Stack & Packet Encapsulation" theme=auto type=layers width=1280 height=760

service AppLayer "Layer 7: Application Layer (HTTP/3, gRPC, TLS 1.3)"
service PresLayer "Layer 6: Presentation Layer (JSON Serialization, Compression)"
service SessLayer "Layer 5: Session Layer (RPC Sockets, Connection State)"
service TransportLayer "Layer 4: Transport Layer (TCP Flow Control, UDP QUIC)" focal=true
service NetworkLayer "Layer 3: Network Layer (IPv6 Routing, BGP, Subnets)"
service DataLinkLayer "Layer 2: Data Link Layer (Ethernet Frames, MAC, VLAN)"
service PhysicalLayer "Layer 1: Physical Layer (Fiber Optic, Radio Signal)"

beat stack_reveal "1. Complete OSI Networking Protocol Stack":
  show $nodes stagger=50ms
  frame TransportLayer zoom=1.1 dur=500ms
  glow TransportLayer color=#047857

beat encapsulation "2. Outgoing Packet Encapsulation (Top-Down)":
  frame AppLayer PresLayer SessLayer TransportLayer NetworkLayer DataLinkLayer PhysicalLayer zoom=1.05 dur=500ms
  AppLayer -> PresLayer "serialize HTTP/3 payload"
  PresLayer -> SessLayer "compress & encrypt TLS stream"
  SessLayer -> TransportLayer "split into TCP segments (SYN/ACK)"
  TransportLayer -> NetworkLayer "encapsulate IPv6 packets"
  NetworkLayer -> DataLinkLayer "frame Ethernet MAC payload"
  DataLinkLayer -> PhysicalLayer "modulate optical bitstream"
  glow PhysicalLayer color=#22c55e

beat decapsulation "3. Ingress Packet Decapsulation & CRC Validation":
  PhysicalLayer -> DataLinkLayer "receive raw bits" -> NetworkLayer "strip MAC header" -> TransportLayer "verify TCP checksum" -> SessLayer "reassemble stream" -> PresLayer "decompress payload" -> AppLayer "deliver to user process"
  glow AppLayer color=#047857 strength=1.4

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#047857"
