# Kafka messaging with producer, topic, consumer group, and sink database.
scene width=1000 height=430 bg=#0f172a fps=30

service Producer at (110, 220)
queue Kafka at (350, 220)
service ConsumerA "Consumer A" at (590, 150)
service ConsumerB "Consumer B" at (590, 290)
database Warehouse at (840, 220)
actor title = caption("Kafka messaging") at top opacity 0

scene "stream" {
  @+0.0: title.line_reveal(from=left, dur=0.4)
  @+0.2: Producer.emit(to=Kafka, label=message, dur=0.6)
  @+0.0: Kafka.ripple(color=#38bdf8, dur=0.5)
  @+0.2: Kafka.emit(to=ConsumerA, label=partition0, dur=0.5)
  @+0.0: Kafka.emit(to=ConsumerB, label=partition1, dur=0.5)
  @+0.2: ConsumerA.request(to=Warehouse, label=sink, dur=0.5)
  @+0.0: ConsumerB.request(to=Warehouse, label=sink, dur=0.5)
}