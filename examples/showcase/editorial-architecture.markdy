scene theme=editorial type=architecture width=1280 height=760
layout LR
annotation "Public edge" target=Gateway position=top-right

browser WebClient
gateway Gateway "API Gateway"
service API
database PrimaryDB
cache Redis

group edge: WebClient Gateway
group core: API PrimaryDB Redis

edge backbone: WebClient -> Gateway -> API
edge data_read: API -> PrimaryDB
edge data_cache: API ~> Redis

beat reveal "Reveal tiers":
  show edge stagger=50ms & show core stagger=50ms

beat request "Handle API call":
  frame core zoom=1.12 dur=500ms
  WebClient -> Gateway "GET /v1/items"
  Gateway -> API "route"
  API -> PrimaryDB "read rows"
  API ~> Redis "cache hit"

beat finish "Edge stays thin":
  frame edge zoom=1.15 dur=500ms
  glow Gateway color=#c45d3e strength=1.2

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.25 1"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
