# 12-multi-axis-radar.markdy
# Demonstrates 5-Axis Multi-Dimensional System Benchmark Radar Topology.

scene theme=paper type=radar width=1100 height=900

metric Latency "Read/Write Latency"
metric Scalability "Horizontal Scalability" focal=true
metric ACID "Strong ACID Consistency"
metric OperationalSimplicity "Operational Simplicity"
metric GlobalReplication "Multi-Region Replication"

beat benchmark_reveal "1. Evaluation Axes":
  show $nodes stagger=50ms
  glow Scalability "Max Priority Criterion"

beat capability_mesh "2. Architecture Trade-Offs":
  Latency -> Scalability "p99 < 5ms"
  Scalability -> GlobalReplication "active-active multi-region"
  GlobalReplication -> ACID "Raft consensus quorum"

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.25 1"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
