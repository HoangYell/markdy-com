# 16-gantt-roadmap.markdy
# Demonstrates Gantt Chart Layout for Engineering Roadmap.

scene theme=paper type=gantt width=1200 height=600

service CoreRefactor "Core Architecture Refactor" phase=0 span=3
service APIDesign "API Design & Review" phase=1 span=2 focal=true
service FrontendRevamp "Frontend Component Library" phase=2 span=3
service LoadTesting "Load & Chaos Testing" phase=3 span=2
service SecurityAudit "SOC2 Security Audit" phase=4 span=2
service GALaunch "Production GA Launch" phase=5 span=1

beat roadmap_reveal "Engineering Phases":
  show $nodes stagger=40ms
  glow APIDesign "Critical path deliverable"

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.1 0.25 0.5 1 1.5"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
