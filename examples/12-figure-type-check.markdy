# Parse-time type check — figure-only actions (wave, nod, face, pose,
# rotate_part) can only target figure actors. This file
# demonstrates the correct form; uncomment the last event to see the
# parser hard-fail with a helpful message.
scene width=800 height=400

actor guide = figure(#c68642, m, 🙂) at (400, 240)
actor label = text("figure-only actions") at (300, 80)

@0.0:  guide.enter(from=left, dur=0.4)
@+0.2: guide.wave(side=right, dur=0.5)
@+0.1: guide.nod(dur=0.3)
@+0.1: guide.face("🙂")

# Uncomment to see the type check fire:
# @+0.1: label.wave(side=right, dur=0.3)
#   → ParseError: action "wave" is figure-only; actor type is "text"
