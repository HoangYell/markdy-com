// Showcase: Code Provenance & Git In-Tree Verification
// Anchors Markdy's parser and compiler to their definitions in this repository.
scene "Markdy Parser & Compiler: Verified Code Anchors" theme=midnight type=flowchart

function EntryPoint "parseAndCompile" src="packages/core/src/parser.ts#L1270"
function Parser "MarkdyScript Parser" src="packages/core/src/parser.ts#L858"
artifact DiagramAST "Typed Diagram AST" src="packages/core/src/ast.ts#L217"
function Compiler "Theme-Aware Compiler" src="packages/core/src/parser.ts#L1266"
function LayoutEngine "Layout & Cue Scheduling" src="packages/core/src/compiler.ts#L2318"

beat parse_source "1. Parse Source into a Typed AST":
  EntryPoint -> Parser "parse(source)"
  Parser -> DiagramAST "Construct typed nodes, edges & beats"
  EntryPoint <- Parser "DiagramAST"

beat compile_plan "2. Resolve Theme, Layout & Timing":
  EntryPoint -> Compiler "compile(ast)"
  Compiler -> LayoutEngine "compilePlan(ast, theme)"
  Compiler <- LayoutEngine "Positioned nodes & scheduled cues"
  EntryPoint <- Compiler "RenderPlan"

beat code_anchor_glow "3. Inspect the Linked Definitions":
  glow Parser color=#22d3ee & glow Compiler LayoutEngine color=#f43f5e
