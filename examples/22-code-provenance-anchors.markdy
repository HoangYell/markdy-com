// Showcase: Code Provenance & Git In-Tree Verification
// Anchors high-level architecture nodes directly to verified source code line numbers.
scene "Code Provenance & Repository Grounding" theme=midnight
layout LR

gateway ApiGateway "API Gateway" src="src/gateway/router.ts#L25-L90"
service AuthService "Auth Service" src="src/auth/jwt.service.ts#L40-L120"
service PaymentService "Payment Service" src="src/billing/stripe.ts#L15-L80"
database UserDb "User Store" src="prisma/schema.prisma#L45-L70"
database LedgerDb "Ledger DB" src="db/migrations/001_ledger.sql#L1-L35"

beat verification_trace:
  show $nodes stagger=80ms
  ApiGateway -> AuthService "POST /auth/token"
  ApiGateway -> PaymentService "POST /checkout"
  AuthService -> UserDb "SELECT credentials"
  PaymentService -> LedgerDb "INSERT payment_record"

beat code_anchor_glow:
  glow AuthService color=#22d3ee & glow PaymentService color=#f43f5e
