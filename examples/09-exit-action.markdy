# exit(to=left|right|top|bottom) — mirror of enter: slides off-screen + fades.
scene width=800 height=400

actor card = box() at (400, 240)
actor bye  = caption("goodbye!") at top

@0.0:  card.enter(from=left, dur=0.5)
@+0.3: card.shake(intensity=4, dur=0.5)
@+0.3: bye.fade_in(dur=0.3)
@+0.6: bye.exit(to=top, dur=0.4)
@+0.0: card.exit(to=right, dur=0.5)
