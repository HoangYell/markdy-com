# scene "title" { ... } — named chapter blocks
# @+N inside a chapter is relative to the chapter's own previous event.
scene width=960 height=540 bg=#0d1117

actor narrator = caption("Act 1: the card arrives") at top
actor card     = box() at (480, 360)

scene "setup" {
  @+0.0: narrator.fade_in(dur=0.4)
  @+0.5: card.enter(from=bottom, dur=0.6)
}

scene "action" {
  @+0.2: card.shake(intensity=6, dur=0.5)
  @+0.3: card.scale(to=1.15, dur=0.4)
}
