# camera.zoom(to=N) — scales the scene-content layer.
# Useful for punchlines, reveals, and emphatic beats.
scene width=800 height=450 bg=#0d1117

actor punchline = caption("wait for it") at center
actor card      = box() at (400, 320)

@0.0:  card.enter(from=bottom, dur=0.5)
@0.8:  punchline.fade_in(dur=0.4)
@+0.3: camera.zoom(to=1.4, dur=0.8, ease=out)
@+0.4: card.shake(intensity=5, dur=0.4)
