// Beats sequence the animation; groups let one cue target many nodes.
// `&` runs cues in parallel. glow/focus emphasize nodes.
scene theme=paper
layout LR

user Visitor
gateway ApiGateway
service OrderService
cache Redis
database OrdersDb

group storage: Redis OrdersDb

beat intro "Reveal the checkout system":
  show Visitor ApiGateway OrderService & show storage stagger=80ms

beat checkout "Follow the checkout request":
  frame ApiGateway OrderService storage zoom=1.12 dur=500ms
  Visitor -> ApiGateway "POST /order" -> OrderService
  OrderService -> Redis "cache write" & OrderService -> OrdersDb "persist"

beat highlight "Storage records the order":
  frame storage zoom=1.18 dur=600ms
  glow storage color=#22c55e & focus OrderService zoom=1.1
  frame $nodes dur=500ms

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.25 1"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
