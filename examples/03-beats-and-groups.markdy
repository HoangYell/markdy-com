// Beats sequence the animation; groups let one cue target many nodes.
// `&` runs cues in parallel. glow/focus emphasize nodes.
scene "Beats And Groups" theme=midnight
layout LR

user Visitor
gateway ApiGateway
service OrderService
cache Redis
database OrdersDb

group storage: Redis OrdersDb

beat intro:
  show Visitor Gateway Orders & show storage stagger=80ms

beat checkout:
  Visitor -> ApiGateway "POST /order" -> OrderService
  OrderService -> Redis "cache write" & OrderService -> OrdersDb "persist"

beat highlight:
  glow storage color=#22c55e & focus OrderService zoom=1.1
