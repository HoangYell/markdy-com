# caption at bottom — pairs with a top caption for two-line callouts.
scene width=720 height=720 bg=#111

actor topline = caption("when the compat gate") at top
actor card    = box() at (360, 430)
actor botline = caption("stays green on every PR") at bottom

@0.0: topline.fade_in(dur=0.3)
@0.2: card.enter(from=bottom, dur=0.5)
@0.9: botline.fade_in(dur=0.3)
@1.4: card.scale(to=1.1, dur=0.4)
@2.0: card.shake(intensity=4, dur=0.4)
