scene "Active-Active Apps & Aurora Regional Failover" theme=paper

gateway Route53DNS "Route53 Latency Routing" icon=aws
service PrimaryCluster "US-East Application" icon=kubernetes
database AuroraMasterEast "Aurora US-East: Initial Writer" icon=postgresql
service SecondaryCluster "EU-West Application" icon=kubernetes
database AuroraMasterWest "Aurora EU-West: Initial Reader" icon=postgresql
service RecoveryControl "Managed Recovery Workflow" icon=aws

beat active_routing "1. Active Applications with Regional Reads":
  Route53DNS -> PrimaryCluster "Route by latency & health"
  Route53DNS -> SecondaryCluster "Route by latency & health"
  PrimaryCluster -> AuroraMasterEast "Read from primary"
  SecondaryCluster -> AuroraMasterWest "Local read (may lag)"

beat single_writer "2. One Writer with Asynchronous Replication":
  PrimaryCluster -> AuroraMasterEast "Write via global writer endpoint"
  SecondaryCluster -> AuroraMasterEast "Write via global writer endpoint"
  AuroraMasterEast ~> AuroraMasterWest "Asynchronous replication"

beat promote_replica "3. Primary Outage: Promote Replica (Data Loss Possible)":
  glow PrimaryCluster AuroraMasterEast color=#dc2626
  RecoveryControl -> AuroraMasterWest "Managed failover: promote writer"
  RecoveryControl <- AuroraMasterWest "Promotion complete; writer endpoint updated"
  glow AuroraMasterWest color=#16a34a

beat recover_traffic "4. Resume Writes after Promotion & Reconnection":
  RecoveryControl ~> Route53DNS "Route away from failed region; TTL applies"
  Route53DNS -> SecondaryCluster "New requests use healthy region"
  SecondaryCluster -> AuroraMasterWest "Write via reconnected global writer endpoint"
  SecondaryCluster <- AuroraMasterWest "Transaction committed"
  glow SecondaryCluster color=#16a34a
