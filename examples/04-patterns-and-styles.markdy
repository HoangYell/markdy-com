// Patterns are reusable cue templates expanded with `use`.
// $params are substituted at the call site. `style` themes a node.
scene theme=paper
layout TB

style hot = fill=#f59e0b

service Api
database PrimaryDb style=hot
database ReadReplica

pattern replicate(leader, follower):
  $leader -> $follower "stream WAL"
  $leader <- $follower "ack"

beat main:
  show $nodes stagger=90ms
  Api -> PrimaryDb "write"
  use replicate(PrimaryDb, ReadReplica)
  Api -> ReadReplica "read"

player:
  playback:
    autoplay true
    loop true
    rate 1.0
  controls:
    play true
    restart true
    prev_beat false
    next_beat false
    seek true
    speed true
    speeds "0.25 1"
    fit true
    reset_view true
    fullscreen true
    svg true
    share true
    code true
    theme false
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
