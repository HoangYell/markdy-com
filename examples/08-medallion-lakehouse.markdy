# 08-medallion-lakehouse.markdy
# Demonstrates Multi-Tier Medallion Data Architecture (Bronze -> Silver -> Gold -> Consumers).

scene theme=editorial type=medallion width=1300 height=750

service CDCStream "Debezium CDC Stream"
service BatchLogs "S3 Ingestion Bucket"

bronze BronzeParquet "Bronze Raw Delta Lake"
silver SilverEnriched "Silver Cleaned & Conformed DB"
gold GoldMarts "Gold Analytics & Feature Store"

client BIDashboard "Executive PowerBI / Looker"
service MLInference "Real-Time Scoring API"

beat ingestion_tier "1. Bronze Ingestion Tier":
  show CDCStream BatchLogs BronzeParquet stagger=30ms
  CDCStream -> BronzeParquet "append-only transaction log"
  BatchLogs -> BronzeParquet "bulk hourly parquet load"

beat transformation_tier "2. Silver Cleaning & Deduplication":
  show SilverEnriched stagger=30ms
  BronzeParquet -> SilverEnriched "dbt schema validation & dedup"

beat aggregation_tier "3. Gold Analytics Aggregation":
  show GoldMarts stagger=30ms
  SilverEnriched -> GoldMarts "star schema & rollup marts"

beat consumer_tier "4. Business Value Delivery":
  show BIDashboard MLInference stagger=30ms
  GoldMarts -> BIDashboard "sub-second analytical queries"
  GoldMarts -> MLInference "low-latency feature lookups"

player:
  playback:
    loop true
  controls:
    theme true
  interaction:
    zoom true
    pan true
    click_to_play true
    double_click_to_reset true
    keyboard false
  chrome:
    badge true
    progress boundary
    color "#3b82f6"
