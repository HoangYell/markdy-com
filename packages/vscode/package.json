{
  "name": "markdy-vscode",
  "displayName": "Markdy: Animated Architecture Diagrams",
  "description": "Open-source diagram-as-code editor tooling for animated architecture and system diagrams.",
  "version": "1.4.0",
  "private": true,
  "publisher": "hoangyell",
  "author": "Hoang Yell <hoangyell@gmail.com> (https://hoangyell.com)",
  "license": "MIT",
  "homepage": "https://markdy.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/HoangYell/markdy-com.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/HoangYell/markdy-com/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdy",
    "markdyscript",
    "diagram",
    "architecture-diagram",
    "system-design",
    "mermaid",
    "flowchart",
    "waapi",
    "animated-diagram"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0a0e17",
    "theme": "dark"
  },
  "qna": "marketplace",
  "badges": [
    {
      "url": "https://img.shields.io/github/stars/HoangYell/markdy-com?style=social",
      "href": "https://github.com/HoangYell/markdy-com",
      "description": "GitHub Stars"
    },
    {
      "url": "https://vsmarketplacebadges.dev/version-short/hoangyell.markdy-vscode.svg",
      "href": "https://marketplace.visualstudio.com/items?itemName=hoangyell.markdy-vscode",
      "description": "VS Code Marketplace"
    },
    {
      "url": "https://img.shields.io/open-vsx/v/hoangyell/markdy-vscode?color=purple&label=Open%20VSX",
      "href": "https://open-vsx.org/extension/hoangyell/markdy-vscode",
      "description": "Open VSX Version"
    },
    {
      "url": "https://img.shields.io/badge/license-MIT-blue",
      "href": "https://github.com/HoangYell/markdy-com/blob/main/LICENSE",
      "description": "MIT License"
    }
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdy",
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onCommand:markdy.showPreview",
    "onCommand:markdy.showPreviewToSide",
    "onCommand:markdy.exportSvg",
    "onCommand:markdy.exportPng",
    "onCommand:markdy.exportGif",
    "onCommand:markdy.copySvg",
    "onCommand:markdy.copyPng",
    "onCommand:markdy.insertTemplate",
    "onCommand:markdy.newDiagramFromTemplate",
    "onCommand:markdy.generateAiPrompt",
    "onCommand:markdy.openInWebStudio",
    "onCommand:markdy.copyShareUrl",
    "onCommand:markdy.importArchitecture",
    "onCommand:markdy.importMermaid",
    "onCommand:markdy.importDockerCompose",
    "onCommand:markdy.importKubernetes",
    "onCommand:markdy.importTerraform",
    "onCommand:markdy.importDrawio",
    "onCommand:markdy.previewSnippet",
    "onCommand:markdy.exportSnippetSvg",
    "onCommand:markdy.restartServer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "markdy",
        "aliases": [
          "Markdy",
          "markdy",
          "markdyscript",
          "MarkdyScript"
        ],
        "extensions": [
          ".markdy",
          ".mdy"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/icon.png",
          "dark": "./assets/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "markdy",
        "scopeName": "source.markdy",
        "path": "./syntaxes/markdy.tmLanguage.json"
      },
      {
        "injectTo": [
          "text.html.markdown",
          "text.html.mdx"
        ],
        "scopeName": "markdown.markdy.codeblock",
        "path": "./syntaxes/markdy-markdown.tmLanguage.json"
      }
    ],
    "submenus": [
      {
        "id": "markdy.submenu",
        "label": "Markdy",
        "icon": "$(play)"
      }
    ],
    "commands": [
      {
        "command": "markdy.showPreviewToSide",
        "title": "Live Preview",
        "icon": "$(play)",
        "category": "Markdy"
      },
      {
        "command": "markdy.showPreview",
        "title": "Open Preview",
        "icon": "$(eye)",
        "category": "Markdy"
      },
      {
        "command": "markdy.exportSvg",
        "title": "Export SVG",
        "icon": "$(file-code)",
        "category": "Markdy"
      },
      {
        "command": "markdy.exportPng",
        "title": "Export PNG",
        "icon": "$(file-media)",
        "category": "Markdy"
      },
      {
        "command": "markdy.exportGif",
        "title": "Export Animated GIF",
        "icon": "$(file-media)",
        "category": "Markdy"
      },
      {
        "command": "markdy.copySvg",
        "title": "Copy SVG",
        "icon": "$(copy)",
        "category": "Markdy"
      },
      {
        "command": "markdy.copyPng",
        "title": "Copy PNG",
        "icon": "$(copy)",
        "category": "Markdy"
      },
      {
        "command": "markdy.insertTemplate",
        "title": "Insert Template...",
        "icon": "$(layout)",
        "category": "Markdy"
      },
      {
        "command": "markdy.newDiagramFromTemplate",
        "title": "New From Template...",
        "icon": "$(file-add)",
        "category": "Markdy"
      },
      {
        "command": "markdy.generateAiPrompt",
        "title": "AI Prompt Helper",
        "icon": "$(sparkle)",
        "category": "Markdy"
      },
      {
        "command": "markdy.openInWebStudio",
        "title": "Open in Web Studio",
        "icon": "$(link-external)",
        "category": "Markdy"
      },
      {
        "command": "markdy.copyShareUrl",
        "title": "Copy Web Link",
        "icon": "$(link)",
        "category": "Markdy"
      },
      {
        "command": "markdy.importArchitecture",
        "title": "Import Diagram...",
        "icon": "$(cloud-download)",
        "category": "Markdy"
      },
      {
        "command": "markdy.importMermaid",
        "title": "Import Mermaid",
        "icon": "$(arrow-swap)",
        "category": "Markdy"
      },
      {
        "command": "markdy.importDockerCompose",
        "title": "Import Docker Compose",
        "icon": "$(arrow-swap)",
        "category": "Markdy"
      },
      {
        "command": "markdy.importKubernetes",
        "title": "Import Kubernetes",
        "icon": "$(arrow-swap)",
        "category": "Markdy"
      },
      {
        "command": "markdy.importTerraform",
        "title": "Import Terraform",
        "icon": "$(arrow-swap)",
        "category": "Markdy"
      },
      {
        "command": "markdy.importDrawio",
        "title": "Import Draw.io",
        "icon": "$(arrow-swap)",
        "category": "Markdy"
      },
      {
        "command": "markdy.restartServer",
        "title": "Restart Server",
        "icon": "$(refresh)",
        "category": "Markdy"
      }
    ],
    "keybindings": [
      {
        "command": "markdy.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == markdy"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == markdy",
          "command": "markdy.showPreviewToSide",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == markdy || resourceLangId == markdy || resourceExtname == .markdy || resourceExtname == .mdy",
          "submenu": "markdy.submenu",
          "group": "1_markdy"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .markdy || resourceExtname == .mdy || resourceExtname == .mermaid || resourceExtname == .mmd || resourceFilename == docker-compose.yml || resourceFilename == compose.yaml || resourceFilename == docker-compose.yaml || resourceExtname == .tfstate || resourceExtname == .drawio || resourceExtname == .drawio.xml",
          "submenu": "markdy.submenu",
          "group": "7_markdy"
        }
      ],
      "markdy.submenu": [
        {
          "command": "markdy.showPreviewToSide",
          "group": "1_preview@1"
        },
        {
          "command": "markdy.insertTemplate",
          "group": "1_preview@2"
        },
        {
          "command": "markdy.generateAiPrompt",
          "group": "1_preview@3"
        },
        {
          "command": "markdy.exportSvg",
          "group": "2_export@1"
        },
        {
          "command": "markdy.exportPng",
          "group": "2_export@2"
        },
        {
          "command": "markdy.exportGif",
          "group": "2_export@3"
        },
        {
          "command": "markdy.copySvg",
          "group": "3_clipboard@1"
        },
        {
          "command": "markdy.copyPng",
          "group": "3_clipboard@2"
        },
        {
          "command": "markdy.openInWebStudio",
          "group": "4_share@1"
        },
        {
          "command": "markdy.copyShareUrl",
          "group": "4_share@2"
        },
        {
          "command": "markdy.importArchitecture",
          "group": "5_import@1"
        },
        {
          "when": "resourceExtname == .mermaid || resourceExtname == .mmd",
          "command": "markdy.importMermaid",
          "group": "5_import@2"
        },
        {
          "when": "resourceFilename == docker-compose.yml || resourceFilename == compose.yaml || resourceFilename == docker-compose.yaml",
          "command": "markdy.importDockerCompose",
          "group": "5_import@3"
        },
        {
          "when": "resourceExtname == .tfstate",
          "command": "markdy.importTerraform",
          "group": "5_import@4"
        },
        {
          "when": "resourceExtname == .drawio || resourceExtname == .drawio.xml",
          "command": "markdy.importDrawio",
          "group": "5_import@5"
        }
      ],
      "commandPalette": [
        {
          "command": "markdy.showPreviewToSide",
          "when": "editorLangId == markdy"
        },
        {
          "command": "markdy.showPreview",
          "when": "editorLangId == markdy"
        },
        {
          "command": "markdy.exportSvg",
          "when": "editorLangId == markdy"
        },
        {
          "command": "markdy.exportPng",
          "when": "editorLangId == markdy"
        },
        {
          "command": "markdy.exportGif",
          "when": "editorLangId == markdy"
        },
        {
          "command": "markdy.copySvg",
          "when": "editorLangId == markdy"
        },
        {
          "command": "markdy.copyPng",
          "when": "editorLangId == markdy"
        },
        {
          "command": "markdy.insertTemplate"
        },
        {
          "command": "markdy.newDiagramFromTemplate"
        },
        {
          "command": "markdy.generateAiPrompt",
          "when": "editorLangId == markdy"
        },
        {
          "command": "markdy.openInWebStudio",
          "when": "editorLangId == markdy"
        },
        {
          "command": "markdy.copyShareUrl",
          "when": "editorLangId == markdy"
        },
        {
          "command": "markdy.importArchitecture"
        },
        {
          "command": "markdy.importMermaid"
        },
        {
          "command": "markdy.importDockerCompose"
        },
        {
          "command": "markdy.importKubernetes"
        },
        {
          "command": "markdy.importTerraform"
        },
        {
          "command": "markdy.importDrawio"
        },
        {
          "command": "markdy.restartServer",
          "when": "editorLangId == markdy"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Markdy",
      "properties": {
        "markdy.preview.autoplay": {
          "type": "boolean",
          "default": true,
          "description": "Automatically play diagram animations when the preview panel opens."
        },
        "markdy.preview.loop": {
          "type": "boolean",
          "default": true,
          "description": "Loop diagram animations continuously."
        },
        "markdy.preview.progressBar": {
          "type": "boolean",
          "default": true,
          "description": "Show interactive playback progress bar and scrubber in the preview panel."
        },
        "markdy.preview.theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "midnight",
            "paper",
            "blueprint",
            "nebula",
            "editorial",
            "graphite",
            "terminal",
            "sketchy",
            "ink",
            "doodle"
          ],
          "description": "Theme override for preview panel (auto matches editor theme)."
        },
        "markdy.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Markdy language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "echo \"VS Code extension test suite ready\"",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "publish:all": "pnpm run publish:vsce && pnpm run publish:ovsx"
  },
  "dependencies": {
    "@markdy/compat": "workspace:*",
    "@markdy/core": "workspace:*",
    "@markdy/language-server": "workspace:*",
    "@markdy/renderer-dom": "workspace:*",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.9.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
