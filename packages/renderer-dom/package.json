{
  "name": "@markdy/renderer-dom",
  "version": "0.8.2",
  "description": "Browser renderer for animated MarkdyScript architecture diagrams, built on the Web Animations API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "markdy",
    "animated-diagram",
    "architecture-diagram",
    "diagram-as-code",
    "web-animations-api",
    "renderer",
    "mermaid-alternative",
    "svg",
    "motion"
  ],
  "author": "Hoang Yell <hoangyell@gmail.com> (https://hoangyell.com)",
  "homepage": "https://markdy.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/HoangYell/markdy-com.git",
    "directory": "packages/renderer-dom"
  },
  "bugs": {
    "url": "https://github.com/HoangYell/markdy-com/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "harness": "pnpm --filter @markdy/core run build && pnpm run build && node harness/serve.mjs"
  },
  "dependencies": {
    "@markdy/core": "workspace:*"
  },
  "devDependencies": {
    "@markdy/stdlib-systems": "workspace:*",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
