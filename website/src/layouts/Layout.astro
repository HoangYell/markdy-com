---
import type { HTMLAttributes } from "astro/types";
import { getProjectVersion } from "../lib/agent-reference";

export interface Props extends HTMLAttributes<"html"> {
  title: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  ogImageAlt?: string;
  keywords?: string;
  preloadImage?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Markdy is a diagram-as-code DSL for animated architecture and system diagrams — an open-source, AI-friendly way to turn MarkdyScript into browser-native motion diagrams.",
  canonicalURL = "https://markdy.com/",
  ogImage = "https://markdy.com/og-image.webp",
  ogImageAlt = "Markdy - Open-Source Animated Architecture Diagram-as-Code DSL",
  keywords = "diagram-native DSL, MarkdyScript, animated architecture diagram, diagram as code, animated diagrams, mermaid alternative, animated mermaid, system design diagram, sequence diagram, flowchart, infrastructure diagram, architecture as code, text to diagram, AI diagram generator, AI agent diagrams, docs as code, software architecture visualization, animated system diagram, developer diagrams",
  preloadImage,
  structuredData = [],
} = Astro.props;

const sameAs = [
  "https://github.com/HoangYell/markdy-com",
  "https://www.npmjs.com/package/@markdy/core",
  "https://www.npmjs.com/package/@markdy/renderer-dom",
  "https://hoangyell.com",
];

const softwareVersion = await getProjectVersion();
const baseStructuredData = [
  {
    "@type": "WebSite",
    "@id": "https://markdy.com/#website",
    name: "Markdy",
    url: "https://markdy.com/",
    description,
    inLanguage: "en",
    publisher: { "@id": "https://markdy.com/#organization" },
  },
  {
    "@type": "Organization",
    "@id": "https://markdy.com/#organization",
    name: "Markdy",
    url: "https://markdy.com/",
    logo: "https://markdy.com/icon.svg",
    sameAs,
  },
  {
    "@type": "Person",
    "@id": "https://markdy.com/#hoang-yell",
    name: "Hoang Yell",
    url: "https://hoangyell.com",
    sameAs: ["https://github.com/HoangYell", "https://hoangyell.com"],
  },
  {
    "@type": "SoftwareApplication",
    "@id": "https://markdy.com/#software",
    name: "Markdy",
    description,
    keywords,
    url: "https://markdy.com/",
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "Diagramming Tool, Architecture Visualization, Developer Documentation Tool",
    operatingSystem: "Web",
    programmingLanguage: "TypeScript",
    softwareVersion,
    codeRepository: "https://github.com/HoangYell/markdy-com",
    license: "https://github.com/HoangYell/markdy-com/blob/main/LICENSE",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    author: { "@id": "https://markdy.com/#hoang-yell" },
    publisher: { "@id": "https://markdy.com/#organization" },
    sameAs,
  },
  {
    "@type": "SoftwareSourceCode",
    "@id": "https://markdy.com/#source",
    name: "Markdy source code",
    codeRepository: "https://github.com/HoangYell/markdy-com",
    programmingLanguage: "TypeScript",
    runtimePlatform: "Web browser, Node.js",
    license: "https://github.com/HoangYell/markdy-com/blob/main/LICENSE",
    about: { "@id": "https://markdy.com/#software" },
  },
];
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [...baseStructuredData, ...pageStructuredData],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Hoang Yell" />
    <meta name="robots" content="index, follow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/markdown" title="MarkdyScript AI Agent Reference" href="/AGENT.md" />
    <link rel="alternate" type="text/plain" title="Markdy llms.txt" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="Markdy full LLM context" href="/llms-full.txt" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:determiner" content="the" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Markdy" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@HoangYell" />
    <meta name="twitter:site" content="@HoangYell" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=optional" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=optional" />
    </noscript>
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />

    <!-- Prevent FOUC: set theme before render -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('markdy-theme');
        if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <style is:global>
      :root {
        --bg-primary: #fbfcfd;
        --bg-secondary: #f3f6f9;
        --bg-tertiary: #e9eef4;
        --bg-elevated: #ffffff;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #64748b;
        --border: #e2e8f0;
        --border-hover: #cbd5e1;
        --border-subtle: #f1f5f9;
        --accent: #047857;
        --accent-hover: #065f46;
        --accent-light: rgba(4, 120, 87, 0.09);
        --accent-glow: rgba(4, 120, 87, 0.22);
        --accent-gradient: linear-gradient(135deg, #047857 0%, #0284c7 100%);
        --danger: #ef4444;
        --danger-light: rgba(239, 68, 68, 0.08);
        --warning: #f59e0b;
        --warning-light: rgba(245, 158, 11, 0.08);
        --code-bg: #f8fafc;
        --code-border: #e2e8f0;
        --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.04);
        --shadow-sm: 0 2px 6px -1px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.03);
        --shadow-md: 0 8px 20px -4px rgba(0, 0, 0, 0.08), 0 2px 6px -1px rgba(0, 0, 0, 0.04);
        --shadow-lg: 0 20px 35px -8px rgba(0, 0, 0, 0.1), 0 4px 12px -2px rgba(0, 0, 0, 0.05);
        --shadow-glow: 0 0 24px -4px rgba(5, 150, 105, 0.25);
        --selection-bg: #d1fae5;
        --selection-text: #064e3b;
        --grid-dot: rgba(15, 23, 42, 0.07);
        --grid-mesh: rgba(15, 23, 42, 0.04);
        --sat: env(safe-area-inset-top, 0px);
        --sab: env(safe-area-inset-bottom, 0px);
        --sal: env(safe-area-inset-left, 0px);
        --sar: env(safe-area-inset-right, 0px);
      }

      [data-theme="dark"] {
        --bg-primary: #070a11;
        --bg-secondary: #0d121d;
        --bg-tertiary: #141c2c;
        --bg-elevated: #101726;
        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --border: rgba(255, 255, 255, 0.08);
        --border-hover: rgba(255, 255, 255, 0.16);
        --border-subtle: rgba(255, 255, 255, 0.04);
        --accent: #10b981;
        --accent-hover: #34d399;
        --accent-light: rgba(16, 185, 129, 0.12);
        --accent-glow: rgba(16, 185, 129, 0.3);
        --accent-gradient: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
        --danger: #f87171;
        --danger-light: rgba(248, 113, 113, 0.12);
        --warning: #fbbf24;
        --warning-light: rgba(251, 191, 36, 0.12);
        --code-bg: #090e18;
        --code-border: rgba(255, 255, 255, 0.07);
        --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.4);
        --shadow-sm: 0 2px 6px rgba(0, 0, 0, 0.5);
        --shadow-md: 0 10px 25px -4px rgba(0, 0, 0, 0.6), 0 4px 10px -2px rgba(0, 0, 0, 0.4);
        --shadow-lg: 0 24px 48px -10px rgba(0, 0, 0, 0.7), 0 8px 18px -4px rgba(0, 0, 0, 0.5);
        --shadow-glow: 0 0 30px -4px rgba(16, 185, 129, 0.35);
        --selection-bg: #064e3b;
        --selection-text: #6ee7b7;
        --grid-dot: rgba(255, 255, 255, 0.06);
        --grid-mesh: rgba(255, 255, 255, 0.035);
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
      }

      img, svg, video, canvas {
        max-width: 100%;
        height: auto;
      }

      html {
        scroll-behavior: smooth;
        overflow-x: hidden;
      }

      body {
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg-primary);
        color: var(--text-primary);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        transition: background-color 0.25s ease, color 0.25s ease;
        overflow-x: hidden;
        min-width: 320px;
      }

      a { color: inherit; text-decoration: none; }

      code, pre, kbd {
        font-family: "JetBrains Mono", "SF Mono", "Fira Code", "Cascadia Code", "Consolas", monospace;
      }

      code:not(pre code) {
        background: var(--bg-tertiary);
        border: 1px solid var(--border);
        padding: 0.15em 0.38em;
        border-radius: 4px;
        font-size: 0.88em;
        color: var(--text-primary);
      }

      kbd {
        background: var(--bg-tertiary);
        border: 1px solid var(--border);
        padding: 0.15em 0.4em;
        border-radius: 4px;
        font-size: 0.82em;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        color: var(--text-primary);
      }

      ::selection {
        background: var(--selection-bg);
        color: var(--selection-text);
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
        border-radius: 6px;
      }

      /* Prevent iOS auto-zoom on form elements */
      @media (max-width: 768px) {
        input, select, textarea {
          font-size: 16px !important;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* Shared "Copy to clipboard" utility button, used wherever a standalone
         copy action sits next to a code block (not part of a multi-button toolbar). */
      .copy-btn {
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        color: var(--text-secondary);
        font-size: 0.72rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .copy-btn:hover {
        color: var(--text-primary);
        border-color: var(--border-hover);
      }

      .copy-btn.copied {
        background: var(--accent);
        border-color: var(--accent);
        color: #ffffff;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      /* ── Global Toast Notifications ── */
      .markdy-toast-container {
        position: fixed;
        bottom: calc(1.5rem + var(--sab));
        right: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        z-index: 9999;
        pointer-events: none;
      }

      .markdy-toast {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.65rem 1rem;
        border-radius: 10px;
        background: var(--bg-elevated);
        color: var(--text-primary);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-lg), 0 0 0 1px rgba(16, 185, 129, 0.2);
        font-size: 0.82rem;
        font-weight: 600;
        opacity: 0;
        transform: translateY(12px) scale(0.95);
        transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: auto;
      }

      .markdy-toast.toast-show {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      .toast-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border-radius: 999px;
        background: var(--accent-light);
        color: var(--accent);
        font-size: 0.72rem;
        font-weight: 800;
        flex-shrink: 0;
      }
    </style>
  </head>
  <body>
    <slot />
    <div id="markdy-toast-container" class="markdy-toast-container" aria-live="polite" aria-atomic="true"></div>
    <script is:inline>
      window.showToast = function(message, icon) {
        var ic = icon || '⚡';
        var container = document.getElementById('markdy-toast-container');
        if (!container) return;
        var toast = document.createElement('div');
        toast.className = 'markdy-toast';
        toast.innerHTML = '<span class="toast-icon">' + ic + '</span><span class="toast-msg">' + message + '</span>';
        container.appendChild(toast);
        setTimeout(function() { toast.classList.add('toast-show'); }, 10);
        setTimeout(function() {
          toast.classList.remove('toast-show');
          setTimeout(function() { toast.remove(); }, 250);
        }, 2800);
      };
    </script>
  </body>
</html>
