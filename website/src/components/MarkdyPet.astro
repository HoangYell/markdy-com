<aside class="pet-companion" data-pet aria-label="Meet Markdy">
  <div class="pet-content">
    <span class="pet-message" aria-live="polite">Hi, I’m Markdy! Click me to play.</span>
    <button class="pet-motion" type="button">Pause animation</button>
  </div>
  <button class="pet-button" type="button" aria-label="Play with Markdy">
    <span class="pet-sprite" aria-hidden="true"></span>
  </button>
</aside>
<style>
  .pet-companion { display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 1.5rem auto; padding: .75rem 1rem; max-width: 420px; border: 1px solid #94a3b855; border-radius: 14px; background: var(--surface, transparent); }
  .pet-button { flex: 0 0 96px; width: 96px; height: 104px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .pet-button:focus-visible { outline: 3px solid #04a995; outline-offset: 3px; border-radius: 12px; }
  .pet-sprite { display: block; width: 96px; height: 104px; background-image: url('/markdy-pet.webp'); background-size: 768px 1144px; background-repeat: no-repeat; }
  .pet-content { display: grid; gap: .5rem; }
  .pet-motion { justify-self: start; min-height: 44px; padding: .4rem .7rem; border: 1px solid #94a3b888; border-radius: 8px; color: inherit; background: transparent; cursor: pointer; font: 600 12px system-ui, sans-serif; }
  .pet-motion:focus-visible { outline: 3px solid #04a995; outline-offset: 3px; }
  .pet-message { font: 600 14px/1.5 system-ui, sans-serif; color: inherit; }
</style>
<script>
  const pet = document.querySelector<HTMLElement>('[data-pet]');
  const sprite = pet?.querySelector<HTMLElement>('.pet-sprite');
  const message = pet?.querySelector<HTMLElement>('.pet-message');
  const play = pet?.querySelector<HTMLButtonElement>('.pet-button');
  const motionButton = pet?.querySelector<HTMLButtonElement>('.pet-motion');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const counts = [6, 8, 8, 4, 5, 8, 6, 6, 6];
  const actions = [
    { row: 3, text: 'Hello, diagram friend!' },
    { row: 4, text: 'Let’s make ideas move!' },
    { row: 7, text: 'Working on a bright idea!' },
    { row: 8, text: 'Looking good!' },
    { row: 6, text: 'What shall we explore next?' },
    { row: 5, text: 'Oops! Let’s try again.' },
    { row: 2, text: 'Off on an adventure!' },
    { row: 1, text: 'And back again!' },
  ];
  let frame = 0, row = 0, ticks = 0, nextAction = 0, idleTicks = 0;
  const paint = () => { if (sprite) sprite.style.backgroundPosition = `${-frame * 96}px ${-row * 104}px`; };
  const act = (announce: boolean) => {
    const action = actions[nextAction++ % actions.length];
    row = action.row; frame = 0; ticks = 0; idleTicks = 0;
    if (announce && message) message.textContent = action.text;
    paint();
  };
  let paused = false;
  try { paused = localStorage.getItem('markdy-pet-paused') === 'true'; } catch { /* Storage can be unavailable. */ }
  const updateControl = () => {
    if (!motionButton) return;
    motionButton.textContent = paused ? 'Resume animation' : 'Pause animation';
  };
  updateControl();
  let visible = false;
  let timer: number | undefined;
  const tick = () => {
    if (row === 0 && ++idleTicks >= 80) { act(false); return; }
    frame = (frame + 1) % counts[row];
    if (row !== 0 && ++ticks >= counts[row] * 2) { row = 0; frame = 0; ticks = 0; }
    paint();
  };
  const syncTimer = () => {
    window.clearInterval(timer);
    timer = undefined;
    if (visible && !document.hidden && !reducedMotion.matches && !paused) timer = window.setInterval(tick, 150);
  };
  document.addEventListener('visibilitychange', syncTimer);
  play?.addEventListener('click', () => {
    if (reducedMotion.matches || paused) {
      const action = actions[nextAction++ % actions.length];
      row = action.row; frame = 0; paint();
      if (message) message.textContent = action.text;
    } else act(true);
  });
  motionButton?.addEventListener('click', () => {
    paused = !paused;
    try { localStorage.setItem('markdy-pet-paused', String(paused)); } catch { /* Keep the preference for this visit. */ }
    updateControl();
    syncTimer();
  });
  if (pet) new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; syncTimer(); }).observe(pet);
  reducedMotion.addEventListener('change', () => { row = 0; frame = 0; ticks = 0; paint(); syncTimer(); });
</script>
