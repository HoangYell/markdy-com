<div class="pet-companion" data-pet aria-label="Markdy Prompt Guide">
  <button
    class="pet-button"
    type="button"
    aria-label="Ask Markdy for an AI prompting tip"
    title="Click Markdy for AI prompt tips"
  >
    <span class="pet-sprite" aria-hidden="true"></span>
  </button>
  <div class="pet-bubble" role="status" aria-live="polite">
    <span class="pet-spark" aria-hidden="true">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
      </svg>
    </span>
    <p class="pet-message">Click Markdy for AI prompt tips</p>
  </div>
</div>

<style>
  .pet-companion {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: transparent;
    border: 0;
    padding: 0;
    position: relative;
  }

  .pet-button {
    flex: 0 0 52px;
    width: 52px;
    height: 56px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease;
    border-radius: 12px;
  }

  .pet-button:hover {
    transform: translateY(-2px) scale(1.08);
    filter: drop-shadow(0 6px 12px color-mix(in srgb, var(--accent) 30%, transparent));
  }

  .pet-button:active {
    transform: scale(0.92);
  }

  .pet-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .pet-sprite {
    display: block;
    width: 52px;
    height: 56px;
    background: url('/markdy-pet.webp') no-repeat;
    background-size: 416px 616px;
  }

  /* Sleek conversational speech bubble with tail */
  .pet-bubble {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.8rem;
    border-radius: 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-xs);
    max-width: 275px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Tail pointing to Markdy */
  .pet-bubble::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
    width: 8px;
    height: 8px;
    background: var(--bg-secondary);
    border-left: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    pointer-events: none;
    transition: border-color 0.2s ease;
  }

  .pet-companion:hover .pet-bubble,
  .pet-bubble.is-active {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: 0 4px 12px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .pet-companion:hover .pet-bubble::before,
  .pet-bubble.is-active::before {
    border-left-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    border-bottom-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }

  .pet-spark {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
  }

  .pet-message {
    margin: 0;
    color: var(--text-primary);
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.35;
    transition: opacity 0.12s ease, transform 0.12s ease;
  }

  .pet-message.is-updating {
    opacity: 0;
    transform: translateY(2px);
  }

  @media (max-width: 640px) {
    .pet-companion {
      width: 100%;
    }
    .pet-bubble {
      flex: 1;
      max-width: none;
    }
    .pet-message {
      font-size: 0.74rem;
    }
  }
</style>

<script>
  const pet = document.querySelector<HTMLElement>('[data-pet]');
  const sprite = pet?.querySelector<HTMLElement>('.pet-sprite');
  const bubble = pet?.querySelector<HTMLElement>('.pet-bubble');
  const message = pet?.querySelector<HTMLElement>('.pet-message');
  const play = pet?.querySelector<HTMLButtonElement>('.pet-button');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const counts = [6, 8, 8, 4, 5, 8, 6, 6, 6];
  const actions = [
    { row: 3, text: 'Tip: Ask your agent to follow the MarkdyScript specification.' },
    { row: 4, text: 'Tip: Use layout LR or TB to set the diagram direction.' },
    { row: 7, text: 'Tip: Declare services, databases, and gateways as semantic nodes.' },
    { row: 8, text: 'Tip: Name a beat to give an animation step a caption.' },
    { row: 6, text: 'Tip: Reference @markdy/mcp-server for instant diagram generation.' },
    { row: 5, text: 'Tip: Check the syntax reference when a scene needs fixing.' },
    { row: 2, text: 'Tip: Use arrows to show requests between nodes.' },
    { row: 1, text: 'Tip: Add glow cues to highlight important architecture paths.' },
  ];
  let frame = 0, row = 0, ticks = 0, nextAction = 0, idleTicks = 0;
  const paint = () => { if (sprite) sprite.style.backgroundPosition = `${-frame * 52}px ${-row * 56}px`; };
  
  const setTip = (text: string) => {
    if (!message) return;
    message.classList.add('is-updating');
    if (bubble) bubble.classList.add('is-active');
    window.setTimeout(() => {
      message.textContent = text;
      message.classList.remove('is-updating');
    }, 120);
    window.setTimeout(() => {
      if (bubble) bubble.classList.remove('is-active');
    }, 450);
  };

  const act = (announce: boolean) => {
    const action = actions[nextAction++ % actions.length];
    row = action.row; frame = 0; ticks = 0; idleTicks = 0;
    if (announce) setTip(action.text);
    paint();
  };

  let visible = false;
  let timer: number | undefined;
  const tick = () => {
    if (row === 0 && ++idleTicks >= 80) { act(false); return; }
    frame = (frame + 1) % counts[row];
    if (row !== 0 && ++ticks >= counts[row] * 2) { row = 0; frame = 0; ticks = 0; }
    paint();
  };

  const syncTimer = () => {
    window.clearInterval(timer);
    timer = undefined;
    if (visible && !document.hidden && !reducedMotion.matches) timer = window.setInterval(tick, 150);
  };

  document.addEventListener('visibilitychange', syncTimer);
  play?.addEventListener('click', () => {
    if (reducedMotion.matches) {
      const action = actions[nextAction++ % actions.length];
      row = action.row; frame = 0; paint();
      setTip(action.text);
    } else {
      act(true);
    }
  });

  if (pet) new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; syncTimer(); }).observe(pet);
  reducedMotion.addEventListener('change', () => { row = 0; frame = 0; ticks = 0; paint(); syncTimer(); });
</script>