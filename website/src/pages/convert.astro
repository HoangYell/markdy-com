}

client -> gw : POST /checkout
gw -> pay : Process Charge
pay -> db : Persist Ledger
pay ..> mq : Publish PaymentSettled
@enduml`,
      },
      {
        label: "PlantUML: C4 Container Diagram",
        code: `@startuml
Person(customer, "Banking Customer", "Active mobile user")
Container(spa, "Web Banking App", "TypeScript / React", "Account dashboard")
Container(api, "Payments API", "Go / gRPC", "Handles transfers")
