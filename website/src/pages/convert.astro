Rel(customer, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls", "JSON/TLS")
Rel(api, db, "Reads & Writes", "SQL/mTLS")
@enduml`,
      },
    ],
    dot: [
      {
        label: "Graphviz DOT: Event Ingestion",
        code: `digraph EventPipeline {
  rankdir=LR;
  client [label="Mobile SDK", shape=ellipse];
  ingest [label="Edge Ingest", shape=hexagon];
  subgraph cluster_stream {
    label="Streaming Core";
    kafka [label="Kafka Cluster", shape=box];
