      },
      {
        label: "Sequence: OAuth2 PKCE Handshake",
        code: `sequenceDiagram
  autonumber
  actor User as Mobile User
  participant App as Client SPA
  participant IdP as Auth Server
  participant API as Resource API
  User->>App: Tap Sign In
  App->>+IdP: GET /authorize (PKCE)
  IdP-->>-App: 302 Redirect (?code)
  App->>IdP: POST /token
  IdP-->>App: Access Token (JWT)
  App->>API: GET /profile (Bearer)
  API-->>App: 200 JSON Profile`,
      },
      {
        label: "State Machine: Order Lifecycle",
        code: `stateDiagram-v2
  direction LR
  [*] --> Pending
  state "Payment Processing" as billing {
    Pending --> Authorizing : submit
    Authorizing --> Captured : approved
  }
  Captured --> Fulfilled : ship
  Fulfilled --> [*] : delivered`,
      },
    ],
    d2: [
      {
        label: "D2: Edge Gateway & Data Tier",
        code: `title: "Edge Gateway Architecture"
client: Browser Client
gateway: Kong API Gateway

core: {
  auth: Auth Service
  orders: Order Service
  db: Postgres Primary
  db.shape: cylinder
  db.icon: postgresql
}

client -> gateway: HTTPS POST /orders
gateway -> core.auth: Verify JWT
gateway -> core.orders: Route Request
core.orders -> core.db: INSERT order`,
      },
    ],
    plantuml: [
      {
        label: "PlantUML: Component Microservices",
        code: `@startuml
