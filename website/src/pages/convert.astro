              { id: "t2", type: "text", x: 285, y: 130, width: 100, height: 24, text: "API Gateway", containerId: "n2" },
              { id: "n3", type: "rectangle", x: 520, y: 105, width: 150, height: 75, frameId: "f1" },
              { id: "t3", type: "text", x: 540, y: 130, width: 110, height: 24, text: "Postgres DB", containerId: "n3" },
              { id: "a1", type: "arrow", x: 170, y: 142, width: 95, height: 0, startBinding: { elementId: "n1" }, endBinding: { elementId: "n2" } },
              { id: "ta1", type: "text", x: 195, y: 120, width: 45, height: 20, text: "HTTPS", containerId: "a1" },
              { id: "a2", type: "arrow", x: 405, y: 142, width: 115, height: 0, startBinding: { elementId: "n2" }, endBinding: { elementId: "n3" } },
              { id: "ta2", type: "text", x: 440, y: 120, width: 45, height: 20, text: "SQL", containerId: "a2" },
            ],
          },
          null,
          2
        ),
      },
    ],
    compose: [
      {
        label: "Docker Compose: Web + API + Cache + DB",
        code: `services:
  web:
    image: nginx:alpine
    ports: ["80:80"]
    depends_on: ["api"]
  api:
    image: node:20-alpine
    ports: ["3000:3000"]
    depends_on: ["db", "cache"]
  db:
    image: postgres:16-alpine
  cache:
    image: redis:7-alpine`,
      },
    ],
    k8s: [
      {
        label: "Kubernetes: Ingress -> Service -> Workload",
        code: `apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: edge-ingress
  namespace: production
---
apiVersion: v1
kind: Service
metadata:
  name: orders-svc
  namespace: production
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: orders-api
  namespace: production`,
      },
    ],
    terraform: [
      {
        label: "Terraform State: VPC ALB + RDS",
        code: JSON.stringify(
          {
            version: 4,
            resources: [
              {
                type: "aws_lb",
                name: "public_alb",
                instances: [{ attributes: { name: "prod-alb", vpc_id: "vpc_prod" } }],
              },
              {
                type: "aws_rds_cluster",
                name: "aurora_postgres",
                instances: [{ attributes: { name: "prod-aurora", vpc_id: "vpc_prod" } }],
              },
              {
                type: "aws_elasticache_cluster",
                name: "redis_cache",
                instances: [{ attributes: { name: "prod-redis", vpc_id: "vpc_prod" } }],
              },
            ],
          },
          null,
          2
        ),
      },
    ],
  };

  const FORMAT_META: Record<CompatFormat, { label: string; ext: string; cli: string }> = {
    mermaid: { label: "Mermaid", ext: "diagram.mmd", cli: "markdy import diagram.mmd --out diagram.markdy" },
    d2: { label: "D2", ext: "architecture.d2", cli: "markdy import architecture.d2 --from d2" },
    plantuml: { label: "PlantUML", ext: "system.puml", cli: "markdy import system.puml --from plantuml" },
    dot: { label: "Graphviz DOT", ext: "graph.dot", cli: "markdy import graph.dot --from dot" },
    drawio: { label: "Draw.io XML", ext: "diagram.drawio", cli: "markdy import diagram.drawio --out diagram.markdy" },
    excalidraw: { label: "Excalidraw JSON", ext: "board.excalidraw", cli: "markdy import board.excalidraw --from excalidraw" },
    compose: { label: "Docker Compose", ext: "docker-compose.yml", cli: "markdy import docker-compose.yml" },
    k8s: { label: "Kubernetes YAML", ext: "manifests.yaml", cli: "markdy import manifests.yaml" },
    terraform: { label: "Terraform State", ext: "terraform.tfstate", cli: "markdy import terraform.tfstate" },
  };

  // DOM References
  const formatPills = document.querySelectorAll<HTMLButtonElement>(".format-pill");
  const sourceInput = document.getElementById("source-input") as HTMLTextAreaElement;
  const dropzoneWrap = document.getElementById("dropzone-wrap") as HTMLDivElement;
  const dropOverlay = document.getElementById("drop-overlay") as HTMLDivElement;
  const fileUploadInput = document.getElementById("file-upload-input") as HTMLInputElement;
  const pasteSourceBtn = document.getElementById("paste-source-btn") as HTMLButtonElement;
  const clearSourceBtn = document.getElementById("clear-source-btn") as HTMLButtonElement;
  const convertErrorBanner = document.getElementById("convert-error-banner") as HTMLDivElement;

  const sampleSelect = document.getElementById("sample-select") as HTMLSelectElement;
  const themeSelect = document.getElementById("theme-select") as HTMLSelectElement;
  const layoutSelect = document.getElementById("layout-select") as HTMLSelectElement;
  const playerToggle = document.getElementById("player-toggle") as HTMLInputElement;

  const detectedBadgeText = document.getElementById("detected-badge-text") as HTMLSpanElement;
  const metricsBadge = document.getElementById("metrics-badge") as HTMLSpanElement;
  const warningsToggleBtn = document.getElementById("warnings-toggle-btn") as HTMLButtonElement;
  const warningsCountText = document.getElementById("warnings-count-text") as HTMLSpanElement;
  const warningsList = document.getElementById("warnings-list") as HTMLUListElement;
  const sourceFilenameLabel = document.getElementById("source-filename-label") as HTMLSpanElement;
  const cliCommandCode = document.getElementById("cli-command-code") as HTMLElement;
  const copyCliBtn = document.getElementById("copy-cli-btn") as HTMLButtonElement;

  const outputEditorHost = document.getElementById("output-editor") as HTMLDivElement;
  const previewStage = document.getElementById("preview-stage") as HTMLDivElement;
  const copyMarkdyBtn = document.getElementById("copy-markdy-btn") as HTMLButtonElement;
  const copyMarkdyLabel = document.getElementById("copy-markdy-label") as HTMLSpanElement;
  const downloadMarkdyBtn = document.getElementById("download-markdy-btn") as HTMLButtonElement;
  const replayBtn = document.getElementById("replay-btn") as HTMLButtonElement;
  const exportSvgBtn = document.getElementById("export-svg-btn") as HTMLButtonElement;
  const openStudioBtn = document.getElementById("open-studio-btn") as HTMLButtonElement;

  const workbenchGrid = document.getElementById("workbench-grid") as HTMLDivElement;
  const layoutModeBtn = document.getElementById("layout-mode-btn") as HTMLButtonElement;
  const mobilePaneBtns = document.querySelectorAll<HTMLButtonElement>(".mobile-pane-btn");

  let selectedMode: CompatFormat | "auto" = "auto";
  let lastDetectedFormat: CompatFormat = "mermaid";
  let lastFilenameHint: string | undefined = undefined;
  let editorView: EditorView | null = null;
  let isProgrammaticEdit = false;
  let diagram: Diagram | null = null;
  let convertTimer: ReturnType<typeof setTimeout> | null = null;

  function isDarkMode(): boolean {
    return document.documentElement.getAttribute("data-theme") === "dark";
  }

  function getOutputCode(): string {
    return editorView?.state.doc.toString() ?? "";
  }

  function setOutputCode(code: string) {
    if (!editorView) {
      createOutputEditor(code);
      return;
    }
    isProgrammaticEdit = true;
    editorView.dispatch({
      changes: { from: 0, to: editorView.state.doc.length, insert: code },
    });
    isProgrammaticEdit = false;
  }

  function createOutputEditor(initialCode: string) {
    if (!outputEditorHost) return;
    if (editorView) {
      editorView.destroy();
      editorView = null;
    }
    const dark = isDarkMode();
    editorView = new EditorView({
      state: EditorState.create({
        doc: initialCode,
        extensions: [
          lineNumbers(),
          highlightActiveLine(),
          highlightActiveLineGutter(),
          history(),
          bracketMatching(),
          markdyLanguage,
          dark ? markdyHighlightDark : markdyHighlightLight,
          baseTheme,
          dark ? darkTheme : lightTheme,
          keymap.of([...defaultKeymap, ...historyKeymap]),
          EditorView.lineWrapping,
          EditorView.updateListener.of((update) => {
            if (update.docChanged && !isProgrammaticEdit) {
              renderLivePreview(getOutputCode());
            }
          }),
        ],
      }),
      parent: outputEditorHost,
    });
  }

  function renderLivePreview(markdyCode: string) {
    if (!previewStage) return;
    const trimmed = markdyCode.trim();
    if (!trimmed) {
      if (diagram) { diagram.destroy(); diagram = null; }
      previewStage.innerHTML = `<div class="preview-empty"><p>Paste or upload a diagram on the left to preview live Markdy motion.</p></div>`;
      return;
    }
    try {
      if (diagram) {
        diagram.destroy();
        diagram = null;
      }
      previewStage.replaceChildren();
      diagram = createDiagram({
        container: previewStage,
        code: trimmed,
        autoplay: false,
        interactiveViewport: true,
        clickToPlay: true,
        responsiveLayout: "auto",
        fitMode: "auto",
        targetWidthRatio: 0.94,
      });
      const totalDuration = diagram.duration?.() ?? 0;
      if (totalDuration > 0) {
        diagram.pause();
        diagram.seek(totalDuration);
      }
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      const errBox = document.createElement("div");
      errBox.className = "preview-error";
      errBox.textContent = `Preview error: ${msg}`;
      previewStage.replaceChildren(errBox);
    }
  }

  function populateSamplesFor(format: CompatFormat) {
    if (!sampleSelect) return;
    const list = SAMPLES[format] || SAMPLES.mermaid;
    sampleSelect.innerHTML = "";
    list.forEach((s, i) => {
      const opt = document.createElement("option");
      opt.value = String(i);
      opt.textContent = s.label;
      sampleSelect.appendChild(opt);
    });
    if (selectedMode === "auto") {
      // Also expose cross-format quick samples in Auto mode
      const allFormats: CompatFormat[] = ["mermaid", "d2", "plantuml", "dot", "drawio", "excalidraw", "compose", "k8s", "terraform"];
      sampleSelect.innerHTML = "";
      for (const f of allFormats) {
        for (let i = 0; i < SAMPLES[f].length; i++) {
          const opt = document.createElement("option");
          opt.value = `${f}:${i}`;
          opt.textContent = SAMPLES[f][i].label;
          sampleSelect.appendChild(opt);
        }
      }
    }
  }

  async function runConversion() {
    const src = sourceInput?.value ?? "";
    if (!src.trim()) {
      if (convertErrorBanner) convertErrorBanner.hidden = true;
      metricsBadge.textContent = "0 nodes · 0 flows";
      warningsToggleBtn.hidden = true;
      setOutputCode("");
      renderLivePreview("");
      return;
    }

    try {
      const result = await transpileToMarkdy(src, {
        format: selectedMode,
        theme: themeSelect?.value || "paper",
        layout: (layoutSelect?.value as any) || "auto",
        includePlayer: playerToggle?.checked ?? true,
        filenameHint: lastFilenameHint,
      });

      lastDetectedFormat = result.format;
      const meta = FORMAT_META[result.format];

      if (convertErrorBanner) convertErrorBanner.hidden = true;
      detectedBadgeText.textContent =
        selectedMode === "auto" ? `Detected: ${meta.label}` : `Format: ${meta.label}`;
      sourceFilenameLabel.textContent = lastFilenameHint || meta.ext;
      cliCommandCode.textContent = meta.cli;

      const groupLabel = result.groupCount > 0 ? ` · ${result.groupCount} group${result.groupCount === 1 ? "" : "s"}` : "";
      metricsBadge.textContent = `${result.nodeCount} node${result.nodeCount === 1 ? "" : "s"} · ${result.edgeCount} flow${result.edgeCount === 1 ? "" : "s"}${groupLabel}`;

      if (result.warnings.length > 0) {
        warningsToggleBtn.hidden = false;
        warningsCountText.textContent = `${result.warnings.length} note${result.warnings.length === 1 ? "" : "s"}`;
        warningsList.innerHTML = "";
        for (const w of result.warnings) {
          const li = document.createElement("li");
          li.textContent = w;
          warningsList.appendChild(li);
        }
      } else {
        warningsToggleBtn.hidden = true;
      }

      setOutputCode(result.code);
      renderLivePreview(result.code);
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      if (convertErrorBanner) {
        convertErrorBanner.hidden = false;
        convertErrorBanner.textContent = `Conversion error: ${msg}`;
      }
    }
  }

  function scheduleConversion() {
    if (convertTimer) clearTimeout(convertTimer);
    convertTimer = setTimeout(() => {
      void runConversion();
    }, 110);
  }

  function selectFormatTab(format: CompatFormat | "auto", loadSample = true) {
    selectedMode = format;
    lastFilenameHint = undefined;

    formatPills.forEach((pill) => {
      const isSelected = pill.dataset.format === format;
      pill.setAttribute("aria-selected", isSelected ? "true" : "false");
    });

    const effectiveFormat: CompatFormat = format === "auto" ? "mermaid" : format;
    populateSamplesFor(effectiveFormat);

    if (loadSample) {
      const firstSample = SAMPLES[effectiveFormat][0];
      if (sourceInput && firstSample) {
        sourceInput.value = firstSample.code;
      }
    }
    void runConversion();
  }

  // Tab Click & Arrow-Key Navigation
  formatPills.forEach((pill, index) => {
    pill.addEventListener("click", () => {
      const fmt = (pill.dataset.format || "auto") as CompatFormat | "auto";
      selectFormatTab(fmt, true);
      pill.scrollIntoView({ block: "nearest", inline: "nearest" });
    });

    pill.addEventListener("keydown", (e) => {
      const arr = Array.from(formatPills);
      let nextIdx = -1;
      if (e.key === "ArrowRight") nextIdx = (index + 1) % arr.length;
      else if (e.key === "ArrowLeft") nextIdx = (index - 1 + arr.length) % arr.length;
      if (nextIdx !== -1) {
        e.preventDefault();
        arr[nextIdx].focus();
        const fmt = (arr[nextIdx].dataset.format || "auto") as CompatFormat | "auto";
        selectFormatTab(fmt, true);
      }
    });
  });

  // Sample Dropdown Change
  sampleSelect?.addEventListener("change", () => {
    const val = sampleSelect.value;
    if (val.includes(":")) {
      const [fmt, idxStr] = val.split(":");
      const sample = SAMPLES[fmt as CompatFormat]?.[Number(idxStr)];
      if (sample && sourceInput) {
        lastFilenameHint = undefined;
        sourceInput.value = sample.code;
        void runConversion();
      }
    } else {
      const targetFmt: CompatFormat = selectedMode === "auto" ? lastDetectedFormat : selectedMode;
      const sample = SAMPLES[targetFmt]?.[Number(val)];
      if (sample && sourceInput) {
        lastFilenameHint = undefined;
        sourceInput.value = sample.code;
        void runConversion();
      }
    }
  });

  // Theme / Layout / Player Overrides
  themeSelect?.addEventListener("change", () => void runConversion());
  layoutSelect?.addEventListener("change", () => void runConversion());
  playerToggle?.addEventListener("change", () => void runConversion());

  // Source Textarea Input
  sourceInput?.addEventListener("input", () => {
    if (selectedMode === "auto") lastFilenameHint = undefined;
    scheduleConversion();
  });

  // Paste Button
  pasteSourceBtn?.addEventListener("click", async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (text && sourceInput) {
        sourceInput.value = text;
        lastFilenameHint = undefined;
        await runConversion();
        if (typeof (window as any).showToast === "function") {
          (window as any).showToast("Pasted diagram source", "✓");
        }
      }
    } catch {
      sourceInput?.focus();
      if (typeof (window as any).showToast === "function") {
        (window as any).showToast("Press Cmd/Ctrl+V inside the source box to paste", "i");
      }
    }
  });

  // Clear Button
  clearSourceBtn?.addEventListener("click", () => {
    if (sourceInput) sourceInput.value = "";
    lastFilenameHint = undefined;
    void runConversion();
    sourceInput?.focus();
  });

  // File Upload & Drag-and-Drop
  async function handleIncomingFile(file: File) {
    const text = await file.text();
    if (!sourceInput) return;
    lastFilenameHint = file.name;
    sourceInput.value = text;
    if (selectedMode !== "auto") {
      selectedMode = "auto";
      formatPills.forEach((p) => p.setAttribute("aria-selected", p.dataset.format === "auto" ? "true" : "false"));
    }
    const detected = detectDiagramFormat(text, file.name);
    populateSamplesFor(detected);
    await runConversion();
    if (typeof (window as any).showToast === "function") {
      (window as any).showToast(`Loaded ${file.name}`, "✓");
    }
  }

  fileUploadInput?.addEventListener("change", () => {
    const file = fileUploadInput.files?.[0];
    if (file) void handleIncomingFile(file);
    fileUploadInput.value = "";
  });

  dropzoneWrap?.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropOverlay.hidden = false;
  });

  dropzoneWrap?.addEventListener("dragleave", (e) => {
    if (!dropzoneWrap.contains(e.relatedTarget as Node)) {
      dropOverlay.hidden = true;
    }
  });

  dropzoneWrap?.addEventListener("drop", (e) => {
    e.preventDefault();
    dropOverlay.hidden = true;
    const file = e.dataTransfer?.files?.[0];
    if (file) void handleIncomingFile(file);
  });

  // Copy Converted MarkdyScript
  copyMarkdyBtn?.addEventListener("click", async () => {
    const code = getOutputCode();
    if (!code) return;
    try {
      await navigator.clipboard.writeText(code);
      if (copyMarkdyLabel) copyMarkdyLabel.textContent = "Copied";
      if (typeof (window as any).showToast === "function") {
        (window as any).showToast("MarkdyScript copied to clipboard", "✓");
      }
      setTimeout(() => {
        if (copyMarkdyLabel) copyMarkdyLabel.textContent = "Copy";
      }, 1800);
    } catch {
      if (typeof (window as any).showToast === "function") {
        (window as any).showToast("Unable to access clipboard", "!");
      }
    }
  });

  // Copy CLI Command
  copyCliBtn?.addEventListener("click", async () => {
    const cmd = cliCommandCode?.textContent?.trim() || "";
    if (!cmd) return;
    try {
      await navigator.clipboard.writeText(cmd);
      const span = copyCliBtn.querySelector("span");
      if (span) span.textContent = "Copied";
      setTimeout(() => {
        if (span) span.textContent = "Copy";
      }, 1800);
    } catch {}
  });

  // Download .markdy
  downloadMarkdyBtn?.addEventListener("click", () => {
    const code = getOutputCode();
    if (!code) return;
    const blob = new Blob([code], { type: "text/plain;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `converted-${lastDetectedFormat}.markdy`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });

  // Replay & Export SVG
  replayBtn?.addEventListener("click", () => {
    if (diagram) {
      diagram.seek(0);
      diagram.play();
    }
  });

  exportSvgBtn?.addEventListener("click", () => {
    const code = getOutputCode().trim();
    if (!code) return;
    const wasPlaying = diagram?.isPlaying?.();
    const resumeAt = diagram?.currentTime?.() ?? 0;
    try {
      if (diagram) {
        diagram.pause();
        diagram.seek(diagram.duration());
      }
      const svg = exportDiagramAsVectorSvg(code);
      const blob = new Blob([svg], { type: "image/svg+xml;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `converted-${lastDetectedFormat}.svg`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    } finally {
      if (diagram) {
        diagram.seek(resumeAt);
        if (wasPlaying) diagram.play();
      }
    }
  });

  // Open Directly in Full Interactive Studio
  openStudioBtn?.addEventListener("click", async () => {
    const code = getOutputCode().trim();
    if (!code) return;
    try {
      const compressed = await compressMarkdyToUrlHash(code);
      window.location.href = `/playground/#code=${compressed}`;
    } catch {
      window.location.href = `/playground/#code=${encodeURIComponent(code)}`;
    }
  });

  // Layout View Toggle (2-Col Studio / 3-Col Split)
  layoutModeBtn?.addEventListener("click", () => {
    const current = workbenchGrid.getAttribute("data-view") || "2col";
    const next = current === "2col" ? "3col" : "2col";
    workbenchGrid.setAttribute("data-view", next);
    const span = layoutModeBtn.querySelector("span");
    if (span) span.textContent = next === "2col" ? "3-Col" : "2-Col";
    layoutModeBtn.setAttribute("aria-pressed", next === "3col" ? "true" : "false");
    renderLivePreview(getOutputCode());
  });

  // Mobile Pane Switcher
  mobilePaneBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const pane = btn.dataset.pane || "source";
      mobilePaneBtns.forEach((b) => b.setAttribute("aria-selected", b === btn ? "true" : "false"));
      workbenchGrid.setAttribute("data-mobile-pane", pane);
      if (pane === "preview") {
        renderLivePreview(getOutputCode());
      }
    });
  });

  // Direct Links below workbench
  document.querySelectorAll<HTMLAnchorElement>(".direct-link-pill[data-jump]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const fmt = link.dataset.jump as CompatFormat;
      if (fmt) {
        selectFormatTab(fmt, true);
        window.history.replaceState(null, "", `/convert/?from=${fmt}`);
        document.querySelector(".converter-shell")?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  // Global Theme Toggle + Mobile Drawer
  const themeBtn = document.getElementById("theme-toggle");
  function updateThemeIcons(theme: string) {
    const sun = themeBtn?.querySelector(".icon-sun") as HTMLElement | null;
    const moon = themeBtn?.querySelector(".icon-moon") as HTMLElement | null;
    if (!sun || !moon) return;
    sun.style.display = theme === "dark" ? "none" : "block";
    moon.style.display = theme === "dark" ? "block" : "none";
  }

  themeBtn?.addEventListener("click", () => {
    const next = isDarkMode() ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    const csMeta = document.querySelector('meta[name="color-scheme"]');
    if (csMeta) csMeta.setAttribute("content", next);
    localStorage.setItem("markdy-theme", next);
    updateThemeIcons(next);
    createOutputEditor(getOutputCode());
  });

  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileDrawer = document.getElementById("mobile-nav-drawer");
  const burgerIcon = mobileMenuBtn?.querySelector(".icon-burger") as HTMLElement | null;
  const closeIcon = mobileMenuBtn?.querySelector(".icon-close") as HTMLElement | null;

  function toggleMobileMenu(open?: boolean) {
    if (!mobileDrawer || !mobileMenuBtn) return;
    const shouldOpen = open !== undefined ? open : mobileDrawer.hidden;
    mobileDrawer.hidden = !shouldOpen;
    mobileMenuBtn.setAttribute("aria-expanded", String(shouldOpen));
    if (burgerIcon && closeIcon) {
      burgerIcon.style.display = shouldOpen ? "none" : "block";
      closeIcon.style.display = shouldOpen ? "block" : "none";
    }
  }
  mobileMenuBtn?.addEventListener("click", () => toggleMobileMenu());
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") toggleMobileMenu(false);
  });

  // Initialize Page State (including ?from= format preselection)
  updateThemeIcons(document.documentElement.getAttribute("data-theme") || "light");

  const params = new URLSearchParams(window.location.search);
  const fromParam = (params.get("from") || "").toLowerCase();
  const aliasMap: Record<string, CompatFormat | "auto"> = {
    auto: "auto",
    mermaid: "mermaid",
    mmd: "mermaid",
    d2: "d2",
    plantuml: "plantuml",
    puml: "plantuml",
    c4: "plantuml",
    dot: "dot",
    graphviz: "dot",
    drawio: "drawio",
    excalidraw: "excalidraw",
    compose: "compose",
    docker: "compose",
    "docker-compose": "compose",
    k8s: "k8s",
    kubernetes: "k8s",
    terraform: "terraform",
    tfstate: "terraform",
  };

  const initialFormat = aliasMap[fromParam] || "auto";
  if (isDarkMode() && themeSelect) {
    themeSelect.value = "midnight";
  }
  createOutputEditor("");

  let handoffApplied = false;
  try {
    const rawHandoff = sessionStorage.getItem("markdy-convert-handoff");
    if (rawHandoff) {
      sessionStorage.removeItem("markdy-convert-handoff");
      const handoff = JSON.parse(rawHandoff) as { format?: string; source?: string };
      if (handoff?.source && handoff.source.trim().length > 0 && sourceInput) {
        const mapped = (handoff.format && aliasMap[handoff.format.toLowerCase()]) || initialFormat;
        selectFormatTab(mapped, false);
        sourceInput.value = handoff.source;
        void runConversion();
        handoffApplied = true;
      }
    }
  } catch {}

  if (!handoffApplied) {
    selectFormatTab(initialFormat, true);
  }
</script>

