---
import Layout from "../layouts/Layout.astro";

const FORMATS = [
  { id: "auto", label: "Auto-Detect", hint: "Any", ext: "auto" },
  { id: "mermaid", label: "Mermaid", hint: "Flow/Seq", ext: "diagram.mmd" },
  { id: "d2", label: "D2", hint: ".d2", ext: "architecture.d2" },
  { id: "plantuml", label: "PlantUML", hint: "C4", ext: "system.puml" },
  { id: "dot", label: "Graphviz DOT", hint: ".dot", ext: "graph.dot" },
  { id: "drawio", label: "Draw.io", hint: ".drawio", ext: "diagram.drawio" },
  { id: "excalidraw", label: "Excalidraw", hint: ".json", ext: "board.excalidraw" },
  { id: "compose", label: "Compose", hint: ".yml", ext: "docker-compose.yml" },
  { id: "k8s", label: "Kubernetes", hint: "YAML", ext: "manifests.yaml" },
  { id: "terraform", label: "Terraform", hint: ".tfstate", ext: "terraform.tfstate" },
];

const THEMES = [
  { id: "paper", label: "Paper (Light)" },
  { id: "midnight", label: "Midnight (Dark)" },
  { id: "cad", label: "CAD Blueprint (Light)" },
  { id: "cad-dark", label: "CAD Dark" },
  { id: "blueprint", label: "Blueprint" },
  { id: "editorial", label: "Editorial" },
  { id: "terminal", label: "Terminal" },
  { id: "sketchy", label: "Sketchy" },
  { id: "ink", label: "Blue Ink" },
  { id: "doodle", label: "Doodle" },
  { id: "nebula", label: "Nebula" },
  { id: "graphite", label: "Graphite" },
];

const FAQS = [
  {
    q: "How does converting Mermaid or D2 to Markdy work?",
    a: "Everything runs locally in your browser using @markdy/compat zero-dependency parsers. Your diagram source never leaves your machine: nodes, labels, semantic roles (database, queue, gateway, browser), groups, and edges are transpiled into animated MarkdyScript and rendered with the Web Animations API.",
  },
  {
    q: "Which Mermaid diagram types are supported?",
    a: "Flowcharts and graphs (LR, TB, TD, RL, BT, subgraphs, double shapes, & fan-out chains), Sequence Diagrams (participants, actors, sync/async arrows, activation markers), and State Diagrams (stateDiagram-v2, [*] start/end endpoints, composite states).",
  },
  {
    q: "Can I upload Draw.io, Excalidraw, Kubernetes, or Terraform files?",
    a: "Yes. Drop or upload .mmd, .d2, .puml, .dot, .gv, .drawio, .xml, .excalidraw, docker-compose.yml, Kubernetes YAML, or .tfstate files directly into the source pane. Auto-Detect identifies the format by filename and syntax.",
  },
  {
    q: "How do I convert diagrams from the CLI or an AI coding agent?",
    a: "Run `npx @markdy/cli import diagram.mmd --out diagram.markdy` in your terminal, or connect `@markdy/mcp-server` in Cursor, Claude, or Antigravity and invoke the `transpile_to_markdy` tool.",
  },
];

const canonicalURL = "https://markdy.com/convert/";

const structuredData = [
  {
    "@type": "WebApplication",
    "@id": "https://markdy.com/convert/#app",
    name: "Markdy Universal Diagram Converter",
    url: canonicalURL,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description:
      "Free browser-based converter that transforms Mermaid, D2, PlantUML, Graphviz DOT, Draw.io, Excalidraw, Docker Compose, Kubernetes YAML, and Terraform state into animated MarkdyScript diagrams.",
    featureList: [
      "Mermaid to Markdy converter (Flowchart, Sequence, State)",
      "D2 to Markdy converter",
      "PlantUML and C4-PlantUML to Markdy converter",
      "Graphviz DOT to Markdy converter",
      "Draw.io XML to Markdy converter",
      "Excalidraw JSON to Markdy converter",
      "Docker Compose, Kubernetes, and Terraform state to Markdy converter",
    ],
    isPartOf: { "@id": "https://markdy.com/#website" },
    about: { "@id": "https://markdy.com/#software" },
  },
  {
    "@type": "FAQPage",
    "@id": "https://markdy.com/convert/#faq",
    mainEntity: FAQS.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: f.a,
      },
    })),
  },
];
---

<Layout
  title="Convert Mermaid, D2, PlantUML, Draw.io & Infra to Markdy | Markdy Converter"
  description="Convert Mermaid flowcharts, sequences, and states, D2, PlantUML, Graphviz DOT, Draw.io, Excalidraw, Docker Compose, Kubernetes, and Terraform into animated MarkdyScript diagrams."
  canonicalURL={canonicalURL}
  keywords="mermaid to markdy, convert mermaid to markdy, d2 to markdy, plantuml to markdy, drawio to markdy, graphviz dot to markdy, excalidraw to markdy, diagram converter"
  structuredData={structuredData}
>
  <!-- Navigation Header -->
  <nav class="home-nav" aria-label="Main Navigation">
    <div class="nav-pill">
      <a href="/" class="nav-brand">
        <img src="/icon.svg" class="nav-logo-svg" alt="Markdy Logo" width="22" height="22" loading="eager" decoding="async" />
        <span class="nav-title">markdy</span>
      </a>

      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/examples/">Gallery</a>
        <a href="/convert/" class="active" aria-current="page">Convert</a>
        <a href="/docs/">Docs</a>
        <a href="/blog/">Articles</a>
      </div>

      <div class="nav-actions">
        <a href="/playground/" class="btn-nav-studio">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Studio</span>
        </a>
        <button id="theme-toggle" class="btn-nav-icon" type="button" aria-label="Toggle dark/light mode" title="Toggle Theme">
          <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <a href="https://github.com/HoangYell/markdy-com" target="_blank" rel="noopener noreferrer" class="btn-nav-icon" title="GitHub Repository" aria-label="GitHub Repository">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <button id="mobile-menu-btn" class="btn-nav-icon mobile-menu-btn" type="button" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
          <svg class="icon-burger" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          <svg class="icon-close" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" style="display:none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
    </div>

    <div id="mobile-nav-drawer" class="mobile-nav-drawer" hidden>
      <div class="mobile-drawer-inner">
        <a href="/" class="mobile-nav-link">Home</a>
        <a href="/examples/" class="mobile-nav-link">Gallery</a>
        <a href="/convert/" class="mobile-nav-link mobile-nav-highlight">Convert Diagrams</a>
        <a href="/docs/" class="mobile-nav-link">Docs</a>
        <a href="/blog/" class="mobile-nav-link">Articles</a>
        <a href="/playground/" class="mobile-nav-link">Interactive Studio</a>
        <a href="https://github.com/HoangYell/markdy-com" target="_blank" rel="noopener noreferrer" class="mobile-nav-link">GitHub Repository</a>
      </div>
    </div>
  </nav>

  <main class="convert-page">
    <!-- Compact Airy Header -->
    <header class="convert-hero">
      <div class="hero-copy">
        <h1>Convert Diagrams to Animated Markdy</h1>
        <p>Paste Mermaid, D2, PlantUML, Graphviz, Draw.io, Excalidraw, or infra configs for instant MarkdyScript and live motion.</p>
      </div>
      <div class="hero-cli-pill" aria-label="CLI equivalent">
        <span class="cli-prefix">$</span>
        <code id="cli-command-code">markdy import diagram.mmd --out diagram.markdy</code>
        <button id="copy-cli-btn" class="cli-copy-btn" type="button" title="Copy CLI command" aria-label="Copy CLI import command">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span>Copy</span>
        </button>
      </div>
    </header>

    <!-- Format Tabs Strip -->
    <section class="converter-shell" aria-label="Diagram converter workbench">
      <div class="format-strip-wrap">
        <div id="format-tablist" class="format-tablist" role="tablist" aria-label="Source Diagram Format">
          {FORMATS.map((fmt, idx) => (
            <button
              type="button"
              role="tab"
              id={`tab-${fmt.id}`}
              class="format-pill"
              data-format={fmt.id}
              aria-selected={idx === 0 ? "true" : "false"}
            >
              <span class="format-pill-label">{fmt.label}</span>
              <span class="format-pill-hint">{fmt.hint}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Studio Conversion Options & Telemetry Bar -->
      <div class="options-bar">
        <div class="options-left">
          <span id="detected-badge" class="telemetry-pill telemetry-pill--accent">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span id="detected-badge-text">Detected: Mermaid</span>
          </span>
          <span id="metrics-badge" class="telemetry-pill">0 nodes · 0 flows</span>
          <button
            id="warnings-toggle-btn"
            type="button"
            class="telemetry-pill telemetry-pill--warn"
            popovertarget="warnings-popover"
            hidden
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span id="warnings-count-text">0 notes</span>
          </button>
          <div id="warnings-popover" popover="auto" class="warnings-popover">
            <div class="warnings-popover-head">Conversion Notes</div>
            <ul id="warnings-list" class="warnings-list"></ul>
          </div>
        </div>

        <div class="options-right">
          <label class="option-control">
            <span>Sample</span>
            <select id="sample-select" aria-label="Choose sample diagram"></select>
          </label>
          <label class="option-control">
            <span>Theme</span>
            <select id="theme-select" aria-label="Output Markdy theme">
              {THEMES.map((t) => (
                <option value={t.id}>{t.label}</option>
              ))}
            </select>
          </label>
          <label class="option-control">
            <span>Layout</span>
            <select id="layout-select" aria-label="Layout direction">
              <option value="auto">Auto</option>
              <option value="LR">LR (Horizontal)</option>
              <option value="TB">TB (Vertical)</option>
              <option value="RL">RL</option>
              <option value="BT">BT</option>
            </select>
          </label>
          <label class="option-checkbox" title="Include interactive player controls block in generated MarkdyScript">
            <input id="player-toggle" type="checkbox" checked />
            <span>Player bar</span>
          </label>
          <button id="layout-mode-btn" type="button" class="wb-btn wb-layout-btn" title="Switch between 2-column studio view and 3-column split" aria-pressed="false">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M12 3v18"/></svg>
            <span>3-Col</span>
          </button>
        </div>
      </div>

      <!-- Mobile / Narrow Viewport Pane Switcher -->
      <div class="mobile-pane-tabs" role="tablist" aria-label="Workbench view">
        <button type="button" role="tab" class="mobile-pane-btn" data-pane="source" aria-selected="true">Source Input</button>
        <button type="button" role="tab" class="mobile-pane-btn" data-pane="output" aria-selected="false">MarkdyScript</button>
        <button type="button" role="tab" class="mobile-pane-btn" data-pane="preview" aria-selected="false">Live Preview</button>
      </div>

      <!-- Studio Workbench (Spacious 2-Column default with 3-Column toggle) -->
      <div id="workbench-grid" class="workbench-grid" data-view="2col" data-mobile-pane="source">
        <!-- Pane 1: Source Input -->
        <section class="wb-pane wb-pane--source" aria-label="Source diagram input">
          <div class="wb-pane-head">
            <div class="wb-pane-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span id="source-filename-label">diagram.mmd</span>
            </div>
            <div class="wb-pane-actions">
              <button id="paste-source-btn" class="wb-btn" type="button" title="Paste source from clipboard">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/></svg>
                <span>Paste</span>
              </button>
              <label class="wb-btn wb-btn--upload" title="Upload diagram file (.mmd, .d2, .puml, .dot, .drawio, .excalidraw, .yml, .tfstate)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span>Upload</span>
                <input
                  id="file-upload-input"
                  type="file"
                  class="sr-only"
                  accept=".mmd,.mermaid,.d2,.puml,.plantuml,.iuml,.dot,.gv,.drawio,.xml,.excalidraw,.yml,.yaml,.json,.tfstate,.txt"
                />
              </label>
              <button id="clear-source-btn" class="wb-btn" type="button" title="Clear source editor" aria-label="Clear source">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
              </button>
            </div>
          </div>

          <div id="dropzone-wrap" class="source-dropzone">
            <textarea
              id="source-input"
              class="source-textarea"
              spellcheck="false"
              aria-label="Paste Mermaid, D2, PlantUML, DOT, Draw.io, Excalidraw, Compose, Kubernetes, or Terraform source"
              placeholder="Paste Mermaid, D2, PlantUML, Graphviz DOT, Draw.io XML, Excalidraw JSON, Docker Compose, Kubernetes YAML, or Terraform state here — or drag and drop a file..."
            ></textarea>
            <div id="drop-overlay" class="drop-overlay" hidden>
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <strong>Drop diagram file to convert</strong>
              <span>Supports .mmd, .d2, .puml, .dot, .drawio, .excalidraw, .yml, .tfstate</span>
            </div>
          </div>
          <div id="convert-error-banner" class="convert-error" role="alert" hidden></div>
        </section>

        <!-- Pane 2: Converted MarkdyScript -->
        <section class="wb-pane wb-pane--output" aria-label="Converted MarkdyScript output">
          <div class="wb-pane-head">
            <div class="wb-pane-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              <span>output.markdy</span>
            </div>
            <div class="wb-pane-actions">
              <button id="copy-markdy-btn" class="wb-btn" type="button" title="Copy converted MarkdyScript">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span id="copy-markdy-label">Copy</span>
              </button>
              <button id="download-markdy-btn" class="wb-btn" type="button" title="Download .markdy file">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>.markdy</span>
              </button>
            </div>
          </div>

          <div id="output-editor" class="output-editor" aria-label="Editable MarkdyScript output"></div>
        </section>

        <!-- Pane 3: Live Animated Motion Preview -->
        <section class="wb-pane wb-pane--preview" aria-label="Live animated Markdy preview">
          <div class="wb-pane-head">
            <div class="wb-pane-title">
              <span class="live-dot" aria-hidden="true"></span>
              <span>Live Motion Preview</span>
            </div>
            <div class="wb-pane-actions">
              <button id="replay-btn" class="wb-btn" type="button" title="Replay animation from beat 1">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                <span>Replay</span>
              </button>
              <button id="export-svg-btn" class="wb-btn" type="button" title="Download pure vector SVG">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>SVG</span>
              </button>
              <button id="open-studio-btn" class="wb-btn wb-btn--primary" type="button" title="Open converted diagram in full interactive Studio">
                <span>Open in Studio</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </button>
            </div>
          </div>

          <div id="preview-stage" class="preview-stage"></div>
        </section>
      </div>
    </section>

    <!-- Direct Format Shortcuts & Syntax Mapping -->
    <section class="mapping-section" aria-label="Supported converters and syntax translation guide">
      <div class="mapping-grid">
        <div class="mapping-card">
          <h2>Supported Converters</h2>
          <p class="mapping-desc">Jump directly to a converter preset or share a deep link with your team:</p>
          <div class="direct-links-grid">
            <a href="/convert/?from=mermaid" class="direct-link-pill" data-jump="mermaid">Mermaid to Markdy</a>
            <a href="/convert/?from=d2" class="direct-link-pill" data-jump="d2">D2 to Markdy</a>
            <a href="/convert/?from=plantuml" class="direct-link-pill" data-jump="plantuml">PlantUML &amp; C4 to Markdy</a>
            <a href="/convert/?from=dot" class="direct-link-pill" data-jump="dot">Graphviz DOT to Markdy</a>
            <a href="/convert/?from=drawio" class="direct-link-pill" data-jump="drawio">Draw.io XML to Markdy</a>
            <a href="/convert/?from=excalidraw" class="direct-link-pill" data-jump="excalidraw">Excalidraw JSON to Markdy</a>
            <a href="/convert/?from=compose" class="direct-link-pill" data-jump="compose">Docker Compose to Markdy</a>
            <a href="/convert/?from=k8s" class="direct-link-pill" data-jump="k8s">Kubernetes YAML to Markdy</a>
            <a href="/convert/?from=terraform" class="direct-link-pill" data-jump="terraform">Terraform State to Markdy</a>
          </div>
        </div>

        <div class="mapping-card">
          <h2>How Concepts Translate</h2>
          <div class="mapping-table-wrap">
            <table class="mapping-table">
              <thead>
                <tr>
                  <th>Source Construct</th>
                  <th>MarkdyScript Output</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>flowchart LR</code> / <code>rankdir=LR</code></td>
                  <td><code>layout LR</code></td>
                </tr>
                <tr>
                  <td><code>sequenceDiagram</code> / <code>stateDiagram-v2</code></td>
                  <td><code>scene type=sequence</code> / <code>type=state</code></td>
                </tr>
                <tr>
                  <td><code>DB[(Postgres)]</code> / <code>shape=cylinder</code></td>
                  <td><code>database DB "Postgres"</code></td>
                </tr>
                <tr>
                  <td><code>subgraph Core ... end</code> / <code>cluster_*</code></td>
                  <td><code>group Core "Core": ...</code></td>
                </tr>
                <tr>
                  <td><code>A -.-> B</code> / <code>style=dashed</code></td>
                  <td><code>A ~&gt; B</code> (animated async event)</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section (Native <details name="convert-faq"> exclusive accordion) -->
    <section class="faq-section" aria-labelledby="faq-title">
      <h2 id="faq-title">Frequently Asked Questions</h2>
      <div class="faq-list">
        {FAQS.map((item, i) => (
          <details class="faq-item" name="convert-faq" open={i === 0}>
            <summary class="faq-summary">
              <span>{item.q}</span>
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="faq-body">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="convert-footer">
    <div class="footer-inner">
      <span>© {new Date().getFullYear()} Markdy · MIT licensed</span>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/playground/">Studio</a>
        <a href="/examples/">Gallery</a>
        <a href="/docs/">Docs</a>
        <a href="/AGENT.md">AGENT.md</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  import { EditorView, keymap, lineNumbers, highlightActiveLine, highlightActiveLineGutter } from "@codemirror/view";
  import { EditorState } from "@codemirror/state";
  import { bracketMatching } from "@codemirror/language";
  import { defaultKeymap, history, historyKeymap } from "@codemirror/commands";
  import { markdyLanguage, markdyHighlightLight, markdyHighlightDark } from "../editor/markdy-language";
  import { baseTheme, lightTheme, darkTheme } from "../editor/editor-theme";
  import { compressMarkdyToUrlHash } from "@markdy/core";
  import { transpileToMarkdy, detectDiagramFormat, type CompatFormat } from "@markdy/compat";
  import { createDiagram, exportDiagramAsVectorSvg, type Diagram } from "@markdy/renderer-dom";

  interface SampleSpec {
    label: string;
    code: string;
  }

  const SAMPLES: Record<CompatFormat, SampleSpec[]> = {
    mermaid: [
