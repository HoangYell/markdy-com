  function updateStatusIndicator(ok: boolean, nodeCount: number = 0, edgeCount: number = 0, errorMsg?: string) {
    if (ok) {
      studioStatusPill.className = "status-pill status-pill--ok";
      statusText.textContent = "Synced";
      statusMeta.textContent = `${nodeCount} node${nodeCount === 1 ? '' : 's'} · ${edgeCount} flow${edgeCount === 1 ? '' : 's'}`;
      diagCountBadge.hidden = true;
    } else {
