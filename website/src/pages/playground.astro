  function getCode(): string {
    return editor?.state.doc.toString() ?? "";
  }

  function insertCodeAtCursor(snippet: string) {
    if (!editor) return;
    const state = editor.state;
    const selection = state.selection.main;
    const doc = state.doc;

    let insert = snippet;
    if (selection.empty && doc.length > 0 && !doc.toString().endsWith("\n") && !snippet.startsWith("\n")) {
      insert = "\n" + snippet;
    }

    editor.dispatch({
      changes: { from: selection.from, to: selection.to, insert },
      selection: { anchor: selection.from + insert.length },
    });
    editor.focus();
    render(getCode());
  }

  function formatMarkdyScript(rawCode: string): string {
    const lines = rawCode.split("\n");
    const formatted: string[] = [];
    const playerBlock: string[] = [];
    let inBeatOrPattern = false;
    let inPlayer = false;
    let inPlayerScope = false;

    for (let line of lines) {
      const trimmed = line.trim();
      if (!trimmed) {
        // Keep at most 1 empty line
        const target = inPlayer ? playerBlock : formatted;
        if (target.length > 0 && target[target.length - 1] !== "") {
          target.push("");
        }
        continue;
      }

      // Check if entering player block
      if (/^player\s*:\s*$/.test(trimmed)) {
        inBeatOrPattern = false;
        inPlayer = true;
        inPlayerScope = false;
        playerBlock.push("player:");
        continue;
      }

      if (inPlayer) {
        // Sub-scopes: playback:, controls:, interaction:, chrome:
        if (/^(playback|controls|interaction|chrome)\s*:\s*$/.test(trimmed)) {
          inPlayerScope = true;
          playerBlock.push(`  ${trimmed}`);
          continue;
        }

        // Check if a root DSL keyword exits player block
        if (/^(scene|layout|beat|pattern|group|service|client|browser|mobile|gateway|database|db|cache|queue|worker|storage|firewall|lambda|pod|user|edge|annotation)\b/.test(trimmed)) {
          inPlayer = false;
          inPlayerScope = false;
        } else {
          // Setting within player
          if (inPlayerScope) {
            playerBlock.push(`    ${trimmed}`);
          } else {
            playerBlock.push(`  ${trimmed}`);
          }
          continue;
        }
      }

      if (/^(beat|pattern)\b.*:\s*$/.test(trimmed)) {
        inBeatOrPattern = true;
        formatted.push(trimmed);
      } else if (inBeatOrPattern && (/^(beat|pattern|layout|scene|theme|service|client|browser|mobile|gateway|database|db|cache|queue|worker|storage|firewall|lambda|pod|user|group|edge|annotation|player)\b/.test(trimmed))) {
        inBeatOrPattern = false;
        formatted.push(trimmed);
      } else if (inBeatOrPattern) {
        formatted.push(`  ${trimmed}`);
      } else {
        formatted.push(trimmed);
      }
    }

    while (formatted.at(-1) === "") formatted.pop();
    while (playerBlock.at(-1) === "") playerBlock.pop();
    return [...formatted, ...(playerBlock.length > 0 ? ["", ...playerBlock] : [])].join("\n") + "\n";
  }

  function updateEntitiesAndSuggestions(code: string) {
    try {
      const ast = parse(code);
      parsedAst = ast;
      const nodes = Object.values(ast.nodes || {}) as any[];
      const beats = ast.beats ?? [];

      updateStoryboard(beats);

      const incomingCounts: Record<string, number> = {};
      const outgoingCounts: Record<string, number> = {};
      let totalFlowEdges = 0;

      for (const beat of beats) {
        for (const cue of beat.cues ?? []) {
          if (cue.kind === "flow") {
            for (const seg of (cue as any).segments ?? []) {
              totalFlowEdges++;
              if (seg.from) outgoingCounts[seg.from] = (outgoingCounts[seg.from] || 0) + 1;
              if (seg.to) incomingCounts[seg.to] = (incomingCounts[seg.to] || 0) + 1;
            }
          }
        }
      }

      for (const edge of (ast.edges ?? [])) {
        totalFlowEdges++;
        if (edge.from) outgoingCounts[edge.from] = (outgoingCounts[edge.from] || 0) + 1;
        if (edge.to) incomingCounts[edge.to] = (incomingCounts[edge.to] || 0) + 1;
      }

      updateStatusIndicator(true, nodes.length, totalFlowEdges);

      // Update Entities Badge & Inspector Grid
      nodesCountBadge.textContent = String(nodes.length);
      nodesInspectorGrid.innerHTML = "";

      if (nodes.length === 0) {
        nodesInspectorGrid.innerHTML = '<div class="inspector-empty">No nodes declared. Click any Node chip in the palette to insert.</div>';
      } else {
        for (const node of nodes) {
          const card = document.createElement("div");
          card.className = "node-item-card";
          const icon = NODE_ICON_MAP[node.kind] || "⚙️";
          const outCount = outgoingCounts[node.id] || 0;
          const inCount = incomingCounts[node.id] || 0;

          card.innerHTML = `
            <div class="node-card-top">
              <span class="node-icon">${icon}</span>
              <strong class="node-id">${node.id}</strong>
              <span class="node-kind-badge" data-kind="${node.kind}">${node.kind}</span>
            </div>
            <p class="node-label-text">${node.label || node.id}</p>
            <div class="node-flows-stat">
              <span>↑ ${outCount} out</span> · <span>↓ ${inCount} in</span>
            </div>
            <div class="node-actions-row">
              <button class="node-action-btn btn-flow" type="button" data-id="${node.id}">+ Flow</button>
              <button class="node-action-btn btn-pulse" type="button" data-id="${node.id}">Pulse</button>
            </div>
          `;

          // Quick flow trigger
          card.querySelector(".btn-flow")?.addEventListener("click", (e) => {
            e.stopPropagation();
            const nextTarget = nodes.find(n => n.id !== node.id)?.id || "Target";
            insertCodeAtCursor(`\nbeat flow_${node.id}:\n  ${node.id} -> ${nextTarget} "request"\n`);
          });

          // Quick pulse trigger
          card.querySelector(".btn-pulse")?.addEventListener("click", (e) => {
            e.stopPropagation();
            insertCodeAtCursor(`\nbeat alert_${node.id}:\n  pulse ${node.id} color=#38bdf8\n`);
          });

          // Click card to select node in canvas
          card.addEventListener("click", () => {
            const el = stageCanvas?.querySelector<HTMLElement>(`[data-node="${node.id}"]`);
            if (el) selectNodeOnCanvas(node.id, el);
          });

          nodesInspectorGrid.appendChild(card);
        }
      }

      // Generate Smart IntelliCode Suggestions
      const suggestions: Array<{ title: string; desc: string; actionLabel?: string; onAction?: () => void }> = [];

      // Proactive architectural recommendations from core engine
      const archRecommendations = getArchitectureSuggestions(code);
      for (const rec of archRecommendations) {
        suggestions.push({
          title: rec.title,
          desc: rec.desc,
          actionLabel: `+ ${rec.actionLabel}`,
          onAction: () => insertCodeAtCursor(`\n${rec.snippet}`),
        });
      }

      if (beats.length === 0 && !archRecommendations.some(r => r.id === "add-entrance-beat")) {
        suggestions.push({
          title: "Static Scene",
          desc: "Add a choreographed beat block to animate requests and highlight stages.",
          actionLabel: "+ Add Beat Entrance",
          onAction: () => insertCodeAtCursor('\nbeat entrance "System Flow":\n  show $nodes stagger=60ms\n'),
        });
      }

      const unconnected = nodes.filter(n => (outgoingCounts[n.id] || 0) === 0 && (incomingCounts[n.id] || 0) === 0);
      if (unconnected.length > 0) {
        const target = unconnected[0];
        const partner = nodes.find(n => n.id !== target.id);
        suggestions.push({
          title: `Isolated node '${target.id}'`,
          desc: `Node '${target.id}' (${target.kind}) has no incoming or outgoing flows.`,
          actionLabel: partner ? `Connect to ${partner.id}` : "+ Connect Flow",
          onAction: () => {
            if (partner) insertCodeAtCursor(`\nbeat connect_${target.id}:\n  ${target.id} -> ${partner.id} "call"\n`);
          },
        });
      }

      if (!code.includes("layout LR") && !code.includes("layout TB")) {
        suggestions.push({
          title: "Directional layout unset",
          desc: "Adding 'layout LR' provides a horizontal topology for clear microservice architectures.",
          actionLabel: "+ Add layout LR",
          onAction: () => insertCodeAtCursor("\nlayout LR\n"),
        });
      }

      suggCountBadge.textContent = String(suggestions.length);
      suggestionsContainer.innerHTML = "";

      if (suggestions.length === 0) {
        suggestionsContainer.innerHTML = '<div class="sugg-perfect">✓ Architecture looks great! All nodes connected with active beats.</div>';
      } else {
        for (const sugg of suggestions) {
          const item = document.createElement("div");
          item.className = "sugg-item";
          item.innerHTML = `
            <div class="sugg-info">
              <strong>${sugg.title}</strong>
              <p>${sugg.desc}</p>
            </div>
          `;
          if (sugg.actionLabel && sugg.onAction) {
            const btn = document.createElement("button");
            btn.className = "sugg-action-btn";
            btn.type = "button";
            btn.textContent = sugg.actionLabel;
            btn.addEventListener("click", sugg.onAction);
            item.appendChild(btn);
          }
          suggestionsContainer.appendChild(item);
        }
      }

    } catch {
      // Ignored during mid-type parsing
    }
  }

  function createEditor(code: string) {
    editor?.destroy();
    editor = new EditorView({
      state: EditorState.create({
        doc: code,
        extensions: [
          lineNumbers(),
          highlightActiveLine(),
          highlightActiveLineGutter(),
          history(),
          bracketMatching(),
          closeBrackets(),
          indentOnInput(),
          highlightSelectionMatches(),
          markdyLanguage,
          markdyAutocomplete,
          markdyInlineSuggestion,
          isDarkMode() ? markdyHighlightDark : markdyHighlightLight,
          baseTheme,
          isDarkMode() ? darkTheme : lightTheme,
          keymap.of([
            ...closeBracketsKeymap,
            ...defaultKeymap,
            ...searchKeymap,
            ...historyKeymap,
            indentWithTab,
          ]),
          EditorView.contentAttributes.of({ "aria-label": "MarkdyScript editor" }),
          EditorView.updateListener.of((update) => {
            if (!update.docChanged) return;
            exampleBtns.forEach((btn) => btn.classList.remove("active"));
            if (debounce) clearTimeout(debounce);
            debounce = setTimeout(() => render(getCode()), 600);
          }),
        ],
      }),
      parent: editorHost,
    });
  }

  function render(code: string) {
    diagram?.destroy();
    diagram = null;
    if (stageCanvas) stageCanvas.innerHTML = "";
    deselectCanvas();
    const warnings: string[] = [];
    try {
      diagram = createDiagram({
        container: stageCanvas || stage,
        code,
        shareUrl: `${window.location.origin}${window.location.pathname}`,
        onWarning(warning: Diagnostic) {
          warnings.push(`line ${warning.line}: ${warning.message}`);
        },
      });
      announce("Preview updated successfully.");
      showDiagnostics(warnings);
      updateEntitiesAndSuggestions(code);
      attachCanvasInteraction();
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      if (stageCanvas) stageCanvas.innerHTML = `<div class="parse-error">⚠️ ${message}</div>`;
      updateStatusIndicator(false, 0, 0, message);
      announce(`Preview could not update. ${message}`);
      showDiagnostics([message]);
    }
  }

  // ─── Theme Switcher (Random Dark / Random Light Toggle) ───────────
  const DARK_THEMES = ["midnight", "blueprint", "graphite", "nebula", "terminal"];
  const LIGHT_THEMES = ["paper", "editorial", "sketchy"];

  function toggleRandomThemeInPlayground(): void {
    const current = getCode();
    const match = current.match(/\btheme\s*[:=]?\s*([a-zA-Z0-9_-]+)/);
    const currentTheme = match ? match[1].toLowerCase() : "paper";
    const isDark = DARK_THEMES.includes(currentTheme);
    const targetThemes = isDark ? LIGHT_THEMES : DARK_THEMES;
    const filtered = targetThemes.filter((t) => t !== currentTheme);
    const nextTheme = filtered[Math.floor(Math.random() * filtered.length)] || targetThemes[0];

    let newCode: string;
    if (match) {
      newCode = current.replace(/\btheme\s*[:=]?\s*([a-zA-Z0-9_-]+)/, `theme=${nextTheme}`);
    } else if (/^scene\b/m.test(current)) {
      newCode = current.replace(/^scene\b(.*)$/m, `scene theme=${nextTheme}$1`);
    } else {
      newCode = `scene theme=${nextTheme}\n\n` + current;
    }
    if (playgroundThemeLabel) playgroundThemeLabel.textContent = nextTheme;
    if (editor) {
      editor.dispatch({
        changes: { from: 0, to: editor.state.doc.length, insert: newCode },
      });
    }
    render(newCode);
  }

  switchThemeBtn?.addEventListener("click", toggleRandomThemeInPlayground);

  (stageCanvas || stage)?.addEventListener("markdy-theme-switch", ((e: CustomEvent) => {
    const themeName = e.detail?.theme;
    if (!themeName) return;
    const current = getCode();
    const match = current.match(/\btheme\s*[:=]?\s*([a-zA-Z0-9_-]+)/);
    let newCode: string;
    if (match) {
      newCode = current.replace(/\btheme\s*[:=]?\s*([a-zA-Z0-9_-]+)/, `theme=${themeName}`);
    } else if (/^scene\b/m.test(current)) {
      newCode = current.replace(/^scene\b(.*)$/m, `scene theme=${themeName}$1`);
    } else {
      newCode = `scene theme=${themeName}\n\n` + current;
    }
    if (playgroundThemeLabel) playgroundThemeLabel.textContent = themeName;
    if (editor) {
      editor.dispatch({
        changes: { from: 0, to: editor.state.doc.length, insert: newCode },
      });
    }
    render(newCode);
  }) as EventListener);

  function setActiveExample(index: number) {
    selectedExample = index;
    exampleBtns.forEach((btn, i) => btn.classList.toggle("active", i === index));
    if (quickExampleSelect && index >= 0) {
      quickExampleSelect.value = String(index);
    }
    const example = examples[index];
    if (example) {
      exampleSourceLink.href = example.sourceUrl;
      exampleSourceLink.textContent = "View source ↗";
    } else {
      exampleSourceLink.href = "https://github.com/HoangYell/markdy-com/tree/main/examples";
      exampleSourceLink.textContent = "Browse examples ↗";
    }
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Direct Manipulation & Canvas Interactions
  // ─────────────────────────────────────────────────────────────────────────────
  let isPickingTargetNode = false;

  function attachCanvasInteraction() {
    if (!stageCanvas) return;
    const nodeEls = stageCanvas.querySelectorAll<HTMLElement>(".markdy-node");
    nodeEls.forEach((nodeEl) => {
      const nodeId = nodeEl.dataset.node;
      if (!nodeId) return;

      nodeEl.addEventListener("click", (e) => {
        e.stopPropagation();

        if (isPickingTargetNode && flowSourceNodeId && flowSourceNodeId !== nodeId) {
          isPickingTargetNode = false;
          flowTargetNodeId = nodeId;
          stageCanvas?.querySelectorAll(".markdy-node").forEach(n => n.classList.remove("markdy-node--target-candidate"));

          if (flowPopoverTitle) flowPopoverTitle.textContent = `${flowSourceNodeId} ➔ ${flowTargetNodeId}`;
          if (flowLabelInput) flowLabelInput.value = "";
          const stageRect = stage.getBoundingClientRect();
          const nodeRect = nodeEl.getBoundingClientRect();
          const relX = nodeRect.left - stageRect.left + nodeRect.width / 2;
          const relY = nodeRect.top - stageRect.top;

          if (flowPopover) {
            flowPopover.style.left = `${Math.max(10, Math.min(stageRect.width - 250, relX - 110))}px`;
            flowPopover.style.top = `${Math.max(10, Math.min(stageRect.height - 190, relY - 60))}px`;
            flowPopover.hidden = false;
            flowLabelInput?.focus();
          }
          return;
        }

        if (isPickingTargetNode) {
          isPickingTargetNode = false;
          stageCanvas?.querySelectorAll(".markdy-node").forEach(n => n.classList.remove("markdy-node--target-candidate"));
        }

        selectNodeOnCanvas(nodeId, nodeEl);
      });

      ensureConnectorPorts(nodeEl, nodeId);
    });
  }

  function selectNodeOnCanvas(nodeId: string, nodeEl: HTMLElement) {
    selectedNodeId = nodeId;
    if (!stageCanvas || !nodeFloatingHud) return;
    if (flowPopover) flowPopover.hidden = true;

    stageCanvas.querySelectorAll(".markdy-node").forEach(n => {
      n.classList.toggle("markdy-node--selected", (n as HTMLElement).dataset.node === nodeId);
    });

    const nodeDecl = parsedAst?.nodes?.[nodeId];
    const kind = (nodeDecl?.kind || nodeEl.dataset.kind || "service").toLowerCase();
    const label = nodeDecl?.label || nodeId;
    const icon = NODE_ICON_MAP[kind] || "⚙️";

    if (hudNodeIcon) hudNodeIcon.textContent = icon;
    if (hudNodeId) hudNodeId.textContent = nodeId;
    if (hudKindSelect) hudKindSelect.value = kind;
    if (hudLabelInput) hudLabelInput.value = label;

    const stageRect = stage.getBoundingClientRect();
    const nodeRect = nodeEl.getBoundingClientRect();

    const left = Math.max(12, Math.min(stageRect.width - 250, nodeRect.left - stageRect.left + (nodeRect.width / 2) - 115));
    const top = Math.max(12, nodeRect.top - stageRect.top - 88);

    nodeFloatingHud.style.left = `${left}px`;
    nodeFloatingHud.style.top = `${top}px`;
    nodeFloatingHud.hidden = false;
  }

  function deselectCanvas() {
    isPickingTargetNode = false;
    selectedNodeId = null;
    if (stageCanvas) {
      stageCanvas.querySelectorAll(".markdy-node").forEach(n => {
        n.classList.remove("markdy-node--selected");
        n.classList.remove("markdy-node--target-candidate");
      });
    }
    if (nodeFloatingHud) nodeFloatingHud.hidden = true;
    if (flowPopover) flowPopover.hidden = true;
  }

  stage?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest(".markdy-node") || target.closest(".node-floating-hud") || target.closest(".flow-popover")) return;
    deselectCanvas();
  });

  hudCloseBtn?.addEventListener("click", deselectCanvas);

  hudConnectBtn?.addEventListener("click", () => {
    if (!selectedNodeId) return;
    flowSourceNodeId = selectedNodeId;
    isPickingTargetNode = true;
    if (nodeFloatingHud) nodeFloatingHud.hidden = true;

    stageCanvas?.querySelectorAll<HTMLElement>(".markdy-node").forEach(nodeEl => {
      const nid = nodeEl.dataset.node;
      if (nid && nid !== flowSourceNodeId) {
        nodeEl.classList.add("markdy-node--target-candidate");
      }
    });
  });

  hudKindSelect?.addEventListener("change", () => {
    if (!selectedNodeId) return;
    const newKind = hudKindSelect.value;
    let code = getCode();
    const regex = new RegExp(`^(\\s*)([a-zA-Z_]+)(\\s+${selectedNodeId}\\b)`, "m");
    if (regex.test(code)) {
      code = code.replace(regex, `$1${newKind}$3`);
      createEditor(code);
      render(code);
      setTimeout(() => {
        const el = stageCanvas?.querySelector<HTMLElement>(`[data-node="${selectedNodeId}"]`);
        if (el) selectNodeOnCanvas(selectedNodeId!, el);
      }, 50);
    }
  });

  hudLabelInput?.addEventListener("change", () => {
    if (!selectedNodeId) return;
    const newLabel = hudLabelInput.value.trim();
    let code = getCode();
    const regex = new RegExp(`^(\\s*[a-zA-Z_]+\\s+${selectedNodeId})(\\s+("[^"]*"|'[^']*'|\\S+))?(.*)$`, "m");
    if (regex.test(code)) {
      code = code.replace(regex, `$1 "${newLabel}"$4`);
      createEditor(code);
      render(code);
      setTimeout(() => {
        const el = stageCanvas?.querySelector<HTMLElement>(`[data-node="${selectedNodeId}"]`);
        if (el) selectNodeOnCanvas(selectedNodeId!, el);
      }, 50);
    }
  });

  hudPulseBtn?.addEventListener("click", () => {
    if (!selectedNodeId) return;
    insertCodeAtCursor(`\nbeat pulse_${selectedNodeId}:\n  pulse ${selectedNodeId} color=#38bdf8\n`);
    deselectCanvas();
  });

  hudFrameBtn?.addEventListener("click", () => {
    if (!selectedNodeId) return;
    insertCodeAtCursor(`\nbeat zoom_${selectedNodeId}:\n  frame ${selectedNodeId} zoom=1.2 dur=600ms\n`);
    deselectCanvas();
  });

  hudDeleteBtn?.addEventListener("click", () => {
    if (!selectedNodeId) return;
    let code = getCode();
    const lines = code.split("\n").filter(line => {
      if (new RegExp(`^[a-zA-Z_]+\\s+${selectedNodeId}\\b`).test(line.trim())) return false;
      if (new RegExp(`\\b${selectedNodeId}\\s*(->|<-|~>|<->|\\.\\.>)|(->|<-|~>|<->|\\.\\.>)\\s*${selectedNodeId}\\b`).test(line)) return false;
      return true;
    });
    const newCode = lines.join("\n");
    deselectCanvas();
    createEditor(newCode);
    render(newCode);
  });

  // ─────────────────────────────────────────────────────────────────────────────
  // Connector Ports & Flow Drawing
  // ─────────────────────────────────────────────────────────────────────────────
  function ensureConnectorPorts(nodeEl: HTMLElement, nodeId: string) {
    if (nodeEl.querySelector(".connector-port")) return;

    ["e", "w", "s", "n"].forEach(pos => {
      const port = document.createElement("div");
      port.className = `connector-port port-${pos}`;
      port.title = "Drag to connect flow";

      port.addEventListener("mousedown", (e) => {
        e.stopPropagation();
        e.preventDefault();
        startDrawingFlow(nodeId, e);
      });

      nodeEl.appendChild(port);
    });
  }

  function startDrawingFlow(sourceId: string, e: MouseEvent) {
    if (!flowCanvasSvg || !flowDragPath) return;
    if (nodeFloatingHud) nodeFloatingHud.hidden = true;
    if (flowPopover) flowPopover.hidden = true;
    isDrawingFlow = true;
    flowSourceNodeId = sourceId;
    flowTargetNodeId = null;

    const stageRect = stage.getBoundingClientRect();
    flowStartX = e.clientX - stageRect.left;
    flowStartY = e.clientY - stageRect.top;

    flowCanvasSvg.hidden = false;
    flowDragPath.setAttribute("d", `M ${flowStartX} ${flowStartY} L ${flowStartX} ${flowStartY}`);

    const onMouseMove = (ev: MouseEvent) => {
      if (!isDrawingFlow) return;
      const currentX = ev.clientX - stageRect.left;
      const currentY = ev.clientY - stageRect.top;

      const dx = currentX - flowStartX;
      const dy = currentY - flowStartY;
      const cx1 = flowStartX + dx * 0.5;
      const cy1 = flowStartY;
      const cx2 = flowStartX + dx * 0.5;
      const cy2 = currentY;

      flowDragPath.setAttribute("d", `M ${flowStartX} ${flowStartY} C ${cx1} ${cy1}, ${cx2} ${cy2}, ${currentX} ${currentY}`);

      const target = (document.elementFromPoint(ev.clientX, ev.clientY) as HTMLElement)?.closest(".markdy-node") as HTMLElement | null;
      stageCanvas?.querySelectorAll(".markdy-node").forEach(n => n.classList.remove("markdy-node--target-drop"));
      if (target && target.dataset.node && target.dataset.node !== sourceId) {
        target.classList.add("markdy-node--target-drop");
        flowTargetNodeId = target.dataset.node;
      } else {
        flowTargetNodeId = null;
      }
    };

    const onMouseUp = (ev: MouseEvent) => {
      isDrawingFlow = false;
      flowCanvasSvg.hidden = true;
      window.removeEventListener("mousemove", onMouseMove);
      window.removeEventListener("mouseup", onMouseUp);
      stageCanvas?.querySelectorAll(".markdy-node").forEach(n => n.classList.remove("markdy-node--target-drop"));

      if (flowTargetNodeId && flowSourceNodeId && flowTargetNodeId !== flowSourceNodeId) {
        if (flowPopoverTitle) flowPopoverTitle.textContent = `${flowSourceNodeId} ➔ ${flowTargetNodeId}`;
        if (flowLabelInput) flowLabelInput.value = "";
        const currentX = ev.clientX - stageRect.left;
        const currentY = ev.clientY - stageRect.top;
        if (flowPopover) {
          flowPopover.style.left = `${Math.max(10, Math.min(stageRect.width - 250, currentX - 110))}px`;
          flowPopover.style.top = `${Math.max(10, Math.min(stageRect.height - 190, currentY - 50))}px`;
          flowPopover.hidden = false;
          flowLabelInput?.focus();
        }
      }
    };

    window.addEventListener("mousemove", onMouseMove);
    window.addEventListener("mouseup", onMouseUp);
  }

  flowPopoverClose?.addEventListener("click", () => { if (flowPopover) flowPopover.hidden = true; });

  flowTypeChips.forEach(chip => {
    chip.addEventListener("click", () => {
      flowTypeChips.forEach(c => c.classList.remove("active"));
      chip.classList.add("active");
      selectedFlowOp = chip.dataset.op || "->";
    });
  });

  flowSubmitBtn?.addEventListener("click", () => {
    if (!flowSourceNodeId || !flowTargetNodeId) return;
    const label = flowLabelInput?.value.trim() || "";
    const labelSnippet = label ? ` "${label}"` : "";
    const flowSnippet = `  ${flowSourceNodeId} ${selectedFlowOp} ${flowTargetNodeId}${labelSnippet}\n`;

    let code = getCode();
    const lines = code.split("\n");
    const lastBeatIndex = lines.findLastIndex(l => /^beat\b/.test(l));

    if (lastBeatIndex !== -1) {
      lines.splice(lastBeatIndex + 1, 0, flowSnippet.trimEnd());
      code = lines.join("\n");
    } else {
      code += `\nbeat flow_${flowSourceNodeId}_${flowTargetNodeId}:\n${flowSnippet}`;
    }

    if (flowPopover) flowPopover.hidden = true;
    createEditor(code);
    render(code);
  });

  // ─────────────────────────────────────────────────────────────────────────────
  // Palette Tabs, Collapsing & Drag-and-Drop onto Canvas
  // ─────────────────────────────────────────────────────────────────────────────
  paletteToggleBtn?.addEventListener("click", () => {
    paletteShelf?.classList.toggle("is-collapsed");
  });

  paletteCloseBtn?.addEventListener("click", () => {
    paletteShelf?.classList.add("is-collapsed");
  });

  paletteTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      paletteShelf?.classList.remove("is-collapsed");
      const targetShelf = tab.dataset.shelf;
      paletteTabs.forEach(t => t.classList.toggle("active", t === tab));
      shelfPanels.forEach(p => {
        p.classList.toggle("active", p.id === `shelf-${targetShelf}`);
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".token-chip").forEach(chip => {
    chip.addEventListener("dragstart", (e) => {
      const kind = chip.dataset.kind;
      const template = chip.dataset.insert || chip.dataset.template;
      draggedToken = { kind, template };
      if (e.dataTransfer) {
        e.dataTransfer.setData("text/plain", template || "");
        e.dataTransfer.effectAllowed = "copy";
      }
      if (dropTargetLabel) {
        dropTargetLabel.textContent = `Release to add ${kind ? kind.toUpperCase() : 'component'}`;
      }
      announce(`Dragging ${kind || "item"}. Release onto canvas stage.`);
    });
    chip.addEventListener("dragend", () => {
      draggedToken = null;
      if (stageDropOverlay) stageDropOverlay.hidden = true;
    });

    chip.addEventListener("click", () => {
      const template = chip.dataset.insert || chip.dataset.template;
      if (template) insertCodeAtCursor(template);
    });
  });

  stage?.addEventListener("dragover", (e) => {
    e.preventDefault();
    if (e.dataTransfer) e.dataTransfer.dropEffect = "copy";
    if (stageDropOverlay) stageDropOverlay.hidden = false;
  });

  stage?.addEventListener("dragleave", (e) => {
    if (!stage?.contains(e.relatedTarget as Node)) {
      if (stageDropOverlay) stageDropOverlay.hidden = true;
    }
  });

  function addNodeFromPalette(kind: string): void {
    const kindSlug = kind.toLowerCase().replace(/[^a-z0-9]/g, "");
    const existingNodes = Object.keys(parsedAst?.nodes || {});
    let idIndex = 1;
    let newId = `${kindSlug}_${idIndex}`;
    while (existingNodes.includes(newId)) {
      idIndex++;
      newId = `${kindSlug}_${idIndex}`;
    }
    const label = `${kind.charAt(0).toUpperCase() + kind.slice(1)} ${idIndex}`;
    const declaration = `${kind} ${newId} "${label}"\n`;

    insertNodeDeclaration(declaration);
    announce(`${label} (${kind}) added to diagram.`);

    // Auto-select the newly dropped node
    setTimeout(() => {
      const el = stageCanvas?.querySelector<HTMLElement>(`[data-node="${newId}"]`);
      if (el) selectNodeOnCanvas(newId, el);
    }, 80);
  }

  stage?.addEventListener("drop", (e) => {
    e.preventDefault();
    if (stageDropOverlay) stageDropOverlay.hidden = true;
    if (!draggedToken) return;
    addNodeFromPalette(draggedToken.kind || "service");
  });

  stage?.addEventListener("keydown", (event) => {
    if (event.key === "Delete" || event.key === "Backspace") {
      if (selectedNodeId && !event.defaultPrevented && !(document.activeElement instanceof HTMLInputElement) && !(document.activeElement instanceof HTMLTextAreaElement)) {
        hudDeleteBtn?.click();
      }
    }
  });

  function insertNodeDeclaration(declaration: string) {
    const code = getCode();
    const lines = code.split("\n");
    let insertIndex = lines.findIndex(l => /^(service|client|browser|mobile|gateway|database|db|cache|queue|worker|storage|firewall|lambda|pod|user)\b/.test(l));

    if (insertIndex === -1) {
      insertIndex = lines.findIndex(l => /^layout\b/.test(l));
      if (insertIndex === -1) insertIndex = lines.findIndex(l => /^scene\b/.test(l));
      if (insertIndex !== -1) insertIndex += 1;
      else insertIndex = lines.length;
    }

    lines.splice(insertIndex, 0, declaration.trim());
    const newCode = lines.join("\n");
    createEditor(newCode);
    render(newCode);
  }


  // ─────────────────────────────────────────────────────────────────────────────
  // Storyboard Beats Ribbon & Dock
  // ─────────────────────────────────────────────────────────────────────────────
  function updateStoryboard(beats: any[]) {
    if (!storyboardTrack) return;
    storyboardTrack.innerHTML = "";
    if (!beats || beats.length === 0) {
      storyboardTrack.innerHTML = '<span class="storyboard-empty-hint">No animation beats.</span>';
      return;
    }

    beats.forEach((beat, index) => {
      const chip = document.createElement("button");
      chip.className = "storyboard-chip";
      chip.type = "button";
      const cueCount = (beat.cues || []).length;
      chip.title = `Beat ${index + 1}: ${beat.name} (${cueCount} cues). Click to seek.`;
      chip.innerHTML = `
        <span class="chip-step">#${index + 1}</span>
        <span class="chip-name">${beat.name}</span>
      `;

      chip.addEventListener("click", () => {
        if (!diagram) return;
        diagram.seekToBeat(beat.name);
        storyboardTrack.querySelectorAll(".storyboard-chip").forEach(c => c.classList.remove("active"));
        chip.classList.add("active");
      });

      storyboardTrack.appendChild(chip);
    });
  }

  storyboardAddBeatBtn?.addEventListener("click", () => {
    const existingCount = (parsedAst?.beats || []).length;
    const newBeatName = `step_${existingCount + 1}`;
    insertCodeAtCursor(`\nbeat ${newBeatName} "Step ${existingCount + 1}":\n  show $nodes stagger=50ms\n`);
  });

  // ─────────────────────────────────────────────────────────────────────────────
  // Assistant Drawer Collapsible Toggle & Tab Switching
  // ─────────────────────────────────────────────────────────────────────────────
  drawerToggleBtn?.addEventListener("click", () => {
    const isExpanded = assistantDrawer.classList.toggle("expanded");
    drawerToggleBtn.querySelector(".drawer-toggle-icon")!.textContent = isExpanded ? "▼" : "▲";
  });

  assistantTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;
      if (!assistantDrawer.classList.contains("expanded")) {
        assistantDrawer.classList.add("expanded");
        drawerToggleBtn.querySelector(".drawer-toggle-icon")!.textContent = "▼";
      }
      assistantTabs.forEach(t => t.classList.toggle("active", t === tab));
      document.querySelectorAll(".assistant-panel").forEach(p => {
        p.classList.toggle("active", p.id === `tab-panel-${target}`);
      });
    });
  });

  quickAddNodeBtn?.addEventListener("click", () => {
    const name = `service_${Math.floor(Math.random() * 900 + 100)}`;
    insertCodeAtCursor(`\nservice ${name} "New Microservice"\n`);
  });

  // ─────────────────────────────────────────────────────────────────────────────
  // View Mode Switching
  // ─────────────────────────────────────────────────────────────────────────────
  function setViewMode(mode: "split" | "canvas" | "code") {
    workspace.dataset.viewMode = mode;
    viewModeBtns.forEach(btn => {
      const active = btn.dataset.mode === mode;
      btn.classList.toggle("active", active);
      btn.setAttribute("aria-pressed", active ? "true" : "false");
    });
    if (mode === "canvas" || mode === "split") {
      requestAnimationFrame(() => {
        diagram?.seek(diagram.currentTime());
      });
    }
  }

  viewModeBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      setViewMode((btn.dataset.mode as any) || "split");
    });
  });

  quickExampleSelect?.addEventListener("change", () => {
    const idx = Number(quickExampleSelect.value);
    if (idx >= 0) loadExample(idx);
  });

  function loadExample(index: number) {
    const example = examples[index];
    if (!example) return;
    setActiveExample(index);
    createEditor(example.code);
    render(example.code);
  }

  async function decodeShare(value: string): Promise<string | null> {
    if (value.startsWith("~m")) {
      try {
        return await decompressMarkdyFromUrlHash(value);
      } catch {
        return null;
      }
    }
    try {
      return decodeURIComponent(atob(value));
    } catch {
      return null;
    }
  }

  async function readClipboard(): Promise<string | null> {
    try {
      if (navigator.clipboard && navigator.clipboard.readText) {
        return await navigator.clipboard.readText();
      }
    } catch {
      // Browser permission denial or security restriction
    }
    return null;
  }

  async function writeClipboard(text: string, button: HTMLButtonElement, label: string) {
    try {
      await navigator.clipboard.writeText(text);
      const old = button.textContent;
      button.textContent = label;
      setTimeout(() => { button.textContent = old; }, 1800);
    } catch {
      const old = button.textContent;
      button.textContent = "Failed";
      button.title = "Copy failed - select and copy manually";
      setTimeout(() => { button.textContent = old; }, 1800);
    }
  }

  function showButtonStatus(button: HTMLButtonElement, label: string) {
    const old = button.textContent;
    button.textContent = label;
    setTimeout(() => { button.textContent = old; }, 1800);
  }

  async function pasteCodeToEditor(button: HTMLButtonElement) {
    let text = await readClipboard();
    if (text === null) {
      const fallback = prompt("Paste your MarkdyScript code below:");
      if (fallback === null) return;
      text = fallback;
    }

    const trimmed = text.trim();
    if (!trimmed) {
      const old = button.textContent;
      button.textContent = "Empty!";
      setTimeout(() => { button.textContent = old; }, 1800);
      return;
    }

    if (editor) {
      editor.dispatch({
        changes: { from: 0, to: editor.state.doc.length, insert: text },
        selection: { anchor: text.length },
      });
      editor.focus();
    } else {
      createEditor(text);
    }
    setActiveExample(-1);
    if (debounce) {
      clearTimeout(debounce);
      debounce = null;
    }
    render(text);
    updateEntitiesAndSuggestions(text);

    const old = button.textContent;
    button.textContent = "Pasted!";
    setTimeout(() => { button.textContent = old; }, 1800);
  }

  formatCodeBtn?.addEventListener("click", () => {
    const raw = getCode();
    const formatted = formatMarkdyScript(raw);
    if (editor) {
      editor.dispatch({
        changes: { from: 0, to: editor.state.doc.length, insert: formatted },
      });
      render(formatted);
      writeClipboard("", formatCodeBtn, "✓ Cleaned");
    }
  });

  const SPLIT_STORAGE_KEY = "markdy_workspace_split";

  function setWorkspaceSplit(percent: number) {
    const next = Math.min(80, Math.max(20, percent));
    workspace?.style.setProperty("--editor-pane", `${next}%`);
    splitter?.setAttribute("aria-valuenow", String(Math.round(next)));
    try {
      localStorage.setItem(SPLIT_STORAGE_KEY, String(next));
    } catch {}
  }

  function setWorkspaceSplitFromClientX(clientX: number) {
    if (!workspace) return;
    const rect = workspace.getBoundingClientRect();
    if (rect.width <= 0) return;
    setWorkspaceSplit(((clientX - rect.left) / rect.width) * 100);
  }

  // AI Prompt Builder for LLMs
  generateAiPromptBtn?.addEventListener("click", () => {
    const promptText = aiUserPrompt?.value.trim() || "Add missing architectural layers and improve diagram animation";
    const currentCode = getCode();
    const fullPrompt = `Please follow the authoritative MarkdyScript specification at https://markdy.com/AGENT.md to modify/extend this architecture diagram.

User Goal: ${promptText}

Current MarkdyScript Code:
\`\`\`markdy
${currentCode}
\`\`\`

Requirements:
1. Follow https://markdy.com/AGENT.md syntax strictly.
2. Use valid architecture node kinds (service, client, gateway, database, cache, queue, worker, storage, cdn, firewall, lambda, pod, user).
3. Use canonical flow operators (-> for sync requests, <- for responses, ~> for async events, <-> for two-way, ..> for weak dependencies).
4. Organize flows into clear beats with cues (show $nodes, glow, pulse, frame).
5. Output the complete, self-contained .markdy scene.`;

    writeClipboard(fullPrompt, generateAiPromptBtn, "✓ Prompt Copied!");
  });

  const ALIAS_MAP: Record<string, string[]> = {
    k8s: ["kubernetes", "cluster", "platform"],
    kube: ["kubernetes"],
    auth: ["oauth", "oidc", "security", "login", "zero-trust"],
    sql: ["database", "postgres", "aurora"],
    db: ["database", "postgres", "redis"],
    async: ["queue", "kafka", "fan-out", "event"],
    cicd: ["ci/cd", "pipeline", "delivery"],
    pipeline: ["ci/cd", "youtube", "medallion", "lakehouse"],
    stream: ["kafka", "queue", "flywheel"],
  };

  const CATEGORY_TAG_MAP: Record<string, string[]> = {
    all: [],
    architecture: ["architecture", "tiered-platform", "system", "product"],
    microservices: ["microservice", "cache-aside", "fan-out", "service", "api", "auth", "event", "gateway"],
    "data pipelines": ["pipeline", "medallion", "lakehouse", "stream", "data", "processing", "kafka"],
    "cloud & infra": ["cloud", "infra", "k8s", "kubernetes", "platform", "cluster", "aws", "docker", "vpc"],
    "state & algorithms": ["state", "algorithm", "tree", "chart", "flywheel", "quadrant", "constellation", "gantt", "radar", "venn"],
  };

  // Gallery Search and Category Filter
  function filterGallery() {
    const rawQuery = exampleSearch?.value.toLowerCase().trim() || "";
    const activeCat = document.querySelector<HTMLButtonElement>(".gallery-filter-chip.active")?.dataset.cat?.toLowerCase() || "all";

    const expandedTerms = [rawQuery];
    if (ALIAS_MAP[rawQuery]) {
      expandedTerms.push(...ALIAS_MAP[rawQuery]);
    }

    exampleBtns.forEach((btn) => {
      const title = (btn.dataset.title || "").toLowerCase();
      const cat = (btn.dataset.cat || "").toLowerCase();
      const pattern = (btn.dataset.pattern || "").toLowerCase();
      const code = (btn.dataset.code || "").toLowerCase();

      const haystack = `${title} ${cat} ${pattern} ${code}`;
      const matchesQuery = rawQuery === "" || expandedTerms.some(term => haystack.includes(term));
      const tags = CATEGORY_TAG_MAP[activeCat];
      const matchesCat = activeCat === "all" || (tags && tags.length > 0 ? tags.some(tag => haystack.includes(tag)) : cat.includes(activeCat) || pattern.includes(activeCat));
      (btn as HTMLElement).style.display = matchesQuery && matchesCat ? "flex" : "none";
    });
  }

  exampleSearch?.addEventListener("input", filterGallery);
  filterChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      filterChips.forEach(c => c.classList.toggle("active", c === chip));
      filterGallery();
    });
  });

  // Cheatsheet modal & Gallery button
  openCheatsheetBtn?.addEventListener("click", () => cheatsheetModal?.showModal());
  closeCheatsheetBtn?.addEventListener("click", () => cheatsheetModal?.close());
  cheatsheetModal?.addEventListener("click", (e) => {
    if (e.target === cheatsheetModal) cheatsheetModal.close();
  });

  openGalleryBtn?.addEventListener("click", () => {
    const section = document.getElementById("resource-strip");
    if (section) {
      section.scrollIntoView({ behavior: "smooth", block: "start" });
      exampleSearch?.focus();
    }
  });

  // Ingestion sample templates
  const SAMPLES: Record<string, string> = {
    mermaid: `flowchart LR\n  Client[Web Client] --> Gateway[Kong API Gateway]\n  Gateway --> OrdersSvc[Orders Microservice]\n  OrdersSvc --> OrdersDB[(PostgreSQL 16)]\n  OrdersSvc --> Cache[(Redis Cluster)]`,
    compose: `services:\n  web:\n    image: nginx:alpine\n    ports: ["80:80"]\n    depends_on: ["api"]\n  api:\n    image: node:20\n    depends_on: ["db", "cache"]\n  db:\n    image: postgres:16\n  cache:\n    image: redis:7`,
    k8s: `apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: payment-service\n  namespace: fintech\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: payment-svc\n  namespace: fintech\n---\napiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: payment-ingress\n  namespace: fintech`,
    terraform: `{\n  "version": 4,\n  "resources": [\n    {\n      "type": "aws_lb",\n      "name": "public_alb",\n      "instances": [{ "attributes": { "name": "prod-alb", "vpc_id": "vpc_prod" } }]\n    },\n    {\n      "type": "aws_rds_cluster",\n      "name": "aurora_postgres",\n      "instances": [{ "attributes": { "name": "prod-db", "vpc_id": "vpc_prod" } }]\n    }\n  ]\n}`,
    drawio: `<mxGraphModel>\n  <root>\n    <mxCell id="0"/>\n    <mxCell id="1" parent="0"/>\n    <mxCell id="2" value="Web Client" vertex="1" parent="1"/>\n    <mxCell id="3" value="API Gateway" style="shape=hexagon;" vertex="1" parent="1"/>\n    <mxCell id="4" value="PostgreSQL" style="shape=cylinder;" vertex="1" parent="1"/>\n    <mxCell id="5" value="HTTPS Request" edge="1" source="2" target="3" parent="1"/>\n    <mxCell id="6" value="SQL Query" edge="1" source="3" target="4" parent="1"/>\n  </root>\n</mxGraphModel>`,
  };

  importBtn?.addEventListener("click", () => {
    if (importError) importError.hidden = true;
    importModal?.showModal();
    if (importSource) importSource.value = SAMPLES[activeImportFormat] ?? "";
  });

  closeModalBtn?.addEventListener("click", () => importModal?.close());
  importModal?.addEventListener("click", (e) => {
    if (e.target === importModal) importModal?.close();
  });

  loadSampleBtn?.addEventListener("click", () => {
    if (importSource) importSource.value = SAMPLES[activeImportFormat] ?? "";
  });

  pasteImportBtn?.addEventListener("click", async () => {
    let text = await readClipboard();
    if (text === null) {
      const fallback = prompt("Paste architecture source code here:");
      if (fallback === null) return;
      text = fallback;
    }
    if (text.trim() && importSource) {
      importSource.value = text;
      const old = pasteImportBtn.textContent;
      pasteImportBtn.textContent = "Pasted!";
      setTimeout(() => { pasteImportBtn.textContent = old; }, 1800);
    }
  });

  formatTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      formatTabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      activeImportFormat = tab.dataset.format ?? "mermaid";
      if (importSource) importSource.value = SAMPLES[activeImportFormat] ?? "";
    });
  });

  doImportBtn?.addEventListener("click", async () => {
    const src = importSource?.value?.trim() || "";
    if (!src) return;
    try {
      let markdyCode = "";
      if (activeImportFormat === "mermaid") {
        const res = transpileMermaidToMarkdy(src);
        markdyCode = typeof res === "string" ? res : res.code;
      } else if (activeImportFormat === "compose") {
        markdyCode = transpileDockerComposeToMarkdy(src);
      } else if (activeImportFormat === "k8s") {
        markdyCode = transpileKubernetesManifestsToMarkdy(src);
      } else if (activeImportFormat === "terraform") {
        markdyCode = transpileTerraformStateToMarkdy(src);
      } else if (activeImportFormat === "drawio") {
        const res = await transpileDrawioToMarkdy(src);
        markdyCode = typeof res === "string" ? res : res.code;
      } else {
        throw new Error(`Unknown format: ${activeImportFormat}`);
      }

      importModal?.close();
      createEditor(markdyCode);
      render(markdyCode);
      setActiveExample(-1);
    } catch (err) {
      if (importError) {
        importError.hidden = false;
        importError.textContent = `Transpilation error: ${(err as Error).message}`;
      }
    }
  });

  // Architecture Governance Audit
  auditBtn?.addEventListener("click", () => {
    try {
      const code = getCode();
      const ast = parse(code);
      const violations = validateArchitecture(ast);
      const errorCount = violations.filter(v => v.severity === "error").length;
      const warnCount = violations.filter(v => v.severity === "warning").length;

      let html = `
        <div class="audit-summary">
          <div class="audit-badge ${errorCount === 0 ? 'badge-pass' : 'badge-fail'}">
            ${errorCount === 0 ? '✓ GOVERNANCE PASS' : `✗ ${errorCount} BLOCKING ISSUES`}
          </div>
          <span class="audit-passrate">${errorCount} error${errorCount === 1 ? '' : 's'}, ${warnCount} warning${warnCount === 1 ? '' : 's'}</span>
        </div>
      `;

      if (violations.length === 0) {
        html += `<p class="audit-clean">✓ Architecture adheres to all cloud well-architected guardrails.</p>`;
      } else {
        html += `<ul class="audit-issues-list">`;
        for (const issue of violations) {
          const isErr = issue.severity === "error";
          html += `
            <li class="audit-issue ${isErr ? 'issue-err' : 'issue-warn'}">
              <span class="issue-badge">${issue.severity.toUpperCase()}</span>
              <div class="issue-body">
                <strong>${issue.ruleName} (line ${issue.line ?? 1})</strong>
                <p>${issue.message}</p>
              </div>
            </li>
          `;
        }
        html += `</ul>`;
      }
      if (auditResults) auditResults.innerHTML = html;

      // Expand drawer & switch to diagnostics tab
      if (assistantDrawer && !assistantDrawer.classList.contains("expanded")) {
        assistantDrawer.classList.add("expanded");
        const icon = drawerToggleBtn?.querySelector(".drawer-toggle-icon");
        if (icon) icon.textContent = "▼";
      }
      assistantTabs.forEach(t => t.classList.toggle("active", t.dataset.tab === "diagnostics"));
      document.querySelectorAll(".assistant-panel").forEach(p => {
        p.classList.toggle("active", p.id === "tab-panel-diagnostics");
      });
    } catch (err) {
      alert("Audit error: " + (err as Error).message);
    }
  });


  runBtn?.addEventListener("click", () => render(getCode()));
  resetBtn?.addEventListener("click", () => loadExample(selectedExample >= 0 ? selectedExample : 0));
  pasteCodeBtn?.addEventListener("click", () => pasteCodeToEditor(pasteCodeBtn));
  copyCodeBtn?.addEventListener("click", () => {
    if (copyCodeBtn) writeClipboard(getCode(), copyCodeBtn, "Copied");
  });

  themeToggle?.addEventListener("click", () => {
    const next = isDarkMode() ? "light" : "dark";
    const code = getCode();
    applyTheme(next);
    createEditor(code);
    render(code);
  });

  liveDirectorBtn?.addEventListener("click", async () => {
    if (!stagePane) return;
    try {
      if (document.fullscreenElement) {
        await document.exitFullscreen();
        stagePane.classList.remove("director-theatre-active");
      } else {
        await stagePane.requestFullscreen();
        stagePane.classList.add("director-theatre-active");
        if (diagram) {
          diagram.seek(0);
          diagram.play();
        }
      }
    } catch {
      stagePane.classList.toggle("director-theatre-active");
      if (diagram) {
        diagram.seek(0);
        diagram.play();
      }
    }
  });

  document.addEventListener("fullscreenchange", () => {
    if (!document.fullscreenElement && stagePane) {
      stagePane.classList.remove("director-theatre-active");
    }
  });

  // Drag splitter with Pointer Events API
  let draggingSplitter = false;
  splitter?.addEventListener("pointerdown", (event) => {
    if (event.button !== 0) return;
    draggingSplitter = true;
    splitter.setPointerCapture(event.pointerId);
    splitter.classList.add("dragging");
    document.body.classList.add("is-resizing-workspace");
    event.preventDefault();
  });

  splitter?.addEventListener("pointermove", (event) => {
    if (!draggingSplitter) return;
    setWorkspaceSplitFromClientX(event.clientX);
  });

  const stopDraggingSplitter = (event: PointerEvent) => {
    if (!draggingSplitter) return;
    draggingSplitter = false;
    splitter?.classList.remove("dragging");
    document.body.classList.remove("is-resizing-workspace");
    if (splitter?.hasPointerCapture(event.pointerId)) {
      splitter.releasePointerCapture(event.pointerId);
    }
  };

  splitter?.addEventListener("pointerup", stopDraggingSplitter);
  splitter?.addEventListener("pointercancel", stopDraggingSplitter);

  splitter?.addEventListener("dblclick", () => setWorkspaceSplit(50));

  splitter?.addEventListener("keydown", (event) => {
    const raw = workspace?.style.getPropertyValue("--editor-pane") || "50";
    const current = parseFloat(raw.replace("%", "")) || 50;
    if (event.key === "ArrowLeft") {
      event.preventDefault();
      setWorkspaceSplit(current - 2);
    } else if (event.key === "ArrowRight") {
      event.preventDefault();
      setWorkspaceSplit(current + 2);
    } else if (event.key === "Home") {
      event.preventDefault();
      setWorkspaceSplit(25);
    } else if (event.key === "End") {
      event.preventDefault();
      setWorkspaceSplit(75);
    } else if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      setWorkspaceSplit(50);
    }
  });

  // Initialize
  const params = new URLSearchParams(window.location.hash.slice(1));
  const sharedCodeParam = params.get("code");

  (async () => {
    let initialIndex = examples.length > 0 ? Math.floor(Math.random() * examples.length) : 0;
    let initialCode = examples[initialIndex]?.code || "";
    if (sharedCodeParam) {
      const decoded = await decodeShare(sharedCodeParam);
      if (decoded) {
        initialCode = decoded;
        initialIndex = -1;
      }
    }

    const savedTheme = localStorage.getItem(STORAGE_KEY);
    applyTheme(
      savedTheme === "dark" || savedTheme === "light"
        ? savedTheme
        : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light",
    );

    try {
      const savedSplit = localStorage.getItem(SPLIT_STORAGE_KEY);
      if (savedSplit) {
        const parsed = parseFloat(savedSplit);
        if (!isNaN(parsed) && parsed >= 20 && parsed <= 80) {
          setWorkspaceSplit(parsed);
        }
      }
    } catch {}

    createEditor(initialCode);
    render(initialCode);
    setActiveExample(initialIndex);
  })();

  exampleBtns.forEach((btn) => {
    btn.addEventListener("click", () => loadExample(Number(btn.dataset.index ?? "0")));
  });

  document.querySelectorAll<HTMLButtonElement>(".snippet-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const snippet = btn.dataset.snippet;
      if (snippet) insertCodeAtCursor(`\n${snippet}\n`);
    });
  });

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key === "Enter") {
      event.preventDefault();
      render(getCode());
    } else if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "s") {
      event.preventDefault();
      formatCodeBtn?.click();
    } else if (event.key === " " && document.activeElement !== editorHost && !(document.activeElement instanceof HTMLInputElement) && !(document.activeElement instanceof HTMLTextAreaElement) && !editor?.hasFocus) {
      event.preventDefault();
      if (diagram?.isPlaying()) diagram.pause();
      else diagram?.play();
    } else if (event.key === "Escape") {
      deselectCanvas();
      importModal?.close();
      cheatsheetModal?.close();
      if (stagePane?.classList.contains("director-theatre-active")) {
        if (document.fullscreenElement) {
          document.exitFullscreen().catch(() => {});
        }
        stagePane.classList.remove("director-theatre-active");
      }
    }
  });
</script>

