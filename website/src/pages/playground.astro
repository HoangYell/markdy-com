---
import Layout from "../layouts/Layout.astro";
import { join } from "node:path";
import { loadExamples } from "../data/examples";

const ROOT = join(process.cwd(), "..");
const EXAMPLES = await loadExamples(ROOT);

const TOKEN_LIBRARIES = {
  nodes: [
    { kind: "service", icon: "⚙️", label: "Service", template: 'service ApiSvc "API Gateway Service"\n' },
    { kind: "client", icon: "💻", label: "Client", template: 'client WebApp "Web Application"\n' },
    { kind: "browser", icon: "🌐", label: "Browser", template: 'browser Chrome "End-User Browser"\n' },
    { kind: "mobile", icon: "📱", label: "Mobile", template: 'mobile App "iOS / Android Client"\n' },
    { kind: "gateway", icon: "🚪", label: "Gateway", template: 'gateway APIGw "Kong / Envoy Gateway"\n' },
    { kind: "database", icon: "🗄️", label: "Database", template: 'database Postgres "PostgreSQL 16"\n' },
    { kind: "cache", icon: "⚡", label: "Cache", template: 'cache Redis "Redis Cluster"\n' },
    { kind: "queue", icon: "📬", label: "Queue", template: 'queue Kafka "Kafka Stream"\n' },
    { kind: "worker", icon: "👷", label: "Worker", template: 'worker AsyncWorker "Background Worker"\n' },
    { kind: "storage", icon: "📦", label: "Storage", template: 'storage S3Bucket "S3 Asset Storage"\n' },
    { kind: "cdn", icon: "🌍", label: "CDN", template: 'cdn Cloudflare "Cloudflare Edge"\n' },
    { kind: "firewall", icon: "🛡️", label: "Firewall", template: 'firewall WAF "WAF Perimeter"\n' },
    { kind: "user", icon: "👤", label: "User", template: 'user Customer "End User"\n' },
    { kind: "lambda", icon: "λ", label: "Lambda", template: 'lambda SlsFunc "Serverless Function"\n' },
    { kind: "pod", icon: "📦", label: "Pod", template: 'pod AppPod "Kubernetes Pod"\n' },
  ],
  flows: [
    { op: "->", label: "Sync (->)", template: 'Client -> Gateway "POST /checkout"\n', desc: "Synchronous HTTP/gRPC request" },
    { op: "<-", label: "Response (<-)", template: 'Client <- Gateway "200 OK JSON"\n', desc: "Synchronous return response" },
    { op: "~>", label: "Async (~>)", template: 'Gateway ~> Queue "order.created"\n', desc: "Asynchronous pub/sub event" },
    { op: "<->", label: "Two-Way (<->)", template: 'WebApp <-> Gateway "WebSocket / mTLS"\n', desc: "Bidirectional streaming socket" },
    { op: "..>", label: "Weak (..>)", template: 'Service ..> Database "depends on"\n', desc: "Dashed / weak dependency line" },
  ],
  layouts: [
    { name: "layout LR", label: "layout LR", template: "layout LR\n", desc: "Left-to-right horizontal flow" },
    { name: "layout TB", label: "layout TB", template: "layout TB\n", desc: "Top-to-bottom vertical hierarchy" },
    { name: "type=nested", label: "type=nested", template: "type=nested\n", desc: "Subsystem boundary perimeters" },
    { name: "type=gantt", label: "type=gantt", template: "type=gantt\n", desc: "Timeline & roadmap phases" },
    { name: "type=medallion", label: "type=medallion", template: "type=medallion\n", desc: "Bronze → Silver → Gold data stages" },
    { name: "type=flywheel", label: "type=flywheel", template: "type=flywheel\n", desc: "Compounding circular growth loop" },
    { name: "type=constellation", label: "type=constellation", template: "type=constellation\n", desc: "Radial cluster around leader node" },
    { name: "type=quadrant", label: "type=quadrant", template: "type=quadrant\n", desc: "2x2 strategic priority matrix" },
  ],
  themes: [
    { name: "paper", label: "theme=paper", template: "theme=paper\n" },
    { name: "editorial", label: "theme=editorial", template: "theme=editorial\n" },
    { name: "terminal", label: "theme=terminal", template: "theme=terminal\n" },
    { name: "sketchy", label: "theme=sketchy", template: "theme=sketchy\n" },
    { name: "blueprint", label: "theme=blueprint", template: "theme=blueprint\n" },
    { name: "midnight", label: "theme=midnight", template: "theme=midnight\n" },
    { name: "graphite", label: "theme=graphite", template: "theme=graphite\n" },
    { name: "nebula", label: "theme=nebula", template: "theme=nebula\n" },
  ],
  beats: [
    { label: "Reveal All Nodes", template: 'beat reveal "System Entrance":\n  show $nodes stagger=60ms\n', desc: "Choreographed entrance" },
    { label: "Subsystem Frame", template: 'beat inspect "Inspect Subsystem":\n  frame myGroup zoom=1.2 dur=600ms\n', desc: "Camera zoom focus" },
    { label: "Pulse Glow", template: 'beat highlight "Alert State":\n  pulse NodeA color=#38bdf8\n', desc: "Glowing pulse effect" },
    { label: "Group Boundary", template: 'group cluster "Secure VPC": NodeA NodeB DB\n', desc: "Perimeter enclosure" },
  ],
};

const PLAY_SNIPPETS = [
  {
    label: "Reveal All Nodes",
    code: `beat reveal "Reveal the system":\n  show $nodes stagger=60ms`,
  },
  {
    label: "Frame Subsystem Group",
    code: `beat inspect "Inspect backend":\n  frame backend zoom=1.18 dur=600ms`,
  },
  {
    label: "Request & Response Flow",
    code: `beat request "Trace request":\n  Client -> API "GET /items"\n  Client <- API "200 OK"`,
  },
  {
    label: "Async Event & Glow",
    code: `beat event "Async job":\n  API ~> Queue "order.created"\n  glow Queue color=#38bdf8`,
  },
  {
    label: "OSI Stack (type=layers)",
    code: `service L7 "Application Layer"\nservice L4 "Transport Layer"\nservice L3 "Network Layer"\n\nbeat stack:\n  show $nodes stagger=50ms\n  L7 -> L4 -> L3`,
  },
  {
    label: "Perimeter (type=nested)",
    code: `group dmz: IngressGateway\ngroup secure: AuthPod VaultDB\n\nbeat route:\n  show dmz & show secure\n  IngressGateway -> AuthPod "mTLS"`,
  },
];

const CATEGORIES = ["All", "Architecture", "Microservices", "Data Pipelines", "Cloud & Infra", "State & Algorithms"];

const playgroundStructuredData = [
  {
    "@type": "WebPage",
    "@id": "https://markdy.com/playground/#webpage",
    url: "https://markdy.com/playground/",
    name: "Markdy Playground",
    description: "A spacious browser playground for writing, testing, learning, and sharing MarkdyScript animated architecture diagrams.",
    isPartOf: { "@id": "https://markdy.com/#website" },
    about: { "@id": "https://markdy.com/#software" },
  },
];
---

<Layout
  title="Markdy Playground — Interactive Architecture Studio & Diagram As Code"
  description="Author, test, inspect, and export animated architecture diagrams. Built-in token library, AST inspector, AI prompt assistant, governance linter, and vector SVG/PNG export."
  canonicalURL="https://markdy.com/playground/"
  keywords="Markdy playground, architecture studio, diagram as code playground, mermaid alternative, animated architecture diagram, system design editor"
  structuredData={playgroundStructuredData}
>
  <main class="playground-page">
    <nav class="topbar" aria-label="Playground navigation">
      <a class="brand" href="/" aria-label="Markdy home">
        <span>🎬</span>
        <strong>markdy studio</strong>
      </a>
      <div class="topbar-links">
        <div class="view-mode-group" role="group" aria-label="Studio layout mode">
          <button id="view-split-btn" class="view-mode-btn active" type="button" data-mode="split" title="Split Screen (Code + Canvas)">⚡ Split</button>
          <button id="view-canvas-btn" class="view-mode-btn" type="button" data-mode="canvas" title="Canvas Visual Studio">🎨 Canvas</button>
          <button id="view-code-btn" class="view-mode-btn" type="button" data-mode="code" title="Code Only Editor">📝 Code</button>
        </div>
        <button id="open-cheatsheet-btn" class="topbar-chip" type="button" title="Syntax cheatsheet & keyboard shortcuts">⌨️ Shortcuts</button>
        <a href="/docs/">Docs</a>
        <a href="https://github.com/HoangYell/markdy-com" target="_blank" rel="noopener noreferrer">GitHub</a>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">Theme</button>
      </div>
    </nav>

    <!-- ── Interactive Workspace (Editor + Splitter + Preview) ── -->
    <section id="workspace" class="workspace" aria-label="MarkdyScript playground workspace">
      
      <!-- ── Left Column: Editor & Authoring Tools ── -->
      <section class="editor-panel" aria-label="Code editor">
        <div class="panel-head">
          <div class="panel-head-left">
            <div>
              <span class="panel-kicker">Editor</span>
              <h2>MarkdyScript</h2>
            </div>
            <select id="quick-example-select" class="tool-select" aria-label="Load Showcase Example">
              {EXAMPLES.map((ex, i) => (
                <option value={i}>{ex.title} ({ex.pattern ?? ex.category})</option>
              ))}
            </select>
          </div>
          <div class="toolbar">
            <button id="import-btn" class="tool-btn" type="button" title="Import from Mermaid, Docker Compose, Kubernetes, Terraform, Draw.io">Import</button>
            <button id="audit-btn" class="tool-btn" type="button" title="Run Architecture Governance Audit">Audit</button>
            <button id="copy-code-btn" class="tool-btn" type="button">Copy</button>
            <button id="reset-btn" class="tool-btn" type="button">Reset</button>
            <button id="run-btn" class="tool-btn tool-btn-primary" type="button">Run ▶</button>
          </div>
        </div>

        <!-- ── Token Library Quick Insert Bar ── -->
        <div class="token-library-bar" aria-label="Token and Syntax Library">
          <div class="token-group">
            <span class="token-group-label">Nodes:</span>
            <div class="token-chips">
              {TOKEN_LIBRARIES.nodes.map((n) => (
                <button class="token-chip" type="button" draggable="true" data-kind={n.kind} data-insert={n.template} title={`Drag to canvas or click to insert ${n.kind}: ${n.desc}`}>
                  <span>{n.icon}</span>
                  <code>{n.kind}</code>
                </button>
              ))}
            </div>
          </div>
          <div class="token-group">
            <span class="token-group-label">Flows:</span>
            <div class="token-chips">
              {TOKEN_LIBRARIES.flows.map((f) => (
                <button class="token-chip" type="button" data-insert={f.template} title={f.desc}>
                  <code>{f.op}</code>
                </button>
              ))}
            </div>
          </div>
          <div class="token-group">
            <span class="token-group-label">Presets:</span>
            <div class="token-chips">
              {TOKEN_LIBRARIES.layouts.slice(0, 4).map((l) => (
                <button class="token-chip" type="button" data-insert={l.template} title={l.desc}>
                  <code>{l.name}</code>
                </button>
              ))}
              {TOKEN_LIBRARIES.beats.slice(0, 2).map((b) => (
                <button class="token-chip" type="button" data-insert={b.template} title={b.desc}>
                  <span>🎬</span>
                  <code>{b.label}</code>
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- ── CodeMirror Editor Container ── -->
        <div id="code-editor" class="code-editor" aria-label="MarkdyScript editor"></div>
        <p class="hint">Auto-runs live after typing · Cmd/Ctrl+Enter to compile · Drag splitter to resize</p>

        <!-- ── Editor Assistant & Entity Inspector Drawer ── -->
        <div class="assistant-drawer" aria-label="Assistant and Inspector">
          <div class="assistant-tabs" role="tablist">
            <button class="assistant-tab active" type="button" data-tab="nodes">
              <span>📦 Entities</span>
              <span id="nodes-count-badge" class="tab-badge">0</span>
            </button>
            <button class="assistant-tab" type="button" data-tab="suggestions">
              <span>💡 Health &amp; Suggestions</span>
              <span id="sugg-count-badge" class="tab-badge">0</span>
            </button>
            <button class="assistant-tab" type="button" data-tab="ai">
              <span>🤖 AI Prompt Builder</span>
            </button>
            <button class="assistant-tab" type="button" data-tab="diagnostics">
              <span>🛡️ Diagnostics &amp; Lint</span>
            </button>
          </div>

          <!-- Tab 1: Entities List -->
          <div id="tab-panel-nodes" class="assistant-panel active">
            <div class="entities-head">
              <span class="entities-summary" id="entities-summary">Parsed Nodes &amp; Connections in Scene</span>
              <button id="quick-add-node-btn" class="tool-btn-sm" type="button">+ Add Service</button>
            </div>
            <div id="nodes-inspector-grid" class="nodes-inspector-grid"></div>
          </div>

          <!-- Tab 2: Suggestions & Health -->
          <div id="tab-panel-suggestions" class="assistant-panel">
            <div class="suggestions-container" id="suggestions-container"></div>
          </div>

          <!-- Tab 3: AI Prompt Generator -->
          <div id="tab-panel-ai" class="assistant-panel">
            <div class="ai-builder-box">
              <label for="ai-user-prompt">Describe architectural changes or system additions:</label>
              <div class="ai-input-row">
                <input id="ai-user-prompt" type="text" placeholder="e.g., Add a Kafka message queue between Ingress and OrderWorker..." />
                <button id="generate-ai-prompt-btn" class="tool-btn tool-btn-primary" type="button">Copy Prompt for LLM</button>
              </div>
              <p class="ai-builder-hint">Generates an optimized prompt containing current AST and Markdy syntax conventions ready to paste into Claude, Cursor, or ChatGPT.</p>
            </div>
          </div>

          <!-- Tab 4: Diagnostics & Governance -->
          <div id="tab-panel-diagnostics" class="assistant-panel">
            <div id="diagnostics" class="diagnostics" aria-live="polite"></div>
            <div id="audit-results" class="audit-results"></div>
          </div>
        </div>
      </section>

      <!-- ── Draggable Splitter ── -->
      <button
        id="splitter"
        class="splitter"
        type="button"
        role="separator"
        aria-label="Resize editor and preview panes"
        aria-orientation="vertical"
        aria-valuemin="30"
        aria-valuemax="70"
        aria-valuenow="50"
        title="Drag to resize. Double-click to reset."
      >
        <span></span>
      </button>

      <!-- ── Right Column: Embedded Preview Panel ── -->
      <section class="preview-panel" aria-label="Animated preview">
        <div class="panel-head">
          <div>
            <span class="panel-kicker"><span id="status-dot" class="status-dot status-ok"></span>Preview</span>
            <h2>Animated diagram</h2>
          </div>
          <div class="toolbar">
            <button id="export-svg-btn" class="tool-btn" type="button" title="Export clean Vector SVG">SVG</button>
            <button id="export-png-btn" class="tool-btn" type="button" title="Export 2x Retina PNG">PNG</button>
            <button id="share-btn" class="tool-btn" type="button">Share</button>
            <button id="restart-btn" class="tool-btn" type="button">Restart</button>
            <button id="play-btn" class="tool-btn tool-btn-primary" type="button">Pause</button>
          </div>
        </div>

        <div class="preview-toolbar">
          <select id="beat-jump" class="beat-jump" aria-label="Jump to beat" hidden></select>
          <div class="speed-group" role="group" aria-label="Playback speed">
            <button class="speed-btn active" type="button" data-speed="1" aria-pressed="true">1x</button>
            <button class="speed-btn" type="button" data-speed="1.5" aria-pressed="false">1.5x</button>
            <button class="speed-btn" type="button" data-speed="2" aria-pressed="false">2x</button>
            <button class="speed-btn" type="button" data-speed="0.5" aria-pressed="false">0.5x</button>
          </div>
        </div>

        <!-- Canvas Stage with Direct Interaction Overlays -->
        <div id="stage" class="stage">
          <!-- Diagram Scene Host -->
          <div id="stage-canvas" class="stage-canvas"></div>

          <!-- Drop Zone Indicator -->
          <div id="stage-drop-overlay" class="stage-drop-overlay" hidden>
            <div class="stage-drop-hint">
              <span>✨</span>
              <strong>Drop Node onto Canvas</strong>
            </div>
          </div>

          <!-- Rubber-band Flow Connector SVG -->
          <svg id="flow-canvas-svg" class="flow-canvas-svg" hidden>
            <path id="flow-drag-path" class="flow-drag-path" d=""></path>
          </svg>

          <!-- Floating Node Contextual HUD -->
          <div id="node-floating-hud" class="node-floating-hud" hidden>
            <div class="hud-header">
              <span id="hud-node-icon" class="hud-icon">📦</span>
              <strong id="hud-node-id" class="hud-title">Node</strong>
              <button id="hud-close-btn" class="hud-btn-close" type="button" title="Close HUD">✕</button>
            </div>
            <div class="hud-row">
              <select id="hud-kind-select" class="hud-select" aria-label="Change Node Kind">
                <option value="service">Service</option>
                <option value="database">Database</option>
                <option value="cache">Cache</option>
                <option value="queue">Queue</option>
                <option value="gateway">Gateway</option>
                <option value="client">Client</option>
                <option value="browser">Browser</option>
                <option value="mobile">Mobile</option>
                <option value="worker">Worker</option>
                <option value="storage">Storage</option>
                <option value="firewall">Firewall</option>
                <option value="lambda">Lambda</option>
                <option value="pod">Pod</option>
              </select>
              <input id="hud-label-input" class="hud-input" type="text" placeholder="Node label..." />
            </div>
            <div class="hud-actions-row">
              <button id="hud-pulse-btn" class="hud-action-btn btn-hud-pulse" type="button" title="Add kinetic glow pulse">⚡ Pulse</button>
              <button id="hud-frame-btn" class="hud-action-btn btn-hud-frame" type="button" title="Add camera zoom focus">🔍 Frame</button>
              <button id="hud-delete-btn" class="hud-action-btn btn-hud-danger" type="button" title="Delete node from code">🗑️ Delete</button>
            </div>
          </div>

          <!-- Flow Popover HUD -->
          <div id="flow-popover" class="flow-popover" hidden>
            <div class="flow-popover-header">
              <span id="flow-popover-title">Connect Nodes</span>
              <button id="flow-popover-close" class="hud-btn-close" type="button">✕</button>
            </div>
            <div class="flow-popover-body">
              <div class="flow-type-chips">
                <button class="flow-type-chip active" type="button" data-op="->">➔ Sync (-&gt;)</button>
                <button class="flow-type-chip" type="button" data-op="~>">↝ Async (~&gt;)</button>
                <button class="flow-type-chip" type="button" data-op="<->">↔ Bi-dir (&lt;-&gt;)</button>
                <button class="flow-type-chip" type="button" data-op="<-">← Return (&lt;-)</button>
              </div>
              <input id="flow-label-input" class="hud-input" type="text" placeholder='Flow label (e.g. "GET /orders", "200 OK")' />
              <button id="flow-submit-btn" class="tool-btn tool-btn-primary" type="button">Connect Flow</button>
            </div>
          </div>
        </div>

        <!-- Storyboard Beats Ribbon -->
        <div class="storyboard-ribbon" aria-label="Storyboard Beats">
          <div class="storyboard-header">
            <span class="storyboard-title">🎬 Storyboard Beats</span>
            <button id="storyboard-add-beat-btn" class="tool-btn-sm" type="button">+ Add Beat</button>
          </div>
          <div id="storyboard-track" class="storyboard-track">
            <!-- Dynamically populated with parsed beats -->
          </div>
        </div>

        <div class="timeline">
          <input id="timeline-range" type="range" min="0" max="0" step="0.01" value="0" aria-label="Scrub timeline" />
          <span id="timeline-label">0:00 / 0:00</span>
        </div>
      </section>
    </section>

    <!-- ── Showcase Library & Learning Strip (Below Workspace) ── -->
    <section class="resource-strip" aria-label="Examples and learning helpers">
      
      <!-- Showcase Gallery -->
      <section class="card examples-card">
        <div class="panel-title">
          <span>Showcase Examples Gallery (29 Systems)</span>
          <a id="example-source-link" href={EXAMPLES[0].sourceUrl} target="_blank" rel="noopener noreferrer">View source ↗</a>
        </div>
        
        <!-- Live search and category filters -->
        <div class="gallery-controls">
          <input id="example-search" class="gallery-search-input" type="text" placeholder="Search architecture models (e.g. k8s, kafka, redis, oauth)..." />
          <div class="gallery-filter-chips">
            {CATEGORIES.map((cat, i) => (
              <button class={`gallery-filter-chip ${i === 0 ? 'active' : ''}`} type="button" data-cat={cat}>{cat}</button>
            ))}
          </div>
        </div>

        <div id="example-list" class="example-list">
          {EXAMPLES.map((ex, i) => (
            <button
              class="example-btn"
              type="button"
              data-index={i}
              data-title={ex.title.toLowerCase()}
              data-cat={(ex.category ?? "").toLowerCase()}
              data-pattern={(ex.pattern ?? "").toLowerCase()}
              data-code={ex.code.slice(0, 300).toLowerCase()}
            >
              <strong>{ex.title}</strong>
              <span>{ex.pattern ?? ex.category}</span>
            </button>
          ))}
        </div>
      </section>

      <!-- Pattern templates insertion -->
      <section class="card learn-card">
        <div class="panel-title">
          <span>Learn by Inserting Patterns</span>
        </div>
        <p>Click any pattern to append directly into the editor:</p>
        <div class="snippet-list">
          {PLAY_SNIPPETS.map((snippet) => (
            <button class="snippet-btn" type="button" data-snippet={snippet.code}>{snippet.label}</button>
          ))}
        </div>
      </section>

      <!-- Fast feedback checklist -->
      <section class="card checklist">
        <div class="panel-title">
          <span>Fast Feedback Loop</span>
        </div>
        <ol>
          <li>Declare semantic nodes (<code>service</code>, <code>database</code>, <code>cache</code>).</li>
          <li>Connect relationships with <code>-&gt;</code> (sync) or <code>~&gt;</code> (async).</li>
          <li>Choreograph steps inside <code>beat</code> blocks.</li>
          <li>Use <code>frame</code> to direct camera attention to subsystems.</li>
        </ol>
      </section>
    </section>

    <!-- ── Universal Ingestion Modal ── -->
    <dialog id="import-modal" class="import-modal" aria-labelledby="import-modal-title">
      <div class="modal-backdrop"></div>
      <div class="modal-box">
        <div class="modal-header">
          <div>
            <span class="panel-kicker">Universal Ingestion</span>
            <h3 id="import-modal-title">Import Existing Architecture</h3>
          </div>
          <button id="close-modal-btn" class="modal-close" type="button" aria-label="Close modal">✕</button>
        </div>
        <p class="modal-desc">Convert Mermaid diagrams, Draw.io XML graphs, Docker Compose services, Kubernetes manifests, or Terraform state files directly into animated MarkdyScript scenes.</p>

        <div class="format-tabs" role="tablist">
          <button class="format-tab active" type="button" data-format="mermaid">Mermaid</button>
          <button class="format-tab" type="button" data-format="compose">Docker Compose</button>
          <button class="format-tab" type="button" data-format="k8s">Kubernetes</button>
          <button class="format-tab" type="button" data-format="terraform">Terraform</button>
          <button class="format-tab" type="button" data-format="drawio">Draw.io</button>
        </div>

        <textarea id="import-source" class="import-textarea" placeholder="Paste source code here..."></textarea>
        <div id="import-error" class="import-error" hidden></div>

        <div class="modal-footer">
          <button id="load-sample-btn" class="tool-btn" type="button">Load Sample</button>
          <button id="do-import-btn" class="tool-btn tool-btn-primary" type="button">Transpile &amp; Open</button>
        </div>
      </div>
    </dialog>

    <!-- ── Shortcuts & Cheatsheet Modal ── -->
    <dialog id="cheatsheet-modal" class="import-modal" aria-labelledby="cheatsheet-title">
      <div class="modal-backdrop"></div>
      <div class="modal-box">
        <div class="modal-header">
          <div>
            <span class="panel-kicker">Quick Reference</span>
            <h3 id="cheatsheet-title">Keyboard Shortcuts &amp; Syntax Reference</h3>
          </div>
          <button id="close-cheatsheet-btn" class="modal-close" type="button" aria-label="Close modal">✕</button>
        </div>
        
        <div class="cheatsheet-body">
          <div class="cheatsheet-section">
            <h4>Keyboard Shortcuts</h4>
            <div class="shortcuts-grid">
              <div class="shortcut-row"><kbd>Cmd / Ctrl + Enter</kbd><span>Compile &amp; Re-run Scene</span></div>
              <div class="shortcut-row"><kbd>Ctrl + Space</kbd><span>Trigger Autocomplete</span></div>
              <div class="shortcut-row"><kbd>Space</kbd><span>Play / Pause Animation</span></div>
              <div class="shortcut-row"><kbd>Esc</kbd><span>Close Modals / Reset Selection</span></div>
            </div>
          </div>

          <div class="cheatsheet-section">
            <h4>Flow Operators</h4>
            <div class="shortcuts-grid">
              <div class="shortcut-row"><code>A -&gt; B "call"</code><span>Synchronous request</span></div>
              <div class="shortcut-row"><code>A &lt;- B "response"</code><span>Return response</span></div>
              <div class="shortcut-row"><code>A ~&gt; B "event"</code><span>Asynchronous stream</span></div>
              <div class="shortcut-row"><code>A &lt;-&gt; B "socket"</code><span>Bidirectional connection</span></div>
              <div class="shortcut-row"><code>A ..&gt; B "dep"</code><span>Weak / dashed dependency</span></div>
            </div>
          </div>
        </div>
      </div>
    </dialog>

  </main>
</Layout>

<script define:vars={{ examples: EXAMPLES }}>
  window.__MARKDY_PLAYGROUND_EXAMPLES = examples;
</script>

<script>
  import { EditorView, keymap, lineNumbers, highlightActiveLine, highlightActiveLineGutter } from "@codemirror/view";
  import { EditorState } from "@codemirror/state";
  import { bracketMatching, indentOnInput } from "@codemirror/language";
  import { defaultKeymap, history, historyKeymap, indentWithTab } from "@codemirror/commands";
  import { highlightSelectionMatches, searchKeymap } from "@codemirror/search";
  import { closeBrackets, closeBracketsKeymap } from "@codemirror/autocomplete";

  import { markdyLanguage, markdyAutocomplete, markdyHighlightLight, markdyHighlightDark } from "../editor/markdy-language";
  import { baseTheme, lightTheme, darkTheme } from "../editor/editor-theme";
  import { createDiagram, exportDiagramAsVectorSvg, exportDiagramAsPng } from "@markdy/renderer-dom";
  import type { Diagram } from "@markdy/renderer-dom";
  import {
    parse,
    validateArchitecture,
    compressMarkdyToUrlHash,
    decompressMarkdyFromUrlHash,
    type Diagnostic,
  } from "@markdy/core";
  import {
    transpileMermaidToMarkdy,
    transpileDockerComposeToMarkdy,
    transpileKubernetesManifestsToMarkdy,
    transpileTerraformStateToMarkdy,
    transpileDrawioToMarkdy,
  } from "@markdy/compat";
  import type { ExampleEntry } from "../data/examples";

  const STORAGE_KEY = "markdy-theme";
  const examples: ExampleEntry[] = (window as any).__MARKDY_PLAYGROUND_EXAMPLES;

  const editorHost = document.getElementById("code-editor") as HTMLDivElement;
  const stage = document.getElementById("stage") as HTMLDivElement;
  const stageCanvas = document.getElementById("stage-canvas") as HTMLDivElement;
  const stageDropOverlay = document.getElementById("stage-drop-overlay") as HTMLDivElement;
  const flowCanvasSvg = document.getElementById("flow-canvas-svg") as unknown as SVGSVGElement;
  const flowDragPath = document.getElementById("flow-drag-path") as unknown as SVGPathElement;
  const nodeFloatingHud = document.getElementById("node-floating-hud") as HTMLDivElement;
  const hudNodeIcon = document.getElementById("hud-node-icon") as HTMLSpanElement;
  const hudNodeId = document.getElementById("hud-node-id") as HTMLElement;
  const hudKindSelect = document.getElementById("hud-kind-select") as HTMLSelectElement;
  const hudLabelInput = document.getElementById("hud-label-input") as HTMLInputElement;
  const hudPulseBtn = document.getElementById("hud-pulse-btn") as HTMLButtonElement;
  const hudFrameBtn = document.getElementById("hud-frame-btn") as HTMLButtonElement;
  const hudDeleteBtn = document.getElementById("hud-delete-btn") as HTMLButtonElement;
  const hudCloseBtn = document.getElementById("hud-close-btn") as HTMLButtonElement;

  const flowPopover = document.getElementById("flow-popover") as HTMLDivElement;
  const flowPopoverTitle = document.getElementById("flow-popover-title") as HTMLSpanElement;
  const flowPopoverClose = document.getElementById("flow-popover-close") as HTMLButtonElement;
  const flowLabelInput = document.getElementById("flow-label-input") as HTMLInputElement;
  const flowSubmitBtn = document.getElementById("flow-submit-btn") as HTMLButtonElement;
  const flowTypeChips = document.querySelectorAll<HTMLButtonElement>(".flow-type-chip");

  const storyboardTrack = document.getElementById("storyboard-track") as HTMLDivElement;
  const storyboardAddBeatBtn = document.getElementById("storyboard-add-beat-btn") as HTMLButtonElement;
  const viewModeBtns = document.querySelectorAll<HTMLButtonElement>(".view-mode-btn");

  const diagnostics = document.getElementById("diagnostics") as HTMLDivElement;
  const auditResults = document.getElementById("audit-results") as HTMLDivElement;
  const importModal = document.getElementById("import-modal") as HTMLDialogElement;
  const importSource = document.getElementById("import-source") as HTMLTextAreaElement;
  const importError = document.getElementById("import-error") as HTMLDivElement;
  const importBtn = document.getElementById("import-btn") as HTMLButtonElement;
  const auditBtn = document.getElementById("audit-btn") as HTMLButtonElement;
  const closeModalBtn = document.getElementById("close-modal-btn") as HTMLButtonElement;
  const loadSampleBtn = document.getElementById("load-sample-btn") as HTMLButtonElement;
  const doImportBtn = document.getElementById("do-import-btn") as HTMLButtonElement;
  const exportSvgBtn = document.getElementById("export-svg-btn") as HTMLButtonElement;
  const exportPngBtn = document.getElementById("export-png-btn") as HTMLButtonElement;
  const formatTabs = document.querySelectorAll<HTMLButtonElement>(".format-tab");

  const cheatsheetModal = document.getElementById("cheatsheet-modal") as HTMLDialogElement;
  const openCheatsheetBtn = document.getElementById("open-cheatsheet-btn") as HTMLButtonElement;
  const closeCheatsheetBtn = document.getElementById("close-cheatsheet-btn") as HTMLButtonElement;

  const runBtn = document.getElementById("run-btn") as HTMLButtonElement;
  const resetBtn = document.getElementById("reset-btn") as HTMLButtonElement;
  const copyCodeBtn = document.getElementById("copy-code-btn") as HTMLButtonElement;
  const shareBtn = document.getElementById("share-btn") as HTMLButtonElement;
  const restartBtn = document.getElementById("restart-btn") as HTMLButtonElement;
  const playBtn = document.getElementById("play-btn") as HTMLButtonElement;
  const statusDot = document.getElementById("status-dot") as HTMLSpanElement;
  const timelineRange = document.getElementById("timeline-range") as HTMLInputElement;
  const timelineLabel = document.getElementById("timeline-label") as HTMLSpanElement;
  const beatJump = document.getElementById("beat-jump") as HTMLSelectElement;
  const exampleSourceLink = document.getElementById("example-source-link") as HTMLAnchorElement;
  const quickExampleSelect = document.getElementById("quick-example-select") as HTMLSelectElement;
  const exampleBtns = document.querySelectorAll<HTMLButtonElement>(".example-btn");
  const speedBtns = document.querySelectorAll<HTMLButtonElement>(".speed-btn");
  const themeToggle = document.getElementById("theme-toggle") as HTMLButtonElement;
  const workspace = document.getElementById("workspace") as HTMLElement;
  const splitter = document.getElementById("splitter") as HTMLButtonElement;

  const nodesCountBadge = document.getElementById("nodes-count-badge") as HTMLSpanElement;
  const suggCountBadge = document.getElementById("sugg-count-badge") as HTMLSpanElement;
  const nodesInspectorGrid = document.getElementById("nodes-inspector-grid") as HTMLDivElement;
  const suggestionsContainer = document.getElementById("suggestions-container") as HTMLDivElement;
  const assistantTabs = document.querySelectorAll<HTMLButtonElement>(".assistant-tab");
  const quickAddNodeBtn = document.getElementById("quick-add-node-btn") as HTMLButtonElement;

  const aiUserPrompt = document.getElementById("ai-user-prompt") as HTMLInputElement;
  const generateAiPromptBtn = document.getElementById("generate-ai-prompt-btn") as HTMLButtonElement;

  const exampleSearch = document.getElementById("example-search") as HTMLInputElement;
  const filterChips = document.querySelectorAll<HTMLButtonElement>(".gallery-filter-chip");

  let activeImportFormat = "mermaid";
  let editor: EditorView | null = null;
  let diagram: Diagram | null = null;
  let debounce: ReturnType<typeof setTimeout> | null = null;
  let selectedExample = 0;
  let playbackRate = 1;
  let isScrubbing = false;

  let parsedAst: any = null;
  let selectedNodeId: string | null = null;
  let isDrawingFlow = false;
  let flowSourceNodeId: string | null = null;
  let flowTargetNodeId: string | null = null;
  let flowStartX = 0;
  let flowStartY = 0;
  let selectedFlowOp = "->";
  let draggedToken: { kind?: string; template?: string } | null = null;

  const NODE_ICON_MAP: Record<string, string> = {
    service: "⚙️", client: "💻", browser: "🌐", mobile: "📱",
    gateway: "🚪", database: "🗄️", cache: "⚡", queue: "📬",
    worker: "👷", storage: "📦", cdn: "🌍", firewall: "🛡️",
    user: "👤", lambda: "λ", pod: "📦",
  };

  function isDarkMode(): boolean {
    return document.documentElement.getAttribute("data-theme") === "dark";
  }

  function applyTheme(theme: "light" | "dark") {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem(STORAGE_KEY, theme);
    themeToggle.textContent = theme === "dark" ? "Light" : "Dark";
  }

  function formatTime(seconds: number): string {
    if (!Number.isFinite(seconds) || seconds <= 0) return "0:00";
    const total = Math.floor(seconds);
    return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
  }

  function setStatus(ok: boolean) {
    statusDot.className = `status-dot ${ok ? "status-ok" : "status-error"}`;
  }

  function showDiagnostics(items: string[]) {
    diagnostics.innerHTML = "";
    if (items.length === 0) {
      diagnostics.innerHTML = '<div class="diag-empty">✓ Scene parsed with 0 syntax errors.</div>';
      return;
    }
    const title = document.createElement("strong");
    title.textContent = "Diagnostics";
    diagnostics.appendChild(title);
    const list = document.createElement("ul");
    for (const item of items) {
      const li = document.createElement("li");
      li.textContent = item;
      list.appendChild(li);
    }
    diagnostics.appendChild(list);
  }

  function setTimeline(current: number, duration: number) {
    const safeDuration = Number.isFinite(duration) && duration > 0 ? duration : 0;
    const safeCurrent = safeDuration > 0 ? Math.min(Math.max(current, 0), safeDuration) : 0;
    timelineRange.max = safeDuration.toFixed(2);
    if (!isScrubbing) timelineRange.value = safeCurrent.toFixed(2);
    timelineRange.disabled = safeDuration <= 0;
    timelineLabel.textContent = `${formatTime(safeCurrent)} / ${formatTime(safeDuration)}`;
  }

  function populateBeatJump(beats: Array<{ name: string; label?: string }>) {
    beatJump.innerHTML = "";
    if (beats.length === 0) {
      beatJump.hidden = true;
      return;
    }
    beatJump.hidden = false;
    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "Jump to beat...";
    beatJump.appendChild(placeholder);
    for (const beat of beats) {
      const option = document.createElement("option");
      option.value = beat.name;
      option.textContent = beat.label ? `${beat.name} - ${beat.label}` : beat.name;
      beatJump.appendChild(option);
    }
    beatJump.value = "";
  }

  function getCode(): string {
    return editor?.state.doc.toString() ?? "";
  }

  function insertCodeAtCursor(snippet: string) {
    if (!editor) return;
    const state = editor.state;
    const selection = state.selection.main;
    const doc = state.doc;
    
    // If empty or end of doc
    let insert = snippet;
    if (selection.empty && doc.length > 0 && !doc.toString().endsWith("\n") && !snippet.startsWith("\n")) {
      insert = "\n" + snippet;
    }

    editor.dispatch({
      changes: { from: selection.from, to: selection.to, insert },
      selection: { anchor: selection.from + insert.length },
    });
    editor.focus();
    render(getCode());
  }

  function updateEntitiesAndSuggestions(code: string) {
    try {
      const ast = parse(code);
      parsedAst = ast;
      const nodes = Object.values(ast.nodes || {});
      const beats = ast.beats ?? [];
      
      updateStoryboard(beats);

      // Calculate connection map
      const incomingCounts: Record<string, number> = {};
      const outgoingCounts: Record<string, number> = {};

      for (const beat of beats) {
        for (const cue of beat.cues ?? []) {
          if (cue.kind === "flow") {
            for (const seg of (cue as any).segments ?? []) {
              if (seg.from) outgoingCounts[seg.from] = (outgoingCounts[seg.from] || 0) + 1;
              if (seg.to) incomingCounts[seg.to] = (incomingCounts[seg.to] || 0) + 1;
            }
          }
        }
      }

      for (const edge of (ast.edges ?? [])) {
        if (edge.from) outgoingCounts[edge.from] = (outgoingCounts[edge.from] || 0) + 1;
        if (edge.to) incomingCounts[edge.to] = (incomingCounts[edge.to] || 0) + 1;
      }

      // Update Entities badge & grid
      nodesCountBadge.textContent = String(nodes.length);
      nodesInspectorGrid.innerHTML = "";

      if (nodes.length === 0) {
        nodesInspectorGrid.innerHTML = '<div class="inspector-empty">No nodes declared. Click any Node chip above to insert.</div>';
      } else {
        for (const node of nodes) {
          const card = document.createElement("div");
          card.className = "node-item-card";
          const icon = NODE_ICON_MAP[node.kind] || "⚙️";
          const outCount = outgoingCounts[node.id] || 0;
          const inCount = incomingCounts[node.id] || 0;

          card.innerHTML = `
            <div class="node-card-top">
              <span class="node-icon">${icon}</span>
              <strong class="node-id">${node.id}</strong>
              <span class="node-kind-badge" data-kind="${node.kind}">${node.kind}</span>
            </div>
            <p class="node-label-text">${node.label || node.id}</p>
            <div class="node-flows-stat">
              <span>↑ ${outCount} out</span> · <span>↓ ${inCount} in</span>
            </div>
            <div class="node-actions-row">
              <button class="node-action-btn btn-flow" type="button" data-id="${node.id}">+ Flow</button>
              <button class="node-action-btn btn-pulse" type="button" data-id="${node.id}">Pulse</button>
            </div>
          `;

          // Quick flow trigger
          card.querySelector(".btn-flow")?.addEventListener("click", () => {
            const nextTarget = nodes.find(n => n.id !== node.id)?.id || "Target";
            insertCodeAtCursor(`\nbeat flow_${node.id}:\n  ${node.id} -> ${nextTarget} "request"`);
          });

          // Quick pulse trigger
          card.querySelector(".btn-pulse")?.addEventListener("click", () => {
            insertCodeAtCursor(`\nbeat alert_${node.id}:\n  pulse ${node.id} color=#38bdf8`);
          });

          nodesInspectorGrid.appendChild(card);
        }
      }

      // Generate Smart Suggestions
      const suggestions: Array<{ title: string; desc: string; actionLabel?: string; onAction?: () => void }> = [];

      if (beats.length === 0) {
        suggestions.push({
          title: "Scene is static",
          desc: "Add a choreographed beat block to animate requests and highlight stages.",
          actionLabel: "+ Add Beat Entrance",
          onAction: () => insertCodeAtCursor('\nbeat entrance "System Flow":\n  show $nodes stagger=60ms\n'),
        });
      }

      const unconnected = nodes.filter(n => (outgoingCounts[n.id] || 0) === 0 && (incomingCounts[n.id] || 0) === 0);
      if (unconnected.length > 0) {
        const target = unconnected[0];
        const partner = nodes.find(n => n.id !== target.id);
        suggestions.push({
          title: `Isolated node '${target.id}'`,
          desc: `Node '${target.id}' (${target.kind}) has no incoming or outgoing flows.`,
          actionLabel: partner ? `Connect to ${partner.id}` : "+ Connect Flow",
          onAction: () => {
            if (partner) insertCodeAtCursor(`\nbeat connect_${target.id}:\n  ${target.id} -> ${partner.id} "call"\n`);
          },
        });
      }

      if (!code.includes("layout LR") && !code.includes("layout TB")) {
        suggestions.push({
          title: "Directional layout unset",
          desc: "Adding 'layout LR' provides a horizontal topology for clear microservice architectures.",
          actionLabel: "+ Add layout LR",
          onAction: () => insertCodeAtCursor("\nlayout LR\n"),
        });
      }

      suggCountBadge.textContent = String(suggestions.length);
      suggestionsContainer.innerHTML = "";

      if (suggestions.length === 0) {
        suggestionsContainer.innerHTML = '<div class="sugg-perfect">✓ Architecture looks great! All nodes connected with active beats.</div>';
      } else {
        for (const sugg of suggestions) {
          const item = document.createElement("div");
          item.className = "sugg-item";
          item.innerHTML = `
            <div class="sugg-info">
              <strong>${sugg.title}</strong>
              <p>${sugg.desc}</p>
            </div>
          `;
          if (sugg.actionLabel && sugg.onAction) {
            const btn = document.createElement("button");
            btn.className = "sugg-action-btn";
            btn.type = "button";
            btn.textContent = sugg.actionLabel;
            btn.addEventListener("click", sugg.onAction);
            item.appendChild(btn);
          }
          suggestionsContainer.appendChild(item);
        }
      }

    } catch {
      // Ignored during mid-type errors
    }
  }

  function createEditor(code: string) {
    editor?.destroy();
    editor = new EditorView({
      state: EditorState.create({
        doc: code,
        extensions: [
          lineNumbers(),
          highlightActiveLine(),
          highlightActiveLineGutter(),
          history(),
          bracketMatching(),
          closeBrackets(),
          indentOnInput(),
          highlightSelectionMatches(),
          markdyLanguage,
          markdyAutocomplete,
          isDarkMode() ? markdyHighlightDark : markdyHighlightLight,
          baseTheme,
          isDarkMode() ? darkTheme : lightTheme,
          keymap.of([
            ...closeBracketsKeymap,
            ...defaultKeymap,
            ...searchKeymap,
            ...historyKeymap,
            indentWithTab,
          ]),
          EditorView.contentAttributes.of({ "aria-label": "MarkdyScript editor" }),
          EditorView.updateListener.of((update) => {
            if (!update.docChanged) return;
            exampleBtns.forEach((btn) => btn.classList.remove("active"));
            if (debounce) clearTimeout(debounce);
            debounce = setTimeout(() => render(getCode()), 650);
          }),
        ],
      }),
      parent: editorHost,
    });
  }

  function render(code: string) {
    diagram?.destroy();
    diagram = null;
    if (stageCanvas) stageCanvas.innerHTML = "";
    deselectCanvas();
    const warnings: string[] = [];
    try {
      diagram = createDiagram({
        container: stageCanvas || stage,
        code,
        autoplay: true,
        loop: true,
        copyright: false,
        sceneBoundaryProgress: false,
        playbackRate,
        interactiveViewport: true,
        onWarning(warning: Diagnostic) {
          warnings.push(`line ${warning.line}: ${warning.message}`);
        },
        onTimeUpdate: setTimeline,
        onPlayStateChange(playing) {
          playBtn.textContent = playing ? "Pause" : "Play";
        },
      });
      setStatus(true);
      showDiagnostics(warnings);
      setTimeline(diagram.currentTime(), diagram.duration());
      populateBeatJump(diagram.beats());
      updateEntitiesAndSuggestions(code);
      attachCanvasInteraction();
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      if (stageCanvas) stageCanvas.innerHTML = `<div class="parse-error">${message}</div>`;
      setStatus(false);
      showDiagnostics([message]);
      setTimeline(0, 0);
      populateBeatJump([]);
      playBtn.textContent = "Play";
    }
  }

  function setActiveExample(index: number) {
    selectedExample = index;
    exampleBtns.forEach((btn, i) => btn.classList.toggle("active", i === index));
    if (quickExampleSelect && index >= 0) {
      quickExampleSelect.value = String(index);
    }
    const example = examples[index];
    if (example) {
      exampleSourceLink.href = example.sourceUrl;
      exampleSourceLink.textContent = "View source ↗";
    } else {
      exampleSourceLink.href = "https://github.com/HoangYell/markdy-com/tree/main/examples";
      exampleSourceLink.textContent = "Browse examples ↗";
    }
  }

  // ─────────────────────────────────────────────────────────────────────────────
  // Direct Manipulation & Canvas Interactions
  // ─────────────────────────────────────────────────────────────────────────────
  function attachCanvasInteraction() {
    if (!stageCanvas) return;
    const nodeEls = stageCanvas.querySelectorAll<HTMLElement>(".markdy-node");
    nodeEls.forEach((nodeEl) => {
      const nodeId = nodeEl.dataset.node;
      if (!nodeId) return;

      nodeEl.addEventListener("click", (e) => {
        e.stopPropagation();
        selectNodeOnCanvas(nodeId, nodeEl);
      });

      ensureConnectorPorts(nodeEl, nodeId);
    });
  }

  function selectNodeOnCanvas(nodeId: string, nodeEl: HTMLElement) {
    selectedNodeId = nodeId;
    if (!stageCanvas || !nodeFloatingHud) return;
    if (flowPopover) flowPopover.hidden = true;

    stageCanvas.querySelectorAll(".markdy-node").forEach(n => {
      n.classList.toggle("markdy-node--selected", (n as HTMLElement).dataset.node === nodeId);
    });

    const nodeDecl = parsedAst?.nodes?.[nodeId];
    const kind = (nodeDecl?.kind || nodeEl.dataset.kind || "service").toLowerCase();
    const label = nodeDecl?.label || nodeId;
    const icon = NODE_ICON_MAP[kind] || "⚙️";

    if (hudNodeIcon) hudNodeIcon.textContent = icon;
    if (hudNodeId) hudNodeId.textContent = nodeId;
    if (hudKindSelect) hudKindSelect.value = kind;
    if (hudLabelInput) hudLabelInput.value = label;

    const stageRect = stage.getBoundingClientRect();
    const nodeRect = nodeEl.getBoundingClientRect();

    const left = Math.max(12, Math.min(stageRect.width - 240, nodeRect.left - stageRect.left + (nodeRect.width / 2) - 110));
    const top = Math.max(12, nodeRect.top - stageRect.top - 84);

    nodeFloatingHud.style.left = `${left}px`;
    nodeFloatingHud.style.top = `${top}px`;
    nodeFloatingHud.hidden = false;
  }

  function deselectCanvas() {
    selectedNodeId = null;
    if (stageCanvas) {
      stageCanvas.querySelectorAll(".markdy-node").forEach(n => n.classList.remove("markdy-node--selected"));
    }
    if (nodeFloatingHud) nodeFloatingHud.hidden = true;
    if (flowPopover) flowPopover.hidden = true;
  }

  stage.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest(".markdy-node") || target.closest(".node-floating-hud") || target.closest(".flow-popover")) return;
    deselectCanvas();
  });

  hudCloseBtn?.addEventListener("click", deselectCanvas);

  hudKindSelect?.addEventListener("change", () => {
    if (!selectedNodeId) return;
    const newKind = hudKindSelect.value;
    let code = getCode();
    const regex = new RegExp(`^(\\s*)([a-zA-Z_]+)(\\s+${selectedNodeId}\\b)`, "m");
    if (regex.test(code)) {
      code = code.replace(regex, `$1${newKind}$3`);
      createEditor(code);
      render(code);
      setTimeout(() => {
        const el = stageCanvas?.querySelector<HTMLElement>(`[data-node="${selectedNodeId}"]`);
        if (el) selectNodeOnCanvas(selectedNodeId!, el);
      }, 50);
    }
  });

  hudLabelInput?.addEventListener("change", () => {
    if (!selectedNodeId) return;
    const newLabel = hudLabelInput.value.trim();
    let code = getCode();
    const regex = new RegExp(`^(\\s*[a-zA-Z_]+\\s+${selectedNodeId})(\\s+("[^"]*"|'[^']*'|\\S+))?(.*)$`, "m");
    if (regex.test(code)) {
      code = code.replace(regex, `$1 "${newLabel}"$4`);
      createEditor(code);
      render(code);
      setTimeout(() => {
        const el = stageCanvas?.querySelector<HTMLElement>(`[data-node="${selectedNodeId}"]`);
        if (el) selectNodeOnCanvas(selectedNodeId!, el);
      }, 50);
    }
  });

  hudPulseBtn?.addEventListener("click", () => {
    if (!selectedNodeId) return;
    insertCodeAtCursor(`\nbeat pulse_${selectedNodeId}:\n  pulse ${selectedNodeId} color=#38bdf8\n`);
    deselectCanvas();
  });

  hudFrameBtn?.addEventListener("click", () => {
    if (!selectedNodeId) return;
    insertCodeAtCursor(`\nbeat zoom_${selectedNodeId}:\n  frame ${selectedNodeId} zoom=1.2 dur=600ms\n`);
    deselectCanvas();
  });

  hudDeleteBtn?.addEventListener("click", () => {
    if (!selectedNodeId) return;
    let code = getCode();
    const lines = code.split("\n").filter(line => {
      if (new RegExp(`^[a-zA-Z_]+\\s+${selectedNodeId}\\b`).test(line.trim())) return false;
      if (new RegExp(`\\b${selectedNodeId}\\s*(->|<-|~>|<->|\\.\\.>)|(->|<-|~>|<->|\\.\\.>)\\s*${selectedNodeId}\\b`).test(line)) return false;
      return true;
    });
    const newCode = lines.join("\n");
    deselectCanvas();
    createEditor(newCode);
    render(newCode);
  });

