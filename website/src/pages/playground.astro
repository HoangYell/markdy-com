  function showDiagnostics(items: string[]) {
    diagnostics.innerHTML = "";
    if (items.length === 0) {
      diagnostics.innerHTML = '<div class="diag-empty">✓ Scene parsed cleanly with 0 syntax errors.</div>';
      diagCountBadge.hidden = true;
      return;
    }
    diagCountBadge.hidden = false;
    diagCountBadge.textContent = String(items.length);
