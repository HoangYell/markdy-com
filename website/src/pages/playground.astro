  });

  stage.addEventListener("dragleave", (e) => {
    if (!stage.contains(e.relatedTarget as Node)) {
      if (stageDropOverlay) stageDropOverlay.hidden = true;
    }
  });

  stage.addEventListener("drop", (e) => {
    e.preventDefault();
    if (stageDropOverlay) stageDropOverlay.hidden = true;
    if (!draggedToken) return;

    const kind = draggedToken.kind || "service";
    const kindSlug = kind.toLowerCase().replace(/[^a-z0-9]/g, "");
    const existingNodes = Object.keys(parsedAst?.nodes || {});
    let idIndex = 1;
    let newId = `${kindSlug}_${idIndex}`;
    while (existingNodes.includes(newId)) {
      idIndex++;
      newId = `${kindSlug}_${idIndex}`;
    }
    const label = `${kind.charAt(0).toUpperCase() + kind.slice(1)} ${idIndex}`;
    const declaration = `${kind} ${newId} "${label}"\n`;

    insertNodeDeclaration(declaration);
  });

  function insertNodeDeclaration(declaration: string) {
    const code = getCode();
    const lines = code.split("\n");
    let insertIndex = lines.findIndex(l => /^(service|client|browser|mobile|gateway|database|db|cache|queue|worker|storage|firewall|lambda|pod|user)\b/.test(l));
    
    if (insertIndex === -1) {
      insertIndex = lines.findIndex(l => /^layout\b/.test(l));
      if (insertIndex === -1) insertIndex = lines.findIndex(l => /^scene\b/.test(l));
      if (insertIndex !== -1) insertIndex += 1;
      else insertIndex = lines.length;
    }

    lines.splice(insertIndex, 0, declaration.trim());
    const newCode = lines.join("\n");
    createEditor(newCode);
    render(newCode);
  }

