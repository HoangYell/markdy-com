  // ─────────────────────────────────────────────────────────────────────────────
  function ensureConnectorPorts(nodeEl: HTMLElement, nodeId: string) {
    if (nodeEl.querySelector(".connector-port")) return;

    ["e", "w", "s", "n"].forEach(pos => {
      const port = document.createElement("div");
      port.className = `connector-port port-${pos}`;
      port.title = "Drag to connect flow";
      
      port.addEventListener("mousedown", (e) => {
        e.stopPropagation();
        e.preventDefault();
        startDrawingFlow(nodeId, e);
      });

      nodeEl.appendChild(port);
    });
  }

  function startDrawingFlow(sourceId: string, e: MouseEvent) {
    if (!flowCanvasSvg || !flowDragPath) return;
    if (nodeFloatingHud) nodeFloatingHud.hidden = true;
    if (flowPopover) flowPopover.hidden = true;
    isDrawingFlow = true;
    flowSourceNodeId = sourceId;
    flowTargetNodeId = null;

    const stageRect = stage.getBoundingClientRect();
    flowStartX = e.clientX - stageRect.left;
    flowStartY = e.clientY - stageRect.top;

    flowCanvasSvg.hidden = false;
    flowDragPath.setAttribute("d", `M ${flowStartX} ${flowStartY} L ${flowStartX} ${flowStartY}`);

    const onMouseMove = (ev: MouseEvent) => {
      if (!isDrawingFlow) return;
      const currentX = ev.clientX - stageRect.left;
      const currentY = ev.clientY - stageRect.top;

      const dx = currentX - flowStartX;
      const dy = currentY - flowStartY;
      const cx1 = flowStartX + dx * 0.5;
      const cy1 = flowStartY;
      const cx2 = flowStartX + dx * 0.5;
      const cy2 = currentY;

      flowDragPath.setAttribute("d", `M ${flowStartX} ${flowStartY} C ${cx1} ${cy1}, ${cx2} ${cy2}, ${currentX} ${currentY}`);

      const target = (document.elementFromPoint(ev.clientX, ev.clientY) as HTMLElement)?.closest(".markdy-node") as HTMLElement | null;
      stageCanvas?.querySelectorAll(".markdy-node").forEach(n => n.classList.remove("markdy-node--target-drop"));
      if (target && target.dataset.node && target.dataset.node !== sourceId) {
        target.classList.add("markdy-node--target-drop");
        flowTargetNodeId = target.dataset.node;
      } else {
        flowTargetNodeId = null;
      }
    };

    const onMouseUp = (ev: MouseEvent) => {
      isDrawingFlow = false;
      flowCanvasSvg.hidden = true;
      window.removeEventListener("mousemove", onMouseMove);
      window.removeEventListener("mouseup", onMouseUp);
      stageCanvas?.querySelectorAll(".markdy-node").forEach(n => n.classList.remove("markdy-node--target-drop"));

      if (flowTargetNodeId && flowSourceNodeId && flowTargetNodeId !== flowSourceNodeId) {
        if (flowPopoverTitle) flowPopoverTitle.textContent = `${flowSourceNodeId} ➔ ${flowTargetNodeId}`;
        if (flowLabelInput) flowLabelInput.value = "";
        const currentX = ev.clientX - stageRect.left;
        const currentY = ev.clientY - stageRect.top;
        if (flowPopover) {
          flowPopover.style.left = `${Math.max(10, Math.min(stageRect.width - 240, currentX - 110))}px`;
          flowPopover.style.top = `${Math.max(10, Math.min(stageRect.height - 180, currentY - 50))}px`;
          flowPopover.hidden = false;
          flowLabelInput?.focus();
        }
      }
    };

    window.addEventListener("mousemove", onMouseMove);
    window.addEventListener("mouseup", onMouseUp);
  }

