---
import Layout from "../layouts/Layout.astro";
import { join } from "node:path";
import { loadExamples } from "../data/examples";

const ROOT = join(process.cwd(), "..");
const EXAMPLES = await loadExamples(ROOT);

const TOKEN_LIBRARIES = {
  nodes: [
    { kind: "service", icon: "⚙️", label: "Service", desc: "Microservice / API service", template: 'service ApiSvc "API Gateway Service"\n' },
    { kind: "client", icon: "💻", label: "Client", desc: "Web client application", template: 'client WebApp "Web Application"\n' },
    { kind: "browser", icon: "🌐", label: "Browser", desc: "End-user web browser", template: 'browser Chrome "End-User Browser"\n' },
    { kind: "mobile", icon: "📱", label: "Mobile", desc: "iOS / Android mobile client", template: 'mobile App "iOS / Android Client"\n' },
    { kind: "gateway", icon: "🚪", label: "Gateway", desc: "API gateway / ingress proxy", template: 'gateway APIGw "Kong / Envoy Gateway"\n' },
    { kind: "database", icon: "🗄️", label: "Database", desc: "Relational / NoSQL database", template: 'database Postgres "PostgreSQL 16"\n' },
    { kind: "cache", icon: "⚡", label: "Cache", desc: "In-memory cache cluster", template: 'cache Redis "Redis Cluster"\n' },
    { kind: "queue", icon: "📬", label: "Queue", desc: "Message queue / event stream", template: 'queue Kafka "Kafka Stream"\n' },
    { kind: "worker", icon: "👷", label: "Worker", desc: "Async background worker", template: 'worker AsyncWorker "Background Worker"\n' },
    { kind: "storage", icon: "📦", label: "Storage", desc: "Object / blob cloud storage", template: 'storage S3Bucket "S3 Asset Storage"\n' },
    { kind: "cdn", icon: "🌍", label: "CDN", desc: "Edge content delivery network", template: 'cdn Cloudflare "Cloudflare Edge"\n' },
    { kind: "firewall", icon: "🛡️", label: "Firewall", desc: "Security perimeter / WAF", template: 'firewall WAF "WAF Perimeter"\n' },
    { kind: "user", icon: "👤", label: "User", desc: "End-user / customer actor", template: 'user Customer "End User"\n' },
    { kind: "lambda", icon: "λ", label: "Lambda", desc: "Serverless compute function", template: 'lambda SlsFunc "Serverless Function"\n' },
    { kind: "pod", icon: "📦", label: "Pod", desc: "Kubernetes container pod", template: 'pod AppPod "Kubernetes Pod"\n' },
  ],
  flows: [
    { op: "->", label: "Sync (->)", template: 'Client -> Gateway "POST /checkout"\n', desc: "Synchronous HTTP/gRPC request" },
    { op: "<-", label: "Response (<-)", template: 'Client <- Gateway "200 OK JSON"\n', desc: "Synchronous return response" },
    { op: "~>", label: "Async (~>)", template: 'Gateway ~> Queue "order.created"\n', desc: "Asynchronous pub/sub event" },
    { op: "<->", label: "Two-Way (<->)", template: 'WebApp <-> Gateway "WebSocket / mTLS"\n', desc: "Bidirectional streaming socket" },
    { op: "..>", label: "Weak (..>)", template: 'Service ..> Database "depends on"\n', desc: "Dashed / weak dependency line" },
  ],
  layouts: [
    { name: "layout LR", label: "layout LR", template: "layout LR\n", desc: "Left-to-right horizontal topology" },
    { name: "layout TB", label: "layout TB", template: "layout TB\n", desc: "Top-to-bottom vertical hierarchy" },
    { name: "type=nested", label: "type=nested", template: "type=nested\n", desc: "Subsystem boundary perimeters" },
    { name: "type=medallion", label: "type=medallion", template: "type=medallion\n", desc: "Bronze → Silver → Gold data stages" },
    { name: "type=flywheel", label: "type=flywheel", template: "type=flywheel\n", desc: "Compounding circular growth loop" },
    { name: "type=constellation", label: "type=constellation", template: "type=constellation\n", desc: "Radial cluster around leader node" },
    { name: "type=quadrant", label: "type=quadrant", template: "type=quadrant\n", desc: "2x2 strategic priority matrix" },
    { name: "type=gantt", label: "type=gantt", template: "type=gantt\n", desc: "Timeline & roadmap phases" },
  ],
  themes: [
    { name: "paper", label: "theme=paper", template: "theme=paper\n" },
    { name: "editorial", label: "theme=editorial", template: "theme=editorial\n" },
    { name: "terminal", label: "theme=terminal", template: "theme=terminal\n" },
    { name: "sketchy", label: "theme=sketchy", template: "theme=sketchy\n" },
    { name: "blueprint", label: "theme=blueprint", template: "theme=blueprint\n" },
    { name: "midnight", label: "theme=midnight", template: "theme=midnight\n" },
    { name: "graphite", label: "theme=graphite", template: "theme=graphite\n" },
    { name: "nebula", label: "theme=nebula", template: "theme=nebula\n" },
  ],
  beats: [
    { label: "Reveal All Nodes", template: 'beat reveal "System Entrance":\n  show $nodes stagger=60ms\n', desc: "Choreographed entrance" },
    { label: "Subsystem Frame", template: 'beat inspect "Inspect Subsystem":\n  frame myGroup zoom=1.2 dur=600ms\n', desc: "Camera zoom focus" },
    { label: "Pulse Glow", template: 'beat highlight "Alert State":\n  pulse NodeA color=#38bdf8\n', desc: "Glowing pulse effect" },
    { label: "Group Boundary", template: 'group cluster "Secure VPC": NodeA NodeB DB\n', desc: "Perimeter enclosure" },
  ],
};

const PLAY_SNIPPETS = [
  {
    label: "Reveal All Nodes",
    code: `beat reveal "Reveal the system":\n  show $nodes stagger=60ms`,
  },
  {
    label: "Frame Subsystem Group",
    code: `beat inspect "Inspect backend":\n  frame backend zoom=1.18 dur=600ms`,
  },
  {
    label: "Request & Response Flow",
    code: `beat request "Trace request":\n  Client -> API "GET /items"\n  Client <- API "200 OK"`,
  },
  {
    label: "Async Event & Glow",
    code: `beat event "Async job":\n  API ~> Queue "order.created"\n  glow Queue color=#38bdf8`,
  },
  {
    label: "OSI Stack (type=layers)",
    code: `service L7 "Application Layer"\nservice L4 "Transport Layer"\nservice L3 "Network Layer"\n\nbeat stack:\n  show $nodes stagger=50ms\n  L7 -> L4 -> L3`,
  },
  {
    label: "Perimeter (type=nested)",
    code: `group dmz: IngressGateway\ngroup secure: AuthPod VaultDB\n\nbeat route:\n  show dmz & show secure\n  IngressGateway -> AuthPod "mTLS"`,
  },
];

const CATEGORIES = ["All", "Architecture", "Microservices", "Data Pipelines", "Cloud & Infra", "State & Algorithms"];

const playgroundStructuredData = [
  {
    "@type": "WebPage",
    "@id": "https://markdy.com/playground/#webpage",
    url: "https://markdy.com/playground/",
    name: "Markdy Playground",
    description: "An interactive architecture studio for authoring, choreographing, testing, and sharing MarkdyScript animated diagrams.",
    isPartOf: { "@id": "https://markdy.com/#website" },
    about: { "@id": "https://markdy.com/#software" },
  },
];
---

<Layout
  title="Markdy Playground — Interactive Architecture Studio & Diagram As Code"
  description="Author, test, inspect, and export animated architecture diagrams. Built-in token library, AST inspector, AI prompt assistant, governance linter, and vector SVG/PNG/GIF export."
  canonicalURL="https://markdy.com/playground/"
  keywords="Markdy playground, architecture studio, diagram as code playground, mermaid alternative, animated architecture diagram, system design editor"
  structuredData={playgroundStructuredData}
>
  <main class="playground-page">
    <!-- ── Top Navigation Bar ── -->
    <nav class="topbar" aria-label="Playground navigation">
      <div class="topbar-left">
        <a class="brand" href="/" title="Markdy home">
          <img src="/icon.svg" class="brand-logo-svg" alt="" width="22" height="22" loading="eager" decoding="async" />
          <strong>markdy studio</strong>
        </a>
        <div id="studio-status-pill" class="status-pill status-pill--ok" title="Diagram compiler status">
          <span id="status-dot" class="status-dot"></span>
          <span id="status-text">Synced</span>
          <span id="status-meta" class="status-meta">0 nodes</span>
        </div>
      </div>

      <div class="topbar-center">
        <!-- View Mode Segmented Switcher -->
        <div class="view-mode-group" role="group" aria-label="Studio layout mode">
          <button id="view-split-btn" class="view-mode-btn active" type="button" data-mode="split" title="Split Screen (Code + Canvas)">⚡ Split</button>
          <button id="view-canvas-btn" class="view-mode-btn" type="button" data-mode="canvas" title="Canvas Visual Studio">🎨 Canvas</button>
          <button id="view-code-btn" class="view-mode-btn" type="button" data-mode="code" title="Code Editor Only">📄 Code</button>
        </div>
      </div>

      <div class="topbar-right">
        <!-- Primary Quick Actions -->
        <button id="import-btn" class="tool-btn" type="button" title="Import from Mermaid, Docker Compose, Kubernetes, Terraform or Draw.io">
          <span>⚡ Import</span>
        </button>

        <button id="live-director-btn" class="tool-btn" type="button" title="Open Stage Presentation & Director Mode (Fullscreen Motion Theatre)">
          <span>🎬 Present</span>
        </button>

        <button id="open-cheatsheet-btn" class="tool-btn" type="button" title="Keyboard Shortcuts & Syntax Reference">
          <span>⌨ Shortcuts</span>
        </button>

        <a href="https://github.com/HoangYell/markdy-com" target="_blank" rel="noopener noreferrer" class="tool-btn tool-btn-icon" aria-label="GitHub Repository" title="GitHub Repository">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
          </svg>
        </a>

        <button id="theme-toggle-btn" class="tool-btn tool-btn-icon" type="button" aria-label="Toggle theme">
          <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5" /><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
          </svg>
          <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- ── Interactive Workspace (Editor + Splitter + Preview Canvas) ── -->
    <section id="workspace" class="workspace" aria-label="MarkdyScript playground workspace">
      <p id="studio-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></p>

      <!-- ── Left Column: Authoring Code Editor ── -->
      <section class="editor-panel" aria-label="Code editor">
        <!-- Editor Header Bar -->
        <div class="panel-head editor-panel-head">
          <div class="editor-head-left">
            <div class="pane-tab active">
              <span class="tab-icon">📄</span>
              <span>scene.markdy</span>
            </div>
            <select id="quick-example-select" class="studio-select" aria-label="Load Showcase Example">
              {EXAMPLES.map((ex, i) => (
                <option value={i}>{ex.title} ({ex.pattern ?? ex.category})</option>
              ))}
            </select>
            <button id="palette-toggle-btn" class="tool-btn tool-btn-sm" type="button" title="Toggle Components & Token Palette">
              <span>＋ Insert</span>
            </button>
          </div>

          <div class="editor-head-actions" aria-label="Editor actions">
            <button id="format-code-btn" class="tool-btn tool-btn-sm" type="button" title="Clean and format MarkdyScript indentation">✨ Format</button>
            <button id="copy-code-btn" class="tool-btn tool-btn-sm" type="button" title="Copy MarkdyScript code to clipboard">📄 Copy</button>
            <button id="reset-btn" class="tool-btn tool-btn-sm" type="button" title="Reset scene to initial template">↺ Reset</button>
            <button id="run-btn" class="tool-btn tool-btn-sm tool-btn-primary" type="button" aria-keyshortcuts="Control+Enter Meta+Enter" title="Compile & Run scene (Cmd/Ctrl+Enter)">
              <span>Run</span>
              <span class="btn-icon-run" aria-hidden="true">▶</span>
            </button>
            <!-- Hidden compatibility elements -->
            <button id="paste-code-btn" type="button" style="display:none;" aria-hidden="true"></button>
            <button id="switch-theme-btn" type="button" style="display:none;" aria-hidden="true"><span id="playground-theme-label">Theme</span></button>
          </div>
        </div>

        <!-- ── Collapsible Token & Component Palette ── -->
        <div id="palette-shelf" class="palette-shelf is-collapsed" aria-label="Component and Token Palette">
          <div class="palette-tabs-header">
            <div class="palette-tabs-group" role="tablist">
              <button class="palette-tab active" type="button" data-shelf="nodes">Nodes</button>
              <button class="palette-tab" type="button" data-shelf="flows">Flows</button>
              <button class="palette-tab" type="button" data-shelf="layouts">Layouts</button>
              <button class="palette-tab" type="button" data-shelf="themes">Themes</button>
              <button class="palette-tab" type="button" data-shelf="beats">Beats</button>
            </div>
            <button id="palette-close-btn" class="palette-close-btn" type="button" title="Close Palette">✕</button>
          </div>

          <!-- Shelf 1: Nodes -->
          <div id="shelf-nodes" class="shelf-panel active">
            <div class="token-chips-scroll">
              {TOKEN_LIBRARIES.nodes.map((n) => (
                <button class="token-chip token-chip--node" type="button" draggable="true" data-kind={n.kind} data-insert={n.template} title={`Drag onto canvas or click to insert: ${n.desc}`}>
                  <span class="token-chip-icon">{n.icon}</span>
                  <code>{n.kind}</code>
                </button>
              ))}
            </div>
          </div>

          <!-- Shelf 2: Flows -->
          <div id="shelf-flows" class="shelf-panel">
            <div class="token-chips-scroll">
              {TOKEN_LIBRARIES.flows.map((f) => (
                <button class="token-chip token-chip--flow" type="button" data-insert={f.template} title={f.desc}>
                  <code class="flow-op">{f.op}</code>
                  <span>{f.label.replace(/\(.*\)/, '').trim()}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Shelf 3: Layouts -->
          <div id="shelf-layouts" class="shelf-panel">
            <div class="token-chips-scroll">
              {TOKEN_LIBRARIES.layouts.map((l) => (
                <button class="token-chip token-chip--preset" type="button" data-insert={l.template} title={l.desc}>
                  <code>{l.name}</code>
                </button>
              ))}
            </div>
          </div>

          <!-- Shelf 4: Themes -->
          <div id="shelf-themes" class="shelf-panel">
            <div class="token-chips-scroll">
              {TOKEN_LIBRARIES.themes.map((t) => (
                <button class="token-chip token-chip--theme" type="button" data-insert={t.template} title={`Apply visual theme: ${t.name}`}>
                  <code>{t.label}</code>
                </button>
              ))}
            </div>
          </div>

          <!-- Shelf 5: Beats -->
          <div id="shelf-beats" class="shelf-panel">
            <div class="token-chips-scroll">
              {TOKEN_LIBRARIES.beats.map((b) => (
                <button class="token-chip token-chip--beat" type="button" data-insert={b.template} title={b.desc}>
                  <span>🎬</span>
                  <code>{b.label}</code>
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- ── CodeMirror Editor Container ── -->
        <div id="code-editor" class="code-editor" aria-label="MarkdyScript editor"></div>

        <!-- ── Editor Assistant & Architecture Inspector Drawer ── -->
        <div id="assistant-drawer" class="assistant-drawer" aria-label="Assistant and Inspector">
          <div class="assistant-tabs-bar">
            <div class="assistant-tabs" role="tablist" aria-label="Assistant Tabs">
              <button class="assistant-tab active" type="button" data-tab="diagnostics" role="tab" aria-selected="true">
                <span>🛡️ Diagnostics &amp; Lint</span>
                <span id="diag-count-badge" class="tab-badge tab-badge--diag" hidden>0</span>
              </button>
              <button class="assistant-tab" type="button" data-tab="nodes" role="tab" aria-selected="false">
                <span>📦 Entities</span>
                <span id="nodes-count-badge" class="tab-badge">0</span>
              </button>
              <button class="assistant-tab" type="button" data-tab="suggestions" role="tab" aria-selected="false">
                <span>💡 Suggestions</span>
                <span id="sugg-count-badge" class="tab-badge">0</span>
              </button>
              <button class="assistant-tab" type="button" data-tab="ai" role="tab" aria-selected="false">
                <span>🤖 AI Architect</span>
              </button>
            </div>
            <div class="drawer-right-controls">
              <span class="drawer-shortcut-hint"><kbd>⌘↵</kbd> run · <kbd>Space</kbd> play</span>
              <button id="drawer-toggle-btn" class="drawer-toggle-btn" type="button" title="Toggle Inspector Drawer" aria-label="Toggle Inspector Drawer">
                <span class="drawer-toggle-icon">▲</span>
              </button>
            </div>
          </div>

          <!-- Tab 1: Diagnostics & Governance -->
          <div id="tab-panel-diagnostics" class="assistant-panel active">
            <div class="diagnostics-toolbar" style="margin-bottom: 8px; display: flex; justify-content: flex-end;">
              <button id="audit-btn" class="tool-btn tool-btn-primary" type="button" title="Run Cloud Architecture Governance Audit">
                <span>🛡️ Run Governance Audit</span>
              </button>
            </div>
            <div id="diagnostics" class="diagnostics" aria-live="polite"></div>
            <div id="audit-results" class="audit-results"></div>
          </div>

          <!-- Tab 2: Entities List -->
          <div id="tab-panel-nodes" class="assistant-panel">
            <div class="entities-head">
              <span class="entities-summary" id="entities-summary">Parsed Nodes &amp; Topology</span>
              <button id="quick-add-node-btn" class="tool-btn-sm" type="button">+ Add Service</button>
            </div>
            <div id="nodes-inspector-grid" class="nodes-inspector-grid"></div>
          </div>

          <!-- Tab 3: Suggestions & Health -->
          <div id="tab-panel-suggestions" class="assistant-panel">
            <div class="suggestions-container" id="suggestions-container"></div>
          </div>

          <!-- Tab 4: AI Prompt Generator -->
          <div id="tab-panel-ai" class="assistant-panel">
            <div class="ai-builder-box">
              <label for="ai-user-prompt">Describe architectural changes or additions:</label>
              <div class="ai-input-row">
                <input id="ai-user-prompt" type="text" placeholder="e.g., Add Redis caching between ApiGateway and OrderService with async Kafka event..." />
                <button id="generate-ai-prompt-btn" class="tool-btn tool-btn-primary" type="button">Copy Prompt for LLM</button>
              </div>
              <p class="ai-builder-hint">Generates an authoritative prompt embedding current AST &amp; strict rules from <a href="/AGENT.md" target="_blank" rel="noopener noreferrer"><code>markdy.com/AGENT.md</code></a>, ready for Claude, Cursor, ChatGPT, or Antigravity.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Resizable Splitter ── -->
      <button
        id="splitter"
        class="splitter"
        type="button"
        role="separator"
        aria-label="Resize editor and preview panes"
        aria-orientation="vertical"
        aria-valuemin="25"
        aria-valuemax="75"
        aria-valuenow="50"
        title="Drag to resize pane split. Double-click to reset 50/50."
      >
        <span class="splitter-grip"></span>
      </button>

      <!-- ── Right Column: Visual Canvas Studio ── -->
      <section id="stage-pane" class="preview-panel" aria-label="Animated visual canvas preview">
        <!-- Canvas Header Bar -->
        <div class="panel-head preview-panel-head">
          <div class="canvas-header-left">
            <span class="preview-live-dot"></span>
            <h2 class="panel-title-text">WAAPI Motion Canvas</h2>
          </div>

        </div>

        <!-- Canvas Stage with Direct Interaction Overlays -->
        <div id="stage" class="stage stage-grid--dots" tabindex="0" role="region" aria-label="Diagram canvas stage" aria-describedby="canvas-interaction-help">
          <!-- Diagram Scene Host -->
          <div id="stage-canvas" class="stage-canvas"></div>

          <!-- Drop Zone Target Indicator -->
          <div id="stage-drop-overlay" class="stage-drop-overlay" hidden>
            <div class="stage-drop-card">
              <div class="drop-card-icon">✨</div>
              <div class="drop-card-text">
                <strong id="drop-target-label">Release to add node</strong>
                <span class="drop-card-sub">Will auto-format &amp; insert into MarkdyScript</span>
              </div>
            </div>
          </div>

          <!-- Rubber-band Flow Connector SVG -->
          <svg id="flow-canvas-svg" class="flow-canvas-svg" hidden>
            <path id="flow-drag-path" class="flow-drag-path" d=""></path>
          </svg>

          <!-- Floating Node Contextual HUD -->
          <div id="node-floating-hud" class="node-floating-hud" hidden>
            <div class="hud-header">
              <span id="hud-node-icon" class="hud-icon">📦</span>
              <strong id="hud-node-id" class="hud-title">Node</strong>
              <button id="hud-close-btn" class="hud-btn-close" type="button" title="Close HUD">✕</button>
            </div>
            <div class="hud-row">
              <select id="hud-kind-select" class="hud-select" aria-label="Change Node Kind">
                <option value="service">Service</option>
                <option value="database">Database</option>
                <option value="cache">Cache</option>
                <option value="queue">Queue</option>
                <option value="gateway">Gateway</option>
                <option value="client">Client</option>
                <option value="browser">Browser</option>
                <option value="mobile">Mobile</option>
                <option value="worker">Worker</option>
                <option value="storage">Storage</option>
                <option value="firewall">Firewall</option>
                <option value="lambda">Lambda</option>
                <option value="pod">Pod</option>
                <option value="user">User</option>
              </select>
              <input id="hud-label-input" class="hud-input" type="text" placeholder="Node label..." />
            </div>
            <div class="hud-actions-row">
              <button id="hud-connect-btn" class="hud-action-btn btn-hud-connect" type="button" title="Connect flow to another node">➔ Flow</button>
              <button id="hud-pulse-btn" class="hud-action-btn btn-hud-pulse" type="button" title="Add kinetic glow pulse">⚡ Pulse</button>
              <button id="hud-frame-btn" class="hud-action-btn btn-hud-frame" type="button" title="Add camera zoom focus">🔍 Frame</button>
              <button id="hud-delete-btn" class="hud-action-btn btn-hud-danger" type="button" title="Delete node from code">🗑️ Delete</button>
            </div>
          </div>

          <!-- Flow Popover HUD -->
          <div id="flow-popover" class="flow-popover" hidden>
            <div class="flow-popover-header">
              <span id="flow-popover-title">Connect Nodes</span>
              <button id="flow-popover-close" class="hud-btn-close" type="button">✕</button>
            </div>
            <div class="flow-popover-body">
              <div class="flow-type-chips">
                <button class="flow-type-chip active" type="button" data-op="->">➔ Sync (-&gt;)</button>
                <button class="flow-type-chip" type="button" data-op="~>">↝ Async (~&gt;)</button>
