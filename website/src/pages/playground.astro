    --cm-tooltipBorder: #e2e8f0;
    --cm-tooltipShadow: rgba(0, 0, 0, 0.08);
    --cm-tooltipSelected: #059669;
    --cm-tooltipSelectedText: #ffffff;
  }

  :root[data-theme="dark"] {
    --bg-primary: #090d16;
    --bg-secondary: #0f172a;
    --bg-tertiary: #1e293b;
    --bg-elevated: #1a2234;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --border: rgba(255, 255, 255, 0.09);
    --border-hover: rgba(255, 255, 255, 0.18);
    --border-subtle: rgba(255, 255, 255, 0.04);
    --accent: #10b981;
    --accent-hover: #059669;
    --accent-light: rgba(16, 185, 129, 0.12);
    --accent-glow: rgba(16, 185, 129, 0.3);
    --danger: #f87171;
    --danger-light: rgba(248, 113, 113, 0.12);
    --shadow-xs: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
    --shadow-sm: 0 2px 4px 0 rgba(0, 0, 0, 0.3);
    --shadow-md: 0 8px 24px -4px rgba(0, 0, 0, 0.45);
    --shadow-lg: 0 24px 48px -12px rgba(0, 0, 0, 0.6);
    --grid-dot: rgba(255, 255, 255, 0.06);
    --grid-mesh: rgba(255, 255, 255, 0.03);
    --selection-bg: rgba(16, 185, 129, 0.18);
    --selection-text: #f8fafc;
    --cm-caret: #f8fafc;
    --cm-activeLine: rgba(16, 185, 129, 0.06);
    --cm-selection: rgba(16, 185, 129, 0.22);
    --cm-tooltipBg: #1e293b;
    --cm-tooltipBorder: rgba(255, 255, 255, 0.12);
    --cm-tooltipShadow: rgba(0, 0, 0, 0.5);
    --cm-tooltipSelected: #10b981;
    --cm-tooltipSelectedText: #ffffff;
  }

  /* ── Base Layout ─────────────────────────────────────────────────────── */
  .playground-page {
    min-height: 100vh;
    padding: 0.65rem 1.15rem 2.5rem;
    background:
      radial-gradient(ellipse 60% 40% at 50% 0%, var(--accent-light), transparent 70%),
      var(--bg-primary);
    color: var(--text-primary);
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }

  .topbar,
  .workspace,
  .resource-strip {
    max-width: 1780px;
    margin: 0 auto;
  }

  /* ── Header / Topbar ─────────────────────────────────────────────────── */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 0.45rem 0.85rem;
    margin-bottom: 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }

  .topbar-left,
  .topbar-center,
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent-light);
    font-size: 0.95rem;
  }

  .brand strong {
    font-size: 0.94rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  /* Status Pill */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    border: 1px solid var(--border);
    background: var(--bg-tertiary);
    transition: all 0.15s ease;
  }

  .status-pill--ok {
    border-color: rgba(16, 185, 129, 0.3);
    color: var(--accent);
  }

  .status-pill--error {
    border-color: rgba(239, 68, 68, 0.3);
    color: var(--danger);
    background: var(--danger-light);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
  }

  .status-meta {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-family: "JetBrains Mono", monospace;
    padding-left: 0.25rem;
    border-left: 1px solid var(--border);
  }

  /* View Mode Segmented Control */
  .view-mode-group {
    display: inline-flex;
    align-items: center;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2px;
    gap: 2px;
  }

  .view-mode-btn {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.26rem 0.65rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.14s ease;
    white-space: nowrap;
  }

  .view-mode-btn:hover {
    color: var(--text-primary);
  }

  .view-mode-btn.active {
    background: var(--bg-secondary);
    color: var(--accent);
    box-shadow: var(--shadow-xs);
    font-weight: 700;
  }

  /* Topbar Buttons */
  .topbar-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 28px;
    padding: 0 0.65rem;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.14s ease;
    box-shadow: var(--shadow-xs);
    white-space: nowrap;
  }

  .topbar-btn:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
    background: var(--bg-tertiary);
    transform: translateY(-1px);
  }

  .topbar-btn-icon {
    padding: 0 0.45rem;
    font-size: 0.85rem;
  }

  .topbar-btn-share {
    color: var(--accent);
    border-color: rgba(5, 150, 105, 0.25);
    background: var(--accent-light);
  }

  .topbar-btn-share:hover {
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
  }


  /* ── Workspace Layout ────────────────────────────────────────────────── */
  .workspace {
    display: grid;
    grid-template-columns: minmax(260px, var(--editor-pane, 50%)) 16px minmax(280px, 1fr);
    gap: 0;
    align-items: stretch;
    height: clamp(680px, calc(100vh - 100px), 940px);
    min-height: 640px;
    margin-bottom: 1.25rem;
    position: relative;
  }

  .workspace[data-view-mode="canvas"] {
    grid-template-columns: 1fr;
  }

  .workspace[data-view-mode="canvas"] .editor-panel,
  .workspace[data-view-mode="canvas"] .splitter {
    display: none;
  }

  .workspace[data-view-mode="code"] {
    grid-template-columns: 1fr;
  }

  .workspace[data-view-mode="code"] .preview-panel,
  .workspace[data-view-mode="code"] .splitter {
    display: none;
  }

  /* Panels Common */
  .editor-panel,
  .preview-panel {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-secondary);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
  }

  /* ── Fullscreen Director Theatre Mode ── */
  .preview-panel:fullscreen,
  .preview-panel.director-theatre-active {
    position: fixed;
    inset: 0;
    z-index: 99999;
    width: 100vw;
    height: 100vh;
    border-radius: 0;
    border: none;
    background: #090d16;
  }

  .preview-panel.director-theatre-active .preview-panel-head {
    background: rgba(9, 13, 22, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .preview-panel.director-theatre-active .storyboard-dock {
    background: rgba(9, 13, 22, 0.85);
    backdrop-filter: blur(16px);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Panel Headers */
  .panel-head {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-bottom: 1px solid var(--border);
    background: var(--bg-primary);
  }

  /* Unified Single-Row Editor Header */
  .editor-panel-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.65rem;
    min-height: 42px;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border);
    gap: 0.5rem;
  }

  .editor-head-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex: 1;
    min-width: 0;
  }

  .pane-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .pane-tab.active {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-light);
  }

  .studio-select {
    height: 26px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 0 0.45rem;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    flex: 1;
    min-width: 0;
    max-width: 250px;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: all 0.14s ease;
    box-shadow: var(--shadow-xs);
  }

  .studio-select:hover {
    border-color: var(--border-hover);
  }

  .studio-select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-light);
  }

  .editor-head-actions {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
  }

  /* Generic non-editor panel header (preview panel etc.) */
  .panel-head:not(.editor-panel-head) {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.85rem;
    min-height: 44px;
  }

  .panel-head-left,
  .canvas-header-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .preview-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
    animation: livePulse 2s ease-in-out infinite;
    display: inline-block;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.8); }
  }

  .editor-title-box,
  .canvas-title-box {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    flex-shrink: 0;
  }

  .panel-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  .panel-title-text {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .tool-select {
    height: 28px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 0 0.5rem;
    font: inherit;
    font-size: 0.73rem;
    font-weight: 600;
    cursor: pointer;
    flex: 1;
    min-width: 0;
    max-width: 280px;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: all 0.14s ease;
    box-shadow: var(--shadow-xs);
  }

  .tool-select:hover {
    border-color: var(--border-hover);
  }

  .tool-select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-light);
  }

  /* Toolbars */
  .toolbar,
  .toolbar-group {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* Thin vertical rule between button groups */
  .toolbar-divider {
    width: 1px;
    height: 18px;
    background: var(--border);
    flex-shrink: 0;
    margin: 0 0.15rem;
  }

  /* Pushes Run button to far right */
  .toolbar-spacer {
    flex: 1;
  }

  .tool-btn {
    height: 28px;
    padding: 0 0.55rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.73rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    transition: all 0.14s ease;
    white-space: nowrap;
  }

  .tool-btn:hover {
    border-color: var(--border-hover);
    background: var(--bg-tertiary);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .tool-btn-sm {
    height: 24px;
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-secondary);
    color: var(--accent);
    font: inherit;
    font-size: 0.68rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.14s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .tool-btn-sm:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .tool-btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
    font-weight: 700;
    box-shadow: 0 2px 6px -1px var(--accent-glow);
  }

  .tool-btn-primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: #ffffff;
    box-shadow: 0 4px 10px -2px var(--accent-glow);
  }

  .btn-icon-run {
    font-size: 0.65rem;
    opacity: 0.85;
  }

  /* ── Palette Shelf (Collapsible Ribbon) ──────────────────── */
  .palette-shelf {
    border-bottom: 1px solid var(--border);
    background: var(--bg-tertiary);
    display: flex;
    flex-direction: column;
    padding: 0.35rem 0.65rem 0.45rem;
    gap: 0.35rem;
    transition: all 0.2s ease-out;
  }

  .palette-shelf.is-collapsed {
    display: none !important;
  }

  .palette-close-btn {
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.75rem;
    cursor: pointer;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    transition: all 0.12s ease;
  }

  .palette-close-btn:hover {
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .palette-tabs-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .palette-tabs-group {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .palette-tab {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .palette-tab:hover {
    color: var(--text-primary);
  }

  .palette-tab.active {
    background: var(--bg-secondary);
    color: var(--accent);
    box-shadow: var(--shadow-xs);
  }

  .palette-hint {
    font-size: 0.64rem;
    color: var(--text-muted);
  }

  .shelf-panel {
    display: none;
  }

  .shelf-panel.active {
    display: block;
  }

  .token-chips-scroll {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 2px;
  }

  .token-chip {
    height: 24px;
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0 0.45rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    cursor: grab;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: all 0.12s ease;
    white-space: nowrap;
    box-shadow: var(--shadow-xs);
    flex-shrink: 0;
  }

  .token-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-light);
    transform: translateY(-1px);
  }

  .token-chip:active {
    cursor: grabbing;
    transform: translateY(0);
  }

  .token-chip code {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
  }

  .token-chip-icon {
    font-size: 0.78rem;
  }

  .flow-op {
    color: #ea580c;
    font-weight: 700;
  }

  /* ── CodeMirror Editor Container ────────────────────────────────────── */
  .code-editor {
    flex: 1 1 0;
    min-height: 200px;
    overflow: auto;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.84rem;
    line-height: 1.55;
    background: var(--bg-secondary);
  }

  /* ── Assistant & Inspector Drawer ───────────────────────────────────── */
  .assistant-drawer {
    border-top: 1px solid var(--border);
    background: var(--bg-secondary);
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    transition: max-height 0.2s ease-out;
  }

  .assistant-drawer:not(.expanded) .assistant-panel {
    display: none !important;
  }

  .assistant-tabs-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0.65rem;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .drawer-right-controls {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .drawer-shortcut-hint {
    font-size: 0.62rem;
    color: var(--text-muted);
  }

  .drawer-shortcut-hint kbd {
    padding: 0.05rem 0.25rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.6rem;
    font-weight: 700;
  }

  .assistant-tabs {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    overflow-x: auto;
  }

  .assistant-tab {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: all 0.14s ease;
    white-space: nowrap;
  }

  .assistant-tab:hover {
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .assistant-tab.active {
    color: var(--accent);
    background: var(--bg-secondary);
    box-shadow: var(--shadow-xs);
    font-weight: 700;
  }

  .tab-badge {
    background: var(--accent-light);
    color: var(--accent);
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.05rem 0.35rem;
    border-radius: 999px;
    border: 1px solid var(--border);
  }

  .tab-badge--diag {
    background: var(--danger-light);
    color: var(--danger);
  }

  .drawer-toggle-btn {
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.68rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    transition: all 0.14s ease;
  }

  .drawer-toggle-btn:hover {
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .assistant-panel {
    display: none;
    padding: 0.6rem 0.85rem;
    max-height: 165px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .assistant-panel.active {
    display: block;
  }

  .entities-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.45rem;
  }

  .entities-summary {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nodes-inspector-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(172px, 1fr));
    gap: 0.45rem;
  }

  :global(.node-item-card) {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.45rem;
    background: var(--bg-tertiary);
    transition: all 0.14s ease;
    box-shadow: var(--shadow-xs);
    cursor: pointer;
  }

  :global(.node-item-card:hover) {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  :global(.node-card-top) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global(.node-id) {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--text-primary);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: "JetBrains Mono", monospace;
  }

  :global(.node-kind-badge) {
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.08rem 0.35rem;
    border-radius: 4px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border);
    text-transform: lowercase;
  }

  :global(.node-label-text) {
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin: 0.2rem 0 0.35rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.node-flows-stat) {
    font-size: 0.65rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
    font-family: "JetBrains Mono", monospace;
  }

  :global(.node-actions-row) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  :global(.node-action-btn) {
    flex: 1;
    font-family: inherit;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 0.22rem 0.45rem;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    line-height: 1.2;
    transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease, transform 0.12s ease;
    box-shadow: var(--shadow-xs);
    white-space: nowrap;
  }

  :global(.node-action-btn:hover) {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  /* + Flow — accent tinted */
  :global(.node-action-btn.btn-flow) {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    background: var(--accent-light);
  }

  :global(.node-action-btn.btn-flow:hover) {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  /* Pulse — sky tinted, still uses a token-friendly approach */
  :global(.node-action-btn.btn-pulse) {
    color: #0ea5e9;
    border-color: rgba(14, 165, 233, 0.28);
    background: rgba(14, 165, 233, 0.08);
  }

  :global(.node-action-btn.btn-pulse:hover) {
    background: #0ea5e9;
    color: #fff;
    border-color: #0ea5e9;
  }

  :root[data-theme="dark"] :global(.node-action-btn.btn-pulse) {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.3);
    background: rgba(56, 189, 248, 0.1);
  }

  :root[data-theme="dark"] :global(.node-action-btn.btn-pulse:hover) {
    background: #0284c7;
    color: #fff;
    border-color: #0284c7;
  }

  .inspector-empty,
  .diag-empty,
  .sugg-perfect {
    font-size: 0.75rem;
    color: var(--text-secondary);
    padding: 0.4rem 0;
  }

  .sugg-perfect,
  .diag-empty {
    color: var(--accent);
    font-weight: 600;
  }

  .suggestions-container {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sugg-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--bg-tertiary);
    transition: all 0.14s ease;
  }

  .sugg-item:hover {
    border-color: var(--accent);
  }

  .sugg-info strong {
    display: block;
    font-size: 0.75rem;
    color: var(--text-primary);
  }

  .sugg-info p {
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin: 0.1rem 0 0;
  }

  .sugg-action-btn {
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--accent);
    border-radius: 5px;
    background: var(--accent);
    color: #ffffff;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.14s ease;
  }

  .sugg-action-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  /* AI Builder Box */
  .ai-builder-box label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .ai-input-row {
    display: flex;
    gap: 0.4rem;
  }

  .ai-input-row input {
    flex: 1;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    padding: 0.4rem 0.65rem;
    font-size: 0.78rem;
    font-family: inherit;
  }

  .ai-input-row input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-light);
  }

  .ai-builder-hint {
    font-size: 0.68rem;
    color: var(--text-muted);
    margin: 0.35rem 0 0;
  }

  /* ── Splitter ──────────────────────────────────────────────────────── */
  .splitter {
    width: 16px;
    height: 100%;
    min-height: 100%;
    border: 0;
    background: transparent;
    padding: 0;
    margin: 0;
    cursor: col-resize;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 15;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
  }

  .splitter::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -6px;
    right: -6px;
    cursor: col-resize;
  }

  .splitter-grip {
    width: 4px;
    height: 48px;
    border-radius: 999px;
    background: var(--border);
    transition: all 0.16s ease;
    pointer-events: none;
  }

  .splitter:hover .splitter-grip,
  .splitter:focus-visible .splitter-grip,
  .splitter.dragging .splitter-grip {
    background: var(--accent);
    width: 6px;
    height: 64px;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.45);
  }

  .splitter:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  body.is-resizing-workspace {
    cursor: col-resize !important;
    user-select: none !important;
    -webkit-user-select: none !important;
  }

  body.is-resizing-workspace * {
    cursor: col-resize !important;
    pointer-events: none !important;
  }

  body.is-resizing-workspace .workspace,
  body.is-resizing-workspace .splitter {
    pointer-events: auto !important;
  }



  /* Direct Canvas Stage */
  .stage {
    flex: 1 1 auto;
    min-height: 380px;
    position: relative;
    overflow: hidden;
    background-color: var(--bg-secondary);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
  }

  .stage-grid--dots {
    background-image: radial-gradient(circle, var(--grid-dot) 1.3px, transparent 1.3px);
    background-size: 22px 22px;
  }

  .stage-grid--mesh {
    background-image:
      linear-gradient(to right, var(--grid-mesh) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-mesh) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .stage-grid--plain {
    background-image: none;
  }

  .stage-canvas {
    flex: 1 1 auto;
    width: 100%;
    height: 100%;
    min-height: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
  }

  .stage .markdy-footer {
    flex-shrink: 0;
    width: 100%;
    background: transparent;
    border-top: none;
    padding: 0.35rem 0.85rem;
    z-index: 20;
    position: relative;
    pointer-events: auto;
  }

  /* Stage Drop Target Indicator */
  .stage-drop-overlay {
    position: absolute;
    inset: 0.65rem;
    background: rgba(5, 150, 105, 0.08);
    border: 2px dashed var(--accent);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    backdrop-filter: blur(4px);
    pointer-events: none;
    animation: pulseDrop 1.2s ease-in-out infinite;
  }

  .stage-drop-card {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--bg-secondary);
    border: 1px solid var(--accent);
    padding: 0.65rem 1.15rem;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
  }

  .drop-card-icon {
    font-size: 1.3rem;
  }

  .drop-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .drop-card-text strong {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--accent);
  }

  .drop-card-sub {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  @keyframes pulseDrop {
    0%, 100% { opacity: 0.9; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.005); }
  }

  /* Flow Connector Rubber-band SVG */
  .flow-canvas-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 40;
  }

  .flow-drag-path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-dasharray: 6 4;
    animation: flowDash 0.6s linear infinite;
    filter: drop-shadow(0 2px 8px var(--accent-glow));
  }

  @keyframes flowDash {
    to { stroke-dashoffset: -10; }
  }

  /* Connector Port Handles on Nodes */
  .connector-port {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--bg-secondary);
    border: 2px solid var(--accent);
    cursor: crosshair;
    z-index: 30;
    opacity: 0;
    transition: all 0.15s ease;
    transform: translate(-50%, -50%);
  }

  .markdy-node:hover .connector-port {
    opacity: 0.9;
  }

  .connector-port:hover {
    transform: translate(-50%, -50%) scale(1.5);
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    opacity: 1 !important;
  }

  .connector-port.port-e { left: 100%; top: 50%; }
  .connector-port.port-w { left: 0%; top: 50%; }
  .connector-port.port-n { left: 50%; top: 0%; }
  .connector-port.port-s { left: 50%; top: 100%; }

  /* Node Selected State */
  .markdy-node--selected {
    outline: 2px solid var(--accent) !important;
    outline-offset: 3px !important;
    box-shadow: 0 0 16px var(--accent-glow) !important;
  }

  .markdy-node--target-drop {
    outline: 2px dashed var(--accent) !important;
    outline-offset: 3px !important;
    transform: scale(1.03);
  }

  .node-floating-hud[hidden],
  .flow-popover[hidden],
  .stage-drop-overlay[hidden],
  .flow-canvas-svg[hidden] {
    display: none !important;
  }

  /* Floating Contextual Node HUD */
  .node-floating-hud {
    position: absolute;
    z-index: 60;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.55rem 0.7rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 235px;
    animation: hudFadeIn 0.14s ease-out;
    backdrop-filter: blur(16px);
  }

  @keyframes hudFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hud-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .hud-title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
  }

  .hud-btn-close {
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 0.1rem 0.25rem;
    border-radius: 4px;
    transition: all 0.12s ease;
  }

  .hud-btn-close:hover {
    color: var(--text-primary);
    background: var(--bg-tertiary);
  }

  .hud-row {
    display: flex;
    gap: 0.3rem;
  }

  .hud-select,
  .hud-input {
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-size: 0.7rem;
    font-family: inherit;
    padding: 0.22rem 0.45rem;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
    outline: none;
  }

  .hud-select:hover,
  .hud-input:hover {
    border-color: var(--border-hover);
  }

  .hud-select:focus,
  .hud-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-light);
  }

  .hud-select { width: 92px; cursor: pointer; }
  .hud-input { flex: 1; min-width: 0; }

  .hud-actions-row {
    display: flex;
    gap: 0.25rem;
  }

  .hud-action-btn {
    flex: 1;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-secondary);
    font-family: inherit;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 0.25rem 0.35rem;
    color: var(--text-secondary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease, transform 0.12s ease;
    box-shadow: var(--shadow-xs);
  }

  .hud-action-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  /* ➔ Flow — violet accent */
  .btn-hud-connect {
    color: #9333ea;
    background: rgba(147, 51, 234, 0.08);
    border-color: rgba(147, 51, 234, 0.25);
  }

  .btn-hud-connect:hover {
    background: #9333ea;
    color: #fff;
    border-color: #9333ea;
  }

  :root[data-theme="dark"] .btn-hud-connect {
    color: #c084fc;
    background: rgba(192, 132, 252, 0.1);
    border-color: rgba(192, 132, 252, 0.25);
  }

  :root[data-theme="dark"] .btn-hud-connect:hover {
    background: #7c3aed;
    color: #fff;
    border-color: #7c3aed;
  }

  /* ⚡ Pulse — sky accent */
  .btn-hud-pulse {
    color: #0ea5e9;
    background: rgba(14, 165, 233, 0.08);
    border-color: rgba(14, 165, 233, 0.25);
  }

  .btn-hud-pulse:hover {
    background: #0ea5e9;
    color: #fff;
    border-color: #0ea5e9;
  }

  :root[data-theme="dark"] .btn-hud-pulse {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    border-color: rgba(56, 189, 248, 0.25);
  }

  :root[data-theme="dark"] .btn-hud-pulse:hover {
    background: #0284c7;
    color: #fff;
    border-color: #0284c7;
  }

  /* 🔍 Frame — project accent (green) */
  .btn-hud-frame {
    color: var(--accent);
    background: var(--accent-light);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .btn-hud-frame:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  /* 🗑️ Delete — danger */
  .btn-hud-danger {
    color: var(--danger);
    background: var(--danger-light);
    border-color: rgba(239, 68, 68, 0.25);
  }

  .btn-hud-danger:hover {
    background: var(--danger);
    color: #fff;
    border-color: var(--danger);
  }

  .markdy-node--target-candidate {
    outline: 2px dashed #9333ea !important;
    outline-offset: 4px;
    cursor: crosshair !important;
    animation: candidatePulse 1.2s infinite ease-in-out;
  }

  @keyframes candidatePulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.02); }
  }

  /* ── Flow Popover HUD ── */
  .flow-popover {
    position: absolute;
    z-index: 65;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.65rem 0.8rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    width: 240px;
    animation: hudFadeIn 0.14s ease-out;
    backdrop-filter: blur(16px);
  }

  .flow-popover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.73rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .flow-popover-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .flow-type-chips {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
  }

  .flow-type-chip {
    font-family: inherit;
    font-size: 0.64rem;
    font-weight: 700;
    padding: 0.22rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    cursor: pointer;
    text-align: center;
    transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
    box-shadow: var(--shadow-xs);
  }

  .flow-type-chip:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .flow-type-chip.active {
    background: var(--accent-light);
    color: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-glow);
  }

  /* ── Unified Choreography & Storyboard Dock ────────────────────────── */
  .choreography-dock {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.45rem 0.85rem;
    border-top: 1px solid var(--border);
    background: var(--bg-primary);
  }

  .dock-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .dock-storyboard-box {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    flex: 1;
  }

  .dock-label {
    font-size: 0.63rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    white-space: nowrap;
    opacity: 0.8;
  }

  /* ── Storyboard track ── */
  .storyboard-track {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1;
    padding: 0.1rem 0;
  }

  .storyboard-track::-webkit-scrollbar { display: none; }

  :global(.storyboard-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    min-height: 28px;
    padding: 0.22rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.67rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
    box-shadow: var(--shadow-xs);
    flex-shrink: 0;
  }

  :global(.storyboard-chip:hover) {
    border-color: var(--border-hover);
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
  }

  :global(.storyboard-chip.active) {
    border-color: var(--accent);
    background: var(--accent-light);
    color: var(--accent);
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--accent-glow);
  }

  :global(.chip-step) {
    font-size: 0.58rem;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.7;
    letter-spacing: 0.02em;
  }

  :global(.chip-name) {
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── + Beat button ── */
  .dock-add-beat-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-height: 28px;
    border: 1px dashed color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-light);
    color: var(--accent);
    font-family: inherit;
    font-size: 0.67rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 5px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease, box-shadow 0.12s ease;
    flex-shrink: 0;
    box-shadow: var(--shadow-xs);
  }

  .dock-add-beat-btn:hover {
    border-style: solid;
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
    box-shadow: var(--shadow-sm);
  }

  :global(.storyboard-empty-hint) {
    font-size: 0.67rem;
    color: var(--text-muted);
    font-style: italic;
  }

  /* ── Resource Strip & Showcase Gallery ─────────────────────────────── */
  .resource-strip {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(290px, 0.85fr) minmax(260px, 0.75fr);
    gap: 0.85rem;
    margin-bottom: 2rem;
    align-items: stretch;
  }

  .card {
    border: 1px solid var(--border);
