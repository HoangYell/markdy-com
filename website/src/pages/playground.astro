      statusText.textContent = "Needs Attention";
      statusMeta.textContent = errorMsg ? (errorMsg.length > 28 ? errorMsg.slice(0, 26) + "…" : errorMsg) : "Syntax error";
      diagCountBadge.hidden = false;
      diagCountBadge.textContent = "!";
    }
  }

  function announce(message: string): void {
