---
import Layout from "../layouts/Layout.astro";
import { join } from "node:path";
import { loadExamples } from "../data/examples";
import { getProjectVersion } from "../lib/agent-reference";

const ROOT = join(process.cwd(), "..");
const EXAMPLES = await loadExamples(ROOT);
const projectVersion = await getProjectVersion();

const NODE_KINDS = [
  { kind: "user", icon: "👤", desc: "End users, mobile apps, or human actors initiating requests", example: 'user Customer "Mobile User"' },
  { kind: "client", icon: "💻", desc: "Frontends, SPAs, web browsers, or client runtimes", example: 'client WebApp "Next.js WebApp"' },
  { kind: "gateway", icon: "🌐", desc: "API Gateways, reverse proxies, ingress, or load balancers", example: 'gateway ApiGateway "Kong / Envoy"' },
  { kind: "service", icon: "⚙️", desc: "Microservices, backend applications, gRPC daemons", example: 'service AuthService "Auth & Sessions"' },
  { kind: "database", icon: "🗄️", desc: "Relational DBs, document stores, primary persistence", example: 'database Postgres "PostgreSQL 16"' },
  { kind: "cache", icon: "⚡", desc: "In-memory stores, Redis clusters, Memcached instances", example: 'cache Redis "Redis Cluster"' },
  { kind: "queue", icon: "📬", desc: "Message brokers, Kafka event streams, SQS/RabbitMQ", example: 'queue EventBus "Kafka Event Stream"' },
  { kind: "worker", icon: "👷", desc: "Background job processors, async consumers, cron runners", example: 'worker VideoWorker "Transcoder Worker"' },
  { kind: "storage", icon: "📦", desc: "Object storage buckets, S3, blob storage, volume mounts", example: 'storage S3Bucket "Asset S3 Bucket"' },
  { kind: "cdn", icon: "🌍", desc: "Global edge CDNs, Cloudflare, Fastly edge points", example: 'cdn Cloudflare "Cloudflare Edge"' },
  { kind: "firewall", icon: "🛡️", desc: "WAFs, security filters, rate limiters, DMZ shields", example: 'firewall CloudWAF "AWS WAF Shield"' },
  { kind: "lambda", icon: "λ", desc: "Serverless functions, edge compute, ephemeral handlers", example: 'lambda ImageResize "Edge Worker"' },
  { kind: "pod", icon: "📦", desc: "Kubernetes pods, container instances, daemon sets", example: 'pod OrderPod "order-pod-v2"' },
];

const FLOW_OPERATORS = [
  { op: "->", name: "Sync Request", desc: "Direct synchronous RPC, HTTP call, or method invocation with moving payload particle", syntax: 'Client -> Gateway "POST /order"' },
  { op: "<-", name: "Sync Response", desc: "Synchronous return value, ACK response, or status code flowing backward", syntax: 'Client <- Gateway "201 Created"' },
  { op: "<->", name: "Bidirectional", desc: "Full-duplex WebSocket connection, socket streaming, or sync handshake", syntax: 'Browser <-> SocketServer "ws:// live"' },
  { op: "~>", name: "Async Event", desc: "Non-blocking message pub/sub, webhook trigger, or distributed queue emission", syntax: 'Gateway ~> EventBus "order.placed"' },
  { op: "==>", name: "Data Pipe", desc: "High-throughput bulk data stream, ETL pipeline, or database replication", syntax: 'PrimaryDB ==> ReplicaDB "WAL stream"' },
  { op: "-.->", name: "Dotted / Probe", desc: "Heartbeat ping, liveness check, telemetry beacon, or weak reference", syntax: 'Monitor -.-> Service "health check"' },
];

const BEAT_CUES = [
  { cue: "show $nodes", desc: "Progressively reveals all declared nodes with timed stagger animation", example: "show $nodes stagger=60ms" },
  { cue: "show <group>", desc: "Reveals specific boundary groups or clustered subsystem components", example: "show ingress stagger=40ms & show persistence" },
  { cue: "frame <target>", desc: "Directs camera attention and smooth pan/zoom to a group or node", example: "frame storage zoom=1.15" },
  { cue: "pulse <target>", desc: "Highlights node with a luminous phosphorescent beacon ring", example: "pulse Redis color=accent count=2" },
  { cue: "dim <target>", desc: "Fades non-active components to 25% opacity to emphasize current flow", example: "dim Auth WebApp" },
  { cue: "& (parallel)", desc: "Executes multiple cues or concurrent network flows at the same instant", example: "App -> Cache \"get\" & App -> Db \"log\"" },
];

const GOVERNANCE_RULES = [
  { id: "no-circular-dependencies", level: "BLOCKING", desc: "Flags synchronous request cycles (A -> B -> C -> A) that risk cascade deadlocks." },
  { id: "strict-layer-boundaries", level: "ERROR", desc: "Enforces architectural tiers (e.g. Clients cannot bypass API Gateways to talk to DBs)." },
  { id: "isolated-node-warning", level: "WARNING", desc: "Identifies orphaned microservices or unlinked database instances lacking connections." },
  { id: "semantic-diff-evolution", level: "PR AUDIT", desc: "Produces GitHub Markdown change summaries and migration tables for pull requests." },
];

const docStructuredData = [
  {
    "@type": "WebPage",
    "@id": "https://markdy.com/docs/#webpage",
    url: "https://markdy.com/docs/",
    name: "Markdy Documentation — MarkdyScript Reference & Developer Guide",
    description: "Comprehensive developer guide for MarkdyScript: semantic node kinds, flow operators, timeline beats, universal ingestion, AI/MCP agent configuration, and architecture governance.",
    isPartOf: { "@id": "https://markdy.com/#website" },
    about: { "@id": "https://markdy.com/#software" },
  },
  {
    "@type": "BreadcrumbList",
    "@id": "https://markdy.com/docs/#breadcrumb",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://markdy.com/" },
      { "@type": "ListItem", position: 2, name: "Documentation", item: "https://markdy.com/docs/" },
    ],
  },
];
