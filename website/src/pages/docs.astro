<script>
  import { compressMarkdyToUrlHash } from "@markdy/core";

  // Automatically enhance all doc-code-cards with Open in Studio & Copy buttons
  document.querySelectorAll<HTMLElement>(".doc-code-card").forEach(async (card) => {
    const codeEl = card.querySelector("code");
    if (!codeEl) return;
    const codeText = codeEl.textContent?.trim() || "";
    
    // data-lang="markdy" on the <pre> opts a block into Studio explicitly; any other
    // data-lang value opts it out, even if the raw text happens to contain Markdy
    // keywords (e.g. a JS usage example whose template literal embeds a Markdy scene).
    // Falls back to a keyword sniff only when no data-lang is set.
    const declaredLang = (codeEl.closest("pre") as HTMLElement | null)?.dataset.lang;
    const isMarkdy = declaredLang
      ? declaredLang === "markdy"
      : codeText.includes("scene beat ") || codeText.includes(" -> ") || codeText.includes("service ");
    
    let header = card.querySelector(".code-header") as HTMLElement;
    if (!header) {
      header = document.createElement("div");
      header.className = "code-header";
      const titleSpan = document.createElement("span");
      titleSpan.className = "code-title";
      titleSpan.textContent = isMarkdy ? "MarkdyScript" : "Snippet";
      header.appendChild(titleSpan);
      card.insertBefore(header, card.firstChild);
    }

    // Defensive cleanup: remove any preexisting loose copy buttons directly in header to avoid duplicates
    header.querySelectorAll(":scope > .doc-copy-btn").forEach((btn) => btn.remove());

    let actions = header.querySelector(".code-header-actions") as HTMLElement;
    if (!actions) {
      actions = document.createElement("div");
      actions.className = "code-header-actions";
      header.appendChild(actions);
    }
    
    // Add studio button if markdy
    if (isMarkdy && !actions.querySelector(".doc-studio-btn")) {
      const studioLink = document.createElement("a");
      studioLink.className = "doc-studio-btn";
      studioLink.textContent = "⚡ Open in Studio";
      studioLink.target = "_blank";
      try {
        const hash = await compressMarkdyToUrlHash(codeText);
        studioLink.href = `/playground/#code=${hash}`;
      } catch {
        studioLink.href = `/playground/#code=${encodeURIComponent(codeText)}`;
      }
      actions.appendChild(studioLink);
    }

    // Add copy button if not present
    if (!actions.querySelector(".doc-copy-btn")) {
      const copyBtn = document.createElement("button");
      copyBtn.className = "doc-copy-btn copy-btn";
      copyBtn.type = "button";
      copyBtn.textContent = "Copy";
      copyBtn.title = "Copy snippet to clipboard";
      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText(codeText).then(() => {
          copyBtn.textContent = "Copied!";
          copyBtn.classList.add("copied");
          setTimeout(() => {
            copyBtn.textContent = "Copy";
            copyBtn.classList.remove("copied");
          }, 2000);
        }).catch(() => {
          copyBtn.textContent = "Failed";
          setTimeout(() => {
            copyBtn.textContent = "Copy";
          }, 2000);
        });
      });
      actions.appendChild(copyBtn);
    }
  });

  // Copy command buttons in ingestion & framework cards
  document.querySelectorAll<HTMLButtonElement>(".copy-cmd-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest(".ingest-card, .framework-card");
      const codeEl = card?.querySelector("code");
      const text = codeEl?.textContent?.trim() || "";
      if (!text) return;
      navigator.clipboard.writeText(text).then(() => {
        const orig = btn.textContent;
        btn.textContent = "Copied!";
        btn.classList.add("copied");
        setTimeout(() => {
          btn.textContent = orig;
          btn.classList.remove("copied");
        }, 2000);
      }).catch(() => {
        btn.textContent = "Failed";
        setTimeout(() => { btn.textContent = "Copy"; }, 2000);
      });
    });
  });

  // Live Docs Search & Filter
  const searchInput = document.getElementById("docs-search") as HTMLInputElement;
  const sidebarLinks = document.querySelectorAll<HTMLAnchorElement>(".sidebar-link");
  const docSections = document.querySelectorAll<HTMLElement>(".doc-section");

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.toLowerCase().trim();
    if (!query) {
      sidebarLinks.forEach(link => {
        link.style.display = "";
        link.classList.remove("search-match");
      });
      docSections.forEach(sec => sec.style.display = "");
      return;
    }

    sidebarLinks.forEach(link => {
      const text = link.textContent?.toLowerCase() || "";
      const matches = text.includes(query);
      link.style.display = matches ? "" : "none";
      link.classList.toggle("search-match", matches);
    });

    docSections.forEach(sec => {
      const secText = sec.textContent?.toLowerCase() || "";
      const matches = secText.includes(query);
      sec.style.display = matches ? "" : "none";
    });
  });

  // Keyboard Shortcuts: Cmd+K, Ctrl+K, or '/' to focus search
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      searchInput?.focus();
      searchInput?.select();
    } else if (e.key === "/" && document.activeElement !== searchInput && !(document.activeElement instanceof HTMLInputElement) && !(document.activeElement instanceof HTMLTextAreaElement)) {
      e.preventDefault();
      searchInput?.focus();
      searchInput?.select();
    } else if (e.key === "Escape" && document.activeElement === searchInput) {
      searchInput?.blur();
    }
  });

  // Active ScrollSpy
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute("id");
        if (id) {
          sidebarLinks.forEach(link => {
            const href = link.getAttribute("href");
            link.classList.toggle("active", href === `#${id}`);
          });
        }
      }
    }
  }, { rootMargin: "-10% 0px -70% 0px" });

  docSections.forEach(sec => observer.observe(sec));

  // Mobile Table of Contents Drawer
  const mobileTocBtn = document.getElementById("mobile-docs-toc-btn");
  const mobileDocsDrawer = document.getElementById("mobile-docs-drawer");
  const closeDocsDrawerBtn = document.getElementById("close-docs-drawer-btn");

  function toggleDocsDrawer(open?: boolean) {
    if (!mobileDocsDrawer || !mobileTocBtn) return;
    const shouldOpen = open !== undefined ? open : mobileDocsDrawer.hidden;
    mobileDocsDrawer.hidden = !shouldOpen;
    mobileTocBtn.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
  }

  mobileTocBtn?.addEventListener("click", () => toggleDocsDrawer());
  closeDocsDrawerBtn?.addEventListener("click", () => toggleDocsDrawer(false));

  mobileDocsDrawer?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => toggleDocsDrawer(false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && mobileDocsDrawer && !mobileDocsDrawer.hidden) {
      toggleDocsDrawer(false);
    }
  });

  document.addEventListener("click", (e) => {
    if (
      mobileDocsDrawer &&
      !mobileDocsDrawer.hidden &&
      !mobileDocsDrawer.contains(e.target as Node) &&
      !mobileTocBtn?.contains(e.target as Node)
    ) {
      toggleDocsDrawer(false);
    }
  });

  // Theme toggle
  const themeBtn = document.getElementById("theme-toggle");
  themeBtn?.addEventListener("click", () => {
    const isDark = document.documentElement.getAttribute("data-theme") === "dark";
    const next = isDark ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("markdy-theme", next);
    updateThemeIcons(next);
  });

  function updateThemeIcons(theme: string) {
    const sun = document.querySelector(".icon-sun") as HTMLElement;
    const moon = document.querySelector(".icon-moon") as HTMLElement;
    if (!sun || !moon) return;
    if (theme === "dark") {
      sun.style.display = "none";
      moon.style.display = "block";
    } else {
      sun.style.display = "block";
      moon.style.display = "none";
    }
  }

  const initialTheme = document.documentElement.getAttribute("data-theme") || "light";
  updateThemeIcons(initialTheme);
</script>

