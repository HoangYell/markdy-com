            <img src="/images/3d-icon.webp" alt="Markdy 3D Icon" class="doc-badge-icon" width="14" height="14" loading="lazy" decoding="async" fetchpriority="low" />
            Developer Reference
          </span>
          <div class="doc-meta-strip" aria-label="Documentation metadata">
            <span class="doc-meta-item status"><span class="doc-meta-dot"></span> Active &amp; Canonical</span>
