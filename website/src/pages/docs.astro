---
import Layout from "../layouts/Layout.astro";
import { join } from "node:path";
import { loadExamples } from "../data/examples";

const ROOT = join(process.cwd(), "..");
const EXAMPLES = await loadExamples(ROOT);

const NODE_KINDS = [
  { kind: "user", icon: "👤", desc: "End users, mobile apps, or human actors initiating requests", example: 'user Customer "Mobile User"' },
  { kind: "client", icon: "💻", desc: "Frontends, SPAs, web browsers, or client runtimes", example: 'client WebApp "Next.js WebApp"' },
  { kind: "gateway", icon: "🌐", desc: "API Gateways, reverse proxies, ingress, or load balancers", example: 'gateway ApiGateway "Kong / Envoy"' },
  { kind: "service", icon: "⚙️", desc: "Microservices, backend applications, gRPC daemons", example: 'service AuthService "Auth & Sessions"' },
  { kind: "database", icon: "🗄️", desc: "Relational DBs, document stores, primary persistence", example: 'database Postgres "PostgreSQL 16"' },
  { kind: "cache", icon: "⚡", desc: "In-memory stores, Redis clusters, Memcached instances", example: 'cache Redis "Redis Cluster"' },
  { kind: "queue", icon: "📬", desc: "Message brokers, Kafka event streams, SQS/RabbitMQ", example: 'queue EventBus "Kafka Event Stream"' },
  { kind: "worker", icon: "👷", desc: "Background job processors, async consumers, cron runners", example: 'worker VideoWorker "Transcoder Worker"' },
  { kind: "storage", icon: "📦", desc: "Object storage buckets, S3, blob storage, volume mounts", example: 'storage S3Bucket "Asset S3 Bucket"' },
  { kind: "cdn", icon: "🌍", desc: "Global edge CDNs, Cloudflare, Fastly edge points", example: 'cdn Cloudflare "Cloudflare Edge"' },
  { kind: "firewall", icon: "🛡️", desc: "WAFs, security filters, rate limiters, DMZ shields", example: 'firewall CloudWAF "AWS WAF Shield"' },
  { kind: "lambda", icon: "λ", desc: "Serverless functions, edge compute, ephemeral handlers", example: 'lambda ImageResize "Edge Worker"' },
  { kind: "pod", icon: "📦", desc: "Kubernetes pods, container instances, daemon sets", example: 'pod OrderPod "order-pod-v2"' },
];

const FLOW_OPERATORS = [
  { op: "->", name: "Sync Request", desc: "Direct synchronous RPC, HTTP call, or method invocation with moving payload particle", syntax: 'Client -> Gateway "POST /order"' },
  { op: "<-", name: "Sync Response", desc: "Synchronous return value, ACK response, or status code flowing backward", syntax: 'Client <- Gateway "201 Created"' },
  { op: "<->", name: "Bidirectional", desc: "Full-duplex WebSocket connection, socket streaming, or sync handshake", syntax: 'Browser <-> SocketServer "ws:// live"' },
  { op: "~>", name: "Async Event", desc: "Non-blocking message pub/sub, webhook trigger, or distributed queue emission", syntax: 'Gateway ~> EventBus "order.placed"' },
  { op: "==>", name: "Data Pipe", desc: "High-throughput bulk data stream, ETL pipeline, or database replication", syntax: 'PrimaryDB ==> ReplicaDB "WAL stream"' },
  { op: "-.->", name: "Dotted / Probe", desc: "Heartbeat ping, liveness check, telemetry beacon, or weak reference", syntax: 'Monitor -.-> Service "health check"' },
];

const BEAT_CUES = [
  { cue: "show $nodes", desc: "Progressively reveals all declared nodes with timed stagger animation", example: "show $nodes stagger=60ms" },
  { cue: "show <group>", desc: "Reveals specific boundary groups or clustered subsystem components", example: "show ingress stagger=40ms & show persistence" },
  { cue: "frame <target>", desc: "Directs camera attention and smooth pan/zoom to a group or node", example: "frame storage zoom=1.15" },
  { cue: "pulse <target>", desc: "Highlights node with a luminous phosphorescent beacon ring", example: "pulse Redis color=accent count=2" },
  { cue: "dim <target>", desc: "Fades non-active components to 25% opacity to emphasize current flow", example: "dim Auth WebApp" },
  { cue: "& (parallel)", desc: "Executes multiple cues or concurrent network flows at the same instant", example: "App -> Cache \"get\" & App -> Db \"log\"" },
];

const GOVERNANCE_RULES = [
  { id: "no-circular-dependencies", level: "BLOCKING", desc: "Flags synchronous request cycles (A -> B -> C -> A) that risk cascade deadlocks." },
  { id: "strict-layer-boundaries", level: "ERROR", desc: "Enforces architectural tiers (e.g. Clients cannot bypass API Gateways to talk to DBs)." },
  { id: "isolated-node-warning", level: "WARNING", desc: "Identifies orphaned microservices or unlinked database instances lacking connections." },
  { id: "semantic-diff-evolution", level: "PR AUDIT", desc: "Produces GitHub Markdown change summaries and migration tables for pull requests." },
];

const docStructuredData = [
  {
    "@type": "WebPage",
    "@id": "https://markdy.com/docs/#webpage",
    url: "https://markdy.com/docs/",
    name: "Markdy Documentation — MarkdyScript Reference & Developer Guide",
    description: "Comprehensive developer guide for MarkdyScript: semantic node kinds, flow operators, timeline beats, universal ingestion, AI/MCP agent configuration, and architecture governance.",
    isPartOf: { "@id": "https://markdy.com/#website" },
    about: { "@id": "https://markdy.com/#software" },
  },
  {
    "@type": "BreadcrumbList",
    "@id": "https://markdy.com/docs/#breadcrumb",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://markdy.com/" },
      { "@type": "ListItem", position: 2, name: "Documentation", item: "https://markdy.com/docs/" },
    ],
  },
];
---

<Layout
  title="Markdy Docs — MarkdyScript Reference & Complete Developer Guide"
  description="Master MarkdyScript for animated architecture diagrams as code: full grammar cheatsheet, node kinds, flow operators, timeline beats, universal ingestion, AI MCP configuration, and CI/CD governance."
  canonicalURL="https://markdy.com/docs/"
  keywords="Markdy documentation, MarkdyScript tutorial, diagram as code reference, animated architecture diagrams, mermaid alternative, system design diagrams, MCP server diagrams, AI diagram generator, architecture governance"
  structuredData={docStructuredData}
>
  <!-- ─── Docs Topbar ─────────────────────────────────────────────────── -->
  <header class="docs-topbar">
    <div class="topbar-inner">
      <a href="/" class="topbar-brand">
        <span class="brand-badge">🎬</span>
        <span class="brand-name">markdy</span>
        <span class="brand-doc-pill">docs</span>
      </a>

      <nav class="topbar-nav" aria-label="Documentation Navigation">
        <a href="#quickstart">Quickstart</a>
        <a href="#grammar">Syntax &amp; Grammar</a>
        <a href="#node-kinds">Nodes</a>
        <a href="#flows">Flows</a>
        <a href="#beats">Beats &amp; Cues</a>
        <a href="#ingestion">Ingestion</a>
        <a href="#mcp">AI &amp; MCP</a>
        <a href="#governance">Governance</a>
      </nav>

      <div class="topbar-actions">
        <a href="/playground/" class="btn-topbar-studio">
          <span>⚡ Studio</span>
        </a>
        <a href="https://github.com/HoangYell/markdy-com" target="_blank" rel="noopener noreferrer" class="btn-topbar-gh">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <button id="theme-toggle" class="btn-topbar-theme" aria-label="Toggle theme">
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- ─── Docs Layout Container ────────────────────────────────────────── -->
  <div class="docs-container">
    <!-- Sidebar Navigation -->
    <aside class="docs-sidebar" aria-label="Documentation Table of Contents">
      <div class="sidebar-group">
        <span class="sidebar-title">Getting Started</span>
        <a href="#quickstart" class="sidebar-link active">60-Second Quickstart</a>
        <a href="#concepts" class="sidebar-link">Core Philosophy</a>
      </div>

      <div class="sidebar-group">
        <span class="sidebar-title">MarkdyScript Grammar</span>
        <a href="#grammar" class="sidebar-link">Scene Declaration</a>
        <a href="#node-kinds" class="sidebar-link">Semantic Node Kinds</a>
        <a href="#groups" class="sidebar-link">Groups &amp; Subsystems</a>
        <a href="#flows" class="sidebar-link">Flow Operators &amp; Routing</a>
        <a href="#beats" class="sidebar-link">Timeline Beats &amp; Cues</a>
      </div>

      <div class="sidebar-group">
        <span class="sidebar-title">Ecosystem &amp; Tooling</span>
        <a href="#ingestion" class="sidebar-link">Universal Ingestion</a>
        <a href="#mcp" class="sidebar-link">AI Coding &amp; MCP Server</a>
        <a href="#governance" class="sidebar-link">Architecture Governance</a>
        <a href="#frameworks" class="sidebar-link">Astro, MDX &amp; React</a>
        <a href="#packages" class="sidebar-link">Package Directory</a>
      </div>
    </aside>

    <!-- Main Documentation Content -->
    <main class="docs-main">
      <!-- ─── Hero Header ──────────────────────────────────────────────── -->
      <section class="doc-header-block">
        <span class="doc-badge">Developer Reference</span>
        <h1>Markdy Documentation</h1>
        <p class="doc-lead">
          Markdy is a diagram-native DSL for creating animated architecture diagrams from reviewable, version-controlled plain text. 
          Markdy compiles declarations into fluid Web Animations API motion without canvas overhead or manual coordinate math.
        </p>
        <div class="doc-header-ctas">
          <a href="/playground/" class="btn-doc-primary">⚡ Open Interactive Studio</a>
          <a href="https://github.com/HoangYell/markdy-com" target="_blank" rel="noopener noreferrer" class="btn-doc-secondary">View GitHub Repository ↗</a>
        </div>
      </section>

      <!-- ─── 1. Quickstart ────────────────────────────────────────────── -->
      <section id="quickstart" class="doc-section">
        <h2 class="section-heading">60-Second Quickstart</h2>
        <p>Install the Markdy CLI, create your first <code>.markdy</code> scene, and compile it to an interactive HTML preview:</p>

        <div class="doc-code-card">
          <div class="code-header">
            <span class="code-title">Terminal</span>
            <button class="doc-copy-btn" data-code="npm install -g @markdy/cli\nmarkdy init architecture.markdy\nmarkdy render architecture.markdy --open">Copy</button>
          </div>
          <pre><code># 1. Install Markdy CLI globally (or run with npx)
npm install -g @markdy/cli

# 2. Render and open your animated architecture diagram in the browser
markdy render architecture.markdy --open</code></pre>
        </div>

        <p class="mt-4">Here is a complete, runnable <code>architecture.markdy</code> scene:</p>

        <div class="doc-code-card">
          <div class="code-header">
            <span class="code-title">architecture.markdy</span>
            <button class="doc-copy-btn" data-code={`scene "Cache-Aside Architecture" theme=paper layout=LR

client WebBrowser "Client App"
gateway ApiGateway "API Gateway"
cache RedisCluster "Redis Cache"
database PostgresDB "PostgreSQL (Master)"

group caching: RedisCluster
group persistence: PostgresDB

beat setup "Initial System Reveal":
  show $nodes stagger=60ms

beat flow "Cache Lookup & Fallback":
  WebBrowser -> ApiGateway "GET /product/42"
  ApiGateway -> RedisCluster "1. Check Cache (MISS)"
  ApiGateway -> PostgresDB "2. Query Database"
  ApiGateway -> RedisCluster "3. Populate Cache"
  WebBrowser <- ApiGateway "200 OK (JSON)"`}>Copy</button>
          </div>
          <pre><code>scene "Cache-Aside Architecture" theme=paper layout=LR

client WebBrowser "Client App"
gateway ApiGateway "API Gateway"
cache RedisCluster "Redis Cache"
database PostgresDB "PostgreSQL (Master)"

group caching: RedisCluster
group persistence: PostgresDB

beat setup "Initial System Reveal":
  show $nodes stagger=60ms

beat flow "Cache Lookup & Fallback":
  WebBrowser -> ApiGateway "GET /product/42"
  ApiGateway -> RedisCluster "1. Check Cache (MISS)"
  ApiGateway -> PostgresDB "2. Query Database"
  ApiGateway -> RedisCluster "3. Populate Cache"
  WebBrowser <- ApiGateway "200 OK (JSON)"</code></pre>
        </div>
      </section>

      <!-- ─── 2. Grammar & Scene ───────────────────────────────────────── -->
      <section id="grammar" class="doc-section">
        <h2 class="section-heading">Scene Declaration</h2>
        <p>Every Markdy script starts with an optional <code>scene</code> header declaring canvas metadata, visual theme, and reading direction:</p>

        <div class="doc-code-card">
          <pre><code>scene "System Title" theme=paper layout=LR width=1280 height=720</code></pre>
        </div>

        <div class="table-wrap mt-4">
          <table class="doc-table">
            <thead>
              <tr>
                <th>Property</th>
                <th>Options / Format</th>
                <th>Default</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>theme</code></td>
                <td><code>paper</code>, <code>editorial</code>, <code>terminal</code>, <code>sketchy</code>, <code>blueprint</code>, <code>midnight</code>, <code>graphite</code>, <code>nebula</code></td>
                <td><code>paper</code></td>
                <td>Visual presentation theme tailored for publication and documentation.</td>
              </tr>
              <tr>
                <td><code>layout</code></td>
                <td><code>LR</code> (Left to Right), <code>TB</code> (Top to Bottom), <code>RL</code>, <code>BT</code></td>
                <td><code>LR</code></td>
                <td>Primary topological flow direction for the automated DAG router.</td>
              </tr>
              <tr>
                <td><code>type</code></td>
                <td><code>architecture</code>, <code>flowchart</code>, <code>sequence</code>, <code>state</code>, <code>tree</code>, <code>layers</code>, <code>nested</code>, <code>timeline</code>, <code>gantt</code>, <code>venn</code>, <code>radar</code>, <code>medallion</code>, <code>flywheel</code>, <code>constellation</code></td>
                <td><code>architecture</code></td>
                <td>Specialized layout engine tailoring node placement and edge routing.</td>
              </tr>
              <tr>
                <td><code>width</code> / <code>height</code></td>
                <td>Pixel numbers (e.g. <code>width=1280 height=760</code>)</td>
                <td><code>1280x760</code></td>
                <td>Virtual canvas viewport dimension for responsive auto-scaling.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ─── 3. Semantic Node Kinds ──────────────────────────────────── -->
      <section id="node-kinds" class="doc-section">
        <h2 class="section-heading">Semantic Node Kinds</h2>
        <p>Markdy uses semantic node declarations. Rather than generic boxes, each node kind automatically receives domain-specific styling, iconography, and rendering metadata:</p>

        <div class="table-wrap mt-4">
          <table class="doc-table">
            <thead>
              <tr>
                <th>Kind</th>
                <th>Icon</th>
                <th>Description</th>
                <th>Syntax Example</th>
              </tr>
            </thead>
            <tbody>
              {NODE_KINDS.map(k => (
                <tr>
                  <td><code>{k.kind}</code></td>
                  <td><span class="table-icon">{k.icon}</span></td>
                  <td>{k.desc}</td>
                  <td><code class="code-sm">{k.example}</code></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ─── 4. Groups & Subsystems ───────────────────────────────────── -->
      <section id="groups" class="doc-section">
        <h2 class="section-heading">Groups &amp; Subsystem Boundaries</h2>
        <p>Declare logical architectural boundaries, network VPCs, Kubernetes namespaces, or cluster tiers using the <code>group</code> keyword:</p>

        <div class="doc-code-card">
          <pre><code>{`# Syntax: group <group_id> [label="Display Title"]: <node1> <node2> ...
group ingress "Public Ingress Tier": WebClient ApiGateway
group storage "Data Persistence": RedisCluster PostgresDB`}</code></pre>
        </div>
      </section>

      <!-- ─── 5. Flow Operators & Routing ──────────────────────────────── -->
      <section id="flows" class="doc-section">
        <h2 class="section-heading">Flow Operators &amp; Routing</h2>
        <p>Markdy provides 6 expressive flow operators to distinguish synchronous requests, asynchronous event streams, and streaming data pipes:</p>

        <div class="table-wrap mt-4">
          <table class="doc-table">
            <thead>
              <tr>
                <th>Operator</th>
                <th>Name</th>
                <th>Behavior</th>
                <th>Example</th>
              </tr>
            </thead>
            <tbody>
              {FLOW_OPERATORS.map(f => (
                <tr>
                  <td><code>{f.op}</code></td>
                  <td><strong>{f.name}</strong></td>
                  <td>{f.desc}</td>
                  <td><code class="code-sm">{f.syntax}</code></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 class="subsection-heading mt-6">Multi-Hop Chaining</h3>
        <p>Chain multi-stage operations cleanly on a single line:</p>
        <div class="doc-code-card">
          <pre><code>WebApp -> ApiGateway "POST /checkout" -> PaymentWorker "charge" -> PostgresDB "save"</code></pre>
        </div>
      </section>

      <!-- ─── 6. Timeline Beats & Cues ─────────────────────────────────── -->
      <section id="beats" class="doc-section">
        <h2 class="section-heading">Timeline Beats &amp; Motion Choreography</h2>
        <p>Markdy diagrams are animated through discrete <strong>beats</strong>. Each beat represents a step in a walkthrough, story, or lifecycle:</p>

        <div class="table-wrap mt-4">
          <table class="doc-table">
            <thead>
              <tr>
                <th>Cue Directive</th>
                <th>Description</th>
                <th>Example</th>
              </tr>
            </thead>
            <tbody>
              {BEAT_CUES.map(c => (
                <tr>
                  <td><code>{c.cue}</code></td>
                  <td>{c.desc}</td>
                  <td><code class="code-sm">{c.example}</code></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ─── 7. Universal Ingestion ───────────────────────────────────── -->
      <section id="ingestion" class="doc-section">
        <h2 class="section-heading">Universal Ingestion &amp; 1-Click Migration</h2>
        <p>Convert existing static architecture files directly into animated MarkdyScript using <code>@markdy/compat</code>:</p>

        <div class="ingestion-table-grid mt-4">
          <div class="ingest-card">
            <h4>Mermaid.js (Flowcharts &amp; Sequences)</h4>
            <p>Converts graph TD/LR and sequence diagrams to MarkdyScript.</p>
            <pre><code>markdy import flow.mmd --out flow.markdy</code></pre>
          </div>
          <div class="ingest-card">
            <h4>Docker Compose</h4>
            <p>Extracts services, network links, volumes, and ports into clustered scenes.</p>
            <pre><code>markdy import docker-compose.yml</code></pre>
          </div>
          <div class="ingest-card">
            <h4>Kubernetes YAML</h4>
            <p>Maps Ingress, Service, Deployment, Pod, and PVC tiers into nested groups.</p>
            <pre><code>markdy import k8s-manifest.yaml</code></pre>
          </div>
          <div class="ingest-card">
            <h4>Terraform State</h4>
            <p>Extracts cloud VPCs, subnets, databases, and gateways into layered architectures.</p>
            <pre><code>markdy import terraform.tfstate</code></pre>
          </div>
        </div>
      </section>

      <!-- ─── 8. AI Coding & MCP Server ────────────────────────────────── -->
      <section id="mcp" class="doc-section">
        <h2 class="section-heading">AI Coding Agents &amp; Official MCP Server</h2>
        <p>Connect Claude Desktop, Cursor, Antigravity, or any LLM agent to the official Model Context Protocol server:</p>

        <div class="doc-code-card">
          <div class="code-header">
            <span class="code-title">Claude Desktop / Cursor MCP Config</span>
            <button class="doc-copy-btn" data-code={`{
  "mcpServers": {
    "markdy": {
      "command": "npx",
      "args": ["-y", "@markdy/mcp-server"]
    }
  }
}`}>Copy</button>
          </div>
          <pre><code>{`{
  "mcpServers": {
    "markdy": {
      "command": "npx",
      "args": ["-y", "@markdy/mcp-server"]
    }
  }
}`}</code></pre>
        </div>

        <p class="mt-4">
          AI agents can access <a href="/AGENT.md"><code>markdy.com/AGENT.md</code></a> and call <code>validate_markdy_script</code> to test and self-heal diagrams during generation.
        </p>
      </section>

      <!-- ─── 9. Architecture Governance ───────────────────────────────── -->
      <section id="governance" class="doc-section">
        <h2 class="section-heading">Architecture Governance &amp; CI/CD Linter</h2>
        <p>Integrate automated Well-Architected governance checks in your continuous integration pipeline:</p>

        <div class="table-wrap mt-4">
          <table class="doc-table">
            <thead>
              <tr>
                <th>Rule ID</th>
                <th>Severity</th>
                <th>Enforcement Rule</th>
              </tr>
            </thead>
            <tbody>
              {GOVERNANCE_RULES.map(r => (
                <tr>
                  <td><code>{r.id}</code></td>
                  <td><span class={`gov-badge ${r.level === 'BLOCKING' ? 'gov-badge--crit' : 'gov-badge--warn'}`}>{r.level}</span></td>
                  <td>{r.desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ─── 10. Framework Integrations ───────────────────────────────── -->
      <section id="frameworks" class="doc-section">
        <h2 class="section-heading">Framework Integrations: Astro, MDX &amp; React</h2>
        
        <div class="framework-grid mt-4">
          <div class="framework-card">
            <h4>Astro Integration</h4>
            <pre><code>import &#123; Markdy &#125; from "@markdy/astro";

&lt;Markdy code=&#123;sceneCode&#125; autoplay /&gt;</code></pre>
          </div>

          <div class="framework-card">
            <h4>MDX Documentation</h4>
            <pre><code>```markdy
scene "Docs Architecture" theme=paper
client Browser -> service Api -> database DB
```</code></pre>
          </div>
        </div>
      </section>

      <!-- ─── 11. Package Directory ────────────────────────────────────── -->
      <section id="packages" class="doc-section">
        <h2 class="section-heading">Ecosystem Package Directory</h2>
        <div class="pkg-list-grid mt-4">
          <div class="pkg-box">
            <strong>@markdy/core</strong>
            <span>Zero-dep tokenizer, AST parser, semantic diffing, classifier, and linter.</span>
          </div>
          <div class="pkg-box">
            <strong>@markdy/renderer-dom</strong>
            <span>WAAPI motion runtime, zero-dep GIF89a encoder, and SVG vector exporter.</span>
          </div>
