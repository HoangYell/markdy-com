---
import Layout from "../../layouts/Layout.astro";
import { getAgentReference } from "../../lib/agent-reference";

const reference = await getAgentReference();

const prompt = `Before generating MarkdyScript, read and follow ${reference.canonicalMarkdownUrl}. Use the current syntax from that page, not older examples from model memory.`;

const structuredData = [
  {
    "@type": "TechArticle",
    "@id": "https://markdy.com/agent/#article",
    headline: "MarkdyScript AI Agent Reference",
    description: "Canonical AI-facing MarkdyScript reference for ChatGPT, Gemini, coding agents, crawlers, and other LLM tools.",
    url: reference.humanUrl,
    inLanguage: "en",
    isPartOf: { "@id": "https://markdy.com/#website" },
    about: { "@id": "https://markdy.com/#software" },
    encodingFormat: "text/html",
    mainEntityOfPage: reference.humanUrl,
    version: reference.version,
    dateModified: reference.timeUpdated,
    sameAs: [reference.canonicalMarkdownUrl, reference.githubUrl, reference.fullContextUrl],
  },
  {
    "@type": "CreativeWork",
    "@id": "https://markdy.com/AGENT.md#markdown",
    name: "MarkdyScript AI Agent Reference Markdown",
    url: reference.canonicalMarkdownUrl,
    encodingFormat: "text/markdown",
    version: reference.version,
    dateModified: reference.timeUpdated,
    isBasedOn: reference.githubUrl,
    about: { "@id": "https://markdy.com/#software" },
  },
];
---

<Layout
  title="MarkdyScript AI Agent Reference — Current Syntax for LLMs"
  description="Canonical, crawlable MarkdyScript reference for ChatGPT, Gemini, coding agents, and search crawlers. Generated from AGENT.md so every public AI surface stays in sync."
  canonicalURL={reference.humanUrl}
  keywords="MarkdyScript AI agent reference, llms.txt, ChatGPT Markdy, Gemini Markdy, AI generated architecture diagrams, diagram DSL syntax"
  structuredData={structuredData}
>
  <main class="agent-page">
    <a href="/docs/" class="back-link">Back to docs</a>

    <header class="hero">
      <div class="hero-header-split">
        <div class="hero-header-content">
          <div class="hero-top">
            <span class="kicker">AI agent reference</span>
            <div class="meta-strip" aria-label="Specification metadata">
              <span class="meta-badge status"><span class="meta-dot"></span> {reference.status}</span>
              <span class="meta-badge version"><strong>Version</strong> v{reference.version}</span>
              <span class="meta-badge spec"><strong>Spec</strong> {reference.specVersion}</span>
              <span class="meta-badge time"><strong>Updated</strong> <time datetime={reference.timeUpdated}>{reference.timeUpdated}</time></span>
            </div>
          </div>
          <h1>Current MarkdyScript syntax for AI tools</h1>
          <p>
            This page is generated from the same source as the repository guide:
            <a href={reference.githubUrl} target="_blank" rel="noopener noreferrer">AGENT.md</a>.
            The raw Markdown, LLM index, and full context bundle are rebuilt from that file so agents do not drift across releases.
          </p>
        </div>
        <div class="hero-mascot-badge" aria-hidden="true">
          <img
            src="/images/male-markdy-ads.webp"
            alt="Markdy AI Mascot"
            class="agent-hero-mascot-img"
            width="160"
            height="160"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
          />
        </div>
      </div>
    </header>

    <section class="surface-grid" aria-label="AI documentation entry points">
      <a class="surface-card primary" href="/AGENT.md">
        <span>Canonical Markdown</span>
        <strong>/AGENT.md</strong>
        <p>Best URL to give ChatGPT, Gemini, Copilot, Cursor, Windsurf, and other agents before they generate MarkdyScript.</p>
      </a>
      <a class="surface-card" href="/llms.txt">
        <span>LLM index</span>
        <strong>/llms.txt</strong>
        <p>Short machine-readable entry point that points tools to the latest canonical Markdy syntax guide.</p>
      </a>
      <a class="surface-card" href="/llms-full.txt">
        <span>Full context</span>
        <strong>/llms-full.txt</strong>
        <p>A single text bundle that includes the complete agent reference for tools that prefer one fetch.</p>
      </a>
    </section>

    <section class="prompt-box" aria-labelledby="prompt-title">
      <div>
        <span class="kicker">Recommended instruction</span>
        <h2 id="prompt-title">Tell AI tools to fetch the guide first</h2>
        <p class="prompt-subtitle">Copy and paste this instruction into Claude, Cursor, ChatGPT, or Antigravity before asking for a diagram:</p>
      </div>
      <div class="prompt-code-wrap">
        <pre><code id="prompt-content">{prompt}</code></pre>
        <button id="copy-prompt-btn" class="copy-action-btn copy-btn" type="button" aria-label="Copy instruction to clipboard">
          <span class="btn-text">Copy Instruction</span>
        </button>
      </div>
    </section>

    <!-- ── 1-Click MCP Server Installation ── -->
    <section class="mcp-section" aria-labelledby="mcp-section-title">
      <div class="mcp-section-header">
        <span class="kicker">Model Context Protocol</span>
        <h2 id="mcp-section-title">Official Markdy MCP Server</h2>
        <p class="mcp-section-desc">Equip AI Coding Agents with instant syntax validation, AST repair, and universal transpilation tools via MCP:</p>
        <div class="mcp-oneclick-badges">
          <a class="mcp-badge-btn" href="cursor://anysphere.cursor-deeplink/mcp/install?name=markdy&config=eyJjb21tYW5kIjoibnB4IiwiYXJncyI6WyIteSIsIkBtYXJrZHkvbWNwLXNlcnZlciJdfQ%3D%3D" title="1-Click Install in Cursor">
            <img src="https://img.shields.io/badge/⚡_Install_in-Cursor-000000?style=for-the-badge&logo=cursor&logoColor=white" alt="Install in Cursor" />
          </a>
          <a class="mcp-badge-btn" href="vscode:mcp/install?%7B%22name%22%3A%22markdy%22%2C%22command%22%3A%22npx%22%2C%22args%22%3A%5B%22-y%22%2C%22%40markdy%2Fmcp-server%22%5D%7D" title="1-Click Install in VS Code">
            <img src="https://img.shields.io/badge/⚡_Install_in-VS_Code-007ACC?style=for-the-badge&logo=visualstudiocode&logoColor=white" alt="Install in VS Code" />
          </a>
          <a class="mcp-badge-btn" href="#mcp-config-preview-id" title="Setup in Google Antigravity">
            <img src="https://img.shields.io/badge/⚡_Setup_in-Antigravity-4285F4?style=for-the-badge&logo=google&logoColor=white" alt="Setup in Antigravity" />
          </a>
        </div>
      </div>
      <div id="mcp-config-preview-id" class="mcp-config-preview">
        <div class="mcp-config-tag">1-Command CLI Quick Install (Claude Code &amp; Antigravity):</div>
        <pre class="mcp-pre"><code>{`# Claude Code CLI:
claude mcp add markdy -- npx -y @markdy/mcp-server

# Google Antigravity CLI:
agy mcp add markdy -- npx -y @markdy/mcp-server`}</code></pre>
        <div class="mcp-config-tag" style="margin-top: 0.5rem;">JSON Configuration (Claude Desktop, Cursor, Antigravity, Cline, Zed):</div>
        <pre class="mcp-pre"><code>{`{
  "mcpServers": {
    "markdy": {
      "command": "npx",
      "args": ["-y", "@markdy/mcp-server"]
    }
  }
}`}</code></pre>
      </div>
    </section>

    <section class="source-panel" aria-labelledby="source-title">
      <div class="source-heading">
        <div>
          <span class="kicker">Generated from source</span>
          <h2 id="source-title">AGENT.md</h2>
        </div>
        <div class="source-actions">
          <span class="version">Markdy v{reference.version}</span>
          <button id="copy-spec-btn" class="copy-action-btn-sm" type="button">Copy Spec</button>
          <a class="download-spec-link" href="/AGENT.md" download="AGENT.md">Download .md</a>
        </div>
      </div>
      <pre class="agent-source"><code id="agent-source-content">{reference.content}</code></pre>
    </section>
  </main>

  <script>
    const copyPromptBtn = document.getElementById("copy-prompt-btn");
    const copySpecBtn = document.getElementById("copy-spec-btn");
    const promptCode = document.getElementById("prompt-content");
    const specCode = document.getElementById("agent-source-content");

    async function copyText(text: string, button: HTMLElement, successText = "Copied!") {
      try {
        await navigator.clipboard.writeText(text);
        const originalText = button.textContent;
        button.textContent = successText;
        button.classList.add("copied");
        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove("copied");
        }, 2000);
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        document.body.removeChild(textarea);
        button.textContent = successText;
        setTimeout(() => {
          button.textContent = "Copy";
        }, 2000);
      }
    }

    copyPromptBtn?.addEventListener("click", () => {
      if (promptCode?.textContent) {
        copyText(promptCode.textContent.trim(), copyPromptBtn, "✓ Copied!");
      }
    });

    copySpecBtn?.addEventListener("click", () => {
      if (specCode?.textContent) {
        copyText(specCode.textContent, copySpecBtn, "✓ Copied Spec!");
      }
    });
  </script>
</Layout>

<style>
  .agent-page {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: max(3.5rem, calc(2.5rem + var(--sat))) 0 4rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--accent, #047857);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .hero {
    max-width: 860px;
    margin-bottom: 2rem;
  }

  .hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .meta-strip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .meta-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    background: var(--surface, #ffffff);
    color: var(--text-secondary, #475569);
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .meta-badge strong {
    color: var(--text-primary, #0f172a);
    font-weight: 600;
  }

  .meta-badge.version,
  .meta-badge.spec,
  .meta-badge.time time {
    font-family: "JetBrains Mono", monospace;
  }

  .meta-badge.status {
    border-color: rgba(4, 120, 87, 0.25);
    background: rgba(16, 185, 129, 0.08);
    color: var(--accent, #047857);
    font-weight: 700;
  }

  .meta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent, #047857);
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
  }

  .hero-header-split {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .hero-header-content {
    flex: 1;
  }

  .hero-mascot-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .agent-hero-mascot-img {
    width: 160px;
    height: 160px;
    object-fit: contain;
    filter: drop-shadow(0 14px 32px rgba(4, 120, 87, 0.24));
    animation: agent-float 4s ease-in-out infinite alternate;
  }

  @keyframes agent-float {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(-8px) rotate(2deg); }
  }

  @media (max-width: 820px) {
    .hero-header-split {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-mascot-badge {
      display: none;
    }
  }

  .hero h1 {
    margin: 0.4rem 0 1rem;
    color: var(--text-primary, #0f172a);
    font-size: clamp(2rem, 6vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .hero p,
  .surface-card p {
    color: var(--text-secondary, #475569);
  }

  .hero a {
    color: var(--accent, #047857);
    font-weight: 700;
  }

  .kicker {
    color: var(--accent, #047857);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .surface-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }

  .surface-card,
  .prompt-box,
  .mcp-section,
  .source-panel {
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 24px;
    background: var(--surface, #ffffff);
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.06);
  }

  .mcp-section {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background:
      radial-gradient(circle at bottom left, rgba(56, 189, 248, 0.08), transparent 50%),
      var(--surface, #ffffff);
  }

  .mcp-section-header h2 {
    margin-top: 0.35rem;
    color: var(--text-primary, #0f172a);
    line-height: 1.15;
  }

  .mcp-section-desc {
    margin-top: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--text-secondary, #475569);
  }

  .mcp-oneclick-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .mcp-badge-btn {
    display: inline-block;
    transition: transform 0.18s ease;
  }

  .mcp-badge-btn:hover {
    transform: translateY(-2px);
  }

  .mcp-config-preview {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mcp-config-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary, #64748b);
  }

  .mcp-pre {
    padding: 0.85rem 1rem;
    font-size: 0.78rem;
  }

  @media (max-width: 860px) {
    .mcp-section {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .surface-card {
    display: flex;
    min-height: 210px;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.35rem;
  }

  .surface-card.primary {
    border-color: rgba(4, 120, 87, 0.35);
    background:
      radial-gradient(circle at top right, rgba(16, 185, 129, 0.14), transparent 42%),
      var(--surface, #ffffff);
  }

  .surface-card span {
    color: var(--accent, #047857);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .surface-card strong {
    color: var(--text-primary, #0f172a);
    font-family: "JetBrains Mono", monospace;
    font-size: 1.35rem;
  }

  .prompt-box {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2rem;
    padding: 1.35rem;
  }

  .prompt-box h2,
  .source-heading h2 {
    margin-top: 0.35rem;
    color: var(--text-primary, #0f172a);
    line-height: 1.1;
  }

  pre {
    overflow: auto;
    margin: 0;
    border-radius: 18px;
    background: #0f172a;
    color: #e2e8f0;
    -webkit-overflow-scrolling: touch;
  }

  .prompt-subtitle {
    margin-top: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .prompt-code-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .copy-action-btn {
    align-self: flex-start;
  }

  .copy-action-btn-sm.copied {
    background: #10b981;
    color: #ffffff;
  }

  .source-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .copy-action-btn-sm,
  .download-spec-link {
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    background: var(--surface, #ffffff);
    color: var(--text-primary, #0f172a);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .copy-action-btn-sm:hover,
  .download-spec-link:hover {
    border-color: var(--accent, #047857);
    color: var(--accent, #047857);
    background: rgba(16, 185, 129, 0.06);
  }

  .prompt-box pre {
    padding: 1rem;
    white-space: pre-wrap;
  }

  .source-panel {
    padding: 1.35rem;
  }

  .source-heading {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .version {
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 999px;
    padding: 0.45rem 0.75rem;
    color: var(--text-secondary, #475569);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .agent-source {
    max-height: 72vh;
    padding: 1.2rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .surface-grid,
    .prompt-box {
      grid-template-columns: 1fr;
    }

    .source-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (max-width: 640px) {
    .agent-page {
      width: calc(100% - 1.5rem);
      padding: max(2.5rem, calc(2rem + var(--sat))) 0 3rem;
    }
    .surface-card,
    .prompt-box,
    .source-panel {
      padding: 1rem;
      border-radius: 16px;
    }
    .agent-source {
      padding: 0.85rem;
      font-size: 0.82rem;
    }
  }
</style>
