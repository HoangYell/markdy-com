    icon: "🔄",
    types: [
      { name: "timeline", label: "type=timeline", desc: "Horizontal hairline baseline with alternating milestone placement." },
      { name: "gantt", label: "type=gantt", desc: "Phase-based horizontal bar stacking with phase and span properties." },
      { name: "medallion", label: "type=medallion", desc: "Multi-tier Bronze → Silver → Gold lakehouse data stages." },
      { name: "flywheel", label: "type=flywheel", desc: "Circular closed-loop compounding engine with tangential flow paths." },
