      { name: "architecture", label: "type=architecture", desc: "Ranked DAG topology with smart obstacle-avoiding edge routing (default)." },
      { name: "flowchart", label: "type=flowchart", desc: "Top-down decision branches, conditional routing, and pipeline steps." },
      { name: "tree", label: "type=tree", desc: "Parent/child hierarchies with shared horizontal sibling buses." },
      { name: "state", label: "type=state", desc: "Cycle-safe state machine transitions, loops, and self-referencing arcs." },
      { name: "sequence", label: "type=sequence", desc: "Participant columns, lifelines, ordered messages, and activation spans." },
    ],
  },
  {
    category: "Structure & Security Boundaries",
    icon: "🛡️",
    types: [
      { name: "layers", label: "type=layers", desc: "Full-width horizontal stacked abstraction bands (OSI, CSS cascade, memory)." },
      { name: "nested", label: "type=nested", desc: "Concentric rounded boundaries with stepped insets for defense-in-depth." },
      { name: "swimlane", label: "type=swimlane", desc: "Cross-functional team lanes and multi-actor handoff tracks." },
    ],
  },
