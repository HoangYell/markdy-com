---
import Layout from "../layouts/Layout.astro";
import { join } from "node:path";
import { loadExamples } from "../data/examples";

const ROOT = join(process.cwd(), "..");
const EXAMPLES = await loadExamples(ROOT);

const FLOWER_ASSET: Record<string, string> = {
  flower: "data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'36'%20height%3D'36'%3E%3Ccircle%20cx%3D'18'%20cy%3D'18'%20r%3D'16'%20fill%3D'%23ff69b4'%2F%3E%3Ccircle%20cx%3D'18'%20cy%3D'18'%20r%3D'6'%20fill%3D'%23ffff00'%2F%3E%3C%2Fsvg%3E",
};

const PILLARS = [
  {
    icon: "🧭",
    title: "Diagram-Native DSL & Motion",
    desc: "Declare semantic nodes, groups, flows, and timed beats in reviewable text. Layout, collision avoidance, and choreography are 100% automatic.",
    tag: "Core Engine",
    href: "/docs/#grammar",
  },
  {
    icon: "🔄",
    title: "Universal Ingestion",
    desc: "1-click transpilation from Mermaid flowcharts, Draw.io XML, Docker Compose, Kubernetes YAML, and Terraform state into animated scenes.",
    tag: "Compat",
    href: "#ingestion",
  },
  {
    icon: "🤖",
    title: "AI-Native & MCP Server",
    desc: "Official Model Context Protocol server for Claude, Cursor, and Antigravity with self-healing syntax diagnostics and prompt templates.",
    tag: "MCP Server",
    href: "#ai-gen",
  },
  {
    icon: "🛡️",
    title: "Architecture Governance",
    desc: "Automated CI/CD linter catches deadlock cycles, cross-layer bypasses, ungrounded services, and outputs semantic PR diffs.",
    tag: "CI/CD Linter",
    href: "#governance",
  },
];

const SIGNATURE_PRESETS = [
  { name: "⚡ Cache-Aside (Redis)", index: 0 },
  { name: "📬 Kafka Stream & Fan-Out", index: 1 },
  { name: "☸️ Kubernetes Ingress Cluster", index: 4 },
  { name: "🔐 OAuth2 JWT Handshake", index: 3 },
];

const AI_TOOLS = [
  { id: "cursor", name: "Cursor", badge: "Composer / Agent", tip: "In Cursor Composer (Cmd+I / Cmd+L), paste the prompt referencing @https://markdy.com/AGENT.md or configure @markdy/mcp-server for instant diagram generation." },
  { id: "claude", name: "Claude", badge: "Desktop / Web", tip: "Give Claude URL context with https://markdy.com/AGENT.md or connect @markdy/mcp-server for automated AST validation and self-healing diagrams." },
  { id: "copilot", name: "GitHub Copilot", badge: "VS Code / CLI", tip: "Paste the prompt into GitHub Copilot Chat referencing https://markdy.com/AGENT.md for clean node kinds and choreographed flow operators." },
  { id: "opencode", name: "Open Code", badge: "Terminal / IDE", tip: "Pass the canonical AGENT.md reference URL to Open Code to generate structured, deterministic Markdy architecture scenes." },
  { id: "antigravity", name: "Antigravity", badge: "Autonomous Agent", tip: "Antigravity uses native MCP tools and docs/AGENT.md to autonomously draft, compile, and lint architecture diagrams in your workspace." },
  { id: "chatgpt", name: "ChatGPT", badge: "GPT-4o / Canvas", tip: "Paste the hosted guide link https://markdy.com/AGENT.md and prompt directly into ChatGPT or GPT-4o Canvas for valid MarkdyScript." },
];

const AI_PROMPT_PRESETS = [
  {
    id: "url-shortener",
    name: "🔗 URL Shortener Architecture",
    exampleIndex: 0,
    target: "Design a URL Shortener architecture",
    prompt: `Follow https://markdy.com/AGENT.md and generate one complete MarkdyScript scene:
"Design a URL Shortener architecture: a user creates a short link via API Gateway and URL Shortener service, writes to PostgreSQL and warms Redis cache. Then a visitor opens the short link and gets redirected 301 from cache or DB fallback. Use beats for each step and highlight the cache hit path."`,
  },
  {
    id: "twitter-timeline",
    name: "📬 Kafka Stream & Fan-Out",
    exampleIndex: 1,
    target: "Twitter Timeline Fan-Out Service",
    prompt: `Follow https://markdy.com/AGENT.md and generate one complete MarkdyScript scene:
"Design a real-time event streaming and timeline fan-out service: User posts a tweet, Ingress forwards to TweetService, event publishes to Kafka queue, TimelineWorker consumes and fans out to Redis timelines of active followers."`,
  },
  {
    id: "k8s-cluster",
    name: "☸️ Kubernetes Ingress Cluster",
    exampleIndex: 4,
    target: "Kubernetes Cluster Ingress & Pods",
    prompt: `Follow https://markdy.com/AGENT.md and generate one complete MarkdyScript scene:
"Design a Kubernetes Cluster Architecture: Internet traffic arrives at IngressController, routes to order-service Pods in the cluster group, connects to PostgreSQL database, with a finish glow beat on the cluster."`,
  },
  {
    id: "oauth-flow",
    name: "🔐 OAuth2 JWT Handshake",
    exampleIndex: 3,
    target: "OAuth2 / OIDC Login Handshake",
    prompt: `Follow https://markdy.com/AGENT.md and generate one complete MarkdyScript scene:
"Design an OAuth2 / OIDC login flow: User clicks login on Browser, redirects to AuthServer, exchanges authorization code for JWT token, and passes Bearer token to Backend API."`,
  },
];

const LAYOUT_CATEGORIES = [
  {
    category: "Architecture & Systems",
    icon: "🏗️",
