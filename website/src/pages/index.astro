---
import Layout from "../layouts/Layout.astro";
import { join } from "node:path";
import { loadExamples } from "../data/examples";

const ROOT = join(process.cwd(), "..");
const EXAMPLES = await loadExamples(ROOT);

const FLOWER_ASSET: Record<string, string> = {
  flower: "data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'36'%20height%3D'36'%3E%3Ccircle%20cx%3D'18'%20cy%3D'18'%20r%3D'16'%20fill%3D'%23ff69b4'%2F%3E%3Ccircle%20cx%3D'18'%20cy%3D'18'%20r%3D'6'%20fill%3D'%23ffff00'%2F%3E%3C%2Fsvg%3E",
};

const PILLARS = [
  {
    icon: "🧭",
    title: "Diagram-Native DSL & Motion",
    desc: "Declare semantic nodes, groups, flows, and timed beats in reviewable text. Layout, collision avoidance, and choreography are 100% automatic.",
    tag: "Core Engine",
    href: "/docs/#grammar",
  },
  {
    icon: "🔄",
    title: "Universal Ingestion",
    desc: "1-click transpilation from Mermaid flowcharts, Draw.io XML, Docker Compose, Kubernetes YAML, and Terraform state into animated scenes.",
    tag: "Compat",
    href: "#ingestion",
  },
  {
    icon: "🤖",
    title: "AI-Native & MCP Server",
    desc: "Official Model Context Protocol server for Claude, Cursor, and Antigravity with self-healing syntax diagnostics and prompt templates.",
    tag: "MCP Server",
    href: "#ai-gen",
  },
  {
    icon: "🛡️",
    title: "Architecture Governance",
    desc: "Automated CI/CD linter catches deadlock cycles, cross-layer bypasses, ungrounded services, and outputs semantic PR diffs.",
    tag: "CI/CD Linter",
    href: "#governance",
  },
];

const SIGNATURE_PRESETS = [
  { name: "⚡ Cache-Aside (Redis)", index: 0 },
  { name: "📬 Kafka Stream & Fan-Out", index: 1 },
  { name: "☸️ Kubernetes Ingress Cluster", index: 2 },
  { name: "🔐 OAuth2 JWT Handshake", index: 4 },
];

const LAYOUT_CATEGORIES = [
  {
    category: "Architecture & Systems",
    icon: "🏗️",
    types: [
      { name: "architecture", label: "type=architecture", desc: "Ranked DAG topology with smart obstacle-avoiding edge routing (default)." },
      { name: "flowchart", label: "type=flowchart", desc: "Top-down decision branches, conditional routing, and pipeline steps." },
      { name: "tree", label: "type=tree", desc: "Parent/child hierarchies with shared horizontal sibling buses." },
      { name: "state", label: "type=state", desc: "Cycle-safe state machine transitions, loops, and self-referencing arcs." },
      { name: "sequence", label: "type=sequence", desc: "Participant columns, lifelines, ordered messages, and activation spans." },
    ],
  },
  {
    category: "Structure & Security Boundaries",
    icon: "🛡️",
    types: [
      { name: "layers", label: "type=layers", desc: "Full-width horizontal stacked abstraction bands (OSI, CSS cascade, memory)." },
      { name: "nested", label: "type=nested", desc: "Concentric rounded boundaries with stepped insets for defense-in-depth." },
      { name: "swimlane", label: "type=swimlane", desc: "Cross-functional team lanes and multi-actor handoff tracks." },
    ],
  },
  {
    category: "Pipelines, Roadmaps & Radial",
    icon: "🔄",
    types: [
      { name: "timeline", label: "type=timeline", desc: "Horizontal hairline baseline with alternating milestone placement." },
      { name: "gantt", label: "type=gantt", desc: "Phase-based horizontal bar stacking with phase and span properties." },
      { name: "medallion", label: "type=medallion", desc: "Multi-tier Bronze → Silver → Gold lakehouse data stages." },
      { name: "flywheel", label: "type=flywheel", desc: "Circular closed-loop compounding engine with tangential flow paths." },
      { name: "constellation", label: "type=constellation", desc: "Radial focal-node layout with deterministic orbit decoration." },
    ],
  },
  {
    category: "Curated Publication Themes",
    icon: "🎨",
    types: [
      { name: "paper", label: "theme=paper", desc: "Clean light documentation canvas with high-contrast series palette." },
      { name: "editorial", label: "theme=editorial", desc: "Serif typography, refined ink lines, and muted semantic accents." },
      { name: "terminal", label: "theme=terminal", desc: "Monospace CLI aesthetic with vibrant phosphorescent glow accents." },
      { name: "sketchy", label: "theme=sketchy", desc: "Organic hand-drawn whiteboard style with SVG displacement turbulence." },
      { name: "blueprint", label: "theme=blueprint", desc: "Technical CAD drafting grid with cyan wireframe geometry." },
      { name: "midnight", label: "theme=midnight", desc: "Deep developer canvas with layered glassmorphism elevations." },
    ],
  },
];

const LAYOUT_SNIPPETS: Record<string, string> = {
  architecture: `scene "Microservices Topology" theme=paper\nlayout LR\n\nuser Client\ngateway ApiGateway\nservice Auth\nservice Payments\ndatabase Postgres\n\nbeat flow:\n  show $nodes stagger=60ms\n  Client -> ApiGateway "POST /checkout"\n  ApiGateway -> Auth "verify"\n  ApiGateway -> Payments "charge"\n  Payments -> Postgres "persist"`,
  flowchart: `scene "Decision Flowchart" theme=paper type=flowchart\nlayout TB\n\nclient User\ngateway Validate\nservice Process\nservice Reject\n\nbeat evaluate:\n  show $nodes stagger=70ms\n  User -> Validate "Submit Payload"\n  Validate -> Process "Valid"\n  Validate -> Reject "Invalid"`,
  tree: `scene "Taxonomy Tree" theme=editorial type=tree\nlayout TB\n\nservice Root "Root Domain"\nservice Sub1 "Identity"\nservice Sub2 "Billing"\nservice Sub3 "Storage"\n\nbeat expand:\n  show $nodes stagger=60ms\n  Root -> Sub1\n  Root -> Sub2\n  Root -> Sub3`,
  state: `scene "Connection State Machine" theme=paper type=state\nlayout LR\n\nservice Disconnected\nservice Connecting\nservice Connected\nservice Reconnecting\n\nbeat transition:\n  show $nodes stagger=60ms\n  Disconnected -> Connecting "initiate"\n  Connecting -> Connected "ACK"\n  Connected -> Reconnecting "timeout"\n  Reconnecting -> Connected "retry"`,
  sequence: `scene "OAuth Handshake" theme=paper type=sequence\nlayout LR\n\nuser User\nbrowser App\ngateway AuthServer\nservice Api\n\nbeat handshake:\n  show $nodes stagger=60ms\n  User -> App "Login"\n  App -> AuthServer "GET /auth"\n  AuthServer -> App "Auth Token"\n  App -> Api "GET /data (Bearer Token)"`,
  layers: `scene "OSI Stack Abstraction" theme=editorial type=layers\nlayout TB\n\nservice App "Layer 7: Application"\nservice Transport "Layer 4: Transport (TCP/UDP)"\nservice Network "Layer 3: Network (IP)"\nservice Link "Layer 2: Data Link"\n\nbeat traverse:\n  show $nodes stagger=70ms\n  App -> Transport "Payload"\n  Transport -> Network "Packets"\n  Network -> Link "Frames"`,
  nested: `scene "Kubernetes Security Perimeter" theme=blueprint type=nested\nlayout TB\n\nservice Internet "Public Traffic"\nservice IngressController "DMZ Gateway"\nservice AuthPod "Secure Pod"\nservice SecretsStore "Vault"\n\ngroup public: Internet\ngroup dmz: IngressController\ngroup perimeter: AuthPod SecretsStore\n\nbeat trace:\n  show public\n  show dmz\n  show perimeter\n  Internet -> IngressController "HTTPS"\n  IngressController -> AuthPod "mTLS"\n  AuthPod -> SecretsStore "Fetch Key"`,
  swimlane: `scene "Order Fulfillment Swimlane" theme=paper type=swimlane\nlayout LR\n\nuser Customer\nservice Storefront\nservice Warehouse\nservice Logistics\n\nbeat fulfill:\n  show $nodes stagger=60ms\n  Customer -> Storefront "Place Order"\n  Storefront -> Warehouse "Check Stock"\n  Warehouse -> Logistics "Dispatch Parcel"`,
  timeline: `scene "Release Milestone Timeline" theme=paper type=timeline\nlayout LR\n\nservice V1 "v1.0 Core Engine"\nservice V2 "v2.0 Motion Runtime"\nservice V3 "v3.0 Governance Linter"\nservice V4 "v4.0 MCP AI Integration"\n\nbeat progress:\n  show $nodes stagger=100ms\n  V1 -> V2 -> V3 -> V4`,
  gantt: `scene "Sprint Roadmap" theme=paper type=gantt\nlayout LR\n\nservice Design "Architecture Design"\nservice Core "Parser & Diffing"\nservice UI "Playground Studio"\nservice Docs "Guides & AI Reference"\n\nbeat schedule:\n  show $nodes stagger=80ms\n  Design -> Core -> UI -> Docs`,
  medallion: `scene "Lakehouse Medallion Architecture" theme=editorial type=medallion\nlayout LR\n\nservice Raw "Bronze: Raw Ingest"\nservice Cleansed "Silver: Validated & Clean"\nservice Enriched "Gold: Business Aggregates"\n\nbeat stream:\n  show $nodes stagger=80ms\n  Raw -> Cleansed "dbt Transform"\n  Cleansed -> Enriched "Analytics Model"`,
  flywheel: `scene "Compounding Growth Flywheel" theme=paper type=flywheel\nlayout LR\n\nservice Content "Rich Technical Docs"\nservice Developers "Developer Adoption"\nservice Ecosystem "Plugin Contributions"\nservice Value "Enterprise Value"\n\nbeat cycle:\n  show $nodes stagger=70ms\n  Content -> Developers "engage"\n  Developers -> Ecosystem "build"\n  Ecosystem -> Value "compound"\n  Value -> Content "invest"`,
  constellation: `scene "Distributed Consensus Constellation" theme=nebula type=constellation\nlayout LR\n\nservice Leader "Raft Leader"\nservice Follower1 "Node Alpha"\nservice Follower2 "Node Beta"\nservice Follower3 "Node Gamma"\nservice Follower4 "Node Delta"\n\nbeat sync:\n  show $nodes stagger=60ms\n  Leader -> Follower1 "Heartbeat"\n  Leader -> Follower2 "Heartbeat"\n  Leader -> Follower3 "Heartbeat"\n  Leader -> Follower4 "Heartbeat"`,
  paper: `scene "Paper Theme Architecture" theme=paper\nlayout LR\n\nbrowser WebApp\ngateway API\ndatabase Orders\n\nbeat flow:\n  show $nodes stagger=60ms\n  WebApp -> API "POST /order"\n  API -> Orders "INSERT"`,
  editorial: `scene "Editorial Print Theme" theme=editorial\nlayout LR\n\nclient MobileApp\nservice ApiGateway\ndatabase Postgres\n\nbeat flow:\n  show $nodes stagger=60ms\n  MobileApp -> ApiGateway "fetch"\n  ApiGateway -> Postgres "query"`,
  terminal: `scene "Terminal TUI Glow" theme=terminal\nlayout LR\n\nservice Monitor "Alert Manager"\nservice PagerDuty "On-Call Pager"\nservice SRE "Incident Commander"\n\nbeat alert:\n  show $nodes stagger=60ms\n  Monitor -> PagerDuty "CRITICAL P0"\n  PagerDuty -> SRE "Dispatch"`,
  sketchy: `scene "Whiteboard Brainstorming" theme=sketchy\nlayout LR\n\nuser User\nservice Frontend\nservice Backend\n\nbeat sketch:\n  show $nodes stagger=60ms\n  User -> Frontend "Click"\n  Frontend -> Backend "API Call"`,
  blueprint: `scene "Infrastructure Blueprint" theme=blueprint\nlayout LR\n\nservice LB "Network Load Balancer"\nservice Kube "EKS Worker Pool"\nservice RDS "Aurora Multi-AZ"\n\nbeat provision:\n  show $nodes stagger=60ms\n  LB -> Kube "Ingress"\n  Kube -> RDS "Query"`,
  midnight: `scene "Midnight Developer Dark" theme=midnight\nlayout LR\n\ngateway Cloudflare\nservice Firewall\nservice PrivateApi\n\nbeat filter:\n  show $nodes stagger=60ms\n  Cloudflare -> Firewall "TLS Traffic"\n  Firewall -> PrivateApi "Clean Packet"`,
};

const INGESTION_SOURCES = [
  {
    name: "Mermaid.js",
    ext: ".mmd / .mermaid",
    badge: "Flowcharts & Sequences",
    desc: "Transpile existing Mermaid graph and sequence charts directly into animated MarkdyScript scenes.",
    cmd: "markdy import flow.mmd --out flow.markdy",
    snippet: `scene "Transpiled Mermaid Flow" theme=paper type=flowchart\nlayout TB\n\nservice Client "Client Browser"\ngateway Gateway "API Gateway"\nservice Auth "Auth Microservice"\ndatabase DB "PostgreSQL"\n\nbeat flow:\n  show $nodes stagger=60ms\n  Client -> Gateway "POST /login"\n  Gateway -> Auth "Validate"\n  Auth -> DB "Query Credentials"\n  Gateway <- Auth "JWT Token"`,
  },
  {
    name: "Docker Compose",
    ext: "docker-compose.yml",
    badge: "Containers & Mesh",
    desc: "Extract service definitions, ports, network links, and volumes into a live architecture diagram.",
    cmd: "markdy import docker-compose.yml",
    snippet: `scene "Docker Compose Stack" theme=terminal type=nested\nlayout TB\n\nservice Web "nginx:alpine"\nservice Api "node:20-alpine"\nservice Cache "redis:7-alpine"\ndatabase Db "postgres:16-alpine"\n\ngroup ingress: Web\ngroup app: Api Cache\ngroup data: Db\n\nbeat boot:\n  show ingress stagger=50ms & show app stagger=50ms & show data\n  Web -> Api "proxy_pass :3000"\n  Api -> Cache "connect :6379"\n  Api -> Db "connect :5432"`,
  },
  {
    name: "Kubernetes YAML",
    ext: "k8s-manifest.yaml",
    badge: "Pods & Clusters",
    desc: "Map Ingress, Service, Deployment, Pod, and PVC resources into clustered layout tiers.",
    cmd: "markdy import cluster.yaml",
    snippet: `scene "Kubernetes Cluster Ingress" theme=midnight type=nested\nlayout TB\n\nservice Ingress "nginx-ingress"\nservice Svc "order-service:80"\nservice PodA "order-pod-1"\nservice PodB "order-pod-2"\n\ngroup ingress: Ingress\ngroup cluster: Svc PodA PodB\n\nbeat route:\n  show ingress & show cluster stagger=60ms\n  Ingress -> Svc "Host: api.markdy.com"\n  Svc -> PodA "round_robin"\n  Svc -> PodB "round_robin"`,
  },
  {
    name: "Terraform State",
    ext: "terraform.tfstate",
    badge: "Cloud Infrastructure",
    desc: "Visualize provisioned AWS/GCP/Azure VPCs, subnets, databases, and gateways automatically.",
    cmd: "markdy import terraform.tfstate",
    snippet: `scene "Terraform AWS Multi-AZ VPC" theme=blueprint type=layers\nlayout TB\n\nservice IGW "Internet Gateway"\nservice PublicSubnet "Public Subnet (AZ-1a)"\nservice PrivateSubnet "Private Subnet (AZ-1b)"\nservice RDS "RDS Multi-AZ (AZ-1c)"\n\nbeat provision:\n  show $nodes stagger=70ms\n  IGW -> PublicSubnet "0.0.0.0/0"\n  PublicSubnet -> PrivateSubnet "NAT Route"\n  PrivateSubnet -> RDS "Port 5432"`,
  },
];

const FAQS = [
  {
    question: "What is Markdy?",
    answer: "Markdy is an open-source, diagram-native DSL for animated architecture and system diagrams. You write semantic nodes, groups, flows, and beats in plain text; Markdy compiles browser-native motion graphics with zero coordinate math and zero manual keyframing.",
  },
  {
    question: "How is Markdy different from Mermaid, PlantUML, or D2?",
    answer: "Mermaid, D2, and PlantUML produce static 2D images. Markdy is designed for system motion: request-response paths, cache invalidations, event streaming, camera framing, and step-by-step lifecycles rendered via the browser-native Web Animations API.",
  },
  {
    question: "Does Markdy require Canvas or WebGL?",
    answer: "No. Markdy uses DOM elements, CSS transforms, and the Web Animations API. Scenes are crisp at any DPI, lightweight, accessible, and run seamlessly inside Astro, MDX, React, or static docs sites.",
  },
  {
    question: "Can AI coding agents generate Markdy diagrams?",
    answer: "Yes! Markdy's line-based grammar is designed for LLMs. Our official @markdy/mcp-server connects to Cursor, Claude Desktop, and Antigravity to validate, transpile, and self-heal diagrams in real time.",
  },
];

const homepageStructuredData = [
  {
    "@type": "WebPage",
    "@id": "https://markdy.com/#webpage",
    url: "https://markdy.com/",
    name: "Markdy — Animated Architecture Diagrams as Code",
    description: "Open-source diagram-as-code DSL for animated architecture diagrams: declare semantic nodes, flows, and beats in reviewable text. Zero coordinate math, browser-native motion.",
    isPartOf: { "@id": "https://markdy.com/#website" },
  },
];
---

<Layout
  title="Markdy — Animated Architecture Diagrams as Code"
  description="Markdy is a diagram-as-code DSL for animated architecture and system diagrams: declare semantic nodes, flows, and beats in plain text. Zero coordinate math, browser-native motion."
  keywords="Markdy, animated architecture diagram, diagram as code, mermaid alternative, animated system diagram, architecture visualization, docs as code, MCP server diagrams"
  structuredData={homepageStructuredData}
>
  <!-- ─── Floating Pill Navigation ────────────────────────────────────── -->
  <nav class="home-nav" aria-label="Main Navigation">
    <div class="nav-pill">
      <a href="/" class="nav-brand">
        <span class="nav-logo">🎬</span>
        <span class="nav-title">markdy</span>
      </a>

      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#layouts">Layouts &amp; Themes</a>
        <a href="#ingestion">Ingestion</a>
        <a href="#ai-gen">AI &amp; MCP</a>
        <a href="/docs/">Docs</a>
        <a href="/blog/">Articles</a>
      </div>

      <div class="nav-actions">
        <a href="/playground/" class="btn-nav-studio">⚡ Studio</a>
        <a href="https://github.com/HoangYell/markdy-com" target="_blank" rel="noopener noreferrer" class="btn-nav-icon" title="GitHub Repository">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <button id="theme-toggle" class="btn-nav-icon" title="Toggle Theme" aria-label="Toggle theme">
          <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- ─── Hero Section ─────────────────────────────────────────────────── -->
  <header class="home-hero">
    <div class="hero-content">
      <div class="hero-kicker">Open-source diagram-as-code DSL · Native Browser Motion</div>
      <h1>Animated architecture diagrams from <span class="gradient-text">plain text</span>.</h1>
      <p class="hero-description">
        Declare semantic nodes, flows, and timed beats in reviewable text.
        Markdy compiles browser-native motion graphics that stay version-controlled, PR-friendly, and AI-native.
      </p>

      <div class="hero-btn-row">
        <a href="/playground/" class="btn-hero-primary">⚡ Open Interactive Studio</a>
        <a href="/docs/" class="btn-hero-secondary">Explore Documentation ↗</a>
      </div>

      <!-- Quick Preset Selector -->
      <div class="hero-presets-strip">
        <span class="preset-label">SIGNATURE PRESETS:</span>
        <div class="preset-chips">
          {SIGNATURE_PRESETS.map((p) => (
            <button class="preset-chip example-btn" data-index={p.index}>
              <span>{p.name}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- ─── Embedded Live Interactive Hero Studio ─────────────────────── -->
    <div id="playground" class="hero-studio-card">
      <div class="studio-topbar">
        <div class="studio-left">
          <span class="studio-dot"></span>
          <span class="studio-title">MarkdyScript Live Studio</span>
          <select id="example-select" class="studio-select" aria-label="Load Architecture Example">
            {EXAMPLES.map((ex, i) => (
              <option value={i}>{ex.title} ({ex.pattern ?? ex.category})</option>
            ))}
          </select>
        </div>

        <div class="studio-actions">
          <button id="run-btn" class="btn-studio-run" title="Compile & Run">Run ▶</button>
          <button id="home-export-svg-btn" class="btn-studio-tool" title="Export Vector SVG">SVG</button>
          <button id="home-export-png-btn" class="btn-studio-tool" title="Export 2x PNG">PNG</button>
          <button id="share-btn" class="btn-studio-tool" title="Copy shareable URL">Share</button>
          <a href="/playground/" class="btn-studio-tool" title="Open full studio in new page">Popout ↗</a>
        </div>
      </div>

      <div class="studio-split-body">
        <!-- Editor Left Column -->
        <div class="studio-editor-pane">
          <div id="code-editor" class="code-editor-wrap"></div>
          <textarea id="code-input" style="display:none" spellcheck="false" aria-label="Code Editor">{EXAMPLES[0].code}</textarea>
        </div>

        <!-- Preview Right Column -->
        <div class="studio-preview-pane">
          <div class="preview-transport-bar">
            <div class="transport-controls">
              <button id="restart-btn" class="btn-transport" title="Restart">⏮</button>
              <button id="rewind-btn" class="btn-transport" title="Back 1s">⏪ 1s</button>
              <button id="play-btn" class="btn-transport-play" title="Play / Pause">
                <svg id="play-icon" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                <svg id="pause-icon" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                <span id="play-label">Play</span>
              </button>
            </div>

            <div class="speed-group">
              <button class="speed-btn" type="button" data-speed="0.5">0.5×</button>
              <button class="speed-btn active" type="button" data-speed="1">1×</button>
              <button class="speed-btn" type="button" data-speed="1.5">1.5×</button>
              <button class="speed-btn" type="button" data-speed="2">2×</button>
            </div>

            <span id="status" class="status-indicator status-ok"></span>
          </div>

          <div id="stage-wrap" class="stage-wrap">
            <div id="stage"></div>
          </div>

          <div class="timeline-bar">
            <select id="scene-jump" class="scene-jump" aria-label="Jump to scene" hidden></select>
            <input id="timeline-range" class="timeline-range" type="range" min="0" max="0" step="0.01" value="0" aria-label="Scrub timeline" />
            <span id="timeline-time" class="timeline-time">0:00 / 0:00</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ─── 4 Core Pillars of Markdy ────────────────────────────────────── -->
  <main class="home-main">
    <section id="features" class="pillars-section">
      <div class="section-heading-block">
        <span class="section-tag">Core Value</span>
        <h2>Why Engineers &amp; Teams Choose Markdy</h2>
        <p>A diagramming layer built for modern software architecture, autonomous coding agents, and CI/CD reviews.</p>
      </div>

      <div class="pillars-grid">
        {PILLARS.map((p) => (
          <a href={p.href} class="pillar-card">
            <div class="pillar-card-header">
              <span class="pillar-icon">{p.icon}</span>
              <span class="pillar-tag">{p.tag}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <div class="pillar-learn-more">Learn more ↗</div>
          </a>
        ))}
      </div>
    </section>

    <!-- ─── Interactive Layout Engines & Curated Themes ──────────────────── -->
    <section id="layouts" class="layouts-section">
      <div class="section-heading-block">
        <span class="section-tag">Layout &amp; Presentation</span>
        <h2>17 Domain-Native Engines &amp; 8 Publication Themes</h2>
