<!-- ─── Interactive Client Logic ─────────────────────────────────────── -->
<script>
  import { EditorView, keymap, lineNumbers, highlightActiveLine, highlightActiveLineGutter } from "@codemirror/view";
  import { EditorState } from "@codemirror/state";
  import { bracketMatching, indentOnInput } from "@codemirror/language";
  import { defaultKeymap, history, historyKeymap, indentWithTab } from "@codemirror/commands";
  import { highlightSelectionMatches, searchKeymap } from "@codemirror/search";
  import { closeBrackets, closeBracketsKeymap } from "@codemirror/autocomplete";

  import { markdyLanguage, markdyAutocomplete, markdyHighlightLight, markdyHighlightDark } from "../editor/markdy-language";
  import { baseTheme, lightTheme, darkTheme } from "../editor/editor-theme";
  import { createDiagram, exportDiagramAsVectorSvg } from "@markdy/renderer-dom";
  import type { Diagram } from "@markdy/renderer-dom";
  import { compressMarkdyToUrlHash } from "@markdy/core";
  import type { ExampleEntry } from "../data/examples";

  const examples: ExampleEntry[] = (window as any).__MARKDY_EXAMPLES || [];
  const editorContainer = document.getElementById("code-editor") as HTMLDivElement;
  const stage = document.getElementById("stage") as HTMLDivElement;
  const stageWrap = document.getElementById("stage-wrap") as HTMLDivElement;
  const runBtn = document.getElementById("run-btn") as HTMLButtonElement;
  const statusEl = document.getElementById("status") as HTMLSpanElement;
  const playBtn = document.getElementById("play-btn") as HTMLButtonElement;
  const restartBtn = document.getElementById("restart-btn") as HTMLButtonElement;
  const rewindBtn = document.getElementById("rewind-btn") as HTMLButtonElement;
  const playIcon = document.getElementById("play-icon") as SVGElement;
  const pauseIcon = document.getElementById("pause-icon") as SVGElement;
  const playLabel = document.getElementById("play-label") as HTMLSpanElement;
  const speedBtns = document.querySelectorAll<HTMLButtonElement>(".speed-btn");
  const timelineRange = document.getElementById("timeline-range") as HTMLInputElement;
  const timelineTime = document.getElementById("timeline-time") as HTMLSpanElement;
  const sceneJump = document.getElementById("scene-jump") as HTMLSelectElement;
  const exampleSelect = document.getElementById("example-select") as HTMLSelectElement;
  const presetChips = document.querySelectorAll<HTMLButtonElement>(".preset-chip");
  const autoShuffleBtn = document.getElementById("auto-shuffle-btn") as HTMLButtonElement | null;

  let diagram: Diagram | null = null;
  let isAnimPlaying = false;
  let debounce: ReturnType<typeof setTimeout> | null = null;
  let editorView: EditorView | null = null;
  let isScrubbing = false;
  let selectedPlaybackRate = 1;
  let isAutoShuffleEnabled = true;
  let autoShuffleTimer: ReturnType<typeof setTimeout> | null = null;
  let currentExampleIndex = 0;
  let userEditedCode = false;

  function clearAutoShuffleTimer() {
    if (autoShuffleTimer) {
      clearTimeout(autoShuffleTimer);
      autoShuffleTimer = null;
    }
  }

  function pickNextRandomExampleIndex(current: number, total: number): number {
    if (total <= 1) return 0;
    let next = Math.floor(Math.random() * (total - 1));
    if (next >= current) next += 1;
    return next;
  }

  function triggerAutoShuffleNext() {
    clearAutoShuffleTimer();
    if (!isAutoShuffleEnabled || userEditedCode || examples.length === 0) return;
    autoShuffleTimer = setTimeout(() => {
      if (!isAutoShuffleEnabled || userEditedCode) return;
      const nextIdx = pickNextRandomExampleIndex(currentExampleIndex, examples.length);
      currentExampleIndex = nextIdx;
      if (examples[nextIdx]) {
        if (exampleSelect) exampleSelect.value = String(nextIdx);
        presetChips.forEach((c) => c.classList.toggle("active", c.dataset.index === String(nextIdx)));
        setEditorCode(examples[nextIdx].code);
      }
    }, 1500);
  }

  function isDarkMode(): boolean {
    return document.documentElement.getAttribute("data-theme") === "dark";
  }

  function setStatus(ok: boolean) {
    if (!statusEl) return;
    statusEl.className = `status-indicator ${ok ? "status-ok" : "status-error"}`;
  }

  function formatTime(seconds: number): string {
    if (!Number.isFinite(seconds) || seconds <= 0) return "0:00";
    const total = Math.floor(seconds);
    const mins = Math.floor(total / 60);
    const secs = total % 60;
    return `${mins}:${secs.toString().padStart(2, "0")}`;
  }

  function setTimeline(current: number, duration: number) {
    if (!timelineRange || !timelineTime) return;
    const safeDuration = Number.isFinite(duration) && duration > 0 ? duration : 0;
    const safeCurrent = safeDuration > 0 ? Math.min(Math.max(current, 0), safeDuration) : 0;
    timelineRange.max = safeDuration.toFixed(2);
    if (!isScrubbing) timelineRange.value = safeCurrent.toFixed(2);
    timelineRange.disabled = safeDuration <= 0;
    timelineTime.textContent = `${formatTime(safeCurrent)} / ${formatTime(safeDuration)}`;
  }

  function setPlayState(playing: boolean) {
    isAnimPlaying = playing;
    if (playIcon) playIcon.style.display = playing ? "none" : "";
    if (pauseIcon) pauseIcon.style.display = playing ? "" : "none";
    if (playLabel) playLabel.textContent = playing ? "Pause" : "Play";
    if (playBtn) playBtn.setAttribute("aria-label", playing ? "Pause" : "Play");
  }

  function populateSceneJump(beats: { name: string; start: number }[]) {
    if (!sceneJump) return;
    sceneJump.innerHTML = "";
    if (beats.length === 0) {
      sceneJump.hidden = true;
      return;
    }
    sceneJump.hidden = false;
    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "Jump to beat…";
    sceneJump.appendChild(placeholder);
    for (const beat of beats) {
      const option = document.createElement("option");
      option.value = beat.name;
      option.textContent = beat.name;
      sceneJump.appendChild(option);
    }
  }

  function render(code: string) {
    if (!stage) return;
    if (diagram) { diagram.destroy(); diagram = null; }
    stage.innerHTML = "";
    try {
      diagram = createDiagram({
        container: stage,
        code,
        autoplay: true,
        copyright: false,
        sceneBoundaryProgress: false,
        playbackRate: selectedPlaybackRate,
        interactiveViewport: true,
        onTimeUpdate: setTimeline,
        onPlayStateChange: setPlayState,
        onEnded: () => {
          triggerAutoShuffleNext();
        },
      });
      setPlayState(true);
      setTimeline(diagram.currentTime(), diagram.duration());
      populateSceneJump(diagram.beats());
      setStatus(true);
    } catch (e) {
      const msg = (e as Error).message ?? String(e);
      stage.innerHTML = `<p class="parse-error" style="color:var(--danger);padding:1rem;font-family:monospace;font-size:0.8rem;">${msg}</p>`;
      setStatus(false);
      setPlayState(false);
    }
  }

  function getEditorCode(): string {
    return editorView?.state.doc.toString() ?? "";
  }

  function createEditor(initialCode: string) {
    if (!editorContainer) return;
    if (editorView) {
      editorView.destroy();
      editorView = null;
    }

    const dark = isDarkMode();

    const extensions = [
      lineNumbers(),
      highlightActiveLine(),
      highlightActiveLineGutter(),
      history(),
      bracketMatching(),
      closeBrackets(),
      indentOnInput(),
      highlightSelectionMatches(),
      markdyLanguage,
      markdyAutocomplete,
      dark ? markdyHighlightDark : markdyHighlightLight,
      baseTheme,
      dark ? darkTheme : lightTheme,
      keymap.of([
        ...closeBracketsKeymap,
        ...defaultKeymap,
        ...searchKeymap,
        ...historyKeymap,
        indentWithTab,
      ]),
      EditorView.contentAttributes.of({ "aria-label": "Code Editor" }),
      EditorView.updateListener.of((update) => {
        if (update.docChanged) {
          if (update.transactions.some((tr) => tr.isUserEvent("input") || tr.isUserEvent("delete"))) {
            userEditedCode = true;
            clearAutoShuffleTimer();
          }
          if (debounce) clearTimeout(debounce);
          debounce = setTimeout(() => render(getEditorCode()), 500);
        }
      }),
    ];

    editorView = new EditorView({
      state: EditorState.create({
        doc: initialCode,
        extensions,
      }),
      parent: editorContainer,
    });
  }

  function setEditorCode(code: string) {
    if (!editorView) return;
    editorView.dispatch({
      changes: { from: 0, to: editorView.state.doc.length, insert: code },
    });
    render(code);
  }

  // Preset chips handler
  presetChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      userEditedCode = false;
      clearAutoShuffleTimer();
      const index = Number(chip.dataset.index || "0");
      currentExampleIndex = index;
      if (examples[index]) {
        setEditorCode(examples[index].code);
        if (exampleSelect) exampleSelect.value = String(index);
        presetChips.forEach((c) => c.classList.toggle("active", c === chip));
      }
    });
  });

  // Example select dropdown
  exampleSelect?.addEventListener("change", () => {
    userEditedCode = false;
    clearAutoShuffleTimer();
    const idx = Number(exampleSelect.value);
    currentExampleIndex = idx;
    if (examples[idx]) {
      setEditorCode(examples[idx].code);
      presetChips.forEach((c) => c.classList.toggle("active", c.dataset.index === String(idx)));
    }
  });

  // Snippet trigger buttons
  document.querySelectorAll<HTMLButtonElement>(".try-chip-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      userEditedCode = false;
      clearAutoShuffleTimer();
      const snippet = btn.dataset.snippet;
      if (snippet) {
        setEditorCode(snippet);
        const studio = document.getElementById("playground");
        if (studio) {
          studio.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      }
    });
  });

  // ─── AI Prompt Tutorial Handlers ─────────────────────────────────────
  const toolChips = document.querySelectorAll<HTMLButtonElement>(".ai-tool-chip");
  const toolTipText = document.getElementById("ai-tool-tip-text");
  const promptPresetTabs = document.querySelectorAll<HTMLButtonElement>(".prompt-preset-tab");
  const promptCodeEl = document.getElementById("tutorial-prompt-code");
  const promptTargetTitleEl = document.getElementById("prompt-target-title");
  const tutorialCopyBtn = document.getElementById("tutorial-copy-btn") as HTMLButtonElement | null;
  const tutorialCopyLabel = document.getElementById("tutorial-copy-label");
  const tutorialRunBtn = document.getElementById("tutorial-run-btn") as HTMLButtonElement | null;
  let activeTutorialExampleIndex = 0;

  // Tool chips switcher
  toolChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      toolChips.forEach((c) => {
        c.classList.remove("active");
        c.setAttribute("aria-selected", "false");
      });
      chip.classList.add("active");
      chip.setAttribute("aria-selected", "true");
      const tip = chip.dataset.tip || "";
      if (toolTipText) toolTipText.textContent = tip;
    });
  });

  // Prompt Presets switcher
  promptPresetTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      promptPresetTabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");
      const promptText = tab.dataset.prompt || "";
      const exIdx = Number(tab.dataset.exampleIndex || "0");
      const target = tab.dataset.target || tab.textContent?.trim() || "";
      activeTutorialExampleIndex = exIdx;
      if (promptCodeEl) promptCodeEl.textContent = promptText;
      if (promptTargetTitleEl) promptTargetTitleEl.textContent = target;
    });
  });

  // Copy Prompt button
  tutorialCopyBtn?.addEventListener("click", async () => {
    const code = promptCodeEl?.textContent?.trim() || "";
    try {
      await navigator.clipboard.writeText(code);
      if (tutorialCopyLabel) tutorialCopyLabel.textContent = "✓ Copied to Clipboard!";
      tutorialCopyBtn.classList.add("btn-copied-active");
      setTimeout(() => {
        if (tutorialCopyLabel) tutorialCopyLabel.textContent = "Copy Prompt for AI";
        tutorialCopyBtn.classList.remove("btn-copied-active");
      }, 2200);
    } catch {
      if (tutorialCopyLabel) tutorialCopyLabel.textContent = "Copy failed";
      setTimeout(() => {
        if (tutorialCopyLabel) tutorialCopyLabel.textContent = "Copy Prompt for AI";
      }, 2000);
    }
  });

  // Run Result in Studio button
  tutorialRunBtn?.addEventListener("click", () => {
    userEditedCode = false;
    clearAutoShuffleTimer();
    currentExampleIndex = activeTutorialExampleIndex;
    if (examples[activeTutorialExampleIndex]) {
      setEditorCode(examples[activeTutorialExampleIndex].code);
      if (exampleSelect) exampleSelect.value = String(activeTutorialExampleIndex);
      presetChips.forEach((c) => c.classList.toggle("active", c.dataset.index === String(activeTutorialExampleIndex)));
      const studio = document.getElementById("playground");
      if (studio) {
        studio.scrollIntoView({ behavior: "smooth", block: "center" });
        studio.classList.add("studio-highlight-flash");
        setTimeout(() => studio.classList.remove("studio-highlight-flash"), 1500);
      }
    }
  });

  // Playback transport buttons
  playBtn?.addEventListener("click", () => {
    clearAutoShuffleTimer();
    if (!diagram) return;
    if (isAnimPlaying) {
      diagram.pause();
    } else {
      if (diagram.currentTime() >= diagram.duration() && diagram.duration() > 0) {
        diagram.seek(0);
      }
      diagram.play();
    }
  });

  restartBtn?.addEventListener("click", () => {
    clearAutoShuffleTimer();
    if (diagram) {
      diagram.seek(0);
      diagram.play();
    }
  });

  rewindBtn?.addEventListener("click", () => {
    clearAutoShuffleTimer();
    if (!diagram) return;
    diagram.seek(Math.max(0, diagram.currentTime() - 1));
  });

  autoShuffleBtn?.addEventListener("click", () => {
    isAutoShuffleEnabled = !isAutoShuffleEnabled;
    autoShuffleBtn.classList.toggle("active", isAutoShuffleEnabled);
    autoShuffleBtn.setAttribute("aria-pressed", isAutoShuffleEnabled ? "true" : "false");
    autoShuffleBtn.title = isAutoShuffleEnabled
      ? "Auto-Shuffle ON: Automatically plays random examples & demos on scene end"
      : "Auto-Shuffle OFF: Click to enable auto-cycling examples on scene end";
    if (!isAutoShuffleEnabled) {
      clearAutoShuffleTimer();
    }
  });

  speedBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const speed = Number(btn.dataset.speed || "1");
      selectedPlaybackRate = speed;
      speedBtns.forEach((b) => b.classList.toggle("active", b === btn));
      diagram?.setPlaybackRate(speed);
    });
  });

  timelineRange?.addEventListener("input", () => {
    isScrubbing = true;
    diagram?.seek(Number(timelineRange.value));
  });

  timelineRange?.addEventListener("change", () => {
    isScrubbing = false;
  });

  sceneJump?.addEventListener("change", () => {
    if (sceneJump.value) {
      diagram?.jumpTo(sceneJump.value);
    }
  });

  runBtn?.addEventListener("click", () => {
    render(getEditorCode());
  });

  const afterPaint = () => new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
  async function withFinalFrame<T>(action: (scene: HTMLElement) => Promise<T> | T): Promise<T> {
    if (!diagram) throw new Error("No diagram is available to export");
    const scene = stage.querySelector(".markdy-scene-root") as HTMLElement | null;
    if (!scene) throw new Error("No diagram scene is available to export");
    const previousTime = diagram.currentTime();
    const wasPlaying = diagram.isPlaying();
    diagram.pause();
    diagram.seek(diagram.duration());
    await afterPaint();
    try {
      return await action(scene);
    } finally {
      diagram.seek(previousTime);
      if (wasPlaying) diagram.play();
    }
  }

  function download(blob: Blob, filename: string): void {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 0);
  }

  // Static exports always capture the completed last frame.
  document.getElementById("home-export-svg-btn")?.addEventListener("click", async () => {
    if (!diagram) return;
    const svg = await withFinalFrame((scene) => exportDiagramAsVectorSvg(scene, { includeThemeStyles: true }));
    download(new Blob([svg], { type: "image/svg+xml;charset=utf-8" }), "diagram.svg");
  });

  // Copy code button
  const homeCopyBtn = document.getElementById("home-copy-btn") as HTMLButtonElement | null;
  homeCopyBtn?.addEventListener("click", async () => {
    const code = getEditorCode();
    try {
      await navigator.clipboard.writeText(code);
      const orig = homeCopyBtn.textContent;
      homeCopyBtn.textContent = "Copied!";
      setTimeout(() => { homeCopyBtn.textContent = orig; }, 1800);
    } catch {
      homeCopyBtn.title = "Copy failed";
    }
  });

  // Paste code button
  const homePasteBtn = document.getElementById("home-paste-btn") as HTMLButtonElement | null;
  homePasteBtn?.addEventListener("click", async () => {
    let text = "";
    try {
      if (navigator.clipboard && navigator.clipboard.readText) {
        text = await navigator.clipboard.readText();
      } else {
        text = prompt("Paste your MarkdyScript code here:") || "";
      }
    } catch {
      const fallback = prompt("Clipboard read access was blocked. Paste your MarkdyScript code below:");
      if (fallback !== null) {
        text = fallback;
      } else {
        return;
      }
    }

    const trimmed = text.trim();
    if (!trimmed) {
      const orig = homePasteBtn.textContent;
      homePasteBtn.textContent = "Empty!";
      setTimeout(() => { homePasteBtn.textContent = orig; }, 1800);
      return;
    }

    setEditorCode(text);
    render(text);
    const orig = homePasteBtn.textContent;
    homePasteBtn.textContent = "Pasted!";
    setTimeout(() => { homePasteBtn.textContent = orig; }, 1800);
  });

  // Share button
  document.getElementById("share-btn")?.addEventListener("click", async () => {
    const code = getEditorCode();
    try {
      const hash = await compressMarkdyToUrlHash(code);
      const url = `${window.location.origin}/playground/#code=${hash}`;
      navigator.clipboard.writeText(url).then(() => {
        const shareBtn = document.getElementById("share-btn") as HTMLButtonElement;
        if (shareBtn) {
          const orig = shareBtn.textContent;
          shareBtn.textContent = "Copied!";
          setTimeout(() => (shareBtn.textContent = orig), 2000);
        }
      });
    } catch {
      const encoded = encodeURIComponent(code);
      const url = `${window.location.origin}/playground/#code=${encoded}`;
      navigator.clipboard.writeText(url);
    }
  });

  // Framework tabs
  const fTabs = document.querySelectorAll<HTMLButtonElement>(".f-tab");
  const fPanels = document.querySelectorAll<HTMLDivElement>(".f-panel");
  fTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;
      fTabs.forEach((t) => t.classList.remove("active"));
      fPanels.forEach((p) => p.classList.remove("active"));
      tab.classList.add("active");
      document.querySelector(`.f-panel[data-panel="${target}"]`)?.classList.add("active");
    });
  });

  // Copy buttons
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const container = btn.closest(".ai-config-card, .f-panel, .cmd-row, .ingestion-box") || btn.closest("div");
      const codeBlock = container?.querySelector("code");
      const text = codeBlock?.textContent || "";
      navigator.clipboard.writeText(text.trim()).then(() => {
        const orig = btn.textContent;
        btn.textContent = "Copied!";
        btn.classList.add("copied");
        setTimeout(() => {
          btn.textContent = orig;
          btn.classList.remove("copied");
        }, 2000);
      }).catch(() => {
        const orig = btn.textContent;
        btn.textContent = "Failed";
        setTimeout(() => (btn.textContent = orig), 2000);
      });
    });
  });

  // Mobile Menu Drawer Toggle
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileDrawer = document.getElementById("mobile-nav-drawer");
  const burgerIcon = mobileMenuBtn?.querySelector(".icon-burger") as HTMLElement | null;
  const closeIcon = mobileMenuBtn?.querySelector(".icon-close") as HTMLElement | null;

  function toggleMobileMenu(open?: boolean) {
    if (!mobileDrawer || !mobileMenuBtn) return;
    const shouldOpen = open !== undefined ? open : mobileDrawer.hidden;
    if (shouldOpen) {
      mobileDrawer.hidden = false;
      mobileMenuBtn.setAttribute("aria-expanded", "true");
      if (burgerIcon && closeIcon) {
        burgerIcon.style.display = "none";
        closeIcon.style.display = "block";
      }
    } else {
      mobileDrawer.hidden = true;
      mobileMenuBtn.setAttribute("aria-expanded", "false");
      if (burgerIcon && closeIcon) {
        burgerIcon.style.display = "block";
        closeIcon.style.display = "none";
      }
    }
  }

  mobileMenuBtn?.addEventListener("click", () => toggleMobileMenu());

  // Close mobile drawer when clicking any nav link
  mobileDrawer?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => toggleMobileMenu(false));
  });

  // Close mobile drawer on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && mobileDrawer && !mobileDrawer.hidden) {
      toggleMobileMenu(false);
    }
  });

  // Close mobile drawer on outside click
  document.addEventListener("click", (e) => {
    if (
      mobileDrawer &&
      !mobileDrawer.hidden &&
      !mobileDrawer.contains(e.target as Node) &&
      !mobileMenuBtn?.contains(e.target as Node)
    ) {
      toggleMobileMenu(false);
    }
  });

  // Theme toggle
  const themeBtn = document.getElementById("theme-toggle");
  themeBtn?.addEventListener("click", () => {
    const isDark = document.documentElement.getAttribute("data-theme") === "dark";
    const next = isDark ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("markdy-theme", next);
    updateThemeIcons(next);
    createEditor(getEditorCode());
  });

  function updateThemeIcons(theme: string) {
    const sun = document.querySelector(".icon-sun") as HTMLElement;
    const moon = document.querySelector(".icon-moon") as HTMLElement;
    if (!sun || !moon) return;
    if (theme === "dark") {
      sun.style.display = "none";
      moon.style.display = "block";
    } else {
      sun.style.display = "block";
      moon.style.display = "none";
    }
  }

  // Initialize
  const initialTheme = document.documentElement.getAttribute("data-theme") || "light";
  updateThemeIcons(initialTheme);

  const initialCode = examples[0]?.code || 'scene "Demo" theme=paper\nclient Browser -> service API -> database DB\nbeat flow:\n  show $nodes';
  createEditor(initialCode);
  render(initialCode);
</script>

