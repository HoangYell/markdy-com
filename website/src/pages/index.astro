    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.98) 0%,
      rgba(255, 255, 255, 0.94) 45%,
      rgba(255, 255, 255, 0.72) 62%,
      rgba(255, 255, 255, 0.1) 85%,
      transparent 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  :global([data-theme="dark"]) .hero-stage-wash {
    background: linear-gradient(
      90deg,
      #090d16 0%,
      rgba(9, 13, 22, 0.98) 45%,
      rgba(9, 13, 22, 0.8) 65%,
      rgba(9, 13, 22, 0.25) 85%,
      transparent 100%
    );
  }

  /* Left Floating Content Panel */
  .hero-stage-content {
    position: relative;
    z-index: 3;
    max-width: 660px;
    padding: 3.5rem 3rem 3.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--accent-light);
    color: var(--accent);
    border: 1px solid var(--accent);
    margin-bottom: 1.15rem;
    width: fit-content;
  }

  .hero-stage-content h1 {
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.12;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .gradient-text {
    color: var(--accent);
  }

  .hero-description {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.6rem;
  }

  .hero-btn-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
  }

  .btn-hero-primary {
    background: var(--accent);
    color: #ffffff !important;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.7rem 1.4rem;
    border-radius: 9px;
    box-shadow: 0 2px 16px var(--accent-glow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-hero-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 20px var(--accent-glow);
  }

  .btn-hero-secondary {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.7rem 1.35rem;
    border-radius: 9px;
    transition: all 0.15s ease;
  }

  .btn-hero-secondary:hover {
    border-color: var(--border-hover);
    background: var(--bg-secondary);
  }

  /* Preset Chips Strip */
  .hero-presets-strip {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .preset-label {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .preset-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .preset-chip {
    font-size: 0.76rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .preset-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
    background: var(--bg-tertiary);
  }

  @media (max-width: 900px) {
    .hero-stage {
      flex-direction: column;
      min-height: auto;
    }
    .hero-stage-wash {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.98) 0%,
        rgba(255, 255, 255, 0.94) 60%,
        rgba(255, 255, 255, 0.82) 100%
      );
    }
    :global([data-theme="dark"]) .hero-stage-wash {
      background: linear-gradient(
        180deg,
        #090d16 0%,
        rgba(9, 13, 22, 0.97) 60%,
        rgba(9, 13, 22, 0.88) 100%
      );
    }
    .hero-stage-content {
      padding: 2.5rem 1.75rem 2.25rem;
      max-width: 100%;
    }
  }

  .preset-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
    background: var(--bg-tertiary);
  }

  .preset-chip.active {
    background: var(--accent-light);
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ─── Hero Prompt Tutorial Section ─────────────────────────────────── */
  .hero-prompt-tutorial {
    width: 100%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    margin-bottom: 2.25rem;
    text-align: left;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-prompt-tutorial:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: var(--shadow-lg);
  }

  .prompt-tutorial-inner {
    padding: 1.6rem 1.75rem;
  }

  .prompt-tutorial-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prompt-header-left {
    flex: 1;
  }

  .prompt-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-light);
    color: var(--accent);
    border: 1px solid var(--accent);
    margin-bottom: 0.5rem;
  }

  .prompt-tutorial-header h2 {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
  }

  .prompt-subtitle {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .prompt-header-right {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .prompt-mascot-guide {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    padding: 0.3rem 0.65rem 0.3rem 0.35rem;
    border-radius: 999px;
    box-shadow: var(--shadow-xs);
  }

  .prompt-mascot-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    filter: drop-shadow(0 2px 5px rgba(0,0,0,0.12));
  }

  .prompt-mascot-speech {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .spec-link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    transition: all 0.15s ease;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: var(--shadow-xs);
  }

  .spec-link-pill:hover {
    border-color: var(--accent);
    background: var(--accent-light);
    transform: translateY(-1px);
  }

  .spec-icon { font-size: 0.9rem; }
  .spec-url { font-family: "JetBrains Mono", monospace; }
  .spec-arrow { font-size: 0.85rem; }

  /* AI Tools Shelf */
  .ai-tools-shelf {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .tools-shelf-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .ai-tools-list {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .ai-tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .ai-tool-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
    background: var(--bg-tertiary);
  }

  .ai-tool-chip.active {
    background: var(--accent-light);
    color: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .tool-chip-name {
    font-weight: 700;
  }

  .tool-chip-badge {
    font-size: 0.62rem;
    padding: 0.05rem 0.35rem;
    border-radius: 999px;
    background: var(--bg-tertiary);
    color: var(--text-muted);
  }

  .ai-tool-chip.active .tool-chip-badge {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
  }

  /* Tool Tip Bar */
  .ai-tool-tip-bar {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    background: color-mix(in srgb, var(--accent-light) 30%, var(--bg-secondary));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    font-size: 0.78rem;
    color: var(--text-primary);
    margin-bottom: 1.15rem;
  }

  .tip-icon {
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .tip-text {
    line-height: 1.45;
  }

  /* Presets Bar */
  .prompt-presets-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }

  .presets-bar-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .prompt-preset-tabs {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .prompt-preset-tab {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .prompt-preset-tab:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
    background: var(--bg-tertiary);
  }

  .prompt-preset-tab.active {
    background: var(--accent);
    color: #ffffff !important;
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  /* Prompt Display Box */
  .prompt-display-box {
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.35rem;
    box-shadow: var(--shadow-xs);
  }

  .prompt-display-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 0.85rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .prompt-target-tag {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.76rem;
    color: var(--text-secondary);
  }

  .prompt-target-tag strong {
    color: var(--text-primary);
  }

  .target-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .prompt-box-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-prompt-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
    border: none;
    text-decoration: none;
  }

  .btn-prompt-copy {
    background: var(--accent);
    color: #ffffff;
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .btn-prompt-copy:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .btn-prompt-copy.btn-copied-active {
    background: #10b981;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
  }

  .btn-prompt-run {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    color: var(--text-primary);
  }

  .btn-prompt-run:hover {
    background: var(--accent-light);
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .prompt-code-wrap {
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
  }

  .prompt-code-wrap pre {
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
  }

  .prompt-code-wrap code {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--text-primary);
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* 3-Step Workflow Grid */
  .tutorial-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .tutorial-step-card {
    display: flex;
    gap: 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
    align-items: flex-start;
  }

  .step-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--accent);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .step-content strong {
    display: block;
    font-size: 0.84rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .step-content p {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .step-content code {
    font-size: 0.74rem;
    background: var(--bg-tertiary);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    color: var(--accent);
  }

  .step-content a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .studio-highlight-flash {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    animation: flashBorder 1.5s ease-out;
  }

  @keyframes flashBorder {
    0% { outline-color: var(--accent); box-shadow: 0 0 24px var(--accent-glow); }
    100% { outline-color: transparent; box-shadow: var(--shadow-lg); }
  }

  /* ─── Hero Live Studio Card ────────────────────────────────────────── */
  .hero-studio-card {
    width: 100%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    text-align: left;
  }

  .studio-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.85rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .studio-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .studio-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  .studio-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-primary);
    font-family: "JetBrains Mono", monospace;
  }

  .studio-select {
    font-size: 0.74rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .studio-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .btn-studio-run {
    background: var(--accent);
    color: #ffffff;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    box-shadow: 0 0 8px var(--accent-glow);
    transition: opacity 0.15s ease;
  }

  .btn-studio-run:hover { opacity: 0.9; }

  .btn-studio-tool {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-studio-tool:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .studio-split-body {
    display: grid;
    grid-template-columns: 460px 1fr;
    height: 480px;
  }

  .studio-editor-pane {
    border-right: 1px solid var(--border);
    background: var(--code-bg);
    overflow: hidden;
  }

  .code-editor-wrap {
    height: 100%;
    overflow-y: auto;
    font-size: 0.82rem;
  }

  .studio-preview-pane {
    display: flex;
    flex-direction: column;
    background: var(--bg-primary);
    position: relative;
    overflow: hidden;
  }

  .preview-transport-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.75rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }

  .transport-controls {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .btn-transport {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.7rem;
    padding: 0.2rem 0.45rem;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-transport:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .auto-shuffle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 600;
  }

  .auto-shuffle-btn.active {
    background: var(--accent-light);
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-transport-play {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: var(--accent-light);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 5px;
    cursor: pointer;
  }

  .speed-group {
    display: flex;
    gap: 0.2rem;
  }

  .speed-btn {
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--border);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    border-radius: 4px;
    cursor: pointer;
  }

  .speed-btn.active {
    background: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
  }

  .status-indicator {
    width: 7px;
    height: 7px;
    border-radius: 999px;
  }

  .status-ok { background: #10b981; box-shadow: 0 0 6px rgba(16, 185, 129, 0.6); }
  .status-error { background: #ef4444; box-shadow: 0 0 6px rgba(239, 68, 68, 0.6); }

  .stage-wrap {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: var(--bg-primary);
    background-image: radial-gradient(circle, var(--grid-dot) 1.2px, transparent 1.2px);
    background-size: 20px 20px;
  }

  #stage {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .timeline-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
  }

  .scene-jump {
    font-size: 0.7rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
  }

  .timeline-range {
    flex: 1;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .timeline-time {
    font-size: 0.68rem;
    font-family: "JetBrains Mono", monospace;
    color: var(--text-muted);
    min-width: 72px;
    text-align: right;
  }

  /* ─── Main Sections ────────────────────────────────────────────────── */
  .home-main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .section-heading-block {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.5rem;
  }

  .section-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.4rem;
    display: inline-block;
  }

  .section-heading-block h2 {
    font-size: 1.8rem;
    font-weight: 800;
