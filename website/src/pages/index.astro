    flex-direction: column;
    min-height: 0;
    min-width: 0;
  }

  .panel-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.85rem;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    transition: all 0.3s ease;
  }

  .panel-label > span:first-child {
    flex-shrink: 0;
  }

  .panel-label-title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .editor-toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .preview-toolbar {
    display: flex;
    align-items: center;
    gap: 0.4rem 0.75rem;
    flex-wrap: wrap;
    padding: 0.4rem 0.85rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }

  .control-group {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .control-group--expand {
    margin-left: auto;
  }

  .speed-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.15rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .speed-btn {
    font-family: inherit;
    font-size: 0.64rem;
    font-weight: 700;
    padding: 0.16rem 0.42rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    line-height: 1.2;
    transition: all 0.18s ease;
  }

  .speed-btn:hover {
    color: var(--accent);
  }

  .speed-btn.active {
    background: var(--accent-light);
    border-color: var(--accent);
    color: var(--accent);
  }

  .editor-hint {
    font-size: 0.65rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-muted);
  }

  .btn-run {
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-secondary);
    cursor: pointer;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .btn-run:hover { border-color: var(--accent); color: var(--accent); }

  .btn-icon {
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.24rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-secondary);
    cursor: pointer;
    color: var(--text-secondary);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .btn-icon:hover { border-color: var(--accent); color: var(--accent); }

  .btn-icon--primary {
    background: var(--accent-light);
    border-color: var(--accent);
    color: var(--accent);
  }

  .panel-label .btn-icon {
    text-transform: none;
    letter-spacing: 0;
  }

  .status {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .status.ok  { background: var(--accent); }
  .status.err { background: #ef4444; }

  .code-editor-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: auto;
  }

  .code-editor-wrap .cm-editor {
    flex: 1;
    min-height: 100%;
  }

  .stage-wrap {
    flex: 1 1 auto;
    width: 100%;
    align-self: stretch;
    box-sizing: border-box;
    min-height: 0;
    margin: 0;
    position: relative;
    background: var(--bg-tertiary);
    overflow: hidden;
    --stage-pad: 0px;
    transition: background 0.3s ease;
  }

  .playground.is-theater .stage-wrap {
    flex: 1 1 auto;
    min-height: 0;
    aspect-ratio: auto;
    margin: 0;
    --stage-pad: 1rem;
  }

  .timeline-controls {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.85rem;
    border-top: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .scene-jump {
    font-family: inherit;
    font-size: 0.68rem;
    color: var(--text-secondary);
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.2rem 0.4rem;
    max-width: 9rem;
    cursor: pointer;
  }

  .timeline-range {
    width: 100%;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .timeline-range:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .timeline-time {
    min-width: 5.6rem;
    text-align: right;
    font-family: "JetBrains Mono", "SF Mono", "Fira Code", monospace;
    font-size: 0.68rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  #stage {
    position: absolute;
    inset: var(--stage-pad);
    overflow: hidden;
    line-height: 0;
  }

  .parse-error {
    font-family: "JetBrains Mono", "SF Mono", "Fira Code", monospace;
    font-size: 0.78rem;
    color: #dc2626;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    max-width: 340px;
    white-space: pre-wrap;
    margin: 0;
  }

  :root[data-theme="dark"] .parse-error {
    color: #fca5a5;
    background: rgba(220, 38, 38, 0.1);
    border-color: rgba(220, 38, 38, 0.3);
  }

  /* ── Syntax Reference ────────────────────────────────────────────── */
  .syntax-ref {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 3.5rem;
    border-top: 1px solid var(--border-subtle);
    scroll-margin-top: 68px;
  }

  .ref-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .ref-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    background: var(--bg-secondary);
    box-shadow: 0 1px 4px var(--shadow-sm);
    transition: all 0.25s ease;
    /* Prevent grid item from expanding wider than its column */
    min-width: 0;
    overflow: hidden;
  }

  .ref-card:hover {
    box-shadow: 0 4px 16px var(--shadow-md);
    border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
  }

  .ref-card-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
  }

  .step-badge {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .ref-card-header h3 {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
  }

  .apply-ref-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    color: var(--accent);
    background: var(--accent-light);
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
  }

  .apply-ref-btn:hover { background: rgba(63, 185, 80, 0.25); }
  .apply-ref-btn:active { transform: scale(0.92); }

  .ref-intro {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }

  .ref-code-wrap {
    overflow-x: auto;
    margin-bottom: 0.7rem;
  }

  .ref-card pre {
    position: relative;
    background: var(--ref-code-bg);
    color: var(--ref-code-text);
    border: none;
    border-radius: 8px;
    padding: 0.7rem 0.85rem;
    overflow-x: auto;
    font-size: 0.74rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  .ref-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 0.6rem;
  }

  .ref-table-wrap table {
    min-width: 0;
    margin-bottom: 0;
  }

  .ref-card p {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .ref-card table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 0.6rem;
    font-size: 0.78rem;
  }

  .ref-card th {
    text-align: left;
    font-weight: 600;
    padding: 0.3rem 0.5rem 0.3rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
  }

  .ref-card td {
    padding: 0.3rem 0.5rem 0.3rem 0;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .ref-card td code {
    font-size: 0.74rem;
    background: var(--bg-tertiary);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: var(--accent);
  }

  /* ── AI Section ──────────────────────────────────────────────────── */
  .ai-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 3.5rem;
    border-top: 1px solid var(--border-subtle);
    scroll-margin-top: 68px;
  }

  .ai-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .ai-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    background: var(--bg-secondary);
    box-shadow: 0 1px 4px var(--shadow-sm);
    transition: all 0.25s ease;
    min-width: 0;
    overflow: hidden;
  }

  .ai-card:hover {
    box-shadow: 0 4px 16px var(--shadow-md);
  }

  .ai-card h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .ai-steps {
    list-style: none;
    counter-reset: ai-step;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ai-steps li {
    counter-increment: ai-step;
    position: relative;
    padding-left: 2.25rem;
  }

  .ai-steps li::before {
    content: counter(ai-step);
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-steps li strong {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.15rem;
  }

  .ai-steps li p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .ai-steps li a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ai-steps li a:hover {
    color: var(--accent-hover);
  }

  .ai-prompt {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }

  .ai-prompt-header {
    padding: 0.4rem 0.85rem;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border);
  }

  .ai-prompt-label {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .ai-prompt-text {
    padding: 0.85rem;
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-primary);
    line-height: 1.6;
    border: none;
  }

  .ai-prompt-text code {
    font-size: 0.74rem;
    background: var(--bg-tertiary);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: var(--accent);
    word-break: break-all;
  }

  .ai-prompt-text em {
    color: var(--text-secondary);
  }

  .ai-hint {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .ai-hint code {
    font-size: 0.74rem;
    background: var(--bg-tertiary);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: var(--accent);
  }

  .ai-tools {
    text-align: center;
  }

  .ai-tools-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .ai-tools-list {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .ai-tool {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 100px;
    color: var(--text-secondary);
    background: var(--bg-secondary);
  }

  /* ── Intent + FAQ + Promotion ────────────────────────────────────── */
  .intent-section,
  .faq-section,
  .share-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 3.5rem;
    border-top: 1px solid var(--border-subtle);
    scroll-margin-top: 68px;
  }

  .intent-grid,
  .share-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .intent-card,
  .share-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-secondary);
    box-shadow: 0 1px 4px var(--shadow-sm);
    transition: all 0.2s ease;
  }

  .intent-card h3,
  .share-card strong {
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-primary);
  }

  .intent-card p,
  .share-card span {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .share-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 16px var(--shadow-md);
    transform: translateY(-2px);
  }

  .faq-list {
    display: grid;
    gap: 0.8rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-secondary);
    box-shadow: 0 1px 4px var(--shadow-sm);
  }

  .faq-item summary {
    cursor: pointer;
    padding: 1rem 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .faq-item summary::marker {
    color: var(--accent);
  }

  .faq-item p {
    padding: 0 1.25rem 1rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .share-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 900px;
    margin: 0 auto;
  }

  .share-copy {
    display: grid;
    gap: 0.45rem;
    max-width: 900px;
    margin: 1rem auto 0;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-tertiary);
  }

  .share-copy span {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .share-copy code {
    color: var(--text-primary);
    font-size: 0.82rem;
    line-height: 1.6;
    white-space: normal;
  }

  /* ── Footer ──────────────────────────────────────────────────────── */
  .footer {
    padding: 2.5rem 1.5rem 1.5rem;
    border-top: 1px solid var(--border-subtle);
    transition: all 0.3s ease;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-brand {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .footer-tagline {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-col h3 {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    font-size: 0.78rem;
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .footer-col a:hover { color: var(--accent); }

  .footer-bottom {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .footer-bottom a { color: var(--text-secondary); transition: color 0.2s; }
  .footer-bottom a:hover { color: var(--accent); }
  .dot { color: var(--text-muted); }

  /* ── Scroll to top ───────────────────────────────────────────────── */
  .scroll-top {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--bg-secondary) 90%, transparent);
    backdrop-filter: blur(8px);
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: all 0.25s ease;
    z-index: 9;
  }

  .scroll-top.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .scroll-top:hover {
    color: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 2px 8px var(--accent-light);
  }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media (max-width: 1080px) {
    .pkg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 720px;
    }

    .pkg-card,
    .pkg-card:last-child {
      grid-column: auto;
    }
  }

  @media (max-width: 768px) {
    .menu-toggle { display: flex; }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      padding: 1rem 1.5rem;
      background: var(--bg-primary);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 8px 24px var(--shadow-md);
      gap: 0.75rem;
    }

    .nav-links.open { display: flex; }

    .nav-links a { font-size: 0.9rem; }

    .nav { padding: 0.7rem 1rem; }
    .hero { padding: 3rem 1rem 1.75rem; }
    .hero h1 { font-size: 2rem; line-height: 1.06; }
    .hero-sub { font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; }
    .usage-section { max-width: none; }
    .usage-tabs { overflow-x: auto; scrollbar-width: none; }
    .usage-tabs::-webkit-scrollbar { display: none; }
    .usage-tab { flex: 1 0 auto; white-space: nowrap; padding: 0.5rem 0.85rem; }

    .features-grid { grid-template-columns: repeat(2, 1fr); }
    .pkg-grid { grid-template-columns: minmax(0, 1fr); max-width: none; }

    .playground {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .editor-layout {
      grid-template-columns: 1fr;
      height: auto;
      min-height: 0;
    }

    .playground.is-theater .editor-layout {
      height: min(72vh, 560px);
      min-height: 360px;
    }

    .examples-col { border-right: none; border-bottom: 1px solid var(--border); }
    .editor-col { border-right: none; border-bottom: 1px solid var(--border); }
    .examples-list { max-height: 220px; }
    .code-editor-wrap { min-height: 220px; }
    .stage-wrap {
      flex: 0 0 auto;
      width: 100%;
      margin: 0;
      aspect-ratio: var(--preview-aspect, 16 / 9);
      min-height: 0;
      --stage-pad: 0.5rem;
    }

    .playground.is-theater .stage-wrap {
      flex: 1 1 auto;
      aspect-ratio: auto;
      --stage-pad: 0.75rem;
    }

    .preview-toolbar {
      gap: 0.3rem 0.5rem;
      padding: 0.4rem 0.6rem;
    }

    .speed-controls {
      gap: 0.15rem;
    }

    .speed-btn {
      font-size: 0.62rem;
      padding: 0.14rem 0.36rem;
    }

    #expand-preview-label {
      display: inline;
    }

    .timeline-controls {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .scene-jump {
      max-width: none;
      width: 100%;
    }

    .timeline-time {
      text-align: left;
    }

