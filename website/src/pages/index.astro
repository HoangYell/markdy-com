<script>
  /* ── Usage tabs ────────────────────────────────────────────────────── */
  const tabs = document.querySelectorAll<HTMLButtonElement>(".usage-tab");
  const panels = document.querySelectorAll<HTMLDivElement>(".usage-panel");

  tabs.forEach(tab => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;
      tabs.forEach(t => { t.classList.remove("active"); t.setAttribute("aria-selected", "false"); });
      panels.forEach(p => p.classList.remove("active"));
      tab.classList.add("active");
      tab.setAttribute("aria-selected", "true");
      document.querySelector(`.usage-panel[data-panel="${target}"]`)?.classList.add("active");
    });
  });

  /* ── Copy install commands ─────────────────────────────────────────── */
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach(btn => {
    let revertTimer: ReturnType<typeof setTimeout> | null = null;
    btn.addEventListener("click", () => {
      const cmd = btn.closest(".usage-install")?.querySelector(".usage-cmd");
      if (!cmd) return;
      navigator.clipboard.writeText(cmd.textContent?.trim() ?? "").then(() => {
        if (revertTimer) clearTimeout(revertTimer);
        btn.classList.add("copied");
        btn.title = "Copied!";
        btn.setAttribute("aria-label", "Copied to clipboard");
        revertTimer = setTimeout(() => {
          btn.classList.remove("copied");
          btn.title = "Copy";
          btn.setAttribute("aria-label", "Copy install command");
        }, 2000);
      }).catch(() => {
        btn.title = "Copy failed — select and copy manually";
      });
    });
  });

  /* ── Scroll to top ─────────────────────────────────────────────────── */
  const scrollTopBtn = document.getElementById("scroll-top");
  if (scrollTopBtn) {
    window.addEventListener("scroll", () => {
      scrollTopBtn.classList.toggle("visible", window.scrollY > 400);
    }, { passive: true });
    scrollTopBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }

  /* ── Mobile menu toggle ────────────────────────────────────────────── */
  const menuToggle = document.getElementById("menu-toggle");
  const navLinks = document.querySelector(".nav-links");
  if (menuToggle && navLinks) {
    menuToggle.addEventListener("click", () => {
      navLinks.classList.toggle("open");
      menuToggle.classList.toggle("open");
      menuToggle.setAttribute("aria-expanded", navLinks.classList.contains("open").toString());
    });
    // Close menu on link click
    navLinks.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        navLinks.classList.remove("open");
        menuToggle.classList.remove("open");
        menuToggle.setAttribute("aria-expanded", "false");
      });
    });
  }

  /* ── Active nav link via IntersectionObserver ───────────────────── */
  (function () {
    const sectionIds = ["features", "playground", "learn", "ai-gen", "faq"];
    const navAnchors = new Map(
      sectionIds.map(id => [id, document.querySelector(`.nav-links a[href="#${id}"]`) as HTMLAnchorElement | null])
    );

    function setActive(id: string | null) {
      navAnchors.forEach((a, key) => {
        if (!a) return;
        if (key === id) {
          a.setAttribute("aria-current", "true");
        } else {
          a.removeAttribute("aria-current");
        }
      });
    }

    // Use an ordered array — topmost visible section wins
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(e => {
          const id = (e.target as HTMLElement).id;
          if (e.isIntersecting) visible.add(id);
          else visible.delete(id);
        });
        // Pick first in order
        const active = sectionIds.find(id => visible.has(id)) ?? null;
        setActive(active);
      },
      { rootMargin: "-68px 0px -40% 0px", threshold: 0 }
    );

    sectionIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  })();

  /* ── Theme toggle (must run before CodeMirror to set CSS vars) ──── */
  const STORAGE_KEY = "markdy-theme";

  function getPreferredTheme(): "light" | "dark" {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === "dark" || stored === "light") return stored;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function applyTheme(theme: "light" | "dark") {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem(STORAGE_KEY, theme);
    // Update toggle icon visibility
    const toggle = document.getElementById("theme-toggle");
    if (toggle) {
      toggle.classList.toggle("is-dark", theme === "dark");
    }
  }

  // Apply saved theme immediately
  applyTheme(getPreferredTheme());

  // Toggle button
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme") || "light";
    applyTheme(current === "dark" ? "light" : "dark");
    // Recreate editor with new theme
    if ((window as any).__recreateEditor) {
      (window as any).__recreateEditor();
    }
  });
</script>

<script>
  import { EditorView, keymap, lineNumbers, highlightActiveLine, highlightActiveLineGutter } from "@codemirror/view";
  import { EditorState } from "@codemirror/state";
  import { syntaxHighlighting, bracketMatching, indentOnInput } from "@codemirror/language";
  import { defaultKeymap, history, historyKeymap, indentWithTab } from "@codemirror/commands";
  import { highlightSelectionMatches, searchKeymap } from "@codemirror/search";
  import { closeBrackets, closeBracketsKeymap } from "@codemirror/autocomplete";

  import { markdyLanguage, markdyAutocomplete, markdyHighlightLight, markdyHighlightDark } from "../editor/markdy-language";
  import { baseTheme, lightTheme, darkTheme } from "../editor/editor-theme";
  import { createPlayer } from "@markdy/renderer-dom";
  import type { Player } from "@markdy/renderer-dom";
  import type { ExampleEntry } from "../data/examples";

  const examples: ExampleEntry[]  = (window as any).__MARKDY_EXAMPLES;
  const assets: Record<string, string> = (window as any).__MARKDY_ASSETS;

  const editorContainer = document.getElementById("code-editor") as HTMLDivElement;
  const stage     = document.getElementById("stage")      as HTMLDivElement;
  const runBtn    = document.getElementById("run-btn")    as HTMLButtonElement;
  const statusEl  = document.getElementById("status")     as HTMLSpanElement;
  const rewindBtn = document.getElementById("rewind-btn") as HTMLButtonElement;
  const restartBtn = document.getElementById("restart-btn") as HTMLButtonElement;
  const playBtn   = document.getElementById("play-btn")   as HTMLButtonElement;
  const speedBtns = document.querySelectorAll<HTMLButtonElement>(".speed-btn");
  const playIcon  = document.getElementById("play-icon")  as SVGElement;
  const pauseIcon = document.getElementById("pause-icon") as SVGElement;
  const playLabel = document.getElementById("play-label") as HTMLSpanElement;
  const expandPreviewBtn = document.getElementById("expand-preview-btn") as HTMLButtonElement;
  const expandPreviewLabel = document.getElementById("expand-preview-label") as HTMLSpanElement;
  const timelineRange = document.getElementById("timeline-range") as HTMLInputElement;
  const timelineTime = document.getElementById("timeline-time") as HTMLSpanElement;
  const sceneJump = document.getElementById("scene-jump") as HTMLSelectElement;
  const exBtns    = document.querySelectorAll<HTMLButtonElement>(".example-btn");
  const exampleDescription = document.getElementById("example-description") as HTMLParagraphElement;
  const exampleSourceLink = document.getElementById("example-source-link") as HTMLAnchorElement;

  let player: Player | null = null;
  let isAnimPlaying = false;
  let debounce: ReturnType<typeof setTimeout> | null = null;
  let editorView: EditorView | null = null;
  let currentPreviewStart = 0;
  let isScrubbing = false;
  let isPreviewExpanded = false;
  let selectedPlaybackRate = 1;

  function setSelectedPlaybackRate(rate: number) {
    if (!Number.isFinite(rate) || rate <= 0) return;
    selectedPlaybackRate = rate;
    for (const btn of speedBtns) {
      const btnRate = Number(btn.dataset.speed ?? "1");
      const isActive = Math.abs(btnRate - rate) < 0.001;
      btn.classList.toggle("active", isActive);
      btn.setAttribute("aria-pressed", isActive ? "true" : "false");
    }
    player?.setPlaybackRate(rate);
  }

  setSelectedPlaybackRate(1);

  function formatTime(seconds: number): string {
    if (!Number.isFinite(seconds) || seconds <= 0) return "0:00";
    const total = Math.floor(seconds);
    const mins = Math.floor(total / 60);
    const secs = total % 60;
    return `${mins}:${secs.toString().padStart(2, "0")}`;
  }

  function setTimeline(current: number, duration: number) {
    const safeDuration = Number.isFinite(duration) && duration > 0 ? duration : 0;
    const safeCurrent = safeDuration > 0 ? Math.min(Math.max(current, 0), safeDuration) : 0;
    timelineRange.max = safeDuration.toFixed(2);
    if (!isScrubbing) timelineRange.value = safeCurrent.toFixed(2);
    timelineRange.disabled = safeDuration <= 0;
    timelineTime.textContent = `${formatTime(safeCurrent)} / ${formatTime(safeDuration)}`;
  }

  function populateSceneJump(beats: { name: string; start: number }[]) {
    sceneJump.innerHTML = "";
    if (beats.length === 0) {
      sceneJump.hidden = true;
      return;
    }
    sceneJump.hidden = false;
    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "Jump to scene…";
    sceneJump.appendChild(placeholder);
    for (const beat of beats) {
      const option = document.createElement("option");
      option.value = beat.name;
      option.textContent = beat.name;
      sceneJump.appendChild(option);
    }
    sceneJump.value = "";
  }

  function setPlayState(playing: boolean) {
    isAnimPlaying = playing;
    playIcon.style.display  = playing ? "none"   : "";
    pauseIcon.style.display = playing ? ""       : "none";
    playLabel.textContent   = playing ? "Pause"  : "Play";
    playBtn.setAttribute("aria-label", playing ? "Pause" : "Play");
  }

  function isDarkMode(): boolean {
    return document.documentElement.getAttribute("data-theme") === "dark";
  }

  function setStatus(ok: boolean) {
    statusEl.className = `status ${ok ? "ok" : "err"}`;
  }

  const stageWrap = document.getElementById("stage-wrap") as HTMLDivElement;

  function resizeStage() {
    if (!stageWrap || !stage.firstElementChild) return;
    const sceneEl = stage.firstElementChild as HTMLElement;
    
    // Don't scale error messages
    if (sceneEl.classList.contains("parse-error")) {
      stageWrap.style.removeProperty("--preview-aspect");
      sceneEl.style.transform = "";
      return;
    }

    const wrapW = stage.clientWidth;
    const styleWidth = sceneEl.style.width.trim();
    const styleHeight = sceneEl.style.height.trim();
    const aspectRatio = sceneEl.style.aspectRatio || getComputedStyle(sceneEl).aspectRatio;

    let sceneWidth = parseFloat(styleWidth);
    let sceneHeight = parseFloat(styleHeight);

    if (styleWidth.endsWith("%") && aspectRatio.includes("/")) {
      const [aspectW, aspectH] = aspectRatio.split("/").map((value) => Number.parseFloat(value.trim()));
      if (Number.isFinite(aspectW) && Number.isFinite(aspectH) && aspectW > 0 && aspectH > 0) {
        stageWrap.style.setProperty("--preview-aspect", `${aspectW} / ${aspectH}`);
        sceneWidth = wrapW;
        sceneHeight = wrapW * (aspectH / aspectW);
      }
    }

    const wrapH = stage.clientHeight;
    if (wrapW === 0 || wrapH === 0) return;

    if (!Number.isFinite(sceneWidth) || sceneWidth <= 0 || !Number.isFinite(sceneHeight) || sceneHeight <= 0) {
      stageWrap.style.removeProperty("--preview-aspect");
      sceneWidth = wrapW;
      sceneHeight = stageWrap.firstElementChild?.getBoundingClientRect().height || 400;
    }

    const availW = Math.max(1, wrapW);
    const availH = Math.max(1, wrapH);

    const scaleX = availW / sceneWidth;
    const scaleY = availH / sceneHeight;
    const scale = Math.max(0.01, Math.min(scaleX, scaleY));

    // Override renderer's absolute position cleanly to center it visually
    sceneEl.style.position = "absolute";
    sceneEl.style.left = "50%";
    sceneEl.style.top = "50%";
    sceneEl.style.transform = `translate(-50%, -50%) scale(${scale})`;
    sceneEl.style.transformOrigin = "center center";
  }

  const ro = new ResizeObserver(() => resizeStage());
  ro.observe(stageWrap);
  ro.observe(stage);

  function setPreviewExpanded(expanded: boolean) {
    isPreviewExpanded = expanded;
    document.querySelector(".playground")?.classList.toggle("is-theater", expanded);
    expandPreviewBtn.setAttribute("aria-pressed", expanded ? "true" : "false");
    expandPreviewBtn.setAttribute("aria-label", expanded ? "Collapse preview" : "Expand preview");
    expandPreviewBtn.title = expanded ? "Collapse preview" : "Expand preview";
    expandPreviewLabel.textContent = expanded ? "Collapse" : "Expand";
    requestAnimationFrame(() => resizeStage());
  }

  function adaptCodeToTheme(code: string): string {
    return code;
  }

  function render(code: string, previewStart = currentPreviewStart) {
    currentPreviewStart = previewStart;
    if (player) { player.destroy(); player = null; }
    stage.innerHTML = "";
    try {
      player = createPlayer({
        container: stage,
        code: adaptCodeToTheme(code),
        autoplay: true,
        copyright: false,
        sceneBoundaryProgress: false,
        playbackRate: selectedPlaybackRate,
        onTimeUpdate: setTimeline,
        onPlayStateChange: setPlayState,
      });
      if (previewStart > 0) {
        player.seek(previewStart);
      }
      setPlayState(true);
      setTimeline(player.currentTime(), player.duration());
      populateSceneJump(player.beats());
      setStatus(true);
      if ((window as any).Iconify) {
        (window as any).Iconify.scan(stage);
      }
      resizeStage();
    } catch (e) {
      const msg = (e as Error).message ?? String(e);
      stage.innerHTML = `<p class="parse-error">${msg}</p>`;
      setStatus(false);
      setPlayState(false);
      setTimeline(0, 0);
      populateSceneJump([]);
    }
  }

  function setActiveBtn(index: number) {
    exBtns.forEach((b, i) => b.classList.toggle("active", i === index));
  }

  function setExampleMeta(index: number) {
    const example = examples[index];
    if (!example) {
      exampleDescription.textContent = "Custom scene";
      exampleSourceLink.href = "https://github.com/HoangYell/markdy-com/tree/main/examples";
      exampleSourceLink.textContent = "Browse examples ↗";
      return;
    }

    exampleDescription.textContent = example.description;
    exampleSourceLink.href = example.sourceUrl;
    exampleSourceLink.textContent = "View source ↗";
  }

  function getEditorCode(): string {
    return editorView?.state.doc.toString() ?? "";
  }

  function createEditor(initialCode: string) {
    // Destroy if existing
    if (editorView) {
      editorView.destroy();
      editorView = null;
    }

    const dark = isDarkMode();

    const extensions = [
      lineNumbers(),
      highlightActiveLine(),
      highlightActiveLineGutter(),
      history(),
      bracketMatching(),
      closeBrackets(),
      indentOnInput(),
      highlightSelectionMatches(),
      markdyLanguage,
      markdyAutocomplete,
      syntaxHighlighting(dark ? markdyHighlightDark : markdyHighlightLight),
      baseTheme,
      dark ? darkTheme : lightTheme,
      keymap.of([
        ...closeBracketsKeymap,
        ...defaultKeymap,
        ...searchKeymap,
        ...historyKeymap,
        indentWithTab,
      ]),
      EditorView.contentAttributes.of({ "aria-label": "Code Editor" }),
      EditorView.updateListener.of((update) => {
        if (update.docChanged) {
          currentPreviewStart = 0;
          exBtns.forEach(b => b.classList.remove("active"));
          if (debounce) clearTimeout(debounce);
          debounce = setTimeout(() => render(getEditorCode()), 600);
        }
      }),
    ];

    editorView = new EditorView({
      state: EditorState.create({
        doc: initialCode,
        extensions,
      }),
      parent: editorContainer,
    });
  }


  // ── URL hash share state ────────────────────────────────────────────
  function getCodeFromHash(): string | null {
    try {
      const hash = window.location.hash.slice(1);
      if (!hash) return null;
      const params = new URLSearchParams(hash);
      const encoded = params.get("code");
      if (!encoded) return null;
      return decodeURIComponent(atob(encoded));
    } catch {
      return null;
    }
  }

  function setShareURL(code: string) {
    const encoded = btoa(encodeURIComponent(code));
    const url = `${window.location.origin}${window.location.pathname}#code=${encoded}`;
    return url;
  }

  const shareBtn = document.getElementById("share-btn") as HTMLButtonElement;
  shareBtn?.addEventListener("click", () => {
    const code = getEditorCode();
    const url = setShareURL(code);
    navigator.clipboard.writeText(url).then(() => {
      shareBtn.textContent = "✓ Copied!";
      shareBtn.style.color = "var(--accent, #ea4c89)";
      setTimeout(() => {
        shareBtn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg><span>Share</span>`;
        shareBtn.style.color = "";
      }, 2000);
    }).catch(() => {
      shareBtn.title = "Copy failed — check clipboard permissions";
    });
  });

  // Lazy initialization on interaction to guarantee 100/100 Lighthouse performance
  let isPlaygroundInit = false;
  const lazyInit = () => {
    if (isPlaygroundInit) return;
    isPlaygroundInit = true;
    // Load from URL hash if present, else use default example
    const sharedCode = getCodeFromHash();
    const initialCode = sharedCode ?? examples[0].code;
    createEditor(initialCode);
    if (!sharedCode) {
      currentPreviewStart = examples[0].playback?.previewStart ?? 0;
      render(initialCode, currentPreviewStart);
      setActiveBtn(0);
      setExampleMeta(0);
    } else {
      currentPreviewStart = 0;
      render(initialCode, 0);
      setActiveBtn(-1);
      setExampleMeta(-1);
    }
  };

  ['mousemove', 'scroll', 'keydown', 'click', 'touchstart'].forEach((event) => {
    window.addEventListener(event, lazyInit, { once: true, passive: true });
  });

  // Fallback in case there is no interaction for a bit:
  setTimeout(lazyInit, 8000);

  // Expose theme-change handler — also re-render the scene with adapted bg
  (window as any).__recreateEditor = () => {
    const currentCode = getEditorCode();
    createEditor(currentCode);
    render(currentCode, currentPreviewStart);
  };

  // Example buttons
  exBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const idx = Number(btn.dataset.index);
      setActiveBtn(idx);
      setExampleMeta(idx);
      createEditor(examples[idx].code);
      render(examples[idx].code, examples[idx].playback?.previewStart ?? 0);
    });
  });

  // Play / Pause button
  playBtn.addEventListener("click", () => {
    if (!player) return;
    if (isAnimPlaying) {
      player.pause();
    } else {
      player.play();
    }
  });

  rewindBtn.addEventListener("click", () => {
    if (!player) return;
    player.seek(player.currentTime() - 1);
  });

  expandPreviewBtn.addEventListener("click", () => {
    setPreviewExpanded(!isPreviewExpanded);
  });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isPreviewExpanded) {
      setPreviewExpanded(false);
    }
  });

  restartBtn.addEventListener("click", () => {
    if (!player) return;
    player.seek(0);
    if (!player.isPlaying()) player.play();
  });

  speedBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const rate = Number(btn.dataset.speed ?? "1");
      setSelectedPlaybackRate(rate);
    });
  });

  timelineRange.addEventListener("input", () => {
    if (!player) return;
    isScrubbing = true;
    player.seek(Number(timelineRange.value));
  });

  timelineRange.addEventListener("change", () => {
    isScrubbing = false;
    if (!player) return;
    player.seek(Number(timelineRange.value));
  });

  sceneJump.addEventListener("change", () => {
    if (!player || !sceneJump.value) return;
    player.seekToBeat(sceneJump.value);
  });

  // Run button
  runBtn.addEventListener("click", () => render(getEditorCode()));

  // Keyboard shortcut: Cmd/Ctrl+Enter to run
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
      e.preventDefault();
      render(getEditorCode());
    }
  });

  // Setup global Apply function for Syntax Reference examples
  (window as any).applyRefCode = (code: string) => {
    createEditor(code);
    currentPreviewStart = 0;
    render(code, 0);
    setActiveBtn(-1); // Remove active state
    setExampleMeta(-1);
    // scrollIntoView respects scroll-margin-top (set to 68px to clear the sticky nav)
    document.getElementById("playground")?.scrollIntoView({ behavior: "smooth", block: "start" });
  };
</script>

