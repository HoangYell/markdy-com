  <!-- ─── Hero Section ─────────────────────────────────────────────────── -->
  <header class="home-hero">
    <!-- Hero Showcase Stage with og-image.webp Visual Foundation -->
    <div class="hero-stage">
      <img
        src="/og-image.webp"
        class="hero-stage-bg"
        alt="Markdy Animated Diagrams Foundation"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        width="1200"
        height="630"
      />
      <div class="hero-stage-wash" aria-hidden="true"></div>

      <div class="hero-stage-content">
        <div class="hero-kicker">⚡ Open-Source Diagram-as-Code DSL · Native Browser Motion</div>
