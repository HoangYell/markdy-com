              <span>1s</span>
            </button>
            <button id="play-btn" class="btn-icon btn-icon--primary" title="Play / Pause" aria-label="Play">
              <svg id="play-icon" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              <svg id="pause-icon" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
              <span id="play-label">Play</span>
            </button>
