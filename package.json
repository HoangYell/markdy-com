{
  "name": "markdy",
  "version": "1.4.1",
  "private": true,
  "description": "Open-source diagram-as-code DSL for animated architecture and system diagrams. Write diagram-native MarkdyScript, get browser-native motion diagrams.",
  "license": "MIT",
  "author": "Hoang Yell <hoangyell@gmail.com> (https://hoangyell.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/HoangYell/markdy-com.git"
  },
  "homepage": "https://markdy.com",
  "bugs": {
    "url": "https://github.com/HoangYell/markdy-com/issues"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "keywords": [
    "markdy",
    "markdyscript",
    "diagram-as-code",
    "diagram-native",
    "animated-diagram",
    "architecture-diagram",
    "mermaid-alternative",
    "system-design",
    "sequence-diagram",
    "docs-as-code",
    "dsl",
    "web-animations-api"
  ],
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "build:website": "pnpm --filter @markdy/website run build",
    "build:vscode": "pnpm --filter markdy-vscode run build",
    "package:vscode": "pnpm --filter markdy-vscode run package",
    "publish:vscode": "node scripts/publish-vscode-marketplace.mjs",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist",
    "gate": "pnpm --filter @markdy/compat run gate",
    "gate:update": "pnpm --filter @markdy/compat run gate:update",
    "verify:examples": "tsx scripts/verify-examples.ts",
    "test:devtools": "node scripts/chrome-devtools-adaptive-test.mjs",
    "test:visual": "node scripts/chrome-devtools-adaptive-test.mjs",
    "test:visual:update": "node scripts/chrome-devtools-adaptive-test.mjs --update-baselines",
    "test:perf": "node scripts/chrome-devtools-perf-benchmark.mjs",
    "regen": "tsx scripts/regenerate-all.ts",
    "harness": "pnpm --filter @markdy/renderer-dom run harness",
    "ci": "pnpm run test && pnpm run gate && pnpm run verify:examples && pnpm run test:devtools",
    "publish:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "release": "./scripts/release.sh"
  },
  "devDependencies": {
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.7.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2"
  }
}
